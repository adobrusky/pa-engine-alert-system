            swingDebugRow := f_addSwingDebugRow(swingDebugTable, swingDebugRow, "Short Final Target Type", shortSwingTargetType, swingDebugNeutralColor)
            swingDebugRow := f_addSwingDebugRow(swingDebugTable, swingDebugRow, "Short Final Target", f_priceText(shortSwingTargetPrice), swingDebugNeutralColor)
            swingDebugRow := f_addSwingDebugBool(swingDebugTable, swingDebugRow, "Bear Swing Base Gate", bearSwingBaseGate, color.red)
            swingDebugRow := f_addSwingDebugBool(swingDebugTable, swingDebugRow, "Bear Swing Alert", bearSwingAlert, color.red)
            swingDebugRow := f_addSwingDebugBool(swingDebugTable, swingDebugRow, "Plot Bear Swing Alert", plotBearSwingAlert, color.red)

longSwingDebugOnChartBar = showSwingDebugOnChart and swingDebugShowLong and barstate.isconfirmed and (bullSwingBaseGate or longSwingLevelTouched or longSwingSetupQualified or bullSwingSignalAllowed)
shortSwingDebugOnChartBar = showSwingDebugOnChart and swingDebugShowShort and barstate.isconfirmed and (bearSwingBaseGate or shortSwingLevelTouched or shortSwingSetupQualified or bearSwingSignalAllowed)

if longSwingDebugOnChartBar
    label.new(
         bar_index,
         low,
         "L SWING\n" + longSwingRejectionReason + "\n" + longSwingSetupTextShort + " " + f_rrText(longSwingRR),
         style=label.style_label_up,
         textcolor=color.white,
         color=longSwingTradeValid ? color.new(color.lime, 0) : color.rgb(170, 120, 0),
         size=size.tiny
    )

if shortSwingDebugOnChartBar
    label.new(
         bar_index,
         high,
         "S SWING\n" + shortSwingRejectionReason + "\n" + shortSwingSetupTextShort + " " + f_rrText(shortSwingRR),
         style=label.style_label_down,
         textcolor=color.white,
         color=shortSwingTradeValid ? color.new(color.red, 0) : color.rgb(170, 120, 0),
         size=size.tiny
    )

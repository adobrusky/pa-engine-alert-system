            swingDebugRow := f_addSwingDebugBool(swingDebugTable, swingDebugRow, "Chart PDL Broken Short", shortChartPdlSwingBroken, color.red)
            swingDebugRow := f_addSwingDebugBool(swingDebugTable, swingDebugRow, "Short Swing Level Touched", shortSwingLevelTouched, color.red)
            swingDebugRow := f_addSwingDebugRow(swingDebugTable, swingDebugRow, "Short Touched Level Name", shortSwingTouchedLevelName, swingDebugNeutralColor)
            swingDebugRow := f_addSwingDebugRow(swingDebugTable, swingDebugRow, "Short Touched Level Price", f_priceText(shortSwingTouchedLevelPrice), swingDebugNeutralColor)
            swingDebugRow := f_addSwingDebugBool(swingDebugTable, swingDebugRow, "Short Swing Level Broken", shortSwingLevelBroken, color.red)
            swingDebugRow := f_addSwingDebugRow(swingDebugTable, swingDebugRow, "Signal Low", f_priceText(low), swingDebugNeutralColor)

            swingDebugRow := f_addSwingDebugRow(swingDebugTable, swingDebugRow, "Micro Swing Low Bar", f_debugIntText(mostRecentMicroSwingLowBar), swingDebugNeutralColor)
            swingDebugRow := f_addSwingDebugRow(swingDebugTable, swingDebugRow, "Long Swing Stop Source", longSwingStopSource, longSwingStopSource == "Micro Swing" ? color.lime : swingDebugWarnColor)
            swingDebugRow := f_addSwingDebugRow(swingDebugTable, swingDebugRow, "Long Swing Stop", f_priceText(longSwingStopPrice), swingDebugNeutralColor)

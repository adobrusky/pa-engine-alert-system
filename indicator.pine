//@version=6
indicator("PA Engine Alert System", shorttitle = "PA Engine Alerts", overlay=true, calc_bars_count=1000, max_bars_back = 1000, max_lines_count=500, max_labels_count=500, max_boxes_count=200, dynamic_requests=true)

// ===================== User Inputs =====================

groupCoreAlerts = "01. Core Alert Controls"
groupSetupFilters = "02. Setup Filters"
groupThesis = "03. Thesis"
groupScalpLevels = "04. Scalp Levels"
groupOpeningRange = "05. Opening Range"
groupRisk = "06. Risk / Position Sizing"
groupTargets = "07. Target Settings"
groupSignalEngine = "08. Signal Engine Tuning"
groupDisplay = "09. Display / Visuals"
groupDebug = "10. Debug / Advanced"
groupSwingAlerts = "11. Swing Alerts"

// 01. Core Alert Controls
alertScalpSetups         = input.bool(true, title="Alert Scalp Setups", group=groupCoreAlerts, tooltip="Alerts high-volume scalp setups only. Scalp stops use the signal-bar extreme plus one tick.")
alertSwingSetups         = input.bool(true, title="Alert Swing Setups", group=groupCoreAlerts, tooltip="Alerts swing setups using high-volume or pressure-qualified normal-volume signals. Swing stops use the most recent micro swing when available.")
tickerInput              = input.string("MES", title="Ticker", options=["MES", "MNQ"], group=groupCoreAlerts)
alertOnBullSignals       = input.bool(true, title="Alert On Bull Signals", group=groupCoreAlerts)
alertOnBearSignals       = input.bool(true, title="Alert On Bear Signals", group=groupCoreAlerts)
waitFirst15Minutes       = input.bool(true, title="Wait First 15 Minutes", group=groupCoreAlerts)
requireOpeningRangeBreak = input.bool(true, title="Require Opening Range Break", group=groupCoreAlerts)
requireValidTarget       = input.bool(true, title="Require Valid Target", group=groupCoreAlerts)
minTargetRR              = input.float(1.0, title="Scalp Minimum Target R:R", minval=0.25, step=0.05, group=groupCoreAlerts, tooltip="Minimum required reward-to-risk for scalp targets. Default is 1.0R. The only exception is the existing HOD/LOD edge exception.")
prioritizeSwingWhenSameEntry = input.bool(true, title="Prioritize Swing When Entry Earlier / Same", group=groupCoreAlerts, tooltip="When a valid scalp and swing setup trigger in the same direction on the same bar, show/send the swing when its selected entry triggers earlier than or at the scalp entry.")

// 02. Setup Filters
requireLevelBreakSetup   = input.bool(true, title="Require Level Break Setup", group=groupSetupFilters, tooltip="Require scalp alerts to have a signal bar that touches an enabled scalp entry level and closes beyond it.")
requireTwoBarSetup       = input.bool(false, title="Require Two-Bar Setup", group=groupSetupFilters, tooltip="Require scalp alerts to have no qualifying level break plus a trend-body signal bar with confirmation from one of the prior two bars.")
requireTwoBarIgnition    = input.bool(true, title="Require Ignition for Two-Bar Setups", group=groupSetupFilters)
skipFiveBarExtension     = input.bool(true, title="Skip 5+ Bar Extension", group=groupSetupFilters)
skipStrongMicrochannelExtension = input.bool(true, title="Skip 3+ Bar Strong Extension", group=groupSetupFilters)
skipTwoBarSameColorExtension = input.bool(false, title="Skip 5 Same-Color Bars For Two-Bar Setups", group=groupSetupFilters)
useFboImpulseFilter      = input.bool(true, title="Use FBO Impulse Filter", group=groupSetupFilters)
fboImpulseTolerance      = input.float(0.0, title="FBO Impulse Tolerance", minval=0.0, step=0.05, group=groupSetupFilters)
impulseLookback          = input.int(3, title="Impulse Lookback", minval=1, maxval=20, group=groupSetupFilters)
impulseAtrLength         = input.int(14, title="Impulse ATR Length", minval=1, maxval=200, group=groupSetupFilters)
esImpulseSymbol          = input.symbol("CME_MINI:ES1!", title="ES Impulse Symbol", group=groupSetupFilters)
nqImpulseSymbol          = input.symbol("CME_MINI:NQ1!", title="NQ Impulse Symbol", group=groupSetupFilters)
minLevelEntryRetracement = input.float(0.20, title="Minimum Level Entry Retracement", minval=0.0, maxval=0.5, step=0.05, group=groupSetupFilters)
alertSetupSignals        = input.bool(true, title="Allow Setup Signals", group=groupSetupFilters)
alertIgnitionSignals     = input.bool(true, title="Allow Ignition Signals", group=groupSetupFilters)
alertStrongIgnitions     = input.bool(true, title="Allow Strong Ignitions", group=groupSetupFilters)

// 03. Thesis 
useAutoThesis                 = input.bool(true, title="Use Auto Thesis", group=groupThesis)
autoThesisFallbackToManual    = input.bool(true, title="Fallback To Manual Thesis If Auto Unavailable", group=groupThesis)
initialThesis                 = input.string("Neutral", title="Initial Thesis", options=["Neutral", "Long", "Short"], group=groupThesis)
thesisLevel                   = input.float(0.0, title="Manual Thesis Level", step=0.25, group=groupThesis)
thesisFollowThroughBars       = input.int(5, title="Thesis Follow-Through Bars", minval=1, maxval=20, group=groupThesis)
autoThesisAtrMultiplier       = input.float(0.75, title="Auto Thesis ATR Multiplier", minval=0.1, step=0.05, group=groupThesis)
thesisSourceMode              = input.string("Auto From Ticker", title="Thesis Source Mode", options=["Auto From Ticker", "Manual Source"], group=groupThesis)
manualThesisSourceSymbol      = input.string("AMEX:SPY", title="Manual Thesis Source Symbol", group=groupThesis)
includeDailyGapsInAutoThesis  = input.bool(true, title="Include Daily Gaps In Auto Thesis", group=groupThesis)
dailyGapLookback              = input.int(200, title="Daily Gap Lookback", minval=10, maxval=500, group=groupThesis, tooltip="Number of SPY/QQQ regular-session daily bars to scan for unfilled daily gaps.")
showAutoThesisLevel           = input.bool(true, title="Show Auto/Effective Thesis Level", group=groupThesis)
showThesisLabel               = input.bool(true, title="Show Thesis Status Table", group=groupThesis)

// 04. Scalp Levels
useAutoPrevDayHighLow            = input.bool(true, title="Use Auto PDH/PDL", group=groupScalpLevels)
usePrevDayHighLevel              = input.bool(true, title="Use PDH Level", group=groupScalpLevels)
prevDayHighLevel                 = input.float(0.0, title="Manual/Fallback PDH Level", step=0.25, group=groupScalpLevels)
usePrevDayLowLevel               = input.bool(true, title="Use PDL Level", group=groupScalpLevels)
prevDayLowLevel                  = input.float(0.0, title="Manual/Fallback PDL Level", step=0.25, group=groupScalpLevels)
useAutoDailyOpen                 = input.bool(true, title="Use Auto Daily Open", group=groupScalpLevels)
useDailyOpenLevel                = input.bool(true, title="Use Daily Open Level", group=groupScalpLevels)
dailyOpenLevel                   = input.float(0.0, title="Manual/Fallback Daily Open", step=0.25, group=groupScalpLevels)
useAutoPremarketHighLow          = input.bool(true, title="Use Auto PMH/PML", group=groupScalpLevels)
usePremarketHighLevel            = input.bool(true, title="Use PMH Level", group=groupScalpLevels)
premarketHighLevel               = input.float(0.0, title="Manual/Fallback PMH Level", step=0.25, group=groupScalpLevels)
usePremarketLowLevel             = input.bool(true, title="Use PML Level", group=groupScalpLevels)
premarketLowLevel                = input.float(0.0, title="Manual/Fallback PML Level", step=0.25, group=groupScalpLevels)
useOpeningRangeHighAsEntryLevel  = input.bool(true, title="Use ORH As Entry Level", group=groupScalpLevels)
useOpeningRangeLowAsEntryLevel   = input.bool(true, title="Use ORL As Entry Level", group=groupScalpLevels)
showAutoScalpLevels              = input.bool(true, title="Show Auto/Effective Scalp Levels", group=groupScalpLevels)
showRawFuturesPrevDayLevels      = input.bool(false, title="Show Raw Futures PDH/PDL", group=groupScalpLevels, tooltip="Shows the raw chart/futures previous day high/low used by scalp logic. Off by default to avoid duplicating converted swing PDH/PDL.")

// 05. Opening Range
showOpeningRange                 = input.bool(true, title="Show Opening Range", group=groupOpeningRange)
useManualOpeningRangeFallback    = input.bool(false, title="Use Manual Opening Range Fallback", group=groupOpeningRange)
manualOpeningRangeHigh           = input.float(0.0, title="Manual Opening Range High", step=0.25, group=groupOpeningRange)
manualOpeningRangeLow            = input.float(0.0, title="Manual Opening Range Low", step=0.25, group=groupOpeningRange)

// 06. Risk / Position Sizing
maxRiskDollars      = input.float(215.0, title="Max Risk Dollars", minval=0.0, step=10.0, group=groupRisk)
commissionRoundTrip = input.float(1.24, title="Commission Per Contract, Round Trip", minval=0.0, step=0.01, group=groupRisk)
useMaxContractCap   = input.bool(true, title="Use Max Contract Cap", group=groupRisk)
maxContracts        = input.int(20, title="Max Contracts", minval=1, group=groupRisk)

// 07. Target Settings
allowSignalExtremeHodLodTarget = input.bool(true, title="Allow Signal-Bar HOD/LOD Edge Target", group=groupTargets, tooltip="Allows HOD/LOD as the target when the signal bar itself made HOD/LOD and the entry is a 50% retracement, even if the R:R is slightly below 1:1 because the stop is one tick beyond the signal bar.")
hodLodEdgeToleranceTicks       = input.int(1, title="HOD/LOD Edge Tolerance Ticks", minval=0, maxval=4, group=groupTargets)
maxTrackedSwingTargets         = input.int(100, title="Max Tracked Swing Targets", minval=20, maxval=300, group=groupTargets)

// 08. Signal Engine Tuning
onlyHighVolumeSignals         = input.bool(false, title="Pressure: Only Show High-Volume Signals", group=groupSignalEngine, tooltip="When enabled, pressure bull/bear signals are shown only when volume is greater than the prior bar.")
maxLookback                   = input.int(20, title="Pressure: Max Lookback", group=groupSignalEngine, minval=3, tooltip="Maximum number of bars to scan backward when finding prior up/down legs for fallback midpoint checks.")
pressureBodyWickThreshold     = input.float(0.40, title="Pressure: Body/Wick Range Threshold", group=groupSignalEngine, minval=0.05, maxval=0.95, step=0.05, tooltip="Minimum fraction of the full bar range required for body or wick qualification in pressure bar quality checks (default 40%).")
acceptableVolumeThreshold     = input(0.33, title="Acceptable Volume Threshold", group=groupSignalEngine, tooltip="Set the minimum volume threshold as a multiple of the volume average (e.g., 0.33x volume average). Bars with volume below this threshold will not display indications.")
volumeMetricLength            = input.int(50, title="Volume SMA Length", group=groupSignalEngine, minval=10, maxval=500, tooltip="Set the length for the volume SMA calculation.")
acceptableVolatilityThreshold = input(0.33, title="Acceptable Volatility Threshold", group=groupSignalEngine, tooltip="Set the minimum volatility threshold as a multiple of the ATR (e.g., 0.5x ATR). Bars with volatility below this threshold will not display indications.")
atrLength                     = input(14, title="ATR Length", group=groupSignalEngine, tooltip="Set the length of the ATR calculation.")

// 09. Display / Visuals
showBullSignals              = input.bool(true, title="Show Bull Signals", group=groupDisplay, tooltip="Enable bullish pressure signal markers and signal-overlap indications.")
showBearSignals              = input.bool(true, title="Show Bear Signals", group=groupDisplay, tooltip="Enable bearish pressure signal markers and signal-overlap indications.")
showSetupSignals             = input.bool(true, title="Setup Signals (Circle)", group=groupDisplay, tooltip="Setup-quality bar, not standalone actionable. Best used with failed-breakout context to identify potential reversals.")
showIgnitionSignals          = input.bool(true, title="Ignition Signals (Triangle)", group=groupDisplay, tooltip="Actionable momentum signal that can stand on its own without requiring failed-breakout context.")
showStrongIgnitions          = input.bool(true, title="Strong Ignitions (Diamond)", group=groupDisplay, tooltip="Strongest ignition signal; same concept as Ignition but with higher bar quality/strength. Useful for bias shifts through key levels.")
showSignalLegend             = input.bool(false, title="Show Signal Legend", group=groupDisplay, tooltip="Display a small on-chart legend mapping shapes to signal tiers.")
alertLabelMode               = input.string("Compact", title="Historical Alert Labels", options=["Off", "Marker Only", "Compact"], group=groupDisplay)
showAlertSignalDetails       = input.bool(false, title="Show Alert Signal Details", group=groupDisplay)
showSwingLevels              = input.bool(true, title="Show Swing Levels", group=groupDisplay, tooltip="Plots the converted higher-timeframe swing levels used for swing entries and targets.")
showSwingLevelLabels         = input.bool(false, title="Show Swing Level Labels", group=groupDisplay)
maxDisplayedDailyGaps        = input.int(20, title="Max Displayed Daily Gaps", minval=0, maxval=100, group=groupDisplay)

// 10. Debug / Advanced
showAutoThesisDebug    = input.bool(false, title="Show Auto Thesis Debug", group=groupDebug)
showDetailedLevelStatus = input.bool(false, title="Show Detailed Level Status", group=groupDebug)
showGapRequestDiagnostics = input.bool(false, title="Show Gap Request Diagnostics", group=groupDebug)

// 11. Swing Alerts
swingMinRR                         = input.float(1.5, title="Swing Minimum R:R", minval=0.25, step=0.05, group=groupSwingAlerts, tooltip="Minimum required reward-to-risk for swing setups. Swings should normally require at least 1.5R.")
swingUseStopOrdersFirst            = input.bool(true, title="Swing: Prioritize Stop Orders", group=groupSwingAlerts)
swingAllowRetracementEntries       = input.bool(true, title="Swing: Allow 50% / 61.8% Entries If Stop Entry Fails R:R", group=groupSwingAlerts)
swingMeasuredMoveAtrDistance       = input.float(2.0, title="Swing Measured Move Distance From Level, 5m ATRs", minval=0.25, step=0.25, group=groupSwingAlerts)
allowRthSwingsBrokenPremarket      = input.bool(true, title="Swing: Allow Prior RTH Swings Broken In Premarket", group=groupSwingAlerts, tooltip="When enabled, prior RTH swings remain eligible for swing failed-breakout logic even if they are tested or broken during the current premarket. They are still invalidated normally if broken during current RTH.")

scalpPointValue = tickerInput == "MES" ? 5.0 : 2.0
scalpTickSize   = 0.25

majorHighLevelColor = color.rgb(0, 100, 0)
majorLowLevelColor = color.rgb(145, 0, 0)
openLevelColor = color.orange
openingRangeHighColor = color.rgb(70, 190, 105)
openingRangeLowColor = color.rgb(235, 95, 95)
premarketLevelColor = color.blue
paEngineHighLevelColor = color.rgb(8, 153, 129)
paEngineLowLevelColor = color.rgb(242, 54, 69)
paEngineOpenLevelColor = color.rgb(243, 152, 15)
dailyGapLineColor = color.rgb(255, 255, 255)
dailyGapBoxColor = color.rgb(255, 255, 255, 95)
dailyGapBorderColor = color.rgb(255, 255, 255, 30)

// ===================== Volume Calculations =====================
volumeSMA = ta.sma(volume, volumeMetricLength)
sufficientVolume = na(volume) ? true : volume > volumeSMA * acceptableVolumeThreshold

// ===================== Price Action Calculations =====================
body = math.abs(close - open)
bodyHigh = math.max(open, close)
bodyLow = math.min(open, close)
barRange = high - low
bodyPct = barRange > 0 ? body / barRange : 0.0
closeInUpperThird = barRange > 0 and close >= low + barRange * (2.0 / 3.0)
closeInLowerThird = barRange > 0 and close <= low + barRange * (1.0 / 3.0)
upperWick = high - bodyHigh
lowerWick = bodyLow - low

// ===================== Pressure Signal Helpers =====================
f_safeRange(_high, _low) =>
    _r = _high - _low
    _r > 0 ? _r : na

f_closeInUpperThird(_close, _low, _range) =>
    not na(_range) and _close >= _low + _range * (2.0 / 3.0)

f_closeInLowerThird(_close, _low, _range) =>
    not na(_range) and _close <= _low + _range * (1.0 / 3.0)

f_meetsPct(_value, _range, _pct) =>
    not na(_range) and _value >= _range * _pct

f_dobruskyPressure() =>
    gapUp   = close[1] < low  ? (low  - close[1]) : 0.0
    gapDown = close[1] > high ? (close[1] - high) : 0.0

    adjLow  = low  - gapUp
    adjHigh = high + gapDown
    rng     = adjHigh - adjLow

    buyPressure  = na(volume) ? na : (rng != 0 ? volume * (close - adjLow) / rng : na)
    sellPressure = volume - buyPressure
    [buyPressure, sellPressure]

f_midPriorLegDown(_maxLookback) =>
    int legStart = na
    bool hasSeq = false

    for i = 0 to _maxLookback - 1
        if na(high[i]) or na(high[i + 1])
            break
        if high[i] < high[i + 1] or (i == 0 and high[i] >= high[i + 1] and high[i + 1] < high[i + 2])
            hasSeq := true
            legStart := i + 1
        else
            break

    float legHigh = na 
    float legLow = na
    float mid = na

    if hasSeq and not na(legStart)
        for j = 0 to _maxLookback - 1
            if j <= legStart
                legLow := na(legLow) ? low[j] : math.min(legLow, low[j])
                if j == legStart
                    legHigh := high[j]
        mid := (legHigh + legLow) / 2.0

    [mid, legLow, legHigh]

f_midPriorLegUp(_maxLookback) =>
    int legStart = na
    bool hasSeq = false

    for i = 0 to _maxLookback - 1
        if na(low[i]) or na(low[i + 1])
            break
        if low[i] > low[i + 1] or (i == 0 and low[i] <= low[i + 1] and low[i + 1] > low[i + 2])
            hasSeq := true
            legStart := i + 1
        else
            break

    float legLow = na
    float legHigh = na
    float mid = na

    if hasSeq and not na(legStart)
        for j = 0 to _maxLookback - 1
            if j <= legStart
                legHigh := na(legHigh) ? high[j] : math.max(legHigh, high[j])
                if j == legStart
                    legLow := low[j]
        mid := (legHigh + legLow) / 2.0

    [mid, legLow, legHigh]

// ===================== Scalp Alert Helpers =====================
f_roundUpToScalpTick(_price) =>
    math.ceil(_price / scalpTickSize) * scalpTickSize

f_roundDownToScalpTick(_price) =>
    math.floor(_price / scalpTickSize) * scalpTickSize

f_initialThesisState(_initialThesis) =>
    _initialThesis == "Long" ? 1 : _initialThesis == "Short" ? -1 : 0

f_thesisText(_thesisState) =>
    _thesisState == 1 ? "LONG" : _thesisState == -1 ? "SHORT" : "NEUTRAL"

f_priceText(_price) =>
    na(_price) ? "N/A" : str.tostring(_price, format.mintick)

f_numberText(_value) =>
    na(_value) ? "N/A" : str.tostring(_value, "#.##")

f_pointsText(_value) =>
    na(_value) ? "N/A" : str.tostring(_value, "#.00")

f_rrText(_rr) =>
    na(_rr) ? "N/A" : str.tostring(_rr, "#.00") + "R"

f_boolText(_condition) =>
    _condition ? "true" : "false"

f_tickCount(_value) =>
    int(math.round(_value / scalpTickSize))

f_roundToScalpTick(_price) =>
    math.round(_price / scalpTickSize) * scalpTickSize

f_longSwingEntryEarlierOrSame(_swingEntry, _scalpEntry) =>
    not na(_swingEntry) and not na(_scalpEntry) and _swingEntry >= _scalpEntry - scalpTickSize * 0.1

f_shortSwingEntryEarlierOrSame(_swingEntry, _scalpEntry) =>
    not na(_swingEntry) and not na(_scalpEntry) and _swingEntry <= _scalpEntry + scalpTickSize * 0.1

f_validSourcePrice(_price) =>
    not na(_price) and _price > 0

f_autoCandidateQualifies(float _price, float _sourceOpen, float _threshold) =>
    f_validSourcePrice(_price) and f_validSourcePrice(_sourceOpen) and not na(_threshold) and _threshold >= 0 and math.abs(_price - _sourceOpen) <= _threshold

f_pickAutoThesisCandidate(float _candidatePrice, string _candidateName, int _candidatePriority, float _sourceOpen, float _threshold, float _bestPrice, string _bestName, int _bestPriority, float _bestDistance) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    float nextDistance = _bestDistance
    if f_autoCandidateQualifies(_candidatePrice, _sourceOpen, _threshold)
        float candidateDistance = math.abs(_candidatePrice - _sourceOpen)
        bool betterCandidate = na(nextPrice) or _candidatePriority < nextPriority or (_candidatePriority == nextPriority and (na(nextDistance) or candidateDistance < nextDistance))
        if betterCandidate
            nextPrice := _candidatePrice
            nextName := _candidateName
            nextPriority := _candidatePriority
            nextDistance := candidateDistance
    [nextPrice, nextName, nextPriority, nextDistance]

f_currentRthOpen() =>
    var float rthOpen = na
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    int dateKey = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
    int priorDateKey = bar_index > 0 ? dateKey[1] : dateKey
    bool wasInRth = bar_index > 0 ? inRth[1] : false
    bool newRth = inRth and (not wasInRth or dateKey != priorDateKey)
    if newRth
        rthOpen := open
    else if not inRth and dateKey != priorDateKey
        rthOpen := na
    rthOpen

getHighLowOpen() =>
    [high[1], low[1], open]

getHigherTimeframeData(_timeframe, _ticker) =>
    // Mirrors the PA Engine level request: previous completed H/L plus current HTF open.
    request.security(_ticker, _timeframe, getHighLowOpen(), lookahead=barmerge.lookahead_on, calc_bars_count=2)

getGaps(_lookBack) =>
    map<int, string> gapsDict = map.new<int, string>()
    i = _lookBack
    float atrSumForGaps = 0.0
    while i >= 0
        dailyOpen = open[i]
        dailyLow = low[i]
        dailyHigh = high[i]
        prevClose = close[i + 1]
        if i < atrLength
            atrSumForGaps := atrSumForGaps + math.max(dailyHigh - dailyLow, math.max(math.abs(dailyHigh - prevClose), math.abs(dailyLow - prevClose)))
        if dailyOpen != prevClose
            gapHigh = str.tostring(math.max(dailyOpen, prevClose))
            gapLow = str.tostring(math.min(dailyOpen, prevClose))
            isGapUp = dailyOpen > prevClose
            dir = isGapUp ? "U" : "D"
            gapsDict.put(time[i], dir + "|" + gapHigh + "," + gapLow + ":" + gapHigh + "," + gapLow)

        keysToRemove = array.new_int(0)
        if not barstate.isrealtime[i]
            for [key, value] in gapsDict
                gapOriginalAndPartial = str.split(value, ":")
                partialGapHighAndLow = str.split(array.get(gapOriginalAndPartial, 1), ",")
                partialGapHigh = str.tonumber(array.get(partialGapHighAndLow, 0))
                partialGapLow = str.tonumber(array.get(partialGapHighAndLow, 1))
                if dailyLow <= partialGapLow and dailyHigh >= partialGapHigh
                    array.push(keysToRemove, key)
                else
                    if dailyLow > partialGapLow and dailyLow < partialGapHigh
                        partialGapHigh := dailyLow
                        gapsDict.put(key, array.get(gapOriginalAndPartial, 0) + ":" + str.tostring(partialGapHigh) + "," + str.tostring(partialGapLow))
                    if dailyHigh < partialGapHigh and dailyHigh > partialGapLow
                        partialGapLow := dailyHigh
                        gapsDict.put(key, array.get(gapOriginalAndPartial, 0) + ":" + str.tostring(partialGapHigh) + "," + str.tostring(partialGapLow))
        for key in keysToRemove
            gapsDict.remove(key)
        i := i - 1
    keysToRemove = array.new_int(0)
    atrForGaps = atrSumForGaps / atrLength
    for [key, value] in gapsDict
        gapOriginalAndPartial = str.split(value, ":")
        partialGapHighAndLow = str.split(array.get(gapOriginalAndPartial, 1), ",")
        gapSize = math.abs(str.tonumber(array.get(partialGapHighAndLow, 0)) - str.tonumber(array.get(partialGapHighAndLow, 1)))
        if gapSize < atrForGaps * 0.1
            array.push(keysToRemove, key)
    for key in keysToRemove
        gapsDict.remove(key)
    gapsDict

f_gapBoundaryPriceFromRecord(string _gapRecord, bool _useHighSide) =>
    float gapBoundaryPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapBoundaryPrice := str.tonumber(array.get(gapHighAndLow, _useHighSide ? 0 : 1))
    gapBoundaryPrice

f_gapHighPriceFromRecord(string _gapRecord) =>
    f_gapBoundaryPriceFromRecord(_gapRecord, true)

f_gapLowPriceFromRecord(string _gapRecord) =>
    f_gapBoundaryPriceFromRecord(_gapRecord, false)

f_gapEndPriceFromRecord(string _gapRecord) =>
    float gapEndPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh = str.tonumber(array.get(gapHighAndLow, 0))
                gapLow = str.tonumber(array.get(gapHighAndLow, 1))
                // Gap end = prior-close side of the gap.
                // Gap up: low side. Gap down: high side.
                gapEndPrice := dir == "U" ? gapLow : gapHigh
    gapEndPrice

f_gapStartPriceFromRecord(string _gapRecord) =>
    float gapStartPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh = str.tonumber(array.get(gapHighAndLow, 0))
                gapLow = str.tonumber(array.get(gapHighAndLow, 1))
                // Gap start = daily-open side of the gap.
                // Gap up: high side. Gap down: low side.
                gapStartPrice := dir == "U" ? gapHigh : gapLow
    gapStartPrice

f_parseGapRecord(string _gapRecord) =>
    bool gapParsed = false
    float gapStart = na
    float gapEnd = na
    float gapHigh = na
    float gapLow = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if (dir == "U" or dir == "D") and array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh := str.tonumber(array.get(gapHighAndLow, 0))
                gapLow := str.tonumber(array.get(gapHighAndLow, 1))
                if not na(gapHigh) and not na(gapLow)
                    gapStart := dir == "U" ? gapHigh : gapLow
                    gapEnd := dir == "U" ? gapLow : gapHigh
                    gapParsed := true
    [gapParsed, gapStart, gapEnd, gapHigh, gapLow]

f_gapMapDiagnostics(map<int, string> _gapMap) =>
    int gapMapCount = 0
    string firstGapRecord = "N/A"
    if not na(_gapMap)
        for [gapMapKey, gapMapValue] in _gapMap
            gapMapCount += 1
            if gapMapCount == 1
                firstGapRecord := gapMapValue
    [gapMapCount, firstGapRecord]

f_isBullBar(_open, _close) =>
    not na(_open) and not na(_close) and _close > _open

f_isBearBar(_open, _close) =>
    not na(_open) and not na(_close) and _close < _open

f_bullUpperThirdBar(_open, _high, _low, _close) =>
    _range = f_safeRange(_high, _low)
    f_isBullBar(_open, _close) and f_closeInUpperThird(_close, _low, _range)

f_bearLowerThirdBar(_open, _high, _low, _close) =>
    _range = f_safeRange(_high, _low)
    f_isBearBar(_open, _close) and f_closeInLowerThird(_close, _low, _range)

f_levelTouched(bool _enabled, float _levelPrice, float _signalLow, float _signalHigh) =>
    _enabled and _levelPrice > 0 and _levelPrice >= _signalLow and _levelPrice <= _signalHigh

f_pickLongTouchedLevel(bool _enabled, float _levelPrice, string _levelName, float _signalLow, float _signalHigh, float _bestPrice, string _bestName) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    if f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh) and (na(nextPrice) or _levelPrice > nextPrice)
        nextPrice := _levelPrice
        nextName := _levelName
    [nextPrice, nextName]

f_pickShortTouchedLevel(bool _enabled, float _levelPrice, string _levelName, float _signalLow, float _signalHigh, float _bestPrice, string _bestName) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    if f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh) and (na(nextPrice) or _levelPrice < nextPrice)
        nextPrice := _levelPrice
        nextName := _levelName
    [nextPrice, nextName]

f_targetRRLong(float _targetPrice, float _entryPrice, float _riskPoints) =>
    float rewardPoints = _targetPrice - _entryPrice
    not na(_targetPrice) and not na(_entryPrice) and not na(_riskPoints) and rewardPoints > 0 and _riskPoints > 0 ? rewardPoints / _riskPoints : na

f_targetRRShort(float _targetPrice, float _entryPrice, float _riskPoints) =>
    float rewardPoints = _entryPrice - _targetPrice
    not na(_targetPrice) and not na(_entryPrice) and not na(_riskPoints) and rewardPoints > 0 and _riskPoints > 0 ? rewardPoints / _riskPoints : na

f_swingRRLong(float _entryPrice, float _stopPrice, float _targetPrice) =>
    float riskPoints = _entryPrice - _stopPrice
    float rewardPoints = _targetPrice - _entryPrice
    not na(_entryPrice) and not na(_stopPrice) and not na(_targetPrice) and riskPoints > 0 and rewardPoints > 0 ? rewardPoints / riskPoints : na

f_swingRRShort(float _entryPrice, float _stopPrice, float _targetPrice) =>
    float riskPoints = _stopPrice - _entryPrice
    float rewardPoints = _entryPrice - _targetPrice
    not na(_entryPrice) and not na(_stopPrice) and not na(_targetPrice) and riskPoints > 0 and rewardPoints > 0 ? rewardPoints / riskPoints : na

f_longHodEdgeQualifies(float _targetPrice, string _targetType, string _entryType, float _signalHigh, float _entryPrice, float _riskPoints, float _currentRTHHigh) =>
    float rewardPoints = _targetPrice - _entryPrice
    bool signalMadeHOD = not na(_currentRTHHigh) and not na(_signalHigh) and (_currentRTHHigh == _signalHigh or math.abs(_currentRTHHigh - _signalHigh) <= scalpTickSize * 0.1)
    bool edgeWithinTolerance = not na(_riskPoints) and not na(rewardPoints) and _riskPoints > 0 and _riskPoints - rewardPoints <= scalpTickSize * hodLodEdgeToleranceTicks + scalpTickSize * 0.1
    allowSignalExtremeHodLodTarget and _targetType == "HOD" and _entryType == "50%" and signalMadeHOD and rewardPoints > 0 and edgeWithinTolerance

f_shortLodEdgeQualifies(float _targetPrice, string _targetType, string _entryType, float _signalLow, float _entryPrice, float _riskPoints, float _currentRTHLow) =>
    float rewardPoints = _entryPrice - _targetPrice
    bool signalMadeLOD = not na(_currentRTHLow) and not na(_signalLow) and (_currentRTHLow == _signalLow or math.abs(_currentRTHLow - _signalLow) <= scalpTickSize * 0.1)
    bool edgeWithinTolerance = not na(_riskPoints) and not na(rewardPoints) and _riskPoints > 0 and _riskPoints - rewardPoints <= scalpTickSize * hodLodEdgeToleranceTicks + scalpTickSize * 0.1
    allowSignalExtremeHodLodTarget and _targetType == "LOD" and _entryType == "50%" and signalMadeLOD and rewardPoints > 0 and edgeWithinTolerance

f_longTargetQualifies(float _targetPrice, string _targetType, string _entryType, float _signalHigh, float _entryPrice, float _riskPoints, float _currentRTHHigh) =>
    bool priceReady = not na(_targetPrice) and _targetPrice > 0
    bool locationOk = priceReady and (_targetType == "HOD" ? _targetPrice >= _signalHigh : _targetPrice > _signalHigh)
    float rr = f_targetRRLong(_targetPrice, _entryPrice, _riskPoints)
    bool normalTargetOk = locationOk and not na(rr) and rr >= minTargetRR
    bool edgeTargetOk = locationOk and f_longHodEdgeQualifies(_targetPrice, _targetType, _entryType, _signalHigh, _entryPrice, _riskPoints, _currentRTHHigh)
    normalTargetOk or edgeTargetOk

f_shortTargetQualifies(float _targetPrice, string _targetType, string _entryType, float _signalLow, float _entryPrice, float _riskPoints, float _currentRTHLow) =>
    bool priceReady = not na(_targetPrice) and _targetPrice > 0
    bool locationOk = priceReady and (_targetType == "LOD" ? _targetPrice <= _signalLow : _targetPrice < _signalLow)
    float rr = f_targetRRShort(_targetPrice, _entryPrice, _riskPoints)
    bool normalTargetOk = locationOk and not na(rr) and rr >= minTargetRR
    bool edgeTargetOk = locationOk and f_shortLodEdgeQualifies(_targetPrice, _targetType, _entryType, _signalLow, _entryPrice, _riskPoints, _currentRTHLow)
    normalTargetOk or edgeTargetOk

f_pickLongTargetCandidate(bool _enabled, float _candidatePrice, string _candidateType, float _signalHigh, string _entryType, float _entryPrice, float _riskPoints, float _currentRTHHigh, float _bestPrice, string _bestType, float _bestRR) =>
    float nextPrice = _bestPrice
    string nextType = _bestType
    float nextRR = _bestRR
    if _enabled and f_longTargetQualifies(_candidatePrice, _candidateType, _entryType, _signalHigh, _entryPrice, _riskPoints, _currentRTHHigh) and (na(nextPrice) or _candidatePrice < nextPrice)
        nextPrice := _candidatePrice
        nextType := _candidateType
        nextRR := f_targetRRLong(_candidatePrice, _entryPrice, _riskPoints)
    [nextPrice, nextType, nextRR]

f_pickShortTargetCandidate(bool _enabled, float _candidatePrice, string _candidateType, float _signalLow, string _entryType, float _entryPrice, float _riskPoints, float _currentRTHLow, float _bestPrice, string _bestType, float _bestRR) =>
    float nextPrice = _bestPrice
    string nextType = _bestType
    float nextRR = _bestRR
    if _enabled and f_shortTargetQualifies(_candidatePrice, _candidateType, _entryType, _signalLow, _entryPrice, _riskPoints, _currentRTHLow) and (na(nextPrice) or _candidatePrice > nextPrice)
        nextPrice := _candidatePrice
        nextType := _candidateType
        nextRR := f_targetRRShort(_candidatePrice, _entryPrice, _riskPoints)
    [nextPrice, nextType, nextRR]

f_swingTargetSessionAllowed(string _session, int _dateKey, int _currentDateKey, int _currentRTHDateKey, int _previousRTHDateKey) =>
    bool pmAllowed = _session == "PM" and _dateKey == _currentDateKey
    bool rthCurrentAllowed = _session == "RTH" and not na(_currentRTHDateKey) and _dateKey == _currentRTHDateKey
    bool rthPreviousAllowed = _session == "RTH" and not na(_previousRTHDateKey) and _dateKey == _previousRTHDateKey
    pmAllowed or rthCurrentAllowed or rthPreviousAllowed

f_swingBreakCanInvalidate(bool _allowRthSwingsBrokenPremarket, bool _currentInPremarket, string _swingSession, int _swingDateKey, int _mostRecentCompletedRTHDateKey) =>
    not (_allowRthSwingsBrokenPremarket and _currentInPremarket and _swingSession == "RTH" and not na(_mostRecentCompletedRTHDateKey) and _swingDateKey == _mostRecentCompletedRTHDateKey)

f_hasPivotBar(array<int> _pivotBars, int _pivotBar) =>
    bool found = false
    if array.size(_pivotBars) > 0
        for pivotBarIndex = 0 to array.size(_pivotBars) - 1
            if array.get(_pivotBars, pivotBarIndex) == _pivotBar
                found := true
    found

// ===================== ATR Calculation (RTH only) =====================
var float atrSum = 0.0
var trArray = array.new_float(0)
isRTH = time(timeframe.period, "0930-1600:23456", "America/New_York") != 0 or timeframe.isdwm
trValue = ta.tr(true)
atrValue = 0.0
if isRTH
    atrSum += trValue
    array.push(trArray, trValue)
    if array.size(trArray) > atrLength
        removed = array.shift(trArray)
        atrSum -= removed
    atrValue := atrSum / array.size(trArray)
else
    atrValue := nz(atrValue[1])

chartIsFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
swingAtrNeeded = alertSwingSetups
swingAtr5 = chartIsFiveMinute ? atrValue : swingAtrNeeded ? request.security(syminfo.tickerid, "5", ta.atr(atrLength), lookahead=barmerge.lookahead_off) : na

sufficientVolatility = barRange >= atrValue * acceptableVolatilityThreshold

// ===================== RTH / Opening Range Logic =====================
scalpRTHTime = time(timeframe.period, "0930-1600:23456", "America/New_York")
openingRangeTime = time(timeframe.period, "0930-0945:23456", "America/New_York")
premarketTime = time(timeframe.period, "0400-0930:23456", "America/New_York")
inScalpRTHSession = not na(scalpRTHTime)
inPremarketSession = not na(premarketTime)
inOpeningRangeWindow = inScalpRTHSession and not na(openingRangeTime)
nySessionDateKey = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
priorNYSessionDateKey = bar_index > 0 ? nySessionDateKey[1] : nySessionDateKey
wasInScalpRTHSession = bar_index > 0 ? inScalpRTHSession[1] : false
wasInPremarketSession = bar_index > 0 ? inPremarketSession[1] : false
newNYSessionDate = bar_index > 0 and nySessionDateKey != priorNYSessionDateKey
newScalpRTHSession = inScalpRTHSession and (not wasInScalpRTHSession or nySessionDateKey != priorNYSessionDateKey)
newPremarketSession = inPremarketSession and (not wasInPremarketSession or nySessionDateKey != priorNYSessionDateKey)

// Auto scalp levels are intended for intraday charts, ideally 5m.
var float currentRTHHigh = na
var float currentRTHLow = na
var float autoPrevDayHigh = na
var float autoPrevDayLow = na
var float autoDailyOpen = na
var float autoPremarketHigh = na
var float autoPremarketLow = na
var float finalizedPremarketHigh = na
var float finalizedPremarketLow = na
var int autoPremarketDateKey = na
var int currentRTHDateKey = na
var int previousRTHDateKey = na
var int currentRTHStartBar = na
var array<float> swingHighPrices = array.new_float(0)
var array<int> swingHighPivotBars = array.new_int(0)
var array<int> swingHighDateKeys = array.new_int(0)
var array<string> swingHighSessions = array.new_string(0)
var array<bool> swingHighActive = array.new_bool(0)
var array<float> swingLowPrices = array.new_float(0)
var array<int> swingLowPivotBars = array.new_int(0)
var array<int> swingLowDateKeys = array.new_int(0)
var array<string> swingLowSessions = array.new_string(0)
var array<bool> swingLowActive = array.new_bool(0)
var array<float> fboSwingHighPrices = array.new_float()
var array<int> fboSwingHighPivotBars = array.new_int()
var array<int> fboSwingHighDateKeys = array.new_int()
var array<string> fboSwingHighSessions = array.new_string()
var array<bool> fboSwingHighCleared = array.new_bool()
var array<float> fboSwingLowPrices = array.new_float()
var array<int> fboSwingLowPivotBars = array.new_int()
var array<int> fboSwingLowDateKeys = array.new_int()
var array<string> fboSwingLowSessions = array.new_string()
var array<bool> fboSwingLowCleared = array.new_bool()
var array<float> rthSwingHistHighs = array.new_float()
var array<float> rthSwingHistLows = array.new_float()
var array<int> rthSwingHistBarIndexes = array.new_int()
var array<int> rthSwingHistDateKeys = array.new_int()
var array<float> pmSwingHistHighs = array.new_float()
var array<float> pmSwingHistLows = array.new_float()
var array<int> pmSwingHistBarIndexes = array.new_int()
var array<int> pmSwingHistDateKeys = array.new_int()
var float mostRecentMicroSwingLow = na
var float mostRecentMicroSwingHigh = na

if newNYSessionDate and not inScalpRTHSession and not inPremarketSession
    autoDailyOpen := na
    finalizedPremarketHigh := na
    finalizedPremarketLow := na

if newPremarketSession
    autoPremarketHigh := high
    autoPremarketLow := low
    autoDailyOpen := na
    finalizedPremarketHigh := na
    finalizedPremarketLow := na
    autoPremarketDateKey := nySessionDateKey
else if inPremarketSession
    autoPremarketHigh := na(autoPremarketHigh) ? high : math.max(autoPremarketHigh, high)
    autoPremarketLow := na(autoPremarketLow) ? low : math.min(autoPremarketLow, low)
    autoPremarketDateKey := nySessionDateKey

if newScalpRTHSession
    if not na(currentRTHDateKey)
        previousRTHDateKey := currentRTHDateKey
    currentRTHDateKey := nySessionDateKey
    currentRTHStartBar := bar_index
    autoPrevDayHigh := currentRTHHigh
    autoPrevDayLow := currentRTHLow
    currentRTHHigh := high
    currentRTHLow := low
    autoDailyOpen := open
    currentPremarketReady = autoPremarketDateKey == nySessionDateKey and not na(autoPremarketHigh) and not na(autoPremarketLow)
    finalizedPremarketHigh := currentPremarketReady ? autoPremarketHigh : na
    finalizedPremarketLow := currentPremarketReady ? autoPremarketLow : na
else if inScalpRTHSession
    currentRTHHigh := na(currentRTHHigh) ? high : math.max(currentRTHHigh, high)
    currentRTHLow := na(currentRTHLow) ? low : math.min(currentRTHLow, low)

effectivePrevDayHigh = useAutoPrevDayHighLow and not na(autoPrevDayHigh) ? autoPrevDayHigh : prevDayHighLevel
effectivePrevDayLow = useAutoPrevDayHighLow and not na(autoPrevDayLow) ? autoPrevDayLow : prevDayLowLevel
effectiveDailyOpen = useAutoDailyOpen and not na(autoDailyOpen) ? autoDailyOpen : dailyOpenLevel
effectivePremarketHigh = useAutoPremarketHighLow and not na(finalizedPremarketHigh) ? finalizedPremarketHigh : premarketHighLevel
effectivePremarketLow = useAutoPremarketHighLow and not na(finalizedPremarketLow) ? finalizedPremarketLow : premarketLowLevel

prevDayHighLowSource = useAutoPrevDayHighLow ? (not na(autoPrevDayHigh) and not na(autoPrevDayLow) ? "Auto" : "Manual Fallback") : "Manual"
dailyOpenSource = useAutoDailyOpen ? (not na(autoDailyOpen) ? "Auto" : "Manual Fallback") : "Manual"
premarketSource = useAutoPremarketHighLow ? (not na(finalizedPremarketHigh) and not na(finalizedPremarketLow) ? "Auto" : "Manual Fallback") : "Manual"

// ===================== Auto Thesis Source Levels =====================
// MES defaults to AMEX:SPY. TradingView alerts may require real-time entitlement
// for the exact feed used by request.security(), even if it appears usable on charts.
autoDefaultThesisSourceSymbol = tickerInput == "MES" ? "AMEX:SPY" : "NASDAQ:QQQ"
autoDefaultThesisSourceTicker = tickerInput == "MES" ? ticker.new("AMEX", "SPY", "us_regular:23456") : ticker.new("NASDAQ", "QQQ", "us_regular:23456")
explicitDailyGapSourceTicker = tickerInput == "MES" ? ticker.new("AMEX", "SPY", "us_regular:23456") : ticker.new("NASDAQ", "QQQ", "us_regular:23456")
explicitDailyGapPlainSymbol = tickerInput == "MES" ? "AMEX:SPY" : "NASDAQ:QQQ"
expectedDailyGapSourceSymbol = tickerInput == "MES" ? "SPY" : "QQQ"
sourceLevelsEnabled = useAutoThesis or alertSwingSetups or showSwingLevels
thesisSourceSymbol = sourceLevelsEnabled ? (thesisSourceMode == "Manual Source" ? manualThesisSourceSymbol : autoDefaultThesisSourceSymbol) : "None"
thesisSourceTicker = sourceLevelsEnabled ? (thesisSourceMode == "Manual Source" ? manualThesisSourceSymbol : autoDefaultThesisSourceTicker) : ""
sourceCloseForConversionNeeded = sourceLevelsEnabled
dailyGapRequestEnabled = sourceLevelsEnabled and (includeDailyGapsInAutoThesis or alertSwingSetups or showSwingLevels)
activeDailyGapSourceTicker = thesisSourceMode == "Manual Source" ? manualThesisSourceSymbol : explicitDailyGapSourceTicker
activeDailyGapSourceSymbol = thesisSourceMode == "Manual Source" ? manualThesisSourceSymbol : explicitDailyGapPlainSymbol
activeDailyGapSourceType = thesisSourceMode == "Manual Source" ? "Manual source" : "Explicit RTH ticker"
activeDailyGapSourceDebugText = activeDailyGapSourceType == "Explicit RTH ticker" ? activeDailyGapSourceSymbol + " RTH" : activeDailyGapSourceSymbol
activeDailyGapRequestMode = "Ungated"
activeDailyGapTimeframe = "1440"
activeDailyGapCalcBarsCount = 600
dailyGapMarketSession = inScalpRTHSession ? "M" : inPremarketSession ? "P" : "A"
var bool executedDailyGapLogic = false
var string prevDailyGapMarketSession = "A"
if barstate.islast
    if (prevDailyGapMarketSession == "P" and dailyGapMarketSession == "M") or (prevDailyGapMarketSession == "M" and dailyGapMarketSession == "A")
        executedDailyGapLogic := false
dailyGapRequestShouldRefresh = dailyGapRequestEnabled and not executedDailyGapLogic and barstate.islast

// The HTF requests intentionally mirror the PA Engine approach: previous completed
// H/L plus the current period open are requested with lookahead_on.
float sourcePrevDayHigh = na
float sourcePrevDayLow = na
float sourceDayOpenHTF = na
float sourcePrevWeekHigh = na
float sourcePrevWeekLow = na
float sourceWeekOpen = na
float sourcePrevMonthHigh = na
float sourcePrevMonthLow = na
float sourceMonthOpen = na
float sourceDayOpenIntraday = na
float sourceDayOpen = na
float source1hRthAtr = na
float sourceCloseForConversion = na
map<int, string> sourceDailyGaps = na
map<int, string> gatedDiagnosticDailyGaps = na
map<int, string> ungatedDiagnosticDailyGaps = na
map<int, string> ungated600DiagnosticDailyGaps = na
map<int, string> explicitRthDiagnosticDailyGaps = na
map<int, string> plainSymbolDiagnosticDailyGaps = na
map<int, string> explicit1440DiagnosticDailyGaps = na
map<int, string> explicitDDiagnosticDailyGaps = na
var float lastRthChartCloseForDisplayConversion = na
var float lastRthSourceCloseForDisplayConversion = na
var array<int> cachedSourceDailyGapTimes = array.new_int()
var array<float> cachedSourceDailyGapStarts = array.new_float()
var array<float> cachedSourceDailyGapEnds = array.new_float()
var array<float> cachedSourceDailyGapHighs = array.new_float()
var array<float> cachedSourceDailyGapLows = array.new_float()
var int lastFreshRequestedSourceDailyGapCount = 0
var int sourceDailyGapParseFailCount = 0
var int sourceDailyGapInvalidPriceCount = 0
var int sourceDailyGapCachedSuccessCount = 0
var string firstRawDailyGapRecord = "N/A"

var array<float> swingLevelPrices = array.new_float()
var array<string> swingLevelNames = array.new_string()
var array<int> swingLevelPriority = array.new_int()
var array<bool> swingLevelAllowedForEntry = array.new_bool()
var array<bool> swingLevelAllowedForTarget = array.new_bool()
var array<float> swingDisplayLevelPrices = array.new_float()
var array<string> swingDisplayLevelLabels = array.new_string()
var array<color> swingDisplayLevelColors = array.new_color()
var array<int> swingDisplayLevelWidths = array.new_int()
var array<int> swingDisplayLevelStyles = array.new_int()
var array<float> swingDisplayGapBoxTops = array.new_float()
var array<float> swingDisplayGapBoxBottoms = array.new_float()
var array<line> swingLevelLines = array.new_line()
var array<label> swingLevelLabels = array.new_label()
var array<box> swingDailyGapBoxes = array.new_box()

if sourceLevelsEnabled
    [requestedPrevDayHigh, requestedPrevDayLow, requestedDayOpenHTF] = getHigherTimeframeData("1440", thesisSourceTicker)
    [requestedPrevWeekHigh, requestedPrevWeekLow, requestedWeekOpen] = getHigherTimeframeData("W", thesisSourceTicker)
    [requestedPrevMonthHigh, requestedPrevMonthLow, requestedMonthOpen] = getHigherTimeframeData("M", thesisSourceTicker)
    sourcePrevDayHigh := requestedPrevDayHigh
    sourcePrevDayLow := requestedPrevDayLow
    sourceDayOpenHTF := requestedDayOpenHTF
    sourcePrevWeekHigh := requestedPrevWeekHigh
    sourcePrevWeekLow := requestedPrevWeekLow
    sourceWeekOpen := requestedWeekOpen
    sourcePrevMonthHigh := requestedPrevMonthHigh
    sourcePrevMonthLow := requestedPrevMonthLow
    sourceMonthOpen := requestedMonthOpen
    sourceDayOpenIntraday := request.security(thesisSourceTicker, "5", f_currentRthOpen(), lookahead=barmerge.lookahead_off, calc_bars_count=500)
    sourceDayOpen := f_validSourcePrice(sourceDayOpenHTF) ? sourceDayOpenHTF : sourceDayOpenIntraday
    source1hRthAtr := useAutoThesis ? request.security(thesisSourceTicker, "60", ta.atr(atrLength), lookahead=barmerge.lookahead_off, calc_bars_count=500) : na
    sourceCloseForConversion := sourceCloseForConversionNeeded ? request.security(thesisSourceTicker, timeframe.period, close, lookahead=barmerge.lookahead_off, calc_bars_count=500) : na
    if dailyGapRequestEnabled
        // Request SPY/QQQ RTH daily gaps from the selected source, cache the
        // original source boundaries below, then convert them to the futures chart.
        // The active request is intentionally ungated so live alert logic and
        // closed-market chart reloads always have the full source gap map.
        sourceDailyGaps := request.security(activeDailyGapSourceTicker, activeDailyGapTimeframe, getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=activeDailyGapCalcBarsCount)
        if showGapRequestDiagnostics
            gatedDiagnosticDailyGaps := request.security(thesisSourceTicker, "1440", not executedDailyGapLogic and barstate.islast ? getGaps(dailyGapLookback) : map.new<int, string>(), lookahead=barmerge.lookahead_on, calc_bars_count=dailyGapLookback)
            ungatedDiagnosticDailyGaps := request.security(thesisSourceTicker, "1440", getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=dailyGapLookback)
            ungated600DiagnosticDailyGaps := request.security(thesisSourceTicker, "1440", getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=600)
            explicitRthDiagnosticDailyGaps := request.security(explicitDailyGapSourceTicker, "1440", getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=600)
            plainSymbolDiagnosticDailyGaps := request.security(explicitDailyGapPlainSymbol, "1440", getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=600)
            explicit1440DiagnosticDailyGaps := request.security(explicitDailyGapSourceTicker, "1440", getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=600)
            explicitDDiagnosticDailyGaps := request.security(explicitDailyGapSourceTicker, "D", getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=600)

if barstate.isconfirmed and inScalpRTHSession and f_validSourcePrice(close) and f_validSourcePrice(sourceCloseForConversion)
    lastRthChartCloseForDisplayConversion := close
    lastRthSourceCloseForDisplayConversion := sourceCloseForConversion

// Current Price Ratio is the only active source-to-chart conversion. Once an
// RTH ratio exists, premarket and after-hours bars reuse it instead of drifting.
fallbackChartConversionClose = barstate.isconfirmed ? close : close[1]
fallbackSourceConversionClose = barstate.isconfirmed ? sourceCloseForConversion : sourceCloseForConversion[1]
chartConversionBase = f_validSourcePrice(lastRthChartCloseForDisplayConversion) ? lastRthChartCloseForDisplayConversion : f_validSourcePrice(fallbackChartConversionClose) and f_validSourcePrice(fallbackSourceConversionClose) ? fallbackChartConversionClose : na
sourceConversionBase = f_validSourcePrice(lastRthSourceCloseForDisplayConversion) ? lastRthSourceCloseForDisplayConversion : f_validSourcePrice(fallbackSourceConversionClose) ? fallbackSourceConversionClose : na
currentConversionRatio = f_validSourcePrice(chartConversionBase) and f_validSourcePrice(sourceConversionBase) ? chartConversionBase / sourceConversionBase : na
swingCurrentPriceRatioReady = f_validSourcePrice(currentConversionRatio)

[requestedSourceDailyGapCount, currentFirstRawDailyGapRecord] = f_gapMapDiagnostics(sourceDailyGaps)
[gatedDiagnosticGapCount, gatedDiagnosticFirstRawRecord] = f_gapMapDiagnostics(gatedDiagnosticDailyGaps)
[ungatedDiagnosticGapCount, ungatedDiagnosticFirstRawRecord] = f_gapMapDiagnostics(ungatedDiagnosticDailyGaps)
[ungated600DiagnosticGapCount, ungated600DiagnosticFirstRawRecord] = f_gapMapDiagnostics(ungated600DiagnosticDailyGaps)
[explicitRthDiagnosticGapCount, explicitRthDiagnosticFirstRawRecord] = f_gapMapDiagnostics(explicitRthDiagnosticDailyGaps)
[plainSymbolDiagnosticGapCount, plainSymbolDiagnosticFirstRawRecord] = f_gapMapDiagnostics(plainSymbolDiagnosticDailyGaps)
[explicit1440DiagnosticGapCount, explicit1440DiagnosticFirstRawRecord] = f_gapMapDiagnostics(explicit1440DiagnosticDailyGaps)
[explicitDDiagnosticGapCount, explicitDDiagnosticFirstRawRecord] = f_gapMapDiagnostics(explicitDDiagnosticDailyGaps)
bestDiagnosticGapCount = math.max(math.max(math.max(gatedDiagnosticGapCount, ungatedDiagnosticGapCount), math.max(ungated600DiagnosticGapCount, explicitRthDiagnosticGapCount)), math.max(plainSymbolDiagnosticGapCount, math.max(explicit1440DiagnosticGapCount, explicitDDiagnosticGapCount)))
bestDiagnosticFirstRawRecord = explicitRthDiagnosticGapCount == bestDiagnosticGapCount ? explicitRthDiagnosticFirstRawRecord : ungated600DiagnosticGapCount == bestDiagnosticGapCount ? ungated600DiagnosticFirstRawRecord : ungatedDiagnosticGapCount == bestDiagnosticGapCount ? ungatedDiagnosticFirstRawRecord : plainSymbolDiagnosticGapCount == bestDiagnosticGapCount ? plainSymbolDiagnosticFirstRawRecord : explicitDDiagnosticGapCount == bestDiagnosticGapCount ? explicitDDiagnosticFirstRawRecord : explicit1440DiagnosticGapCount == bestDiagnosticGapCount ? explicit1440DiagnosticFirstRawRecord : gatedDiagnosticFirstRawRecord

// Cache the active ungated source request. Gated diagnostic requests may return
// intentional empty maps on non-refresh bars, but they never drive this cache.
if dailyGapRequestEnabled and not na(sourceDailyGaps)
    array.clear(cachedSourceDailyGapTimes)
    array.clear(cachedSourceDailyGapStarts)
    array.clear(cachedSourceDailyGapEnds)
    array.clear(cachedSourceDailyGapHighs)
    array.clear(cachedSourceDailyGapLows)
    lastFreshRequestedSourceDailyGapCount := requestedSourceDailyGapCount
    sourceDailyGapParseFailCount := 0
    sourceDailyGapInvalidPriceCount := 0
    sourceDailyGapCachedSuccessCount := 0
    firstRawDailyGapRecord := requestedSourceDailyGapCount > 0 ? currentFirstRawDailyGapRecord : "N/A"
    for [cacheGapKey, cacheGapValue] in sourceDailyGaps
        [cacheGapParsed, cacheGapStart, cacheGapEnd, cacheGapHigh, cacheGapLow] = f_parseGapRecord(cacheGapValue)
        bool cacheGapSourcePricesValid = f_validSourcePrice(cacheGapStart) and f_validSourcePrice(cacheGapEnd) and f_validSourcePrice(cacheGapHigh) and f_validSourcePrice(cacheGapLow)
        if not cacheGapParsed
            sourceDailyGapParseFailCount += 1
        else if not cacheGapSourcePricesValid
            sourceDailyGapInvalidPriceCount += 1
        else
            array.push(cachedSourceDailyGapTimes, cacheGapKey)
            array.push(cachedSourceDailyGapStarts, cacheGapStart)
            array.push(cachedSourceDailyGapEnds, cacheGapEnd)
            array.push(cachedSourceDailyGapHighs, cacheGapHigh)
            array.push(cachedSourceDailyGapLows, cacheGapLow)
            sourceDailyGapCachedSuccessCount += 1

if dailyGapRequestShouldRefresh
    executedDailyGapLogic := true
if barstate.islast
    prevDailyGapMarketSession := dailyGapMarketSession

sourceDailyGapCount = array.size(cachedSourceDailyGapStarts)
float firstValidSourceGapStart = na
float firstValidSourceGapEnd = na
float firstValidSourceGapHigh = na
float firstValidSourceGapLow = na
if sourceDailyGapCount > 0
    for countGapIndex = 0 to sourceDailyGapCount - 1
        float countGapStart = array.get(cachedSourceDailyGapStarts, countGapIndex)
        float countGapEnd = array.get(cachedSourceDailyGapEnds, countGapIndex)
        float countGapHigh = array.get(cachedSourceDailyGapHighs, countGapIndex)
        float countGapLow = array.get(cachedSourceDailyGapLows, countGapIndex)
        if na(firstValidSourceGapStart) and f_validSourcePrice(countGapStart) and f_validSourcePrice(countGapEnd)
            firstValidSourceGapStart := countGapStart
            firstValidSourceGapEnd := countGapEnd
            firstValidSourceGapHigh := countGapHigh
            firstValidSourceGapLow := countGapLow

float sourceGapEndPrice = na
float sourceGapEndDistance = na
if useAutoThesis and includeDailyGapsInAutoThesis and f_validSourcePrice(sourceDayOpen) and sourceDailyGapCount > 0
    // Auto thesis selects one nearest source Gap End only. This selection does
    // not reduce the cached source gap list used for swing levels and display.
    for sourceGapIndex = 0 to sourceDailyGapCount - 1
        float gapEndCandidate = array.get(cachedSourceDailyGapEnds, sourceGapIndex)
        if f_validSourcePrice(gapEndCandidate)
            float gapEndDistance = math.abs(gapEndCandidate - sourceDayOpen)
            if na(sourceGapEndDistance) or gapEndDistance < sourceGapEndDistance
                sourceGapEndPrice := gapEndCandidate
                sourceGapEndDistance := gapEndDistance

sourceAtrThreshold = f_validSourcePrice(source1hRthAtr) ? source1hRthAtr * autoThesisAtrMultiplier : na
float noAutoThesisCandidatePrice = na
string noAutoThesisCandidateName = "N/A"
int noAutoThesisCandidatePriority = 999
float noAutoThesisCandidateDistance = na

[autoAfterLMHPrice, autoAfterLMHName, autoAfterLMHPriority, autoAfterLMHDistance] = f_pickAutoThesisCandidate(sourcePrevMonthHigh, "Last Month High", 1, sourceDayOpen, sourceAtrThreshold, noAutoThesisCandidatePrice, noAutoThesisCandidateName, noAutoThesisCandidatePriority, noAutoThesisCandidateDistance)
[autoAfterLMLPrice, autoAfterLMLName, autoAfterLMLPriority, autoAfterLMLDistance] = f_pickAutoThesisCandidate(sourcePrevMonthLow, "Last Month Low", 1, sourceDayOpen, sourceAtrThreshold, autoAfterLMHPrice, autoAfterLMHName, autoAfterLMHPriority, autoAfterLMHDistance)
[autoAfterMonthOpenPrice, autoAfterMonthOpenName, autoAfterMonthOpenPriority, autoAfterMonthOpenDistance] = f_pickAutoThesisCandidate(sourceMonthOpen, "Monthly Open", 2, sourceDayOpen, sourceAtrThreshold, autoAfterLMLPrice, autoAfterLMLName, autoAfterLMLPriority, autoAfterLMLDistance)
[autoAfterLWHPrice, autoAfterLWHName, autoAfterLWHPriority, autoAfterLWHDistance] = f_pickAutoThesisCandidate(sourcePrevWeekHigh, "Last Week High", 3, sourceDayOpen, sourceAtrThreshold, autoAfterMonthOpenPrice, autoAfterMonthOpenName, autoAfterMonthOpenPriority, autoAfterMonthOpenDistance)
[autoAfterLWLPrice, autoAfterLWLName, autoAfterLWLPriority, autoAfterLWLDistance] = f_pickAutoThesisCandidate(sourcePrevWeekLow, "Last Week Low", 3, sourceDayOpen, sourceAtrThreshold, autoAfterLWHPrice, autoAfterLWHName, autoAfterLWHPriority, autoAfterLWHDistance)
[autoAfterWeekOpenPrice, autoAfterWeekOpenName, autoAfterWeekOpenPriority, autoAfterWeekOpenDistance] = f_pickAutoThesisCandidate(sourceWeekOpen, "Weekly Open", 4, sourceDayOpen, sourceAtrThreshold, autoAfterLWLPrice, autoAfterLWLName, autoAfterLWLPriority, autoAfterLWLDistance)
[autoAfterLDHPrice, autoAfterLDHName, autoAfterLDHPriority, autoAfterLDHDistance] = f_pickAutoThesisCandidate(sourcePrevDayHigh, "Last Day High", 5, sourceDayOpen, sourceAtrThreshold, autoAfterWeekOpenPrice, autoAfterWeekOpenName, autoAfterWeekOpenPriority, autoAfterWeekOpenDistance)
[autoAfterLDLPrice, autoAfterLDLName, autoAfterLDLPriority, autoAfterLDLDistance] = f_pickAutoThesisCandidate(sourcePrevDayLow, "Last Day Low", 5, sourceDayOpen, sourceAtrThreshold, autoAfterLDHPrice, autoAfterLDHName, autoAfterLDHPriority, autoAfterLDHDistance)
// Daily gap starts are intentionally excluded from auto-thesis selection.
[autoAfterGapEndPrice, autoAfterGapEndName, autoAfterGapEndPriority, autoAfterGapEndDistance] = f_pickAutoThesisCandidate(sourceGapEndPrice, "Gap End", 6, sourceDayOpen, sourceAtrThreshold, autoAfterLDLPrice, autoAfterLDLName, autoAfterLDLPriority, autoAfterLDLDistance)

autoHigherPriorityThesisFound = not na(autoAfterGapEndPrice)
selectedAutoThesisSourcePrice = autoHigherPriorityThesisFound ? autoAfterGapEndPrice : sourceDayOpen
selectedAutoThesisName = autoHigherPriorityThesisFound ? autoAfterGapEndName : "Daily Open"
selectedAutoThesisPriority = autoHigherPriorityThesisFound ? autoAfterGapEndPriority : 8
selectedAutoThesisDistance = autoHigherPriorityThesisFound ? autoAfterGapEndDistance : 0.0
selectedAutoThesisAtrThreshold = sourceAtrThreshold
autoThesisSelectionValid = f_validSourcePrice(selectedAutoThesisSourcePrice) and f_validSourcePrice(sourceDayOpen) and not na(selectedAutoThesisAtrThreshold)
autoThesisUsedDailyOpenDefault = autoThesisSelectionValid and not autoHigherPriorityThesisFound

chartDailyOpenForThesis = f_validSourcePrice(autoDailyOpen) ? autoDailyOpen : f_validSourcePrice(effectiveDailyOpen) ? effectiveDailyOpen : na
currentPriceRatioConverted = autoThesisSelectionValid and f_validSourcePrice(currentConversionRatio) ? selectedAutoThesisSourcePrice * currentConversionRatio : na
autoThesisUsesChartDailyOpen = selectedAutoThesisName == "Daily Open"
convertedAutoThesisRaw = useAutoThesis and autoThesisSelectionValid ? (autoThesisUsesChartDailyOpen ? chartDailyOpenForThesis : currentPriceRatioConverted) : na
convertedAutoThesisLevel = f_validSourcePrice(convertedAutoThesisRaw) ? f_roundToScalpTick(convertedAutoThesisRaw) : na
autoThesisConvertedValid = f_validSourcePrice(convertedAutoThesisLevel)
autoThesisConversionMethod = useAutoThesis and autoThesisSelectionValid ? (autoThesisUsesChartDailyOpen ? "Chart RTH Open" : "Current Price Ratio") : "N/A"
autoThesisNeedsConversionRatio = not autoThesisUsesChartDailyOpen
autoThesisUnavailableReason = not useAutoThesis ? "Auto disabled" : not f_validSourcePrice(sourceDayOpen) ? "No source daily open" : not f_validSourcePrice(source1hRthAtr) ? "No source ATR" : not autoThesisSelectionValid ? "No source selection" : autoThesisUsesChartDailyOpen and not f_validSourcePrice(chartDailyOpenForThesis) ? "No chart RTH open" : autoThesisNeedsConversionRatio and not swingCurrentPriceRatioReady ? "Conversion ratio missing" : not autoThesisConvertedValid ? "Conversion invalid" : "Auto ready"

f_convertSourceLevelToChart(_sourcePrice) =>
    f_validSourcePrice(_sourcePrice) and f_validSourcePrice(currentConversionRatio) ? f_roundToScalpTick(_sourcePrice * currentConversionRatio) : na

f_convertSourceLevelToChartForDisplay(_sourcePrice) =>
    float convertedDisplayPrice = f_validSourcePrice(_sourcePrice) and f_validSourcePrice(currentConversionRatio) ? _sourcePrice * currentConversionRatio : na
    f_validSourcePrice(convertedDisplayPrice) ? f_roundToScalpTick(convertedDisplayPrice) : na

f_addSwingDisplayConvertedLevel(_displayPrice, _label, _lineColor, _lineWidth, _lineStyle) =>
    if f_validSourcePrice(_displayPrice)
        array.push(swingDisplayLevelPrices, _displayPrice)
        array.push(swingDisplayLevelLabels, _label)
        array.push(swingDisplayLevelColors, _lineColor)
        array.push(swingDisplayLevelWidths, _lineWidth)
        array.push(swingDisplayLevelStyles, _lineStyle)

f_addSwingLevel(_price, _name, _priority, _entryAllowed, _targetAllowed) =>
    if f_validSourcePrice(_price)
        array.push(swingLevelPrices, _price)
        array.push(swingLevelNames, _name)
        array.push(swingLevelPriority, _priority)
        array.push(swingLevelAllowedForEntry, _entryAllowed)
        array.push(swingLevelAllowedForTarget, _targetAllowed)

f_addSwingDisplayLevel(_sourcePrice, _label, _lineColor, _lineWidth, _lineStyle) =>
    float displayPrice = f_convertSourceLevelToChartForDisplay(_sourcePrice)
    f_addSwingDisplayConvertedLevel(displayPrice, _label, _lineColor, _lineWidth, _lineStyle)

f_addSwingDisplayConvertedGapBox(_displayHigh, _displayLow) =>
    if f_validSourcePrice(_displayHigh) and f_validSourcePrice(_displayLow)
        array.push(swingDisplayGapBoxTops, math.max(_displayHigh, _displayLow))
        array.push(swingDisplayGapBoxBottoms, math.min(_displayHigh, _displayLow))

f_addSwingDisplayGapBox(_sourceHigh, _sourceLow) =>
    float displayHigh = f_convertSourceLevelToChartForDisplay(_sourceHigh)
    float displayLow = f_convertSourceLevelToChartForDisplay(_sourceLow)
    f_addSwingDisplayConvertedGapBox(displayHigh, displayLow)

f_lineStyleFromCode(_styleCode) =>
    _styleCode == 1 ? line.style_dashed : _styleCode == 2 ? line.style_dotted : line.style_solid

f_trimSwingLevelDrawings(_lineCount, _labelCount) =>
    while array.size(swingLevelLines) > _lineCount
        line staleLine = array.pop(swingLevelLines)
        line.delete(staleLine)
    while array.size(swingLevelLabels) > _labelCount
        label staleLabel = array.pop(swingLevelLabels)
        label.delete(staleLabel)

f_trimSwingGapBoxes(_boxCount) =>
    while array.size(swingDailyGapBoxes) > _boxCount
        box staleBox = array.pop(swingDailyGapBoxes)
        box.delete(staleBox)

array.clear(swingLevelPrices)
array.clear(swingLevelNames)
array.clear(swingLevelPriority)
array.clear(swingLevelAllowedForEntry)
array.clear(swingLevelAllowedForTarget)
array.clear(swingDisplayLevelPrices)
array.clear(swingDisplayLevelLabels)
array.clear(swingDisplayLevelColors)
array.clear(swingDisplayLevelWidths)
array.clear(swingDisplayLevelStyles)
array.clear(swingDisplayGapBoxTops)
array.clear(swingDisplayGapBoxBottoms)

int displayedDailyGapCount = 0
int dailyGapConvertedSuccessCount = 0
int swingDailyGapLevelsAdded = 0
float firstValidConvertedGapStart = na
float firstValidConvertedGapEnd = na
float firstValidConvertedGapHigh = na
float firstValidConvertedGapLow = na
string dailyGapUnavailableReason = "N/A"

if sourceDailyGapCount > 0
    for convertGapIndex = 0 to sourceDailyGapCount - 1
        float convertedGapStartForCount = f_convertSourceLevelToChartForDisplay(array.get(cachedSourceDailyGapStarts, convertGapIndex))
        float convertedGapEndForCount = f_convertSourceLevelToChartForDisplay(array.get(cachedSourceDailyGapEnds, convertGapIndex))
        float convertedGapHighForCount = f_convertSourceLevelToChartForDisplay(array.get(cachedSourceDailyGapHighs, convertGapIndex))
        float convertedGapLowForCount = f_convertSourceLevelToChartForDisplay(array.get(cachedSourceDailyGapLows, convertGapIndex))
        bool dailyGapConvertedValid = f_validSourcePrice(convertedGapStartForCount) and f_validSourcePrice(convertedGapEndForCount) and f_validSourcePrice(convertedGapHighForCount) and f_validSourcePrice(convertedGapLowForCount)
        if dailyGapConvertedValid
            dailyGapConvertedSuccessCount += 1
            if na(firstValidConvertedGapStart)
                firstValidConvertedGapStart := convertedGapStartForCount
                firstValidConvertedGapEnd := convertedGapEndForCount
                firstValidConvertedGapHigh := convertedGapHighForCount
                firstValidConvertedGapLow := convertedGapLowForCount

if sourceLevelsEnabled
    // Swing alert calculations use the swing level arrays below. These keep the
    // current price ratio so swing logic stays on converted SPY/QQQ levels.
    // The current day open is the exception: it stays anchored to the chart RTH open.
    f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevMonthHigh), "Previous Month High", 0, false, true)
    f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevMonthLow), "Previous Month Low", 0, false, true)
    f_addSwingLevel(f_convertSourceLevelToChart(sourceMonthOpen), "Current Month Open", 0, false, true)
    f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevWeekHigh), "Previous Week High", 1, true, true)
    f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevWeekLow), "Previous Week Low", 1, true, true)
    f_addSwingLevel(f_convertSourceLevelToChart(sourceWeekOpen), "Current Week Open", 2, true, true)
    f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevDayHigh), "Previous Day High", 3, true, true)
    f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevDayLow), "Previous Day Low", 3, true, true)
    f_addSwingLevel(chartDailyOpenForThesis, "Current Day Open", 4, true, true)
    if sourceDailyGapCount > 0
        // Convert cached source gap boundaries to chart prices, then add the
        // daily gap end as entry/target eligible and the start as target only.
        for sourceGapIndex = 0 to sourceDailyGapCount - 1
            float convertedGapEnd = f_convertSourceLevelToChart(array.get(cachedSourceDailyGapEnds, sourceGapIndex))
            float convertedGapStart = f_convertSourceLevelToChart(array.get(cachedSourceDailyGapStarts, sourceGapIndex))
            if f_validSourcePrice(convertedGapEnd)
                f_addSwingLevel(convertedGapEnd, "Daily Gap End", 5, true, true)
                swingDailyGapLevelsAdded += 1
            if f_validSourcePrice(convertedGapStart)
                f_addSwingLevel(convertedGapStart, "Daily Gap Start", 0, false, true)
                swingDailyGapLevelsAdded += 1
    if showSwingLevels
        // Displayed swing lines are live reference levels. Their current price
        // ratio updates only after confirmed New York RTH closes; they are
        // not intended to behave like historical series plots.
        f_addSwingDisplayLevel(sourcePrevMonthHigh, "PMH", paEngineHighLevelColor, 4, 1)
        f_addSwingDisplayLevel(sourcePrevMonthLow, "PML", paEngineLowLevelColor, 4, 1)
        f_addSwingDisplayLevel(sourceMonthOpen, "MO", paEngineOpenLevelColor, 5, 1)
        f_addSwingDisplayLevel(sourcePrevWeekHigh, "PWH", paEngineHighLevelColor, 3, 0)
        f_addSwingDisplayLevel(sourcePrevWeekLow, "PWL", paEngineLowLevelColor, 3, 0)
        f_addSwingDisplayLevel(sourceWeekOpen, "WO", paEngineOpenLevelColor, 3, 0)
        f_addSwingDisplayLevel(sourcePrevDayHigh, "PDH", paEngineHighLevelColor, 1, 0)
        f_addSwingDisplayLevel(sourcePrevDayLow, "PDL", paEngineLowLevelColor, 1, 0)
        f_addSwingDisplayConvertedLevel(chartDailyOpenForThesis, "DO", paEngineOpenLevelColor, 1, 0)
        int displayedGapCount = 0
        if maxDisplayedDailyGaps > 0 and sourceDailyGapCount > 0
            // Draw converted gap lines and boxes from original SPY/QQQ gap
            // boundaries. Partial fills are only used inside getGaps() to
            // remove filled gaps, not to change displayed levels.
            for displayGapIndex = 0 to sourceDailyGapCount - 1
                if displayedGapCount >= maxDisplayedDailyGaps
                    break
                float sourceGapStartForDisplay = array.get(cachedSourceDailyGapStarts, displayGapIndex)
                float sourceGapEndForDisplay = array.get(cachedSourceDailyGapEnds, displayGapIndex)
                float sourceGapHighForDisplay = array.get(cachedSourceDailyGapHighs, displayGapIndex)
                float sourceGapLowForDisplay = array.get(cachedSourceDailyGapLows, displayGapIndex)
                float convertedGapStartForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapStartForDisplay)
                float convertedGapEndForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapEndForDisplay)
                float convertedGapHighForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapHighForDisplay)
                float convertedGapLowForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapLowForDisplay)
                bool dailyGapDisplayValid = f_validSourcePrice(convertedGapStartForDisplay) and f_validSourcePrice(convertedGapEndForDisplay) and f_validSourcePrice(convertedGapHighForDisplay) and f_validSourcePrice(convertedGapLowForDisplay)
                if dailyGapDisplayValid
                    f_addSwingDisplayConvertedLevel(convertedGapStartForDisplay, "Gap Start", dailyGapLineColor, 2, 1)
                    f_addSwingDisplayConvertedLevel(convertedGapEndForDisplay, "Gap End", dailyGapLineColor, 2, 0)
                    f_addSwingDisplayConvertedGapBox(convertedGapHighForDisplay, convertedGapLowForDisplay)
                    if na(firstValidConvertedGapStart)
                        firstValidConvertedGapStart := convertedGapStartForDisplay
                        firstValidConvertedGapEnd := convertedGapEndForDisplay
                    displayedGapCount += 1
                    displayedDailyGapCount := displayedGapCount

if not dailyGapRequestEnabled
    dailyGapUnavailableReason := "daily gaps disabled"
else if na(sourceDailyGaps)
    dailyGapUnavailableReason := "request returned na"
else if sourceDailyGapCount == 0
    if requestedSourceDailyGapCount == 0
        dailyGapUnavailableReason := "active request returned 0"
    else if lastFreshRequestedSourceDailyGapCount == 0
        dailyGapUnavailableReason := "last active request returned 0"
    else if sourceDailyGapParseFailCount > 0
        dailyGapUnavailableReason := "raw record parse failed"
    else if sourceDailyGapInvalidPriceCount > 0
        dailyGapUnavailableReason := "source price invalid"
    else
        dailyGapUnavailableReason := "cache empty"
else if not swingCurrentPriceRatioReady
    dailyGapUnavailableReason := "conversion ratio missing"
else if dailyGapConvertedSuccessCount == 0
    dailyGapUnavailableReason := "conversion failed"
else if maxDisplayedDailyGaps <= 0
    dailyGapUnavailableReason := "maxDisplayedDailyGaps = 0"
else if not showSwingLevels
    dailyGapUnavailableReason := "showSwingLevels disabled"
else if displayedDailyGapCount == 0
    dailyGapUnavailableReason := "displayed count 0"
else if displayedDailyGapCount < dailyGapConvertedSuccessCount
    dailyGapUnavailableReason := "ready; display capped"
else
    dailyGapUnavailableReason := "ready"

if barstate.isconfirmed or barstate.islast
    int desiredSwingLineCount = showSwingLevels ? array.size(swingDisplayLevelPrices) : 0
    int desiredSwingLabelCount = showSwingLevels and showSwingLevelLabels ? desiredSwingLineCount : 0
    int desiredSwingGapBoxCount = showSwingLevels ? array.size(swingDisplayGapBoxTops) : 0
    int swingLineStartBar = not na(currentRTHStartBar) ? math.max(currentRTHStartBar, bar_index - 9999) : bar_index
    f_trimSwingLevelDrawings(desiredSwingLineCount, desiredSwingLabelCount)
    f_trimSwingGapBoxes(desiredSwingGapBoxCount)
    if desiredSwingGapBoxCount > 0
        for swingGapBoxIndex = 0 to desiredSwingGapBoxCount - 1
            float gapBoxTop = array.get(swingDisplayGapBoxTops, swingGapBoxIndex)
            float gapBoxBottom = array.get(swingDisplayGapBoxBottoms, swingGapBoxIndex)
            box swingDailyGapBox = na
            if array.size(swingDailyGapBoxes) <= swingGapBoxIndex
                swingDailyGapBox := box.new(
                     swingLineStartBar,
                     gapBoxTop,
                     bar_index + 1,
                     gapBoxBottom,
                     xloc=xloc.bar_index,
                     extend=extend.right,
                     border_color=dailyGapBorderColor,
                     border_width=0,
                     bgcolor=dailyGapBoxColor
                )
                array.push(swingDailyGapBoxes, swingDailyGapBox)
            else
                swingDailyGapBox := array.get(swingDailyGapBoxes, swingGapBoxIndex)
            box.set_left(swingDailyGapBox, swingLineStartBar)
            box.set_top(swingDailyGapBox, gapBoxTop)
            box.set_right(swingDailyGapBox, bar_index + 1)
            box.set_bottom(swingDailyGapBox, gapBoxBottom)
            box.set_extend(swingDailyGapBox, extend.right)
            box.set_bgcolor(swingDailyGapBox, dailyGapBoxColor)
            box.set_border_color(swingDailyGapBox, dailyGapBorderColor)
            box.set_border_width(swingDailyGapBox, 0)
    if desiredSwingLineCount > 0
        for swingDisplayIndex = 0 to desiredSwingLineCount - 1
            float swingDisplayPrice = array.get(swingDisplayLevelPrices, swingDisplayIndex)
            color swingDisplayColor = array.get(swingDisplayLevelColors, swingDisplayIndex)
            string swingDisplayLabel = array.get(swingDisplayLevelLabels, swingDisplayIndex)
            int swingDisplayLineStyle = array.get(swingDisplayLevelStyles, swingDisplayIndex)
            int swingDisplayLineWidth = array.get(swingDisplayLevelWidths, swingDisplayIndex)
            line swingDisplayLine = na
            if array.size(swingLevelLines) <= swingDisplayIndex
                swingDisplayLine := line.new(
                     swingLineStartBar,
                     swingDisplayPrice,
                     bar_index + 1,
                     swingDisplayPrice,
                     xloc=xloc.bar_index,
                     extend=extend.right,
                     color=swingDisplayColor,
                     style=f_lineStyleFromCode(swingDisplayLineStyle),
                     width=swingDisplayLineWidth
                )
                array.push(swingLevelLines, swingDisplayLine)
            else
                swingDisplayLine := array.get(swingLevelLines, swingDisplayIndex)
            line.set_x1(swingDisplayLine, swingLineStartBar)
            line.set_y1(swingDisplayLine, swingDisplayPrice)
            line.set_x2(swingDisplayLine, bar_index + 1)
            line.set_y2(swingDisplayLine, swingDisplayPrice)
            line.set_extend(swingDisplayLine, extend.right)
            line.set_color(swingDisplayLine, swingDisplayColor)
            line.set_style(swingDisplayLine, f_lineStyleFromCode(swingDisplayLineStyle))
            line.set_width(swingDisplayLine, swingDisplayLineWidth)
            if showSwingLevelLabels
                label swingDisplayNameLabel = na
                if array.size(swingLevelLabels) <= swingDisplayIndex
                    swingDisplayNameLabel := label.new(
                         bar_index + 1,
                         swingDisplayPrice,
                         swingDisplayLabel,
                         xloc=xloc.bar_index,
                         style=label.style_label_left,
                         textcolor=swingDisplayColor,
                         color=color.new(color.black, 100),
                         size=size.tiny
                    )
                    array.push(swingLevelLabels, swingDisplayNameLabel)
                else
                    swingDisplayNameLabel := array.get(swingLevelLabels, swingDisplayIndex)
                label.set_x(swingDisplayNameLabel, bar_index + 1)
                label.set_y(swingDisplayNameLabel, swingDisplayPrice)
                label.set_text(swingDisplayNameLabel, swingDisplayLabel)
                label.set_textcolor(swingDisplayNameLabel, swingDisplayColor)
                label.set_color(swingDisplayNameLabel, color.new(color.black, 100))
                label.set_style(swingDisplayNameLabel, label.style_label_left)
                label.set_size(swingDisplayNameLabel, size.tiny)

float effectiveThesisLevel = na
string effectiveThesisName = "N/A"
string effectiveThesisSourceSymbol = "N/A"

if useAutoThesis and autoThesisConvertedValid
    effectiveThesisLevel := convertedAutoThesisLevel
    effectiveThesisName := selectedAutoThesisName
    effectiveThesisSourceSymbol := thesisSourceSymbol
else if useAutoThesis and autoThesisFallbackToManual and thesisLevel > 0
    effectiveThesisLevel := thesisLevel
    effectiveThesisName := "Manual"
    effectiveThesisSourceSymbol := "N/A"
else if not useAutoThesis and thesisLevel > 0
    effectiveThesisLevel := thesisLevel
    effectiveThesisName := "Manual"
    effectiveThesisSourceSymbol := "N/A"

var float autoOpeningRangeHigh = na
var float autoOpeningRangeLow = na
var bool openingRangeComplete = false
var bool openingRangeHasBroken = false
var string openingRangeBreakDirection = "None"

if newScalpRTHSession
    autoOpeningRangeHigh := na
    autoOpeningRangeLow := na
    openingRangeComplete := false
    openingRangeHasBroken := false
    openingRangeBreakDirection := "None"

if inOpeningRangeWindow
    autoOpeningRangeHigh := na(autoOpeningRangeHigh) ? high : math.max(autoOpeningRangeHigh, high)
    autoOpeningRangeLow := na(autoOpeningRangeLow) ? low : math.min(autoOpeningRangeLow, low)

if inScalpRTHSession and not inOpeningRangeWindow and not openingRangeComplete and not na(autoOpeningRangeHigh) and not na(autoOpeningRangeLow)
    openingRangeComplete := true

openingRangeHigh = useManualOpeningRangeFallback and manualOpeningRangeHigh > 0 ? manualOpeningRangeHigh : autoOpeningRangeHigh
openingRangeLow = useManualOpeningRangeFallback and manualOpeningRangeLow > 0 ? manualOpeningRangeLow : autoOpeningRangeLow
openingRangeReady = not na(openingRangeHigh) and not na(openingRangeLow)
openingRangeLevelsReady = openingRangeReady and (useManualOpeningRangeFallback or openingRangeComplete)
openingRangeDisplayHigh = openingRangeLevelsReady ? openingRangeHigh : na
openingRangeDisplayLow = openingRangeLevelsReady ? openingRangeLow : na

if barstate.isconfirmed and inScalpRTHSession and openingRangeLevelsReady and not inOpeningRangeWindow
    if not openingRangeHasBroken and close > openingRangeHigh
        openingRangeHasBroken := true
        openingRangeBreakDirection := "First Break Up"
    else if not openingRangeHasBroken and close < openingRangeLow
        openingRangeHasBroken := true
        openingRangeBreakDirection := "First Break Down"

first15FilterAllowsAlerts = not waitFirst15Minutes or (inScalpRTHSession and not inOpeningRangeWindow)

openingRangeAllowsAlerts = not requireOpeningRangeBreak or openingRangeHasBroken

openingRangeStatus = not openingRangeLevelsReady ? "WAITING" : openingRangeHasBroken ? "BROKEN - " + openingRangeBreakDirection : "WAITING FOR ANY BREAK"

// ===================== Untested 5m Swing Target Tracking =====================
int activeCurrentRTHDateKey = inScalpRTHSession ? currentRTHDateKey : na
int activePreviousRTHDateKey = inScalpRTHSession ? previousRTHDateKey : currentRTHDateKey

if newPremarketSession or newScalpRTHSession
    int pruneHighIndex = array.size(swingHighPrices) - 1
    while pruneHighIndex >= 0
        string highSwingSession = array.get(swingHighSessions, pruneHighIndex)
        int highSwingDateKey = array.get(swingHighDateKeys, pruneHighIndex)
        bool keepHighSwing = f_swingTargetSessionAllowed(highSwingSession, highSwingDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepHighSwing
            array.remove(swingHighPrices, pruneHighIndex)
            array.remove(swingHighPivotBars, pruneHighIndex)
            array.remove(swingHighDateKeys, pruneHighIndex)
            array.remove(swingHighSessions, pruneHighIndex)
            array.remove(swingHighActive, pruneHighIndex)
        pruneHighIndex -= 1

    int pruneLowIndex = array.size(swingLowPrices) - 1
    while pruneLowIndex >= 0
        string lowSwingSession = array.get(swingLowSessions, pruneLowIndex)
        int lowSwingDateKey = array.get(swingLowDateKeys, pruneLowIndex)
        bool keepLowSwing = f_swingTargetSessionAllowed(lowSwingSession, lowSwingDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepLowSwing
            array.remove(swingLowPrices, pruneLowIndex)
            array.remove(swingLowPivotBars, pruneLowIndex)
            array.remove(swingLowDateKeys, pruneLowIndex)
            array.remove(swingLowSessions, pruneLowIndex)
            array.remove(swingLowActive, pruneLowIndex)
        pruneLowIndex -= 1

    int pruneFboHighIndex = array.size(fboSwingHighPrices) - 1
    while pruneFboHighIndex >= 0
        string highFboSession = array.get(fboSwingHighSessions, pruneFboHighIndex)
        int highFboDateKey = array.get(fboSwingHighDateKeys, pruneFboHighIndex)
        bool keepHighFbo = f_swingTargetSessionAllowed(highFboSession, highFboDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepHighFbo
            array.remove(fboSwingHighPrices, pruneFboHighIndex)
            array.remove(fboSwingHighPivotBars, pruneFboHighIndex)
            array.remove(fboSwingHighDateKeys, pruneFboHighIndex)
            array.remove(fboSwingHighSessions, pruneFboHighIndex)
            array.remove(fboSwingHighCleared, pruneFboHighIndex)
        pruneFboHighIndex -= 1

    int pruneFboLowIndex = array.size(fboSwingLowPrices) - 1
    while pruneFboLowIndex >= 0
        string lowFboSession = array.get(fboSwingLowSessions, pruneFboLowIndex)
        int lowFboDateKey = array.get(fboSwingLowDateKeys, pruneFboLowIndex)
        bool keepLowFbo = f_swingTargetSessionAllowed(lowFboSession, lowFboDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepLowFbo
            array.remove(fboSwingLowPrices, pruneFboLowIndex)
            array.remove(fboSwingLowPivotBars, pruneFboLowIndex)
            array.remove(fboSwingLowDateKeys, pruneFboLowIndex)
            array.remove(fboSwingLowSessions, pruneFboLowIndex)
            array.remove(fboSwingLowCleared, pruneFboLowIndex)
        pruneFboLowIndex -= 1

if barstate.isconfirmed
    int testHighIndex = 0
    while testHighIndex < array.size(swingHighPrices)
        string highSwingSession = array.get(swingHighSessions, testHighIndex)
        int highSwingDateKey = array.get(swingHighDateKeys, testHighIndex)
        bool canInvalidateHighSwing = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, highSwingSession, highSwingDateKey, currentRTHDateKey)
        if canInvalidateHighSwing and array.get(swingHighActive, testHighIndex) and bar_index > array.get(swingHighPivotBars, testHighIndex) and high >= array.get(swingHighPrices, testHighIndex)
            array.set(swingHighActive, testHighIndex, false)
        testHighIndex += 1

    int testLowIndex = 0
    while testLowIndex < array.size(swingLowPrices)
        string lowSwingSession = array.get(swingLowSessions, testLowIndex)
        int lowSwingDateKey = array.get(swingLowDateKeys, testLowIndex)
        bool canInvalidateLowSwing = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, lowSwingSession, lowSwingDateKey, currentRTHDateKey)
        if canInvalidateLowSwing and array.get(swingLowActive, testLowIndex) and bar_index > array.get(swingLowPivotBars, testLowIndex) and low <= array.get(swingLowPrices, testLowIndex)
            array.set(swingLowActive, testLowIndex, false)
        testLowIndex += 1

    int clearFboHighIndex = 0
    while clearFboHighIndex < array.size(fboSwingHighPrices)
        string highFboSession = array.get(fboSwingHighSessions, clearFboHighIndex)
        int highFboDateKey = array.get(fboSwingHighDateKeys, clearFboHighIndex)
        bool canClearHighFbo = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, highFboSession, highFboDateKey, currentRTHDateKey)
        if canClearHighFbo and not array.get(fboSwingHighCleared, clearFboHighIndex) and bar_index > array.get(fboSwingHighPivotBars, clearFboHighIndex) and low > array.get(fboSwingHighPrices, clearFboHighIndex)
            array.set(fboSwingHighCleared, clearFboHighIndex, true)
        clearFboHighIndex += 1

    int clearFboLowIndex = 0
    while clearFboLowIndex < array.size(fboSwingLowPrices)
        string lowFboSession = array.get(fboSwingLowSessions, clearFboLowIndex)
        int lowFboDateKey = array.get(fboSwingLowDateKeys, clearFboLowIndex)
        bool canClearLowFbo = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, lowFboSession, lowFboDateKey, currentRTHDateKey)
        if canClearLowFbo and not array.get(fboSwingLowCleared, clearFboLowIndex) and bar_index > array.get(fboSwingLowPivotBars, clearFboLowIndex) and high < array.get(fboSwingLowPrices, clearFboLowIndex)
            array.set(fboSwingLowCleared, clearFboLowIndex, true)
        clearFboLowIndex += 1

if barstate.isconfirmed and bar_index >= 2
    bool confirmedMicroSwingLow = low[1] < low[2] and low[1] <= low
    bool confirmedMicroSwingHigh = high[1] > high[2] and high[1] >= high
    if confirmedMicroSwingLow
        mostRecentMicroSwingLow := low[1]
    if confirmedMicroSwingHigh
        mostRecentMicroSwingHigh := high[1]

if barstate.isconfirmed
    if allowRthSwingsBrokenPremarket
        if newPremarketSession
            array.clear(pmSwingHistHighs)
            array.clear(pmSwingHistLows)
            array.clear(pmSwingHistBarIndexes)
            array.clear(pmSwingHistDateKeys)

        if inPremarketSession
            array.push(pmSwingHistHighs, high)
            array.push(pmSwingHistLows, low)
            array.push(pmSwingHistBarIndexes, bar_index)
            array.push(pmSwingHistDateKeys, nySessionDateKey)
            while array.size(pmSwingHistHighs) > 200
                array.shift(pmSwingHistHighs)
                array.shift(pmSwingHistLows)
                array.shift(pmSwingHistBarIndexes)
                array.shift(pmSwingHistDateKeys)

            int pmHistorySize = array.size(pmSwingHistHighs)
            if pmHistorySize >= 5
                int pmPivotIndex = pmHistorySize - 3
                float pmPivotHigh = array.get(pmSwingHistHighs, pmPivotIndex)
                float pmPivotLow = array.get(pmSwingHistLows, pmPivotIndex)
                int pmPivotBar = array.get(pmSwingHistBarIndexes, pmPivotIndex)
                int pmPivotDateKey = array.get(pmSwingHistDateKeys, pmPivotIndex)
                bool confirmedPmSwingHigh = pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex - 1) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex - 2) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex + 1) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex + 2)
                bool confirmedPmSwingLow = pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex - 1) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex - 2) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex + 1) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex + 2)

                if confirmedPmSwingHigh
                    if not f_hasPivotBar(swingHighPivotBars, pmPivotBar)
                        array.push(swingHighPrices, pmPivotHigh)
                        array.push(swingHighPivotBars, pmPivotBar)
                        array.push(swingHighDateKeys, pmPivotDateKey)
                        array.push(swingHighSessions, "PM")
                        array.push(swingHighActive, true)
                    if not f_hasPivotBar(fboSwingHighPivotBars, pmPivotBar)
                        array.push(fboSwingHighPrices, pmPivotHigh)
                        array.push(fboSwingHighPivotBars, pmPivotBar)
                        array.push(fboSwingHighDateKeys, pmPivotDateKey)
                        array.push(fboSwingHighSessions, "PM")
                        array.push(fboSwingHighCleared, false)

                if confirmedPmSwingLow
                    if not f_hasPivotBar(swingLowPivotBars, pmPivotBar)
                        array.push(swingLowPrices, pmPivotLow)
                        array.push(swingLowPivotBars, pmPivotBar)
                        array.push(swingLowDateKeys, pmPivotDateKey)
                        array.push(swingLowSessions, "PM")
                        array.push(swingLowActive, true)
                    if not f_hasPivotBar(fboSwingLowPivotBars, pmPivotBar)
                        array.push(fboSwingLowPrices, pmPivotLow)
                        array.push(fboSwingLowPivotBars, pmPivotBar)
                        array.push(fboSwingLowDateKeys, pmPivotDateKey)
                        array.push(fboSwingLowSessions, "PM")
                        array.push(fboSwingLowCleared, false)

        if inScalpRTHSession
            // Keep prior RTH bars so the first/second current-session RTH bars can confirm with RTH-only left bars.
            array.push(rthSwingHistHighs, high)
            array.push(rthSwingHistLows, low)
            array.push(rthSwingHistBarIndexes, bar_index)
            array.push(rthSwingHistDateKeys, nySessionDateKey)
            while array.size(rthSwingHistHighs) > 200
                array.shift(rthSwingHistHighs)
                array.shift(rthSwingHistLows)
                array.shift(rthSwingHistBarIndexes)
                array.shift(rthSwingHistDateKeys)

            int rthHistorySize = array.size(rthSwingHistHighs)
            if rthHistorySize >= 5
                int rthPivotIndex = rthHistorySize - 3
                float rthPivotHigh = array.get(rthSwingHistHighs, rthPivotIndex)
                float rthPivotLow = array.get(rthSwingHistLows, rthPivotIndex)
                int rthPivotBar = array.get(rthSwingHistBarIndexes, rthPivotIndex)
                int rthPivotDateKey = array.get(rthSwingHistDateKeys, rthPivotIndex)
                bool confirmedRthSwingHigh = rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex - 1) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex - 2) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex + 1) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex + 2)
                bool confirmedRthSwingLow = rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex - 1) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex - 2) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex + 1) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex + 2)

                if confirmedRthSwingHigh
                    if not f_hasPivotBar(swingHighPivotBars, rthPivotBar)
                        array.push(swingHighPrices, rthPivotHigh)
                        array.push(swingHighPivotBars, rthPivotBar)
                        array.push(swingHighDateKeys, rthPivotDateKey)
                        array.push(swingHighSessions, "RTH")
                        array.push(swingHighActive, true)
                    if not f_hasPivotBar(fboSwingHighPivotBars, rthPivotBar)
                        array.push(fboSwingHighPrices, rthPivotHigh)
                        array.push(fboSwingHighPivotBars, rthPivotBar)
                        array.push(fboSwingHighDateKeys, rthPivotDateKey)
                        array.push(fboSwingHighSessions, "RTH")
                        array.push(fboSwingHighCleared, false)

                if confirmedRthSwingLow
                    if not f_hasPivotBar(swingLowPivotBars, rthPivotBar)
                        array.push(swingLowPrices, rthPivotLow)
                        array.push(swingLowPivotBars, rthPivotBar)
                        array.push(swingLowDateKeys, rthPivotDateKey)
                        array.push(swingLowSessions, "RTH")
                        array.push(swingLowActive, true)
                    if not f_hasPivotBar(fboSwingLowPivotBars, rthPivotBar)
                        array.push(fboSwingLowPrices, rthPivotLow)
                        array.push(fboSwingLowPivotBars, rthPivotBar)
                        array.push(fboSwingLowDateKeys, rthPivotDateKey)
                        array.push(fboSwingLowSessions, "RTH")
                        array.push(fboSwingLowCleared, false)

    else if bar_index >= 4
        bool confirmedSwingHigh = high[2] > high[1] and high[2] > high and high[2] > high[3] and high[2] > high[4]
        bool confirmedSwingLow = low[2] < low[1] and low[2] < low and low[2] < low[3] and low[2] < low[4]
        string pivotSession = inPremarketSession[2] ? "PM" : inScalpRTHSession[2] ? "RTH" : "N/A"
        int pivotDateKey = nySessionDateKey[2]
        bool pivotSessionAllowed = pivotSession == "PM" or pivotSession == "RTH"

        if pivotSessionAllowed and confirmedSwingHigh
            array.push(swingHighPrices, high[2])
            array.push(swingHighPivotBars, bar_index - 2)
            array.push(swingHighDateKeys, pivotDateKey)
            array.push(swingHighSessions, pivotSession)
            array.push(swingHighActive, true)
            array.push(fboSwingHighPrices, high[2])
            array.push(fboSwingHighPivotBars, bar_index - 2)
            array.push(fboSwingHighDateKeys, pivotDateKey)
            array.push(fboSwingHighSessions, pivotSession)
            array.push(fboSwingHighCleared, false)

        if pivotSessionAllowed and confirmedSwingLow
            array.push(swingLowPrices, low[2])
            array.push(swingLowPivotBars, bar_index - 2)
            array.push(swingLowDateKeys, pivotDateKey)
            array.push(swingLowSessions, pivotSession)
            array.push(swingLowActive, true)
            array.push(fboSwingLowPrices, low[2])
            array.push(fboSwingLowPivotBars, bar_index - 2)
            array.push(fboSwingLowDateKeys, pivotDateKey)
            array.push(fboSwingLowSessions, pivotSession)
            array.push(fboSwingLowCleared, false)

while array.size(swingHighPrices) > maxTrackedSwingTargets
    array.shift(swingHighPrices)
    array.shift(swingHighPivotBars)
    array.shift(swingHighDateKeys)
    array.shift(swingHighSessions)
    array.shift(swingHighActive)

while array.size(swingLowPrices) > maxTrackedSwingTargets
    array.shift(swingLowPrices)
    array.shift(swingLowPivotBars)
    array.shift(swingLowDateKeys)
    array.shift(swingLowSessions)
    array.shift(swingLowActive)

while array.size(fboSwingHighPrices) > maxTrackedSwingTargets
    array.shift(fboSwingHighPrices)
    array.shift(fboSwingHighPivotBars)
    array.shift(fboSwingHighDateKeys)
    array.shift(fboSwingHighSessions)
    array.shift(fboSwingHighCleared)

while array.size(fboSwingLowPrices) > maxTrackedSwingTargets
    array.shift(fboSwingLowPrices)
    array.shift(fboSwingLowPivotBars)
    array.shift(fboSwingLowDateKeys)
    array.shift(fboSwingLowSessions)
    array.shift(fboSwingLowCleared)

// ===================== Thesis State Logic =====================
var int thesisState = f_initialThesisState(initialThesis)
var bool pendingBullClearance = false
var bool pendingBearClearance = false
var int pendingBullExpirationBar = na
var int pendingBearExpirationBar = na
var bool thesisInitializedForSession = false

if newScalpRTHSession
    thesisState := f_initialThesisState(initialThesis)
    thesisInitializedForSession := false
    pendingBullClearance := false
    pendingBearClearance := false
    pendingBullExpirationBar := na
    pendingBearExpirationBar := na

validThesisLevel = not na(effectiveThesisLevel) and effectiveThesisLevel > 0
thesisRangeValid = barRange > 0
thesisTolerance = scalpTickSize * 0.1

if inScalpRTHSession and validThesisLevel and not thesisInitializedForSession
    if close > effectiveThesisLevel
        thesisState := 1
    else if close < effectiveThesisLevel
        thesisState := -1
    else
        thesisState := f_initialThesisState(initialThesis)
    thesisInitializedForSession := true

bullLowerThirdBoundaryRaw = low + barRange * (1.0 / 3.0)
bullUpperThirdCloseBoundaryRaw = low + barRange * (2.0 / 3.0)
bearUpperThirdBoundaryRaw = high - barRange * (1.0 / 3.0)
bearLowerThirdCloseBoundaryRaw = low + barRange * (1.0 / 3.0)
bullLowerThirdBoundary = f_roundUpToScalpTick(bullLowerThirdBoundaryRaw)
bullUpperThirdCloseBoundary = f_roundUpToScalpTick(bullUpperThirdCloseBoundaryRaw)
bearUpperThirdBoundary = f_roundDownToScalpTick(bearUpperThirdBoundaryRaw)
bearLowerThirdCloseBoundary = f_roundUpToScalpTick(bearLowerThirdCloseBoundaryRaw)
barRangeTicks = math.max(f_tickCount(barRange), 1)
bodyTicks = f_tickCount(body)
closeAboveLowTicks = f_tickCount(close - low)

strongThesisBody = body + thesisTolerance >= barRange * 0.5 or bodyTicks * 2 >= barRangeTicks
strongBullCloseInUpperThird = close + thesisTolerance >= bullUpperThirdCloseBoundary or closeAboveLowTicks * 3 >= barRangeTicks * 2
strongBearCloseInLowerThird = close - thesisTolerance <= bearLowerThirdCloseBoundary or closeAboveLowTicks * 3 <= barRangeTicks

strongBullThesisBar = validThesisLevel and thesisRangeValid and close > open and strongThesisBody and strongBullCloseInUpperThird and close > effectiveThesisLevel
strongBearThesisBar = validThesisLevel and thesisRangeValid and close < open and strongThesisBody and strongBearCloseInLowerThird and close < effectiveThesisLevel

bullTwoThirdsBeyondLevel = validThesisLevel and thesisRangeValid and effectiveThesisLevel <= bullLowerThirdBoundary + thesisTolerance
bearTwoThirdsBeyondLevel = validThesisLevel and thesisRangeValid and effectiveThesisLevel >= bearUpperThirdBoundary - thesisTolerance

bullDirectClearance = strongBullThesisBar and (bullTwoThirdsBeyondLevel or low > effectiveThesisLevel)
bearDirectClearance = strongBearThesisBar and (bearTwoThirdsBeyondLevel or high < effectiveThesisLevel)
bullPendingFollowThrough = validThesisLevel and pendingBullClearance and not na(pendingBullExpirationBar) and bar_index <= pendingBullExpirationBar and low > effectiveThesisLevel
bearPendingFollowThrough = validThesisLevel and pendingBearClearance and not na(pendingBearExpirationBar) and bar_index <= pendingBearExpirationBar and high < effectiveThesisLevel

if barstate.isconfirmed
    if not inScalpRTHSession
        pendingBullClearance := false
        pendingBearClearance := false
        pendingBullExpirationBar := na
        pendingBearExpirationBar := na
    else
        if pendingBullClearance and not na(pendingBullExpirationBar) and bar_index > pendingBullExpirationBar
            pendingBullClearance := false
            pendingBullExpirationBar := na
        if pendingBearClearance and not na(pendingBearExpirationBar) and bar_index > pendingBearExpirationBar
            pendingBearClearance := false
            pendingBearExpirationBar := na

        bool bullThesisCleared = bullDirectClearance or bullPendingFollowThrough
        bool bearThesisCleared = bearDirectClearance or bearPendingFollowThrough

        if bullThesisCleared and not bearThesisCleared
            thesisState := 1
            pendingBullClearance := false
            pendingBearClearance := false
            pendingBullExpirationBar := na
            pendingBearExpirationBar := na
        else if bearThesisCleared and not bullThesisCleared
            thesisState := -1
            pendingBullClearance := false
            pendingBearClearance := false
            pendingBullExpirationBar := na
            pendingBearExpirationBar := na
        else
            if strongBullThesisBar and not bullDirectClearance
                pendingBullClearance := true
                pendingBearClearance := false
                pendingBullExpirationBar := bar_index + thesisFollowThroughBars
                pendingBearExpirationBar := na
            if strongBearThesisBar and not bearDirectClearance
                pendingBearClearance := true
                pendingBullClearance := false
                pendingBearExpirationBar := bar_index + thesisFollowThroughBars
                pendingBullExpirationBar := na
            if not validThesisLevel
                pendingBullClearance := false
                pendingBearClearance := false
                pendingBullExpirationBar := na
                pendingBearExpirationBar := na

// ===================== Pre-computed Conditions =====================
sufficientVolumeAndVolatility = sufficientVolume and sufficientVolatility

// ===================== Pressure Signal Conditions =====================
pressureRange = f_safeRange(high, low)
closeUpperThird = f_closeInUpperThird(close, low, pressureRange)
closeLowerThird = f_closeInLowerThird(close, low, pressureRange)

isBodyThreshold = f_meetsPct(body, pressureRange, pressureBodyWickThreshold)
isMostlyBody = f_meetsPct(body, pressureRange, 0.5)
isLowerWickThreshold = f_meetsPct(lowerWick, pressureRange, pressureBodyWickThreshold)
isUpperWickThreshold = f_meetsPct(upperWick, pressureRange, pressureBodyWickThreshold)

bullBarQuality = closeUpperThird and (isBodyThreshold or isLowerWickThreshold)
bearBarQuality = closeLowerThird and (isBodyThreshold or isUpperWickThreshold)

[buyPressure, sellPressure] = f_dobruskyPressure()

pressureReady = not na(buyPressure) and not na(sellPressure) and not na(buyPressure[1]) and not na(sellPressure[1])
priorDominantlyBear = pressureReady and (sellPressure[1] > buyPressure[1])
priorDominantlyBull = pressureReady and (buyPressure[1] >= sellPressure[1])

bullPressureA = pressureReady and ((priorDominantlyBear and buyPressure > sellPressure[1]) or (priorDominantlyBull and buyPressure > buyPressure[1]))
bearPressureA = pressureReady and ((priorDominantlyBull and sellPressure > buyPressure[1]) or (priorDominantlyBear and sellPressure > sellPressure[1]))

[midDown, legDownLow, legDownHigh] = f_midPriorLegDown(maxLookback)
[midUp, legUpLow, legUpHigh] = f_midPriorLegUp(maxLookback)

bullFallbackB = not na(midDown) and close > midDown
bearFallbackB = not na(midUp) and close < midUp

bullPressurePass = (bullPressureA and not na(volume)) or (bullFallbackB and isBodyThreshold)
bearPressurePass = (bearPressureA and not na(volume)) or (bearFallbackB and isBodyThreshold)
isHighVolume = not na(volume) and volume > volume[1]

bullSignalBase = sufficientVolumeAndVolatility and bullBarQuality
bearSignalBase = sufficientVolumeAndVolatility and bearBarQuality

bullSignalHighVol = bullSignalBase and isHighVolume
bearSignalHighVol = bearSignalBase and isHighVolume
bullSignalNormalVol = bullSignalBase and bullPressurePass and not isHighVolume and not onlyHighVolumeSignals
bearSignalNormalVol = bearSignalBase and bearPressurePass and not isHighVolume and not onlyHighVolumeSignals

// ===================== Plotting =====================
plotBullSignalHighVol = showBullSignals and bullSignalHighVol
plotBullSignalNormalVol = showBullSignals and bullSignalNormalVol
plotBearSignalHighVol = showBearSignals and bearSignalHighVol
plotBearSignalNormalVol = showBearSignals and bearSignalNormalVol

hasBullSignal = plotBullSignalHighVol or plotBullSignalNormalVol
hasBearSignal = plotBearSignalHighVol or plotBearSignalNormalVol
onlyBullSignal = hasBullSignal
onlyBearSignal = hasBearSignal

// Confirmed signals close beyond the prior bar extreme; unconfirmed keep signal logic but use alternate markers.
bullSignalConfirmed = close > high[1]
bearSignalConfirmed = close < low[1]

// Signal-tier visibility filters
plotBullHV_diamond  = plotBullSignalHighVol and showStrongIgnitions
plotBullHV_tri      = plotBullSignalHighVol and showIgnitionSignals
plotBullHV_circle   = plotBullSignalHighVol and showSetupSignals
plotBearHV_diamond  = plotBearSignalHighVol and showStrongIgnitions
plotBearHV_tri      = plotBearSignalHighVol and showIgnitionSignals
plotBearHV_circle   = plotBearSignalHighVol and showSetupSignals
plotBullNV_diamond  = plotBullSignalNormalVol and showStrongIgnitions
plotBullNV_tri      = plotBullSignalNormalVol and showIgnitionSignals
plotBullNV_circle   = plotBullSignalNormalVol and showSetupSignals
plotBearNV_diamond  = plotBearSignalNormalVol and showStrongIgnitions
plotBearNV_tri      = plotBearSignalNormalVol and showIgnitionSignals
plotBearNV_circle   = plotBearSignalNormalVol and showSetupSignals

// ===================== Alert Signal Tier Logic =====================
bullScalpSignalAllowed = bullSignalHighVol
bearScalpSignalAllowed = bearSignalHighVol
bullSwingSignalAllowed = bullSignalHighVol or bullSignalNormalVol
bearSwingSignalAllowed = bearSignalHighVol or bearSignalNormalVol

bullScalpSetupTier = bullScalpSignalAllowed and not bullSignalConfirmed
bullScalpIgnitionTier = bullScalpSignalAllowed and bullSignalConfirmed and not isMostlyBody
bullScalpStrongIgnitionTier = bullScalpSignalAllowed and bullSignalConfirmed and isMostlyBody
bearScalpSetupTier = bearScalpSignalAllowed and not bearSignalConfirmed
bearScalpIgnitionTier = bearScalpSignalAllowed and bearSignalConfirmed and not isMostlyBody
bearScalpStrongIgnitionTier = bearScalpSignalAllowed and bearSignalConfirmed and isMostlyBody

bullSwingSetupTier = bullSwingSignalAllowed and not bullSignalConfirmed
bullSwingIgnitionTier = bullSwingSignalAllowed and bullSignalConfirmed and not isMostlyBody
bullSwingStrongIgnitionTier = bullSwingSignalAllowed and bullSignalConfirmed and isMostlyBody
bearSwingSetupTier = bearSwingSignalAllowed and not bearSignalConfirmed
bearSwingIgnitionTier = bearSwingSignalAllowed and bearSignalConfirmed and not isMostlyBody
bearSwingStrongIgnitionTier = bearSwingSignalAllowed and bearSignalConfirmed and isMostlyBody

bullScalpTierAllowed = (alertSetupSignals and bullScalpSetupTier) or (alertIgnitionSignals and bullScalpIgnitionTier) or (alertStrongIgnitions and bullScalpStrongIgnitionTier)
bearScalpTierAllowed = (alertSetupSignals and bearScalpSetupTier) or (alertIgnitionSignals and bearScalpIgnitionTier) or (alertStrongIgnitions and bearScalpStrongIgnitionTier)
bullSwingTierAllowedByInputs = (alertSetupSignals and bullSwingSetupTier) or (alertIgnitionSignals and bullSwingIgnitionTier) or (alertStrongIgnitions and bullSwingStrongIgnitionTier)
bearSwingTierAllowedByInputs = (alertSetupSignals and bearSwingSetupTier) or (alertIgnitionSignals and bearSwingIgnitionTier) or (alertStrongIgnitions and bearSwingStrongIgnitionTier)

bullScalpVolumeTextShort = bullScalpSignalAllowed ? "HV" : "LV"
bearScalpVolumeTextShort = bearScalpSignalAllowed ? "HV" : "LV"
bullSwingVolumeTextShort = bullSignalHighVol ? "HV" : bullSignalNormalVol ? "LV" : "N/A"
bearSwingVolumeTextShort = bearSignalHighVol ? "HV" : bearSignalNormalVol ? "LV" : "N/A"
bullScalpSignalTierShort = bullScalpStrongIgnitionTier or bullScalpIgnitionTier ? "IGN" : bullScalpSetupTier ? "FBO" : "N/A"
bearScalpSignalTierShort = bearScalpStrongIgnitionTier or bearScalpIgnitionTier ? "IGN" : bearScalpSetupTier ? "FBO" : "N/A"
bullCompactSignalText = bullScalpVolumeTextShort + " " + bullScalpSignalTierShort
bearCompactSignalText = bearScalpVolumeTextShort + " " + bearScalpSignalTierShort

selectedImpulseSymbol = tickerInput == "MES" ? esImpulseSymbol : nqImpulseSymbol
selectedImpulseClose = request.security(selectedImpulseSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off, calc_bars_count=500)
selectedImpulseAtr = request.security(selectedImpulseSymbol, timeframe.period, ta.atr(impulseAtrLength), lookahead=barmerge.lookahead_off, calc_bars_count=500)
selectedImpulseScore = selectedImpulseAtr > 0 ? (selectedImpulseClose - selectedImpulseClose[impulseLookback]) / selectedImpulseAtr : na
impulseReady = not na(selectedImpulseScore)
// The impulse filter is scalp-only and only gates FBO/setup-tier scalp alerts.
longFboImpulseOk = not useFboImpulseFilter or not bullScalpSetupTier or not impulseReady or selectedImpulseScore >= -fboImpulseTolerance
shortFboImpulseOk = not useFboImpulseFilter or not bearScalpSetupTier or not impulseReady or selectedImpulseScore <= fboImpulseTolerance

// ===================== Scalp Level Priority Logic =====================
scalpSignalHigh = high
scalpSignalLow = low
scalpSignalClose = close
scalpEntry50Raw = (scalpSignalHigh + scalpSignalLow) / 2.0
longEntry50 = f_roundDownToScalpTick(scalpEntry50Raw)
shortEntry50 = f_roundUpToScalpTick(scalpEntry50Raw)
float noSelectedLevelPrice = na
string noSelectedLevelName = "N/A"

// ===================== Swing Setup Qualification Logic =====================
float longSwingTouchedLevelPrice = na
string longSwingTouchedLevelName = "N/A"
int longSwingTouchedLevelPriority = 999

float shortSwingTouchedLevelPrice = na
string shortSwingTouchedLevelName = "N/A"
int shortSwingTouchedLevelPriority = 999
bool longSwingBrokenCandidateFound = false
bool shortSwingBrokenCandidateFound = false

if array.size(swingLevelPrices) > 0
    for swingEntryLevelIndex = 0 to array.size(swingLevelPrices) - 1
        float swingEntryLevelPrice = array.get(swingLevelPrices, swingEntryLevelIndex)
        string swingEntryLevelName = array.get(swingLevelNames, swingEntryLevelIndex)
        int swingEntryLevelPriority = array.get(swingLevelPriority, swingEntryLevelIndex)
        bool swingEntryLevelAllowed = array.get(swingLevelAllowedForEntry, swingEntryLevelIndex)
        bool swingEntryLevelTouchedCurrent = f_levelTouched(swingEntryLevelAllowed, swingEntryLevelPrice, scalpSignalLow, scalpSignalHigh)
        bool swingEntryLevelTouchedPrior = not na(low[1]) and not na(high[1]) and f_levelTouched(swingEntryLevelAllowed, swingEntryLevelPrice, low[1], high[1])
        bool priorBarBear = close[1] < open[1]
        bool priorBarBull = close[1] > open[1]
        bool longSwingEntryLevelTouchedForSetup = swingEntryLevelTouchedCurrent or (swingEntryLevelTouchedPrior and priorBarBear)
        bool shortSwingEntryLevelTouchedForSetup = swingEntryLevelTouchedCurrent or (swingEntryLevelTouchedPrior and priorBarBull)
        bool longSwingEntryLevelBroken = longSwingEntryLevelTouchedForSetup and scalpSignalClose > swingEntryLevelPrice
        bool shortSwingEntryLevelBroken = shortSwingEntryLevelTouchedForSetup and scalpSignalClose < swingEntryLevelPrice
        bool betterLongSwingBrokenLevel = not longSwingBrokenCandidateFound or swingEntryLevelPriority < longSwingTouchedLevelPriority or (swingEntryLevelPriority == longSwingTouchedLevelPriority and (na(longSwingTouchedLevelPrice) or swingEntryLevelPrice > longSwingTouchedLevelPrice))
        bool betterShortSwingBrokenLevel = not shortSwingBrokenCandidateFound or swingEntryLevelPriority < shortSwingTouchedLevelPriority or (swingEntryLevelPriority == shortSwingTouchedLevelPriority and (na(shortSwingTouchedLevelPrice) or swingEntryLevelPrice < shortSwingTouchedLevelPrice))
        if longSwingEntryLevelBroken and betterLongSwingBrokenLevel
            longSwingTouchedLevelPrice := swingEntryLevelPrice
            longSwingTouchedLevelName := swingEntryLevelName
            longSwingTouchedLevelPriority := swingEntryLevelPriority
            longSwingBrokenCandidateFound := true
        if shortSwingEntryLevelBroken and betterShortSwingBrokenLevel
            shortSwingTouchedLevelPrice := swingEntryLevelPrice
            shortSwingTouchedLevelName := swingEntryLevelName
            shortSwingTouchedLevelPriority := swingEntryLevelPriority
            shortSwingBrokenCandidateFound := true

longSwingLevelBroken = longSwingBrokenCandidateFound
shortSwingLevelBroken = shortSwingBrokenCandidateFound

bool longSwingFboQualified = false
float longSwingFboPrice = na
if bullSwingSetupTier and array.size(fboSwingLowPrices) > 0
    for fboSwingLowIndex = 0 to array.size(fboSwingLowPrices) - 1
        float fboSwingLowPrice = array.get(fboSwingLowPrices, fboSwingLowIndex)
        bool fboSwingLowPrior = bar_index > array.get(fboSwingLowPivotBars, fboSwingLowIndex)
        string fboSwingLowSession = array.get(fboSwingLowSessions, fboSwingLowIndex)
        int fboSwingLowDateKey = array.get(fboSwingLowDateKeys, fboSwingLowIndex)
        bool fboSwingLowAllowed = f_swingTargetSessionAllowed(fboSwingLowSession, fboSwingLowDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        bool fboSwingLowQualified = fboSwingLowAllowed and not array.get(fboSwingLowCleared, fboSwingLowIndex) and fboSwingLowPrior and scalpSignalLow <= fboSwingLowPrice and scalpSignalClose > fboSwingLowPrice
        if fboSwingLowQualified and (na(longSwingFboPrice) or fboSwingLowPrice < longSwingFboPrice)
            longSwingFboQualified := true
            longSwingFboPrice := fboSwingLowPrice

bool shortSwingFboQualified = false
float shortSwingFboPrice = na
if bearSwingSetupTier and array.size(fboSwingHighPrices) > 0
    for fboSwingHighIndex = 0 to array.size(fboSwingHighPrices) - 1
        float fboSwingHighPrice = array.get(fboSwingHighPrices, fboSwingHighIndex)
        bool fboSwingHighPrior = bar_index > array.get(fboSwingHighPivotBars, fboSwingHighIndex)
        string fboSwingHighSession = array.get(fboSwingHighSessions, fboSwingHighIndex)
        int fboSwingHighDateKey = array.get(fboSwingHighDateKeys, fboSwingHighIndex)
        bool fboSwingHighAllowed = f_swingTargetSessionAllowed(fboSwingHighSession, fboSwingHighDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        bool fboSwingHighQualified = fboSwingHighAllowed and not array.get(fboSwingHighCleared, fboSwingHighIndex) and fboSwingHighPrior and scalpSignalHigh >= fboSwingHighPrice and scalpSignalClose < fboSwingHighPrice
        if fboSwingHighQualified and (na(shortSwingFboPrice) or fboSwingHighPrice > shortSwingFboPrice)
            shortSwingFboQualified := true
            shortSwingFboPrice := fboSwingHighPrice

longSwingFboSetupQualified = bullSwingSetupTier and alertSetupSignals and longSwingFboQualified and longSwingLevelBroken
longSwingIgnitionSetupQualified = longSwingLevelBroken and bullSwingIgnitionTier and alertIgnitionSignals
longSwingStrongIgnitionSetupQualified = longSwingLevelBroken and bullSwingStrongIgnitionTier and alertStrongIgnitions
longSwingSetupQualified = longSwingFboSetupQualified or longSwingIgnitionSetupQualified or longSwingStrongIgnitionSetupQualified

shortSwingFboSetupQualified = bearSwingSetupTier and alertSetupSignals and shortSwingFboQualified and shortSwingLevelBroken
shortSwingIgnitionSetupQualified = shortSwingLevelBroken and bearSwingIgnitionTier and alertIgnitionSignals
shortSwingStrongIgnitionSetupQualified = shortSwingLevelBroken and bearSwingStrongIgnitionTier and alertStrongIgnitions
shortSwingSetupQualified = shortSwingFboSetupQualified or shortSwingIgnitionSetupQualified or shortSwingStrongIgnitionSetupQualified

longSwingSetupTextShort = longSwingStrongIgnitionSetupQualified ? "S-IGN" : longSwingIgnitionSetupQualified ? "IGN" : longSwingFboSetupQualified ? "FBO" : "N/A"
shortSwingSetupTextShort = shortSwingStrongIgnitionSetupQualified ? "S-IGN" : shortSwingIgnitionSetupQualified ? "IGN" : shortSwingFboSetupQualified ? "FBO" : "N/A"
longSwingSetupTextFull = longSwingStrongIgnitionSetupQualified ? "Strong Ignition" : longSwingIgnitionSetupQualified ? "Ignition" : longSwingFboSetupQualified ? "Failed Breakout" : "N/A"
shortSwingSetupTextFull = shortSwingStrongIgnitionSetupQualified ? "Strong Ignition" : shortSwingIgnitionSetupQualified ? "Ignition" : shortSwingFboSetupQualified ? "Failed Breakout" : "N/A"

// ===================== Swing Target Selection Logic =====================
float signalRange = high - low
float longSwingNearestLevelTargetPrice = na
string longSwingNearestLevelTargetName = "N/A"
float shortSwingNearestLevelTargetPrice = na
string shortSwingNearestLevelTargetName = "N/A"

if array.size(swingLevelPrices) > 0
    for swingTargetLevelIndex = 0 to array.size(swingLevelPrices) - 1
        float swingTargetLevelPrice = array.get(swingLevelPrices, swingTargetLevelIndex)
        string swingTargetLevelName = array.get(swingLevelNames, swingTargetLevelIndex)
        bool swingTargetLevelAllowed = array.get(swingLevelAllowedForTarget, swingTargetLevelIndex)
        if swingTargetLevelAllowed and f_validSourcePrice(swingTargetLevelPrice)
            if swingTargetLevelPrice > high and (na(longSwingNearestLevelTargetPrice) or swingTargetLevelPrice < longSwingNearestLevelTargetPrice)
                longSwingNearestLevelTargetPrice := swingTargetLevelPrice
                longSwingNearestLevelTargetName := swingTargetLevelName
            if swingTargetLevelPrice < low and (na(shortSwingNearestLevelTargetPrice) or swingTargetLevelPrice > shortSwingNearestLevelTargetPrice)
                shortSwingNearestLevelTargetPrice := swingTargetLevelPrice
                shortSwingNearestLevelTargetName := swingTargetLevelName

longSwingMeasuredMoveTarget = f_roundToScalpTick(high + signalRange)
shortSwingMeasuredMoveTarget = f_roundToScalpTick(low - signalRange)

longSwingMeasuredMoveDistanceFromLevelAtr = not na(longSwingNearestLevelTargetPrice) and f_validSourcePrice(swingAtr5) ? math.abs(longSwingNearestLevelTargetPrice - longSwingMeasuredMoveTarget) / swingAtr5 : na
shortSwingMeasuredMoveDistanceFromLevelAtr = not na(shortSwingNearestLevelTargetPrice) and f_validSourcePrice(swingAtr5) ? math.abs(shortSwingMeasuredMoveTarget - shortSwingNearestLevelTargetPrice) / swingAtr5 : na

longSwingUseMeasuredMoveOverride = not na(longSwingNearestLevelTargetPrice) and longSwingMeasuredMoveTarget < longSwingNearestLevelTargetPrice and f_validSourcePrice(swingAtr5) and longSwingNearestLevelTargetPrice - longSwingMeasuredMoveTarget >= swingMeasuredMoveAtrDistance * swingAtr5
shortSwingUseMeasuredMoveOverride = not na(shortSwingNearestLevelTargetPrice) and shortSwingMeasuredMoveTarget > shortSwingNearestLevelTargetPrice and f_validSourcePrice(swingAtr5) and shortSwingMeasuredMoveTarget - shortSwingNearestLevelTargetPrice >= swingMeasuredMoveAtrDistance * swingAtr5

longSwingTargetFromMeasuredMove = na(longSwingNearestLevelTargetPrice) or longSwingUseMeasuredMoveOverride
shortSwingTargetFromMeasuredMove = na(shortSwingNearestLevelTargetPrice) or shortSwingUseMeasuredMoveOverride

longSwingTargetPrice = longSwingTargetFromMeasuredMove ? longSwingMeasuredMoveTarget : longSwingNearestLevelTargetPrice
longSwingTargetType = longSwingTargetFromMeasuredMove ? "Measured Move" : longSwingNearestLevelTargetName

shortSwingTargetPrice = shortSwingTargetFromMeasuredMove ? shortSwingMeasuredMoveTarget : shortSwingNearestLevelTargetPrice
shortSwingTargetType = shortSwingTargetFromMeasuredMove ? "Measured Move" : shortSwingNearestLevelTargetName

// ===================== Swing Entry / Stop / Risk Logic =====================
longSwingMicroStopValid = not na(mostRecentMicroSwingLow) and mostRecentMicroSwingLow <= low
shortSwingMicroStopValid = not na(mostRecentMicroSwingHigh) and mostRecentMicroSwingHigh >= high
bool longSwingMicroStopUsed = longSwingMicroStopValid
bool shortSwingMicroStopUsed = shortSwingMicroStopValid
longSwingStopPrice = (longSwingMicroStopUsed ? mostRecentMicroSwingLow : low) - scalpTickSize
shortSwingStopPrice = (shortSwingMicroStopUsed ? mostRecentMicroSwingHigh : high) + scalpTickSize
longSwingStopSource = longSwingMicroStopUsed ? "Micro Swing" : "Signal Fallback"
shortSwingStopSource = shortSwingMicroStopUsed ? "Micro Swing" : "Signal Fallback"

longSwingStopEntry = high + scalpTickSize
shortSwingStopEntry = low - scalpTickSize
longSwingEntry50 = f_roundDownToScalpTick((high + low) / 2.0)
shortSwingEntry50 = f_roundUpToScalpTick((high + low) / 2.0)
longSwingEntry618 = f_roundDownToScalpTick(high - signalRange * 0.618)
shortSwingEntry618 = f_roundUpToScalpTick(low + signalRange * 0.618)

longSwingLevelRetracementFromHigh = signalRange > 0 and longSwingLevelBroken ? (high - longSwingTouchedLevelPrice) / signalRange : na
shortSwingLevelRetracementFromLow = signalRange > 0 and shortSwingLevelBroken ? (shortSwingTouchedLevelPrice - low) / signalRange : na

longSwingLevelEntry50Applies = longSwingLevelBroken and longSwingTouchedLevelPrice < close and longSwingTouchedLevelPrice > longSwingEntry50
longSwingLevelEntry618Applies = longSwingLevelBroken and longSwingTouchedLevelPrice < close and longSwingTouchedLevelPrice > longSwingEntry618
shortSwingLevelEntry50Applies = shortSwingLevelBroken and shortSwingTouchedLevelPrice > close and shortSwingTouchedLevelPrice < shortSwingEntry50
shortSwingLevelEntry618Applies = shortSwingLevelBroken and shortSwingTouchedLevelPrice > close and shortSwingTouchedLevelPrice < shortSwingEntry618

longSwingEntry50Allowed = not longSwingLevelEntry50Applies or (not na(longSwingLevelRetracementFromHigh) and longSwingLevelRetracementFromHigh >= minLevelEntryRetracement)
longSwingEntry618Allowed = not longSwingLevelEntry618Applies or (not na(longSwingLevelRetracementFromHigh) and longSwingLevelRetracementFromHigh >= minLevelEntryRetracement)
shortSwingEntry50Allowed = not shortSwingLevelEntry50Applies or (not na(shortSwingLevelRetracementFromLow) and shortSwingLevelRetracementFromLow >= minLevelEntryRetracement)
shortSwingEntry618Allowed = not shortSwingLevelEntry618Applies or (not na(shortSwingLevelRetracementFromLow) and shortSwingLevelRetracementFromLow >= minLevelEntryRetracement)

longSwingEntry50CandidatePrice = longSwingLevelEntry50Applies ? longSwingTouchedLevelPrice : longSwingEntry50
longSwingEntry50CandidateType = longSwingLevelEntry50Applies ? longSwingTouchedLevelName : "50%"
longSwingEntry618CandidatePrice = longSwingLevelEntry618Applies ? longSwingTouchedLevelPrice : longSwingEntry618
longSwingEntry618CandidateType = longSwingLevelEntry618Applies ? longSwingTouchedLevelName : "61.8%"
shortSwingEntry50CandidatePrice = shortSwingLevelEntry50Applies ? shortSwingTouchedLevelPrice : shortSwingEntry50
shortSwingEntry50CandidateType = shortSwingLevelEntry50Applies ? shortSwingTouchedLevelName : "50%"
shortSwingEntry618CandidatePrice = shortSwingLevelEntry618Applies ? shortSwingTouchedLevelPrice : shortSwingEntry618
shortSwingEntry618CandidateType = shortSwingLevelEntry618Applies ? shortSwingTouchedLevelName : "61.8%"

longSwingStopEntryRR = f_swingRRLong(longSwingStopEntry, longSwingStopPrice, longSwingTargetPrice)
longSwingEntry50RR = longSwingEntry50Allowed ? f_swingRRLong(longSwingEntry50CandidatePrice, longSwingStopPrice, longSwingTargetPrice) : na
longSwingEntry618RR = longSwingEntry618Allowed ? f_swingRRLong(longSwingEntry618CandidatePrice, longSwingStopPrice, longSwingTargetPrice) : na
shortSwingStopEntryRR = f_swingRRShort(shortSwingStopEntry, shortSwingStopPrice, shortSwingTargetPrice)
shortSwingEntry50RR = shortSwingEntry50Allowed ? f_swingRRShort(shortSwingEntry50CandidatePrice, shortSwingStopPrice, shortSwingTargetPrice) : na
shortSwingEntry618RR = shortSwingEntry618Allowed ? f_swingRRShort(shortSwingEntry618CandidatePrice, shortSwingStopPrice, shortSwingTargetPrice) : na
longSwingStopEntryPassesMinRR = not na(longSwingStopEntryRR) and longSwingStopEntryRR >= swingMinRR
longSwingEntry50PassesMinRR = not na(longSwingEntry50RR) and longSwingEntry50RR >= swingMinRR
longSwingEntry618PassesMinRR = not na(longSwingEntry618RR) and longSwingEntry618RR >= swingMinRR
shortSwingStopEntryPassesMinRR = not na(shortSwingStopEntryRR) and shortSwingStopEntryRR >= swingMinRR
shortSwingEntry50PassesMinRR = not na(shortSwingEntry50RR) and shortSwingEntry50RR >= swingMinRR
shortSwingEntry618PassesMinRR = not na(shortSwingEntry618RR) and shortSwingEntry618RR >= swingMinRR

float longSwingEntryPrice = na
string longSwingEntryType = "N/A"
float longSwingRR = na
bool longSwingTargetExists = f_validSourcePrice(longSwingTargetPrice)
bool longSwingStopValid = f_validSourcePrice(longSwingStopPrice) and longSwingStopPrice < longSwingStopEntry

if longSwingSetupQualified and longSwingTargetExists and longSwingStopValid
    if swingUseStopOrdersFirst
        if longSwingStopEntryPassesMinRR
            longSwingEntryPrice := longSwingStopEntry
            longSwingEntryType := "Stop"
            longSwingRR := longSwingStopEntryRR
        else if swingAllowRetracementEntries
            if longSwingEntry50PassesMinRR
                longSwingEntryPrice := longSwingEntry50CandidatePrice
                longSwingEntryType := longSwingEntry50CandidateType
                longSwingRR := longSwingEntry50RR
            else if longSwingEntry618PassesMinRR
                longSwingEntryPrice := longSwingEntry618CandidatePrice
                longSwingEntryType := longSwingEntry618CandidateType
                longSwingRR := longSwingEntry618RR
    else
        if longSwingEntry50PassesMinRR
            longSwingEntryPrice := longSwingEntry50CandidatePrice
            longSwingEntryType := longSwingEntry50CandidateType
            longSwingRR := longSwingEntry50RR
        else if longSwingEntry618PassesMinRR
            longSwingEntryPrice := longSwingEntry618CandidatePrice
            longSwingEntryType := longSwingEntry618CandidateType
            longSwingRR := longSwingEntry618RR

longSwingFinalRR = f_swingRRLong(longSwingEntryPrice, longSwingStopPrice, longSwingTargetPrice)
if not na(longSwingFinalRR)
    longSwingRR := longSwingFinalRR

longSwingDisplayedRrConsistent = na(longSwingEntryPrice) or (not na(longSwingRR) and not na(longSwingFinalRR) and math.abs(longSwingRR - longSwingFinalRR) <= 0.01)
longSwingStopEntryActuallyPasses = not na(longSwingStopEntryRR) and longSwingStopEntryRR >= swingMinRR
longSwingSelectedStopButFails = longSwingEntryType == "Stop" and not longSwingStopEntryActuallyPasses
longSwingRiskPoints = not na(longSwingEntryPrice) ? longSwingEntryPrice - longSwingStopPrice : na
longSwingRiskDollarsPerContract = longSwingRiskPoints > 0 ? longSwingRiskPoints * scalpPointValue + commissionRoundTrip : na
longSwingRawContracts = not na(longSwingRiskDollarsPerContract) and longSwingRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / longSwingRiskDollarsPerContract)) : 0
longSwingContracts = useMaxContractCap ? math.min(longSwingRawContracts, maxContracts) : longSwingRawContracts
longSwingRiskValid = longSwingRiskPoints > 0 and not na(longSwingRiskDollarsPerContract) and longSwingRiskDollarsPerContract > 0 and longSwingContracts >= 1
longSwingTradeValid = longSwingSetupQualified and longSwingTargetExists and longSwingStopValid and not na(longSwingEntryPrice) and not na(longSwingRR) and longSwingRR >= swingMinRR and longSwingRiskValid and longSwingDisplayedRrConsistent and not longSwingSelectedStopButFails

float shortSwingEntryPrice = na
string shortSwingEntryType = "N/A"
float shortSwingRR = na
bool shortSwingTargetExists = f_validSourcePrice(shortSwingTargetPrice)
bool shortSwingStopValid = f_validSourcePrice(shortSwingStopPrice) and shortSwingStopPrice > shortSwingStopEntry

if shortSwingSetupQualified and shortSwingTargetExists and shortSwingStopValid
    if swingUseStopOrdersFirst
        if shortSwingStopEntryPassesMinRR
            shortSwingEntryPrice := shortSwingStopEntry
            shortSwingEntryType := "Stop"
            shortSwingRR := shortSwingStopEntryRR
        else if swingAllowRetracementEntries
            if shortSwingEntry50PassesMinRR
                shortSwingEntryPrice := shortSwingEntry50CandidatePrice
                shortSwingEntryType := shortSwingEntry50CandidateType
                shortSwingRR := shortSwingEntry50RR
            else if shortSwingEntry618PassesMinRR
                shortSwingEntryPrice := shortSwingEntry618CandidatePrice
                shortSwingEntryType := shortSwingEntry618CandidateType
                shortSwingRR := shortSwingEntry618RR
    else
        if shortSwingEntry50PassesMinRR
            shortSwingEntryPrice := shortSwingEntry50CandidatePrice
            shortSwingEntryType := shortSwingEntry50CandidateType
            shortSwingRR := shortSwingEntry50RR
        else if shortSwingEntry618PassesMinRR
            shortSwingEntryPrice := shortSwingEntry618CandidatePrice
            shortSwingEntryType := shortSwingEntry618CandidateType
            shortSwingRR := shortSwingEntry618RR

shortSwingFinalRR = f_swingRRShort(shortSwingEntryPrice, shortSwingStopPrice, shortSwingTargetPrice)
if not na(shortSwingFinalRR)
    shortSwingRR := shortSwingFinalRR

shortSwingDisplayedRrConsistent = na(shortSwingEntryPrice) or (not na(shortSwingRR) and not na(shortSwingFinalRR) and math.abs(shortSwingRR - shortSwingFinalRR) <= 0.01)
shortSwingStopEntryActuallyPasses = not na(shortSwingStopEntryRR) and shortSwingStopEntryRR >= swingMinRR
shortSwingSelectedStopButFails = shortSwingEntryType == "Stop" and not shortSwingStopEntryActuallyPasses
shortSwingRiskPoints = not na(shortSwingEntryPrice) ? shortSwingStopPrice - shortSwingEntryPrice : na
shortSwingRiskDollarsPerContract = shortSwingRiskPoints > 0 ? shortSwingRiskPoints * scalpPointValue + commissionRoundTrip : na
shortSwingRawContracts = not na(shortSwingRiskDollarsPerContract) and shortSwingRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / shortSwingRiskDollarsPerContract)) : 0
shortSwingContracts = useMaxContractCap ? math.min(shortSwingRawContracts, maxContracts) : shortSwingRawContracts
shortSwingRiskValid = shortSwingRiskPoints > 0 and not na(shortSwingRiskDollarsPerContract) and shortSwingRiskDollarsPerContract > 0 and shortSwingContracts >= 1
shortSwingTradeValid = shortSwingSetupQualified and shortSwingTargetExists and shortSwingStopValid and not na(shortSwingEntryPrice) and not na(shortSwingRR) and shortSwingRR >= swingMinRR and shortSwingRiskValid and shortSwingDisplayedRrConsistent and not shortSwingSelectedStopButFails

[longGroup1AfterPDHPrice, longGroup1AfterPDHName] = f_pickLongTouchedLevel(usePrevDayHighLevel, effectivePrevDayHigh, "PDH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[longGroup1Price, longGroup1Name] = f_pickLongTouchedLevel(usePrevDayLowLevel, effectivePrevDayLow, "PDL", scalpSignalLow, scalpSignalHigh, longGroup1AfterPDHPrice, longGroup1AfterPDHName)
[longGroup2Price, longGroup2Name] = f_pickLongTouchedLevel(useDailyOpenLevel, effectiveDailyOpen, "OP", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[longGroup3AfterPMHPrice, longGroup3AfterPMHName] = f_pickLongTouchedLevel(usePremarketHighLevel, effectivePremarketHigh, "PMH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[longGroup3Price, longGroup3Name] = f_pickLongTouchedLevel(usePremarketLowLevel, effectivePremarketLow, "PML", scalpSignalLow, scalpSignalHigh, longGroup3AfterPMHPrice, longGroup3AfterPMHName)
[longGroup4AfterORHPrice, longGroup4AfterORHName] = f_pickLongTouchedLevel(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "ORH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[longGroup4Price, longGroup4Name] = f_pickLongTouchedLevel(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "ORL", scalpSignalLow, scalpSignalHigh, longGroup4AfterORHPrice, longGroup4AfterORHName)

[shortGroup1AfterPDHPrice, shortGroup1AfterPDHName] = f_pickShortTouchedLevel(usePrevDayHighLevel, effectivePrevDayHigh, "PDH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[shortGroup1Price, shortGroup1Name] = f_pickShortTouchedLevel(usePrevDayLowLevel, effectivePrevDayLow, "PDL", scalpSignalLow, scalpSignalHigh, shortGroup1AfterPDHPrice, shortGroup1AfterPDHName)
[shortGroup2Price, shortGroup2Name] = f_pickShortTouchedLevel(useDailyOpenLevel, effectiveDailyOpen, "OP", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[shortGroup3AfterPMHPrice, shortGroup3AfterPMHName] = f_pickShortTouchedLevel(usePremarketHighLevel, effectivePremarketHigh, "PMH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[shortGroup3Price, shortGroup3Name] = f_pickShortTouchedLevel(usePremarketLowLevel, effectivePremarketLow, "PML", scalpSignalLow, scalpSignalHigh, shortGroup3AfterPMHPrice, shortGroup3AfterPMHName)
[shortGroup4AfterORHPrice, shortGroup4AfterORHName] = f_pickShortTouchedLevel(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "ORH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[shortGroup4Price, shortGroup4Name] = f_pickShortTouchedLevel(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "ORL", scalpSignalLow, scalpSignalHigh, shortGroup4AfterORHPrice, shortGroup4AfterORHName)

longMostKeyTouchedLevelPrice = not na(longGroup1Price) ? longGroup1Price : not na(longGroup2Price) ? longGroup2Price : not na(longGroup3Price) ? longGroup3Price : longGroup4Price
longMostKeyTouchedLevelName = not na(longGroup1Price) ? longGroup1Name : not na(longGroup2Price) ? longGroup2Name : not na(longGroup3Price) ? longGroup3Name : not na(longGroup4Price) ? longGroup4Name : "N/A"

shortMostKeyTouchedLevelPrice = not na(shortGroup1Price) ? shortGroup1Price : not na(shortGroup2Price) ? shortGroup2Price : not na(shortGroup3Price) ? shortGroup3Price : shortGroup4Price
shortMostKeyTouchedLevelName = not na(shortGroup1Price) ? shortGroup1Name : not na(shortGroup2Price) ? shortGroup2Name : not na(shortGroup3Price) ? shortGroup3Name : not na(shortGroup4Price) ? shortGroup4Name : "N/A"

longAnyEntryLevelTouched = not na(longMostKeyTouchedLevelPrice)
shortAnyEntryLevelTouched = not na(shortMostKeyTouchedLevelPrice)

longMostKeyTouchedLevelBroken = longAnyEntryLevelTouched and scalpSignalClose > longMostKeyTouchedLevelPrice
shortMostKeyTouchedLevelBroken = shortAnyEntryLevelTouched and scalpSignalClose < shortMostKeyTouchedLevelPrice

longSelectedLevelPrice = longMostKeyTouchedLevelBroken ? longMostKeyTouchedLevelPrice : na
longSelectedLevelName = longMostKeyTouchedLevelBroken ? longMostKeyTouchedLevelName : "N/A"

shortSelectedLevelPrice = shortMostKeyTouchedLevelBroken ? shortMostKeyTouchedLevelPrice : na
shortSelectedLevelName = shortMostKeyTouchedLevelBroken ? shortMostKeyTouchedLevelName : "N/A"

// Level-entry retracement validation only applies when the broken level would be the entry.
levelEntryRange = scalpSignalHigh - scalpSignalLow
longLevelEntryRequired = not na(longSelectedLevelPrice) and longSelectedLevelPrice >= longEntry50 and longSelectedLevelPrice < scalpSignalClose
shortLevelEntryRequired = not na(shortSelectedLevelPrice) and shortSelectedLevelPrice <= shortEntry50 and shortSelectedLevelPrice > scalpSignalClose
float longLevelEntryRetracement = (levelEntryRange > 0 and longLevelEntryRequired) ? (scalpSignalHigh - longSelectedLevelPrice) / levelEntryRange : na
float shortLevelEntryRetracement = (levelEntryRange > 0 and shortLevelEntryRequired) ? (shortSelectedLevelPrice - scalpSignalLow) / levelEntryRange : na
longLevelEntryRetracementOk = not longLevelEntryRequired or (not na(longLevelEntryRetracement) and longLevelEntryRetracement >= minLevelEntryRetracement)
shortLevelEntryRetracementOk = not shortLevelEntryRequired or (not na(shortLevelEntryRetracement) and shortLevelEntryRetracement >= minLevelEntryRetracement)

// ===================== Scalp Setup Qualification Logic =====================
// Level-break setups reuse the enabled scalp entry level checks above. A selected
// level only exists after the signal bar range includes that level and closes beyond it.
longLevelBreakSetup = longMostKeyTouchedLevelBroken and longLevelEntryRetracementOk
shortLevelBreakSetup = shortMostKeyTouchedLevelBroken and shortLevelEntryRetracementOk

longPullbackBreak = not na(low[1]) and low < low[1]
shortPullbackBreak = not na(high[1]) and high > high[1]
longNoPullbackBreak = not na(low[1]) and not longPullbackBreak
shortNoPullbackBreak = not na(high[1]) and not shortPullbackBreak
var int longBarsWithoutPullbackBreak = 0
var int shortBarsWithoutPullbackBreak = 0
longBarsWithoutPullbackBreak := longNoPullbackBreak ? nz(longBarsWithoutPullbackBreak[1]) + 1 : 0
shortBarsWithoutPullbackBreak := shortNoPullbackBreak ? nz(shortBarsWithoutPullbackBreak[1]) + 1 : 0

// Two-bar setups are fallback qualifiers: no qualifying level break, a trend-body
// signal bar, and one of the prior two bars closing strongly in the signal direction.
longSignalTrendBar = f_isBullBar(open, close) and isBodyThreshold
shortSignalTrendBar = f_isBearBar(open, close) and isBodyThreshold
priorBullUpperThirdBar = f_bullUpperThirdBar(open[1], high[1], low[1], close[1]) or f_bullUpperThirdBar(open[2], high[2], low[2], close[2])
priorBearLowerThirdBar = f_bearLowerThirdBar(open[1], high[1], low[1], close[1]) or f_bearLowerThirdBar(open[2], high[2], low[2], close[2])
longTwoBarSetupRaw = not longAnyEntryLevelTouched and longSignalTrendBar and priorBullUpperThirdBar
shortTwoBarSetupRaw = not shortAnyEntryLevelTouched and shortSignalTrendBar and priorBearLowerThirdBar
longTwoBarIgnitionOk = not requireTwoBarIgnition or scalpSignalClose > high[1]
shortTwoBarIgnitionOk = not requireTwoBarIgnition or scalpSignalClose < low[1]
longTwoBarSetup = longTwoBarSetupRaw and longTwoBarIgnitionOk
shortTwoBarSetup = shortTwoBarSetupRaw and shortTwoBarIgnitionOk
longSetupTextFull = longLevelBreakSetup ? "Level Break" : longTwoBarSetup ? "Two-Bar Play" : "None"
shortSetupTextFull = shortLevelBreakSetup ? "Level Break" : shortTwoBarSetup ? "Two-Bar Play" : "None"

prior1StrongBull = f_isBullBar(open[1], close[1]) and bodyPct[1] >= 0.50 and closeInUpperThird[1]
prior2StrongBull = f_isBullBar(open[2], close[2]) and bodyPct[2] >= 0.50 and closeInUpperThird[2]
prior1StrongBear = f_isBearBar(open[1], close[1]) and bodyPct[1] >= 0.50 and closeInLowerThird[1]
prior2StrongBear = f_isBearBar(open[2], close[2]) and bodyPct[2] >= 0.50 and closeInLowerThird[2]
longFiveBarExtension = longBarsWithoutPullbackBreak >= 5
shortFiveBarExtension = shortBarsWithoutPullbackBreak >= 5
longStrongMicrochannelExtension = longBarsWithoutPullbackBreak >= 3 and prior1StrongBull and prior2StrongBull
shortStrongMicrochannelExtension = shortBarsWithoutPullbackBreak >= 3 and prior1StrongBear and prior2StrongBear
longExtendedSetup = longFiveBarExtension or longStrongMicrochannelExtension
shortExtendedSetup = shortFiveBarExtension or shortStrongMicrochannelExtension
longExtendedSetupBlocked = longExtendedSetup and ((skipFiveBarExtension and longFiveBarExtension) or (skipStrongMicrochannelExtension and longStrongMicrochannelExtension))
shortExtendedSetupBlocked = shortExtendedSetup and ((skipFiveBarExtension and shortFiveBarExtension) or (skipStrongMicrochannelExtension and shortStrongMicrochannelExtension))
longFiveBullBarsInRow = f_isBullBar(open, close) and f_isBullBar(open[1], close[1]) and f_isBullBar(open[2], close[2]) and f_isBullBar(open[3], close[3]) and f_isBullBar(open[4], close[4])
shortFiveBearBarsInRow = f_isBearBar(open, close) and f_isBearBar(open[1], close[1]) and f_isBearBar(open[2], close[2]) and f_isBearBar(open[3], close[3]) and f_isBearBar(open[4], close[4])
longActualSetupIsTwoBar = not longLevelBreakSetup and longTwoBarSetup
shortActualSetupIsTwoBar = not shortLevelBreakSetup and shortTwoBarSetup
longTwoBarSoftExtensionBlocked = skipTwoBarSameColorExtension and longActualSetupIsTwoBar and longFiveBullBarsInRow
shortTwoBarSoftExtensionBlocked = skipTwoBarSameColorExtension and shortActualSetupIsTwoBar and shortFiveBearBarsInRow

// Requirement toggles act as filters. If neither setup is required, preserve the
// original behavior and allow any alert that otherwise passes the alert conditions.
requireAnyScalpSetup = requireLevelBreakSetup or requireTwoBarSetup
longRequiredSetupMatched = (requireLevelBreakSetup and longLevelBreakSetup) or (requireTwoBarSetup and longTwoBarSetup)
shortRequiredSetupMatched = (requireLevelBreakSetup and shortLevelBreakSetup) or (requireTwoBarSetup and shortTwoBarSetup)
longScalpSetupQualified = not requireAnyScalpSetup or longRequiredSetupMatched
shortScalpSetupQualified = not requireAnyScalpSetup or shortRequiredSetupMatched

// ===================== Scalp Entry / Stop / Risk Logic =====================
longUsePriorityLevel = longLevelEntryRequired and longLevelEntryRetracementOk
shortUsePriorityLevel = shortLevelEntryRequired and shortLevelEntryRetracementOk
longEntryType = longUsePriorityLevel ? longSelectedLevelName : "50%"
shortEntryType = shortUsePriorityLevel ? shortSelectedLevelName : "50%"

longEntryPrice = longUsePriorityLevel ? longSelectedLevelPrice : longEntry50
shortEntryPrice = shortUsePriorityLevel ? shortSelectedLevelPrice : shortEntry50
longStopPrice = scalpSignalLow - scalpTickSize
shortStopPrice = scalpSignalHigh + scalpTickSize
longRiskPoints = longEntryPrice - longStopPrice
shortRiskPoints = shortStopPrice - shortEntryPrice
longRiskDollarsPerContract = longRiskPoints > 0 ? longRiskPoints * scalpPointValue + commissionRoundTrip : na
shortRiskDollarsPerContract = shortRiskPoints > 0 ? shortRiskPoints * scalpPointValue + commissionRoundTrip : na
longRawContracts = not na(longRiskDollarsPerContract) and longRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / longRiskDollarsPerContract)) : 0
shortRawContracts = not na(shortRiskDollarsPerContract) and shortRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / shortRiskDollarsPerContract)) : 0
longContracts = useMaxContractCap ? math.min(longRawContracts, maxContracts) : longRawContracts
shortContracts = useMaxContractCap ? math.min(shortRawContracts, maxContracts) : shortRawContracts
longRiskValid = longRiskPoints > 0 and not na(longRiskDollarsPerContract) and longRiskDollarsPerContract > 0 and longContracts >= 1
shortRiskValid = shortRiskPoints > 0 and not na(shortRiskDollarsPerContract) and shortRiskDollarsPerContract > 0 and shortContracts >= 1

// ===================== Scalp Target Selection Logic =====================
float noTargetPrice = na
string noTargetType = "N/A"
float noTargetRR = na

[longTargetAfterPDHPrice, longTargetAfterPDHType, longTargetAfterPDHRR] = f_pickLongTargetCandidate(usePrevDayHighLevel, effectivePrevDayHigh, "Level PDH", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, noTargetPrice, noTargetType, noTargetRR)
[longTargetAfterPDLPrice, longTargetAfterPDLType, longTargetAfterPDLRR] = f_pickLongTargetCandidate(usePrevDayLowLevel, effectivePrevDayLow, "Level PDL", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterPDHPrice, longTargetAfterPDHType, longTargetAfterPDHRR)
[longTargetAfterOPPrice, longTargetAfterOPType, longTargetAfterOPRR] = f_pickLongTargetCandidate(useDailyOpenLevel, effectiveDailyOpen, "Level OP", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterPDLPrice, longTargetAfterPDLType, longTargetAfterPDLRR)
[longTargetAfterPMHPrice, longTargetAfterPMHType, longTargetAfterPMHRR] = f_pickLongTargetCandidate(usePremarketHighLevel, effectivePremarketHigh, "Level PMH", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterOPPrice, longTargetAfterOPType, longTargetAfterOPRR)
[longTargetAfterPMLPrice, longTargetAfterPMLType, longTargetAfterPMLRR] = f_pickLongTargetCandidate(usePremarketLowLevel, effectivePremarketLow, "Level PML", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterPMHPrice, longTargetAfterPMHType, longTargetAfterPMHRR)
[longTargetAfterORHPrice, longTargetAfterORHType, longTargetAfterORHRR] = f_pickLongTargetCandidate(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "Level ORH", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterPMLPrice, longTargetAfterPMLType, longTargetAfterPMLRR)
[longTargetAfterORLPrice, longTargetAfterORLType, longTargetAfterORLRR] = f_pickLongTargetCandidate(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "Level ORL", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterORHPrice, longTargetAfterORHType, longTargetAfterORHRR)

float longTargetPrice = longTargetAfterORLPrice
string longTargetType = longTargetAfterORLType
float longTargetRR = longTargetAfterORLRR

if array.size(swingHighPrices) > 0
    for swingHighIndex = 0 to array.size(swingHighPrices) - 1
        float swingHighPrice = array.get(swingHighPrices, swingHighIndex)
        bool swingHighAllowed = array.get(swingHighActive, swingHighIndex) and f_swingTargetSessionAllowed(array.get(swingHighSessions, swingHighIndex), array.get(swingHighDateKeys, swingHighIndex), nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if swingHighAllowed and f_longTargetQualifies(swingHighPrice, "5m Swing", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and (na(longTargetPrice) or swingHighPrice < longTargetPrice)
            longTargetPrice := swingHighPrice
            longTargetType := "5m Swing"
            longTargetRR := f_targetRRLong(swingHighPrice, longEntryPrice, longRiskPoints)

if f_longTargetQualifies(currentRTHHigh, "HOD", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and (na(longTargetPrice) or currentRTHHigh < longTargetPrice)
    longTargetPrice := currentRTHHigh
    longTargetType := "HOD"
    longTargetRR := f_targetRRLong(currentRTHHigh, longEntryPrice, longRiskPoints)

longTargetValid = not na(longTargetPrice) and longTargetType != "N/A"

[shortTargetAfterPDHPrice, shortTargetAfterPDHType, shortTargetAfterPDHRR] = f_pickShortTargetCandidate(usePrevDayHighLevel, effectivePrevDayHigh, "Level PDH", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, noTargetPrice, noTargetType, noTargetRR)
[shortTargetAfterPDLPrice, shortTargetAfterPDLType, shortTargetAfterPDLRR] = f_pickShortTargetCandidate(usePrevDayLowLevel, effectivePrevDayLow, "Level PDL", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterPDHPrice, shortTargetAfterPDHType, shortTargetAfterPDHRR)
[shortTargetAfterOPPrice, shortTargetAfterOPType, shortTargetAfterOPRR] = f_pickShortTargetCandidate(useDailyOpenLevel, effectiveDailyOpen, "Level OP", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterPDLPrice, shortTargetAfterPDLType, shortTargetAfterPDLRR)
[shortTargetAfterPMHPrice, shortTargetAfterPMHType, shortTargetAfterPMHRR] = f_pickShortTargetCandidate(usePremarketHighLevel, effectivePremarketHigh, "Level PMH", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterOPPrice, shortTargetAfterOPType, shortTargetAfterOPRR)
[shortTargetAfterPMLPrice, shortTargetAfterPMLType, shortTargetAfterPMLRR] = f_pickShortTargetCandidate(usePremarketLowLevel, effectivePremarketLow, "Level PML", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterPMHPrice, shortTargetAfterPMHType, shortTargetAfterPMHRR)
[shortTargetAfterORHPrice, shortTargetAfterORHType, shortTargetAfterORHRR] = f_pickShortTargetCandidate(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "Level ORH", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterPMLPrice, shortTargetAfterPMLType, shortTargetAfterPMLRR)
[shortTargetAfterORLPrice, shortTargetAfterORLType, shortTargetAfterORLRR] = f_pickShortTargetCandidate(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "Level ORL", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterORHPrice, shortTargetAfterORHType, shortTargetAfterORHRR)

float shortTargetPrice = shortTargetAfterORLPrice
string shortTargetType = shortTargetAfterORLType
float shortTargetRR = shortTargetAfterORLRR

if array.size(swingLowPrices) > 0
    for swingLowIndex = 0 to array.size(swingLowPrices) - 1
        float swingLowPrice = array.get(swingLowPrices, swingLowIndex)
        bool swingLowAllowed = array.get(swingLowActive, swingLowIndex) and f_swingTargetSessionAllowed(array.get(swingLowSessions, swingLowIndex), array.get(swingLowDateKeys, swingLowIndex), nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if swingLowAllowed and f_shortTargetQualifies(swingLowPrice, "5m Swing", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and (na(shortTargetPrice) or swingLowPrice > shortTargetPrice)
            shortTargetPrice := swingLowPrice
            shortTargetType := "5m Swing"
            shortTargetRR := f_targetRRShort(swingLowPrice, shortEntryPrice, shortRiskPoints)

if f_shortTargetQualifies(currentRTHLow, "LOD", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and (na(shortTargetPrice) or currentRTHLow > shortTargetPrice)
    shortTargetPrice := currentRTHLow
    shortTargetType := "LOD"
    shortTargetRR := f_targetRRShort(currentRTHLow, shortEntryPrice, shortRiskPoints)

shortTargetValid = not na(shortTargetPrice) and shortTargetType != "N/A"
longTargetFilterPassed = not requireValidTarget or longTargetValid
shortTargetFilterPassed = not requireValidTarget or shortTargetValid

// ===================== Alert Conditions =====================
bullSwingBaseGate = alertSwingSetups and barstate.isconfirmed and inScalpRTHSession and validThesisLevel and thesisState == 1 and alertOnBullSignals and first15FilterAllowsAlerts and openingRangeAllowsAlerts
bearSwingBaseGate = alertSwingSetups and barstate.isconfirmed and inScalpRTHSession and validThesisLevel and thesisState == -1 and alertOnBearSignals and first15FilterAllowsAlerts and openingRangeAllowsAlerts
bullSwingAlert = bullSwingBaseGate and longSwingSetupQualified and longSwingTradeValid
bearSwingAlert = bearSwingBaseGate and shortSwingSetupQualified and shortSwingTradeValid

bullScalpAlert = alertScalpSetups and barstate.isconfirmed and inScalpRTHSession and validThesisLevel and thesisState == 1 and alertOnBullSignals and first15FilterAllowsAlerts and openingRangeAllowsAlerts and bullScalpTierAllowed and longFboImpulseOk and longScalpSetupQualified and not longExtendedSetupBlocked and not longTwoBarSoftExtensionBlocked and longRiskValid and longTargetFilterPassed
bullAlertLabelTitle = "LONG SCALP"

bearScalpAlert = alertScalpSetups and barstate.isconfirmed and inScalpRTHSession and validThesisLevel and thesisState == -1 and alertOnBearSignals and first15FilterAllowsAlerts and openingRangeAllowsAlerts and bearScalpTierAllowed and shortFboImpulseOk and shortScalpSetupQualified and not shortExtendedSetupBlocked and not shortTwoBarSoftExtensionBlocked and shortRiskValid and shortTargetFilterPassed
bearAlertLabelTitle = "SHORT SCALP"

longScalpSwingPriority = bullScalpAlert and bullSwingAlert and f_longSwingEntryEarlierOrSame(longSwingEntryPrice, longEntryPrice)
shortScalpSwingPriority = bearScalpAlert and bearSwingAlert and f_shortSwingEntryEarlierOrSame(shortSwingEntryPrice, shortEntryPrice)
prioritizeBullSwingEntry = prioritizeSwingWhenSameEntry and alertScalpSetups and alertSwingSetups and longScalpSwingPriority
prioritizeBearSwingEntry = prioritizeSwingWhenSameEntry and alertScalpSetups and alertSwingSetups and shortScalpSwingPriority
noScalpAlertActive = not bullScalpAlert and not bearScalpAlert
plotBullSwingAlert = bullSwingAlert and (prioritizeBullSwingEntry or noScalpAlertActive)
plotBearSwingAlert = not plotBullSwingAlert and bearSwingAlert and (prioritizeBearSwingEntry or noScalpAlertActive)
effectiveBullScalpAlert = not plotBullSwingAlert and not plotBearSwingAlert and bullScalpAlert
effectiveBearScalpAlert = not plotBullSwingAlert and not plotBearSwingAlert and not effectiveBullScalpAlert and bearScalpAlert

longSwingAlertLabelTitle = "LONG SWING"
shortSwingAlertLabelTitle = "SHORT SWING"
longSwingCompactSignalText = bullSwingVolumeTextShort + " " + longSwingSetupTextShort
shortSwingCompactSignalText = bearSwingVolumeTextShort + " " + shortSwingSetupTextShort

showHistoricalAlertLabels = alertLabelMode != "Off"
showCompactAlertLabels = alertLabelMode == "Compact"

f_buildMarkerChartLabel(_direction, _compactSignalText, _setupTextFull) =>
    showAlertSignalDetails ? _direction + "\n" + _compactSignalText + " | " + _setupTextFull : _direction

f_buildCompactChartLabel(_direction, _compactSignalText, _setupTextFull, _entryType, _entryPrice, _stopPrice, _targetPrice, _targetType, _targetRR, _contracts) =>
    string detailLine = showAlertSignalDetails ? _compactSignalText + " | " + _setupTextFull + "\n" + _entryType + " | S " + f_priceText(_stopPrice) + "\n" : ""
    _direction + "\n" +
     detailLine +
     "E " + f_priceText(_entryPrice) + "\n" +
     "T " + f_priceText(_targetPrice) + " " + _targetType + "\n" +
     str.tostring(_contracts) + "ct | " + f_rrText(_targetRR)

f_addAlertChartLabel(_price, _text, _style, _color) =>
    label.new(bar_index, _price, _text, style=_style, textcolor=color.white, color=_color, size=showCompactAlertLabels ? size.small : size.tiny)

if showHistoricalAlertLabels and plotBullSwingAlert
    string bullSwingChartLabelText = showCompactAlertLabels ? f_buildCompactChartLabel(longSwingAlertLabelTitle, longSwingCompactSignalText, longSwingSetupTextFull, longSwingEntryType, longSwingEntryPrice, longSwingStopPrice, longSwingTargetPrice, longSwingTargetType, longSwingRR, longSwingContracts) : f_buildMarkerChartLabel(longSwingAlertLabelTitle, longSwingCompactSignalText, longSwingSetupTextFull)
    f_addAlertChartLabel(low, bullSwingChartLabelText, label.style_label_up, color.rgb(0, 150, 170))
else if showHistoricalAlertLabels and plotBearSwingAlert
    string bearSwingChartLabelText = showCompactAlertLabels ? f_buildCompactChartLabel(shortSwingAlertLabelTitle, shortSwingCompactSignalText, shortSwingSetupTextFull, shortSwingEntryType, shortSwingEntryPrice, shortSwingStopPrice, shortSwingTargetPrice, shortSwingTargetType, shortSwingRR, shortSwingContracts) : f_buildMarkerChartLabel(shortSwingAlertLabelTitle, shortSwingCompactSignalText, shortSwingSetupTextFull)
    f_addAlertChartLabel(high, bearSwingChartLabelText, label.style_label_down, color.rgb(190, 95, 0))
else if showHistoricalAlertLabels and effectiveBullScalpAlert
    string bullChartLabelText = showCompactAlertLabels ? f_buildCompactChartLabel(bullAlertLabelTitle, bullCompactSignalText, longSetupTextFull, longEntryType, longEntryPrice, longStopPrice, longTargetPrice, longTargetType, longTargetRR, longContracts) : f_buildMarkerChartLabel(bullAlertLabelTitle, bullCompactSignalText, longSetupTextFull)
    f_addAlertChartLabel(low, bullChartLabelText, label.style_label_up, color.new(color.lime, 0))
else if showHistoricalAlertLabels and effectiveBearScalpAlert
    string bearChartLabelText = showCompactAlertLabels ? f_buildCompactChartLabel(bearAlertLabelTitle, bearCompactSignalText, shortSetupTextFull, shortEntryType, shortEntryPrice, shortStopPrice, shortTargetPrice, shortTargetType, shortTargetRR, shortContracts) : f_buildMarkerChartLabel(bearAlertLabelTitle, bearCompactSignalText, shortSetupTextFull)
    f_addAlertChartLabel(high, bearChartLabelText, label.style_label_down, color.new(color.red, 0))

// ===================== Alert Message =====================
f_buildScalpAlertMessage(_directionTitle, _compactSignalText, _setupTextFull, _entryType, _entryPrice, _stopPrice, _targetPrice, _targetType, _targetRR, _riskPoints, _contracts) =>
    string signalDetailLine = "Signal: " + _compactSignalText + " | " + _setupTextFull + "\n"
    "PA ENGINE " + _directionTitle + "\n" +
     signalDetailLine +
     syminfo.ticker + " " + timeframe.period + "\n\n" +
     "Entry: " + f_priceText(_entryPrice) + "\n" +
     "Stop: " + f_priceText(_stopPrice) + "\n" +
     "Target: " + f_priceText(_targetPrice) + "\n" +
     "Target Type: " + _targetType + "\n" +
     "R:R: " + f_rrText(_targetRR) + "\n" +
     "Risk: " + f_pointsText(_riskPoints) + " pts\n" +
     "Contracts: " + str.tostring(_contracts) + "\n" +
     "Entry Type: " + _entryType + "\n\n" +
     "Thesis: " + f_thesisText(thesisState) + "\n" +
     "Thesis Level: " + f_priceText(effectiveThesisLevel) + "\n" +
     "Opening Range: " + openingRangeStatus

f_buildSwingAlertMessage(_directionTitle, _compactSignalText, _setupTextFull, _entryType, _entryPrice, _stopPrice, _stopSource, _targetPrice, _targetType, _targetRR, _riskPoints, _contracts, _swingLevelName, _swingLevelPrice, _fboPrice) =>
    "PA ENGINE " + _directionTitle + "\n" +
     "Signal: " + _compactSignalText + "\n" +
     "Setup: " + _setupTextFull + "\n" +
     syminfo.ticker + " " + timeframe.period + "\n\n" +
     "Entry: " + f_priceText(_entryPrice) + "\n" +
     "Entry Type: " + _entryType + "\n" +
     "Stop: " + f_priceText(_stopPrice) + "\n" +
     "Stop Source: " + _stopSource + "\n" +
     "Target: " + f_priceText(_targetPrice) + "\n" +
     "Target Type: " + _targetType + "\n" +
     "R:R: " + f_rrText(_targetRR) + "\n" +
     "Risk points: " + f_pointsText(_riskPoints) + " pts\n" +
     "Contracts: " + str.tostring(_contracts) + "\n" +
     "Swing Level: " + _swingLevelName + " " + f_priceText(_swingLevelPrice) + "\n" +
     "FBO Level: " + f_priceText(_fboPrice) + "\n\n" +
     "Thesis: " + f_thesisText(thesisState) + "\n" +
     "Thesis Level: " + f_priceText(effectiveThesisLevel) + "\n" +
     "Opening Range: " + openingRangeStatus

if plotBullSwingAlert
    alert(f_buildSwingAlertMessage(longSwingAlertLabelTitle, longSwingCompactSignalText, longSwingSetupTextFull, longSwingEntryType, longSwingEntryPrice, longSwingStopPrice, longSwingStopSource, longSwingTargetPrice, longSwingTargetType, longSwingRR, longSwingRiskPoints, longSwingContracts, longSwingTouchedLevelName, longSwingTouchedLevelPrice, longSwingFboQualified ? longSwingFboPrice : na), alert.freq_once_per_bar_close)
else if plotBearSwingAlert
    alert(f_buildSwingAlertMessage(shortSwingAlertLabelTitle, shortSwingCompactSignalText, shortSwingSetupTextFull, shortSwingEntryType, shortSwingEntryPrice, shortSwingStopPrice, shortSwingStopSource, shortSwingTargetPrice, shortSwingTargetType, shortSwingRR, shortSwingRiskPoints, shortSwingContracts, shortSwingTouchedLevelName, shortSwingTouchedLevelPrice, shortSwingFboQualified ? shortSwingFboPrice : na), alert.freq_once_per_bar_close)
else if effectiveBullScalpAlert
    alert(f_buildScalpAlertMessage(bullAlertLabelTitle, bullCompactSignalText, longSetupTextFull, longEntryType, longEntryPrice, longStopPrice, longTargetPrice, longTargetType, longTargetRR, longRiskPoints, longContracts), alert.freq_once_per_bar_close)
else if effectiveBearScalpAlert
    alert(f_buildScalpAlertMessage(bearAlertLabelTitle, bearCompactSignalText, shortSetupTextFull, shortEntryType, shortEntryPrice, shortStopPrice, shortTargetPrice, shortTargetType, shortTargetRR, shortRiskPoints, shortContracts), alert.freq_once_per_bar_close)

thesisPlot = showAutoThesisLevel and inScalpRTHSession and not na(effectiveThesisLevel) and effectiveThesisLevel > 0 ? effectiveThesisLevel : na
plot(thesisPlot, "Effective Thesis Level", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(showOpeningRange ? openingRangeDisplayHigh : na, "15m Opening Range High", color=openingRangeHighColor, linewidth=1, style=plot.style_linebr)
plot(showOpeningRange ? openingRangeDisplayLow : na, "15m Opening Range Low", color=openingRangeLowColor, linewidth=1, style=plot.style_linebr)
pdhPlot = showAutoScalpLevels and showRawFuturesPrevDayLevels and inScalpRTHSession and effectivePrevDayHigh > 0 ? effectivePrevDayHigh : na
pdlPlot = showAutoScalpLevels and showRawFuturesPrevDayLevels and inScalpRTHSession and effectivePrevDayLow > 0 ? effectivePrevDayLow : na

plot(pdhPlot, "Auto/Effective PDH", color=majorHighLevelColor, linewidth=1, style=plot.style_linebr)
plot(pdlPlot, "Auto/Effective PDL", color=majorLowLevelColor, linewidth=1, style=plot.style_linebr)
plot(showAutoScalpLevels and effectiveDailyOpen > 0 ? effectiveDailyOpen : na, "Auto/Effective OP", color=openLevelColor, linewidth=1, style=plot.style_linebr)
plot(showAutoScalpLevels and effectivePremarketHigh > 0 ? effectivePremarketHigh : na, "Auto/Effective Premarket High", color=premarketLevelColor, linewidth=1, style=plot.style_linebr)
plot(showAutoScalpLevels and effectivePremarketLow > 0 ? effectivePremarketLow : na, "Auto/Effective Premarket Low", color=premarketLevelColor, linewidth=1, style=plot.style_linebr)

// Signals
plotshape(plotBullHV_diamond and onlyBullSignal and bullSignalConfirmed and isMostlyBody, style=shape.diamond, size=size.small, location=location.belowbar, color=color.lime)
plotshape(plotBullHV_tri and onlyBullSignal and bullSignalConfirmed and not isMostlyBody, style=shape.triangleup, size=size.small, location=location.belowbar, color=color.lime)
plotshape(plotBullHV_circle and onlyBullSignal and not bullSignalConfirmed, style=shape.circle, size=size.small, location=location.belowbar, color=color.lime)
plotshape(plotBearHV_diamond and onlyBearSignal and bearSignalConfirmed and isMostlyBody, style=shape.diamond, size=size.small, location=location.abovebar, color=color.red)
plotshape(plotBearHV_tri and onlyBearSignal and bearSignalConfirmed and not isMostlyBody, style=shape.triangledown, size=size.small, location=location.abovebar, color=color.red)
plotshape(plotBearHV_circle and onlyBearSignal and not bearSignalConfirmed, style=shape.circle, size=size.small, location=location.abovebar, color=color.red)
plotshape(plotBullNV_diamond and onlyBullSignal and bullSignalConfirmed and isMostlyBody, style=shape.diamond, size=size.tiny, location=location.belowbar, color=color.new(color.lime, 55))
plotshape(plotBullNV_tri and onlyBullSignal and bullSignalConfirmed and not isMostlyBody, style=shape.triangleup, size=size.tiny, location=location.belowbar, color=color.new(color.lime, 55))
plotshape(plotBullNV_circle and onlyBullSignal and not bullSignalConfirmed, style=shape.circle, size=size.tiny, location=location.belowbar, color=color.new(color.lime, 55))
plotshape(plotBearNV_diamond and onlyBearSignal and bearSignalConfirmed and isMostlyBody, style=shape.diamond, size=size.tiny, location=location.abovebar, color=color.new(color.red, 55))
plotshape(plotBearNV_tri and onlyBearSignal and bearSignalConfirmed and not isMostlyBody, style=shape.triangledown, size=size.tiny, location=location.abovebar, color=color.new(color.red, 55))
plotshape(plotBearNV_circle and onlyBearSignal and not bearSignalConfirmed, style=shape.circle, size=size.tiny, location=location.abovebar, color=color.new(color.red, 55))

// ===================== Signal Legend =====================
var table legendTable = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 85), border_width=0)
if barstate.islast and showSignalLegend
    table.cell(legendTable, 0, 0, "○",  text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_center)
    table.cell(legendTable, 1, 0, " Setup",           text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
    table.cell(legendTable, 0, 1, "△",  text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_center)
    table.cell(legendTable, 1, 1, " Ignition",        text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
    table.cell(legendTable, 0, 2, "◇",  text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_center)
    table.cell(legendTable, 1, 2, " Strong Ignition",  text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)

// ===================== Scalp Status Table =====================
f_addScalpStatusRow(table _statusTable, int _row, string _label, string _value, color _valueColor) =>
    table.cell(_statusTable, 0, _row, _label, text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
    table.cell(_statusTable, 1, _row, _value, text_color=_valueColor, text_size=size.small, text_halign=text.align_right)
    _row + 1

var table scalpStatusTable = table.new(position.bottom_right, 2, 80, bgcolor=color.new(color.black, 85), border_width=0)
if barstate.islast
    table.clear(scalpStatusTable, 0, 0, 1, 79)
    if showThesisLabel
        statusNeutralColor = color.rgb(220, 220, 220)
        statusTextColor = thesisState == 1 ? color.lime : thesisState == -1 ? color.red : statusNeutralColor
        alertSetupsTableText = alertScalpSetups and alertSwingSetups ? "Scalp + Swing" : alertScalpSetups ? "Scalp" : alertSwingSetups ? "Swing" : "Off"
        int scalpStatusRow = 0
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Thesis", f_thesisText(thesisState), statusTextColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Thesis Level", f_priceText(effectiveThesisLevel), statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Thesis Name", effectiveThesisName, statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Symbol", effectiveThesisSourceSymbol, statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Opening Range", openingRangeStatus, statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Alert Setups", alertSetupsTableText, statusNeutralColor)
        if showDetailedLevelStatus
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PDH", f_priceText(effectivePrevDayHigh), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PDL", f_priceText(effectivePrevDayLow), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "OP", f_priceText(effectiveDailyOpen), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PMH", f_priceText(effectivePremarketHigh), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PML", f_priceText(effectivePremarketLow), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PDH/PDL Source", prevDayHighLowSource, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "OP Source", dailyOpenSource, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PM Source", premarketSource, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Auto Note", "Intraday, ideally 5m", statusNeutralColor)
        if showAutoThesisDebug
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conversion Method", autoThesisConversionMethod, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Thesis Price", useAutoThesis ? f_priceText(selectedAutoThesisSourcePrice) : "N/A", statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Daily Open", useAutoThesis ? f_priceText(sourceDayOpen) : "N/A", statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Chart Daily Open", useAutoThesis ? f_priceText(chartDailyOpenForThesis) : "N/A", statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Raw Converted", useAutoThesis ? f_priceText(convertedAutoThesisRaw) : "N/A", statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Final Thesis Level", useAutoThesis ? f_priceText(convertedAutoThesisLevel) : "N/A", statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Auto Distance", useAutoThesis ? f_pointsText(selectedAutoThesisDistance) : "N/A", statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Daily Open Default", useAutoThesis ? f_boolText(autoThesisUsedDailyOpenDefault) : "N/A", statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Auto Status", autoThesisUnavailableReason, autoThesisConvertedValid ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Auto Priority", useAutoThesis and autoThesisSelectionValid ? str.tostring(selectedAutoThesisPriority) : "N/A", statusNeutralColor)
        if showDetailedLevelStatus or showAutoThesisDebug or showGapRequestDiagnostics
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Chart Symbol", syminfo.tickerid, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Ticker Input", tickerInput, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Gap Request Source", activeDailyGapSourceDebugText, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Expected Source", expectedDailyGapSourceSymbol, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Gap Request Mode", activeDailyGapRequestMode, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Active Source Type", activeDailyGapSourceType, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Active Timeframe", activeDailyGapTimeframe, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Active Calc Bars", str.tostring(activeDailyGapCalcBarsCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Daily Gap Lookback", str.tostring(dailyGapLookback), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Gap calc_bars_count", str.tostring(activeDailyGapCalcBarsCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Raw Requested Gaps", str.tostring(requestedSourceDailyGapCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Last Active Raw Gaps", str.tostring(lastFreshRequestedSourceDailyGapCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Gaps", str.tostring(sourceDailyGapCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Cached Parsed Gaps", str.tostring(sourceDailyGapCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Displayed Gaps", str.tostring(displayedDailyGapCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Swing Gap Levels", str.tostring(swingDailyGapLevelsAdded), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Parse Fail Count", str.tostring(sourceDailyGapParseFailCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Invalid Source Count", str.tostring(sourceDailyGapInvalidPriceCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Cached Success Count", str.tostring(sourceDailyGapCachedSuccessCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Convert Success Count", str.tostring(dailyGapConvertedSuccessCount), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Raw Gap Record", firstRawDailyGapRecord, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Cached Start", f_priceText(firstValidSourceGapStart), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Cached End", f_priceText(firstValidSourceGapEnd), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Cached High", f_priceText(firstValidSourceGapHigh), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Cached Low", f_priceText(firstValidSourceGapLow), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Conv Start", f_priceText(firstValidConvertedGapStart), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Conv End", f_priceText(firstValidConvertedGapEnd), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Conv High", f_priceText(firstValidConvertedGapHigh), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "First Conv Low", f_priceText(firstValidConvertedGapLow), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conv Chart Close", f_priceText(chartConversionBase), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conv Source Close", f_priceText(sourceConversionBase), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conv Ratio", f_numberText(currentConversionRatio), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conversion Ready", f_boolText(swingCurrentPriceRatioReady), swingCurrentPriceRatioReady ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Chart RTH Open", f_priceText(chartDailyOpenForThesis), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Gap Status", dailyGapUnavailableReason, (dailyGapUnavailableReason == "ready" or dailyGapUnavailableReason == "ready; display capped") ? color.lime : statusNeutralColor)
            if showGapRequestDiagnostics
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Active Request Count", str.tostring(requestedSourceDailyGapCount), statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Gated Count", str.tostring(gatedDiagnosticGapCount), statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Ungated Count", str.tostring(ungatedDiagnosticGapCount), statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Ungated 600 Count", str.tostring(ungated600DiagnosticGapCount), statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Explicit RTH Count", str.tostring(explicitRthDiagnosticGapCount), statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Plain Symbol Count", str.tostring(plainSymbolDiagnosticGapCount), statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "1440 Count", str.tostring(explicit1440DiagnosticGapCount), statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "D Count", str.tostring(explicitDDiagnosticGapCount), statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Active First Raw", currentFirstRawDailyGapRecord, statusNeutralColor)
                scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Best Variant First Raw", bestDiagnosticFirstRawRecord, statusNeutralColor)

//@version=6
indicator("PA Engine Alert System", shorttitle = "PA Engine Alerts", overlay=true, calc_bars_count=1000, max_bars_back = 1000, max_lines_count=500, max_labels_count=500, dynamic_requests=true)

// ===================== User Inputs =====================

groupCoreAlerts = "01. Core Alert Controls"
groupSetupFilters = "02. Setup Filters"
groupThesis = "03. Thesis"
groupScalpLevels = "04. Scalp Levels"
groupOpeningRange = "05. Opening Range"
groupRisk = "06. Risk / Position Sizing"
groupTargets = "07. Target Settings"
groupSignalEngine = "08. Signal Engine Tuning"
groupDisplay = "09. Display / Visuals"
groupDebug = "10. Debug / Advanced"

// 01. Core Alert Controls
enableScalpAlerts        = input.bool(true, title="Enable Scalp Alerts", group=groupCoreAlerts)
tickerInput              = input.string("MES", title="Ticker", options=["MES", "MNQ"], group=groupCoreAlerts)
alertOnBullSignals       = input.bool(true, title="Alert On Bull Signals", group=groupCoreAlerts)
alertOnBearSignals       = input.bool(true, title="Alert On Bear Signals", group=groupCoreAlerts)
alertVolumeMode          = input.string("High Volume Only", title="Alert Volume Mode", options=["High Volume Only", "All"], group=groupCoreAlerts)
waitFirst15Minutes       = input.bool(true, title="Wait First 15 Minutes", group=groupCoreAlerts)
requireOpeningRangeBreak = input.bool(true, title="Require Opening Range Break", group=groupCoreAlerts)
requireValidTarget       = input.bool(true, title="Require Valid Target", group=groupCoreAlerts)
minTargetRR              = input.float(1.0, title="Minimum Target R:R", minval=0.25, step=0.05, group=groupCoreAlerts)

// 02. Setup Filters
requireLevelBreakSetup   = input.bool(true, title="Require Level Break Setup", group=groupSetupFilters, tooltip="Require scalp alerts to have a signal bar that touches an enabled scalp entry level and closes beyond it.")
requireTwoBarSetup       = input.bool(true, title="Require Two-Bar Setup", group=groupSetupFilters, tooltip="Require scalp alerts to have no qualifying level break plus a trend-body signal bar with confirmation from one of the prior two bars.")
requireTwoBarIgnition    = input.bool(true, title="Require Ignition for Two-Bar Setups", group=groupSetupFilters)
skipFiveBarExtension     = input.bool(true, title="Skip 5+ Bar Extension", group=groupSetupFilters)
skipStrongMicrochannelExtension = input.bool(true, title="Skip 3+ Bar Strong Extension", group=groupSetupFilters)
skipTwoBarSameColorExtension = input.bool(true, title="Skip 5 Same-Color Bars For Two-Bar Setups", group=groupSetupFilters)
useFboImpulseFilter      = input.bool(true, title="Use FBO Impulse Filter", group=groupSetupFilters)
fboImpulseTolerance      = input.float(0.0, title="FBO Impulse Tolerance", minval=0.0, step=0.05, group=groupSetupFilters)
impulseLookback          = input.int(3, title="Impulse Lookback", minval=1, maxval=20, group=groupSetupFilters)
impulseAtrLength         = input.int(14, title="Impulse ATR Length", minval=1, maxval=200, group=groupSetupFilters)
esImpulseSymbol          = input.symbol("CME_MINI:ES1!", title="ES Impulse Symbol", group=groupSetupFilters)
nqImpulseSymbol          = input.symbol("CME_MINI:NQ1!", title="NQ Impulse Symbol", group=groupSetupFilters)
minLevelEntryRetracement = input.float(0.20, title="Minimum Level Entry Retracement", minval=0.0, maxval=0.5, step=0.05, group=groupSetupFilters)
alertSetupSignals        = input.bool(true, title="Allow Setup Signals", group=groupSetupFilters)
alertIgnitionSignals     = input.bool(true, title="Allow Ignition Signals", group=groupSetupFilters)
alertStrongIgnitions     = input.bool(true, title="Allow Strong Ignitions", group=groupSetupFilters)

// 03. Thesis
useAutoThesis                 = input.bool(true, title="Use Auto Thesis", group=groupThesis)
autoThesisFallbackToManual    = input.bool(true, title="Fallback To Manual Thesis If Auto Unavailable", group=groupThesis)
initialThesis                 = input.string("Neutral", title="Initial Thesis", options=["Neutral", "Long", "Short"], group=groupThesis)
thesisLevel                   = input.float(0.0, title="Manual Thesis Level", step=0.25, group=groupThesis)
thesisFollowThroughBars       = input.int(5, title="Thesis Follow-Through Bars", minval=1, maxval=20, group=groupThesis)
autoThesisAtrMultiplier       = input.float(0.75, title="Auto Thesis ATR Multiplier", minval=0.1, step=0.05, group=groupThesis)
thesisSourceMode              = input.string("Auto From Ticker", title="Thesis Source Mode", options=["Auto From Ticker", "Manual Source"], group=groupThesis)
manualThesisSourceSymbol      = input.string("AMEX:SPY", title="Manual Thesis Source Symbol", group=groupThesis)
thesisConversionMode          = input.string("Anchored RTH Ratio", title="Thesis Conversion Mode", options=["Anchored RTH Ratio", "RTH Open Ratio", "Current Price Ratio"], group=groupThesis)
includeDailyGapsInAutoThesis  = input.bool(true, title="Include Daily Gaps In Auto Thesis", group=groupThesis)
showAutoThesisLevel           = input.bool(true, title="Show Auto/Effective Thesis Level", group=groupThesis)
showThesisLabel               = input.bool(true, title="Show Thesis Status Table", group=groupThesis)

// 04. Scalp Levels
useAutoPrevDayHighLow            = input.bool(true, title="Use Auto PDH/PDL", group=groupScalpLevels)
usePrevDayHighLevel              = input.bool(true, title="Use PDH Level", group=groupScalpLevels)
prevDayHighLevel                 = input.float(0.0, title="Manual/Fallback PDH Level", step=0.25, group=groupScalpLevels)
usePrevDayLowLevel               = input.bool(true, title="Use PDL Level", group=groupScalpLevels)
prevDayLowLevel                  = input.float(0.0, title="Manual/Fallback PDL Level", step=0.25, group=groupScalpLevels)
useAutoDailyOpen                 = input.bool(true, title="Use Auto Daily Open", group=groupScalpLevels)
useDailyOpenLevel                = input.bool(true, title="Use Daily Open Level", group=groupScalpLevels)
dailyOpenLevel                   = input.float(0.0, title="Manual/Fallback Daily Open", step=0.25, group=groupScalpLevels)
useAutoPremarketHighLow          = input.bool(true, title="Use Auto PMH/PML", group=groupScalpLevels)
usePremarketHighLevel            = input.bool(true, title="Use PMH Level", group=groupScalpLevels)
premarketHighLevel               = input.float(0.0, title="Manual/Fallback PMH Level", step=0.25, group=groupScalpLevels)
usePremarketLowLevel             = input.bool(true, title="Use PML Level", group=groupScalpLevels)
premarketLowLevel                = input.float(0.0, title="Manual/Fallback PML Level", step=0.25, group=groupScalpLevels)
useOpeningRangeHighAsEntryLevel  = input.bool(true, title="Use ORH As Entry Level", group=groupScalpLevels)
useOpeningRangeLowAsEntryLevel   = input.bool(true, title="Use ORL As Entry Level", group=groupScalpLevels)
showAutoScalpLevels              = input.bool(true, title="Show Auto/Effective Scalp Levels", group=groupScalpLevels)

// 05. Opening Range
showOpeningRange                 = input.bool(true, title="Show Opening Range", group=groupOpeningRange)
useManualOpeningRangeFallback    = input.bool(false, title="Use Manual Opening Range Fallback", group=groupOpeningRange)
manualOpeningRangeHigh           = input.float(0.0, title="Manual Opening Range High", step=0.25, group=groupOpeningRange)
manualOpeningRangeLow            = input.float(0.0, title="Manual Opening Range Low", step=0.25, group=groupOpeningRange)

// 06. Risk / Position Sizing
maxRiskDollars      = input.float(215.0, title="Max Risk Dollars", minval=0.0, step=10.0, group=groupRisk)
commissionRoundTrip = input.float(1.24, title="Commission Per Contract, Round Trip", minval=0.0, step=0.01, group=groupRisk)
useMaxContractCap   = input.bool(true, title="Use Max Contract Cap", group=groupRisk)
maxContracts        = input.int(20, title="Max Contracts", minval=1, group=groupRisk)

// 07. Target Settings
allowSignalExtremeHodLodTarget = input.bool(true, title="Allow Signal-Bar HOD/LOD Edge Target", group=groupTargets, tooltip="Allows HOD/LOD as the target when the signal bar itself made HOD/LOD and the entry is a 50% retracement, even if the R:R is slightly below 1:1 because the stop is one tick beyond the signal bar.")
hodLodEdgeToleranceTicks       = input.int(1, title="HOD/LOD Edge Tolerance Ticks", minval=0, maxval=4, group=groupTargets)
maxTrackedSwingTargets         = input.int(100, title="Max Tracked Swing Targets", minval=20, maxval=300, group=groupTargets)

// 08. Signal Engine Tuning
onlyHighVolumeSignals         = input.bool(false, title="Pressure: Only Show High-Volume Signals", group=groupSignalEngine, tooltip="When enabled, pressure bull/bear signals are shown only when volume is greater than the prior bar.")
maxLookback                   = input.int(20, title="Pressure: Max Lookback", group=groupSignalEngine, minval=3, tooltip="Maximum number of bars to scan backward when finding prior up/down legs for fallback midpoint checks.")
pressureBodyWickThreshold     = input.float(0.40, title="Pressure: Body/Wick Range Threshold", group=groupSignalEngine, minval=0.05, maxval=0.95, step=0.05, tooltip="Minimum fraction of the full bar range required for body or wick qualification in pressure bar quality checks (default 40%).")
acceptableVolumeThreshold     = input(0.33, title="Acceptable Volume Threshold", group=groupSignalEngine, tooltip="Set the minimum volume threshold as a multiple of the volume average (e.g., 0.33x volume average). Bars with volume below this threshold will not display indications.")
volumeMetricLength            = input.int(50, title="Volume SMA Length", group=groupSignalEngine, minval=10, maxval=500, tooltip="Set the length for the volume SMA calculation.")
acceptableVolatilityThreshold = input(0.33, title="Acceptable Volatility Threshold", group=groupSignalEngine, tooltip="Set the minimum volatility threshold as a multiple of the ATR (e.g., 0.5x ATR). Bars with volatility below this threshold will not display indications.")
atrLength                     = input(14, title="ATR Length", group=groupSignalEngine, tooltip="Set the length of the ATR calculation.")

// 09. Display / Visuals
showBullSignals              = input.bool(true, title="Show Bull Signals", group=groupDisplay, tooltip="Enable bullish pressure signal markers and signal-overlap indications.")
showBearSignals              = input.bool(true, title="Show Bear Signals", group=groupDisplay, tooltip="Enable bearish pressure signal markers and signal-overlap indications.")
showSetupSignals             = input.bool(true, title="Setup Signals (Circle)", group=groupDisplay, tooltip="Setup-quality bar, not standalone actionable. Best used with failed-breakout context to identify potential reversals.")
showIgnitionSignals          = input.bool(true, title="Ignition Signals (Triangle)", group=groupDisplay, tooltip="Actionable momentum signal that can stand on its own without requiring failed-breakout context.")
showStrongIgnitions          = input.bool(true, title="Strong Ignitions (Diamond)", group=groupDisplay, tooltip="Strongest ignition signal; same concept as Ignition but with higher bar quality/strength. Useful for bias shifts through key levels.")
showSignalLegend             = input.bool(false, title="Show Signal Legend", group=groupDisplay, tooltip="Display a small on-chart legend mapping shapes to signal tiers.")
alertLabelMode               = input.string("Compact", title="Historical Alert Labels", options=["Off", "Marker Only", "Compact"], group=groupDisplay)
showScalpSignalDetails       = input.bool(false, title="Show Scalp Signal Details", group=groupDisplay)

// 10. Debug / Advanced
showAutoThesisDebug    = input.bool(false, title="Show Auto Thesis Debug", group=groupDebug)
showDetailedLevelStatus = input.bool(false, title="Show Detailed Level Status", group=groupDebug)

scalpPointValue = tickerInput == "MES" ? 5.0 : 2.0
scalpTickSize   = 0.25

// ===================== Volume Calculations =====================
volumeSMA = ta.sma(volume, volumeMetricLength)
sufficientVolume = na(volume) ? true : volume > volumeSMA * acceptableVolumeThreshold

// ===================== Price Action Calculations =====================
body = math.abs(close - open)
bodyHigh = math.max(open, close)
bodyLow = math.min(open, close)
barRange = high - low
bodyPct = barRange > 0 ? body / barRange : 0.0
closeInUpperThird = barRange > 0 and close >= low + barRange * (2.0 / 3.0)
closeInLowerThird = barRange > 0 and close <= low + barRange * (1.0 / 3.0)
upperWick = high - bodyHigh
lowerWick = bodyLow - low

// ===================== Pressure Signal Helpers =====================
f_safeRange(_high, _low) =>
    _r = _high - _low
    _r > 0 ? _r : na

f_closeInUpperThird(_close, _low, _range) =>
    not na(_range) and _close >= _low + _range * (2.0 / 3.0)

f_closeInLowerThird(_close, _low, _range) =>
    not na(_range) and _close <= _low + _range * (1.0 / 3.0)

f_meetsPct(_value, _range, _pct) =>
    not na(_range) and _value >= _range * _pct

f_dobruskyPressure() =>
    gapUp   = close[1] < low  ? (low  - close[1]) : 0.0
    gapDown = close[1] > high ? (close[1] - high) : 0.0

    adjLow  = low  - gapUp
    adjHigh = high + gapDown
    rng     = adjHigh - adjLow

    buyPressure  = na(volume) ? na : (rng != 0 ? volume * (close - adjLow) / rng : na)
    sellPressure = volume - buyPressure
    [buyPressure, sellPressure]

f_midPriorLegDown(_maxLookback) =>
    int legStart = na
    bool hasSeq = false

    for i = 0 to _maxLookback - 1
        if na(high[i]) or na(high[i + 1])
            break
        if high[i] < high[i + 1] or (i == 0 and high[i] >= high[i + 1] and high[i + 1] < high[i + 2])
            hasSeq := true
            legStart := i + 1
        else
            break

    float legHigh = na 
    float legLow = na
    float mid = na

    if hasSeq and not na(legStart)
        for j = 0 to _maxLookback - 1
            if j <= legStart
                legLow := na(legLow) ? low[j] : math.min(legLow, low[j])
                if j == legStart
                    legHigh := high[j]
        mid := (legHigh + legLow) / 2.0

    [mid, legLow, legHigh]

f_midPriorLegUp(_maxLookback) =>
    int legStart = na
    bool hasSeq = false

    for i = 0 to _maxLookback - 1
        if na(low[i]) or na(low[i + 1])
            break
        if low[i] > low[i + 1] or (i == 0 and low[i] <= low[i + 1] and low[i + 1] > low[i + 2])
            hasSeq := true
            legStart := i + 1
        else
            break

    float legLow = na
    float legHigh = na
    float mid = na

    if hasSeq and not na(legStart)
        for j = 0 to _maxLookback - 1
            if j <= legStart
                legHigh := na(legHigh) ? high[j] : math.max(legHigh, high[j])
                if j == legStart
                    legLow := low[j]
        mid := (legHigh + legLow) / 2.0

    [mid, legLow, legHigh]

// ===================== Scalp Alert Helpers =====================
f_roundUpToScalpTick(_price) =>
    math.ceil(_price / scalpTickSize) * scalpTickSize

f_roundDownToScalpTick(_price) =>
    math.floor(_price / scalpTickSize) * scalpTickSize

f_initialThesisState(_initialThesis) =>
    _initialThesis == "Long" ? 1 : _initialThesis == "Short" ? -1 : 0

f_thesisText(_thesisState) =>
    _thesisState == 1 ? "LONG" : _thesisState == -1 ? "SHORT" : "NEUTRAL"

f_priceText(_price) =>
    na(_price) ? "N/A" : str.tostring(_price, format.mintick)

f_numberText(_value) =>
    na(_value) ? "N/A" : str.tostring(_value, "#.##")

f_pointsText(_value) =>
    na(_value) ? "N/A" : str.tostring(_value, "#.00")

f_rrText(_rr) =>
    na(_rr) ? "N/A" : str.tostring(_rr, "#.00") + "R"

f_boolText(_condition) =>
    _condition ? "true" : "false"

f_tickCount(_value) =>
    int(math.round(_value / scalpTickSize))

f_roundToScalpTick(_price) =>
    math.round(_price / scalpTickSize) * scalpTickSize

f_validSourcePrice(_price) =>
    not na(_price) and _price > 0

f_autoCandidateQualifies(float _price, float _sourceOpen, float _threshold) =>
    f_validSourcePrice(_price) and f_validSourcePrice(_sourceOpen) and not na(_threshold) and _threshold >= 0 and math.abs(_price - _sourceOpen) <= _threshold

f_pickAutoThesisCandidate(float _candidatePrice, string _candidateName, int _candidatePriority, float _sourceOpen, float _threshold, float _bestPrice, string _bestName, int _bestPriority, float _bestDistance) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    float nextDistance = _bestDistance
    if f_autoCandidateQualifies(_candidatePrice, _sourceOpen, _threshold)
        float candidateDistance = math.abs(_candidatePrice - _sourceOpen)
        bool betterCandidate = na(nextPrice) or _candidatePriority < nextPriority or (_candidatePriority == nextPriority and (na(nextDistance) or candidateDistance < nextDistance))
        if betterCandidate
            nextPrice := _candidatePrice
            nextName := _candidateName
            nextPriority := _candidatePriority
            nextDistance := candidateDistance
    [nextPrice, nextName, nextPriority, nextDistance]

f_currentRthOpen() =>
    var float rthOpen = na
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    int dateKey = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
    int priorDateKey = bar_index > 0 ? dateKey[1] : dateKey
    bool wasInRth = bar_index > 0 ? inRth[1] : false
    bool newRth = inRth and (not wasInRth or dateKey != priorDateKey)
    if newRth
        rthOpen := open
    else if not inRth and dateKey != priorDateKey
        rthOpen := na
    rthOpen

getHighLowOpenClose() =>
    [high[1], low[1], open, close[1]]

getHigherTimeframeData(_timeframe, _ticker) =>
    // Mirrors the PA Engine level request: previous completed H/L/C plus current HTF open.
    request.security(_ticker, _timeframe, getHighLowOpenClose(), lookahead=barmerge.lookahead_on, calc_bars_count=2)

getGaps(_lookBack) =>
    map<int, string> gapsDict = map.new<int, string>()
    i = _lookBack
    float atrSumForGaps = 0.0
    while i >= 0
        dailyOpen = open[i]
        dailyLow = low[i]
        dailyHigh = high[i]
        prevClose = close[i + 1]
        if i < atrLength
            atrSumForGaps := atrSumForGaps + math.max(dailyHigh - dailyLow, math.max(math.abs(dailyHigh - prevClose), math.abs(dailyLow - prevClose)))
        if dailyOpen != prevClose
            gapHigh = str.tostring(math.max(dailyOpen, prevClose))
            gapLow = str.tostring(math.min(dailyOpen, prevClose))
            isGapUp = dailyOpen > prevClose
            dir = isGapUp ? "U" : "D"
            gapsDict.put(time[i], dir + "|" + gapHigh + "," + gapLow + ":" + gapHigh + "," + gapLow)

        keysToRemove = array.new_int(0)
        if not barstate.isrealtime[i]
            for [key, value] in gapsDict
                gapOriginalAndPartial = str.split(value, ":")
                partialGapHighAndLow = str.split(array.get(gapOriginalAndPartial, 1), ",")
                partialGapHigh = str.tonumber(array.get(partialGapHighAndLow, 0))
                partialGapLow = str.tonumber(array.get(partialGapHighAndLow, 1))
                if dailyLow <= partialGapLow and dailyHigh >= partialGapHigh
                    array.push(keysToRemove, key)
                else
                    if dailyLow > partialGapLow and dailyLow < partialGapHigh
                        partialGapHigh := dailyLow
                        gapsDict.put(key, array.get(gapOriginalAndPartial, 0) + ":" + str.tostring(partialGapHigh) + "," + str.tostring(partialGapLow))
                    if dailyHigh < partialGapHigh and dailyHigh > partialGapLow
                        partialGapLow := dailyHigh
                        gapsDict.put(key, array.get(gapOriginalAndPartial, 0) + ":" + str.tostring(partialGapHigh) + "," + str.tostring(partialGapLow))
        for key in keysToRemove
            gapsDict.remove(key)
        i := i - 1
    keysToRemove = array.new_int(0)
    atrForGaps = atrSumForGaps / atrLength
    for [key, value] in gapsDict
        gapOriginalAndPartial = str.split(value, ":")
        partialGapHighAndLow = str.split(array.get(gapOriginalAndPartial, 1), ",")
        gapSize = math.abs(str.tonumber(array.get(partialGapHighAndLow, 0)) - str.tonumber(array.get(partialGapHighAndLow, 1)))
        if gapSize < atrForGaps * 0.1
            array.push(keysToRemove, key)
    for key in keysToRemove
        gapsDict.remove(key)
    gapsDict

f_gapEndPriceFromRecord(string _gapRecord) =>
    float gapEndPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh = str.tonumber(array.get(gapHighAndLow, 0))
                gapLow = str.tonumber(array.get(gapHighAndLow, 1))
                // Gap end = prior-close side of the gap.
                // Gap up: low side. Gap down: high side.
                gapEndPrice := dir == "U" ? gapLow : gapHigh
    gapEndPrice

f_isBullBar(_open, _close) =>
    not na(_open) and not na(_close) and _close > _open

f_isBearBar(_open, _close) =>
    not na(_open) and not na(_close) and _close < _open

f_bullUpperThirdBar(_open, _high, _low, _close) =>
    _range = f_safeRange(_high, _low)
    f_isBullBar(_open, _close) and f_closeInUpperThird(_close, _low, _range)

f_bearLowerThirdBar(_open, _high, _low, _close) =>
    _range = f_safeRange(_high, _low)
    f_isBearBar(_open, _close) and f_closeInLowerThird(_close, _low, _range)

f_levelTouched(bool _enabled, float _levelPrice, float _signalLow, float _signalHigh) =>
    _enabled and _levelPrice > 0 and _levelPrice >= _signalLow and _levelPrice <= _signalHigh

f_pickLongTouchedLevel(bool _enabled, float _levelPrice, string _levelName, float _signalLow, float _signalHigh, float _bestPrice, string _bestName) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    if f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh) and (na(nextPrice) or _levelPrice > nextPrice)
        nextPrice := _levelPrice
        nextName := _levelName
    [nextPrice, nextName]

f_pickShortTouchedLevel(bool _enabled, float _levelPrice, string _levelName, float _signalLow, float _signalHigh, float _bestPrice, string _bestName) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    if f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh) and (na(nextPrice) or _levelPrice < nextPrice)
        nextPrice := _levelPrice
        nextName := _levelName
    [nextPrice, nextName]

f_targetRRLong(float _targetPrice, float _entryPrice, float _riskPoints) =>
    float rewardPoints = _targetPrice - _entryPrice
    not na(_targetPrice) and not na(_entryPrice) and not na(_riskPoints) and rewardPoints > 0 and _riskPoints > 0 ? rewardPoints / _riskPoints : na

f_targetRRShort(float _targetPrice, float _entryPrice, float _riskPoints) =>
    float rewardPoints = _entryPrice - _targetPrice
    not na(_targetPrice) and not na(_entryPrice) and not na(_riskPoints) and rewardPoints > 0 and _riskPoints > 0 ? rewardPoints / _riskPoints : na

f_longHodEdgeQualifies(float _targetPrice, string _targetType, string _entryType, float _signalHigh, float _entryPrice, float _riskPoints, float _currentRTHHigh) =>
    float rewardPoints = _targetPrice - _entryPrice
    bool signalMadeHOD = not na(_currentRTHHigh) and not na(_signalHigh) and (_currentRTHHigh == _signalHigh or math.abs(_currentRTHHigh - _signalHigh) <= scalpTickSize * 0.1)
    bool edgeWithinTolerance = not na(_riskPoints) and not na(rewardPoints) and _riskPoints > 0 and _riskPoints - rewardPoints <= scalpTickSize * hodLodEdgeToleranceTicks + scalpTickSize * 0.1
    allowSignalExtremeHodLodTarget and _targetType == "HOD" and _entryType == "50%" and signalMadeHOD and rewardPoints > 0 and edgeWithinTolerance

f_shortLodEdgeQualifies(float _targetPrice, string _targetType, string _entryType, float _signalLow, float _entryPrice, float _riskPoints, float _currentRTHLow) =>
    float rewardPoints = _entryPrice - _targetPrice
    bool signalMadeLOD = not na(_currentRTHLow) and not na(_signalLow) and (_currentRTHLow == _signalLow or math.abs(_currentRTHLow - _signalLow) <= scalpTickSize * 0.1)
    bool edgeWithinTolerance = not na(_riskPoints) and not na(rewardPoints) and _riskPoints > 0 and _riskPoints - rewardPoints <= scalpTickSize * hodLodEdgeToleranceTicks + scalpTickSize * 0.1
    allowSignalExtremeHodLodTarget and _targetType == "LOD" and _entryType == "50%" and signalMadeLOD and rewardPoints > 0 and edgeWithinTolerance

f_longTargetQualifies(float _targetPrice, string _targetType, string _entryType, float _signalHigh, float _entryPrice, float _riskPoints, float _currentRTHHigh) =>
    bool priceReady = not na(_targetPrice) and _targetPrice > 0
    bool locationOk = priceReady and (_targetType == "HOD" ? _targetPrice >= _signalHigh : _targetPrice > _signalHigh)
    float rr = f_targetRRLong(_targetPrice, _entryPrice, _riskPoints)
    bool normalTargetOk = locationOk and not na(rr) and rr >= minTargetRR
    bool edgeTargetOk = locationOk and f_longHodEdgeQualifies(_targetPrice, _targetType, _entryType, _signalHigh, _entryPrice, _riskPoints, _currentRTHHigh)
    normalTargetOk or edgeTargetOk

f_shortTargetQualifies(float _targetPrice, string _targetType, string _entryType, float _signalLow, float _entryPrice, float _riskPoints, float _currentRTHLow) =>
    bool priceReady = not na(_targetPrice) and _targetPrice > 0
    bool locationOk = priceReady and (_targetType == "LOD" ? _targetPrice <= _signalLow : _targetPrice < _signalLow)
    float rr = f_targetRRShort(_targetPrice, _entryPrice, _riskPoints)
    bool normalTargetOk = locationOk and not na(rr) and rr >= minTargetRR
    bool edgeTargetOk = locationOk and f_shortLodEdgeQualifies(_targetPrice, _targetType, _entryType, _signalLow, _entryPrice, _riskPoints, _currentRTHLow)
    normalTargetOk or edgeTargetOk

f_pickLongTargetCandidate(bool _enabled, float _candidatePrice, string _candidateType, float _signalHigh, string _entryType, float _entryPrice, float _riskPoints, float _currentRTHHigh, float _bestPrice, string _bestType, float _bestRR) =>
    float nextPrice = _bestPrice
    string nextType = _bestType
    float nextRR = _bestRR
    if _enabled and f_longTargetQualifies(_candidatePrice, _candidateType, _entryType, _signalHigh, _entryPrice, _riskPoints, _currentRTHHigh) and (na(nextPrice) or _candidatePrice < nextPrice)
        nextPrice := _candidatePrice
        nextType := _candidateType
        nextRR := f_targetRRLong(_candidatePrice, _entryPrice, _riskPoints)
    [nextPrice, nextType, nextRR]

f_pickShortTargetCandidate(bool _enabled, float _candidatePrice, string _candidateType, float _signalLow, string _entryType, float _entryPrice, float _riskPoints, float _currentRTHLow, float _bestPrice, string _bestType, float _bestRR) =>
    float nextPrice = _bestPrice
    string nextType = _bestType
    float nextRR = _bestRR
    if _enabled and f_shortTargetQualifies(_candidatePrice, _candidateType, _entryType, _signalLow, _entryPrice, _riskPoints, _currentRTHLow) and (na(nextPrice) or _candidatePrice > nextPrice)
        nextPrice := _candidatePrice
        nextType := _candidateType
        nextRR := f_targetRRShort(_candidatePrice, _entryPrice, _riskPoints)
    [nextPrice, nextType, nextRR]

f_swingTargetSessionAllowed(string _session, int _dateKey, int _currentDateKey, int _currentRTHDateKey, int _previousRTHDateKey) =>
    (_session == "PM" and _dateKey == _currentDateKey) or (_session == "RTH" and (_dateKey == _currentRTHDateKey or _dateKey == _previousRTHDateKey))

// ===================== ATR Calculation (RTH only) =====================
var float atrSum = 0.0
var trArray = array.new_float(0)
isRTH = time(timeframe.period, "0930-1600:23456", "America/New_York") != 0 or timeframe.isdwm
trValue = ta.tr(true)
atrValue = 0.0
if isRTH
    atrSum += trValue
    array.push(trArray, trValue)
    if array.size(trArray) > atrLength
        removed = array.shift(trArray)
        atrSum -= removed
    atrValue := atrSum / array.size(trArray)
else
    atrValue := nz(atrValue[1])

sufficientVolatility = barRange >= atrValue * acceptableVolatilityThreshold

// ===================== RTH / Opening Range Logic =====================
scalpRTHTime = time(timeframe.period, "0930-1600:23456", "America/New_York")
openingRangeTime = time(timeframe.period, "0930-0945:23456", "America/New_York")
premarketTime = time(timeframe.period, "0400-0930:23456", "America/New_York")
inScalpRTHSession = not na(scalpRTHTime)
inPremarketSession = not na(premarketTime)
inOpeningRangeWindow = inScalpRTHSession and not na(openingRangeTime)
nySessionDateKey = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
priorNYSessionDateKey = bar_index > 0 ? nySessionDateKey[1] : nySessionDateKey
wasInScalpRTHSession = bar_index > 0 ? inScalpRTHSession[1] : false
wasInPremarketSession = bar_index > 0 ? inPremarketSession[1] : false
newNYSessionDate = bar_index > 0 and nySessionDateKey != priorNYSessionDateKey
newScalpRTHSession = inScalpRTHSession and (not wasInScalpRTHSession or nySessionDateKey != priorNYSessionDateKey)
newPremarketSession = inPremarketSession and (not wasInPremarketSession or nySessionDateKey != priorNYSessionDateKey)

// Auto scalp levels are intended for intraday charts, ideally 5m.
var float currentRTHHigh = na
var float currentRTHLow = na
var float autoPrevDayHigh = na
var float autoPrevDayLow = na
var float autoDailyOpen = na
var float autoPremarketHigh = na
var float autoPremarketLow = na
var float finalizedPremarketHigh = na
var float finalizedPremarketLow = na
var int autoPremarketDateKey = na
var int currentRTHDateKey = na
var int previousRTHDateKey = na
var array<float> swingHighPrices = array.new_float(0)
var array<int> swingHighPivotBars = array.new_int(0)
var array<int> swingHighDateKeys = array.new_int(0)
var array<string> swingHighSessions = array.new_string(0)
var array<bool> swingHighActive = array.new_bool(0)
var array<float> swingLowPrices = array.new_float(0)
var array<int> swingLowPivotBars = array.new_int(0)
var array<int> swingLowDateKeys = array.new_int(0)
var array<string> swingLowSessions = array.new_string(0)
var array<bool> swingLowActive = array.new_bool(0)

if newNYSessionDate and not inScalpRTHSession and not inPremarketSession
    autoDailyOpen := na
    finalizedPremarketHigh := na
    finalizedPremarketLow := na

if newPremarketSession
    autoPremarketHigh := high
    autoPremarketLow := low
    autoDailyOpen := na
    finalizedPremarketHigh := na
    finalizedPremarketLow := na
    autoPremarketDateKey := nySessionDateKey
else if inPremarketSession
    autoPremarketHigh := na(autoPremarketHigh) ? high : math.max(autoPremarketHigh, high)
    autoPremarketLow := na(autoPremarketLow) ? low : math.min(autoPremarketLow, low)
    autoPremarketDateKey := nySessionDateKey

if newScalpRTHSession
    if not na(currentRTHDateKey)
        previousRTHDateKey := currentRTHDateKey
    currentRTHDateKey := nySessionDateKey
    autoPrevDayHigh := currentRTHHigh
    autoPrevDayLow := currentRTHLow
    currentRTHHigh := high
    currentRTHLow := low
    autoDailyOpen := open
    currentPremarketReady = autoPremarketDateKey == nySessionDateKey and not na(autoPremarketHigh) and not na(autoPremarketLow)
    finalizedPremarketHigh := currentPremarketReady ? autoPremarketHigh : na
    finalizedPremarketLow := currentPremarketReady ? autoPremarketLow : na
else if inScalpRTHSession
    currentRTHHigh := na(currentRTHHigh) ? high : math.max(currentRTHHigh, high)
    currentRTHLow := na(currentRTHLow) ? low : math.min(currentRTHLow, low)

effectivePrevDayHigh = useAutoPrevDayHighLow and not na(autoPrevDayHigh) ? autoPrevDayHigh : prevDayHighLevel
effectivePrevDayLow = useAutoPrevDayHighLow and not na(autoPrevDayLow) ? autoPrevDayLow : prevDayLowLevel
effectiveDailyOpen = useAutoDailyOpen and not na(autoDailyOpen) ? autoDailyOpen : dailyOpenLevel
effectivePremarketHigh = useAutoPremarketHighLow and not na(finalizedPremarketHigh) ? finalizedPremarketHigh : premarketHighLevel
effectivePremarketLow = useAutoPremarketHighLow and not na(finalizedPremarketLow) ? finalizedPremarketLow : premarketLowLevel

prevDayHighLowSource = useAutoPrevDayHighLow ? (not na(autoPrevDayHigh) and not na(autoPrevDayLow) ? "Auto" : "Manual Fallback") : "Manual"
dailyOpenSource = useAutoDailyOpen ? (not na(autoDailyOpen) ? "Auto" : "Manual Fallback") : "Manual"
premarketSource = useAutoPremarketHighLow ? (not na(finalizedPremarketHigh) and not na(finalizedPremarketLow) ? "Auto" : "Manual Fallback") : "Manual"

// ===================== Auto Thesis Source Levels =====================
int autoThesisGapLookback = 200
// MES defaults to AMEX:SPY. TradingView alerts may require real-time entitlement
// for the exact feed used by request.security(), even if it appears usable on charts.
autoDefaultThesisSourceSymbol = tickerInput == "MES" ? "AMEX:SPY" : "NASDAQ:QQQ"
autoDefaultThesisSourceTicker = tickerInput == "MES" ? ticker.new("AMEX", "SPY", "us_regular:23456") : ticker.new("NASDAQ", "QQQ", "us_regular:23456")
thesisSourceSymbol = useAutoThesis ? (thesisSourceMode == "Manual Source" ? manualThesisSourceSymbol : autoDefaultThesisSourceSymbol) : "None"
thesisSourceTicker = useAutoThesis ? (thesisSourceMode == "Manual Source" ? manualThesisSourceSymbol : autoDefaultThesisSourceTicker) : ""
requestedThesisSourceSymbol = useAutoThesis ? thesisSourceSymbol : "None"

// The HTF requests intentionally mirror the PA Engine approach: previous completed
// H/L/C plus the current period open are requested with lookahead_on.
float sourcePrevDayHigh = na
float sourcePrevDayLow = na
float sourceDayOpenHTF = na
float sourcePrevDayClose = na
float sourcePrevWeekHigh = na
float sourcePrevWeekLow = na
float sourceWeekOpen = na
float sourcePrevWeekClose = na
float sourcePrevMonthHigh = na
float sourcePrevMonthLow = na
float sourceMonthOpen = na
float sourcePrevMonthClose = na
float sourceDayOpenIntraday = na
float sourceDayOpen = na
float source1hRthAtr = na
float sourceCloseForConversion = na
map<int, string> sourceDailyGaps = na

if useAutoThesis
    [requestedPrevDayHigh, requestedPrevDayLow, requestedDayOpenHTF, requestedPrevDayClose] = getHigherTimeframeData("1440", thesisSourceTicker)
    [requestedPrevWeekHigh, requestedPrevWeekLow, requestedWeekOpen, requestedPrevWeekClose] = getHigherTimeframeData("W", thesisSourceTicker)
    [requestedPrevMonthHigh, requestedPrevMonthLow, requestedMonthOpen, requestedPrevMonthClose] = getHigherTimeframeData("M", thesisSourceTicker)
    sourcePrevDayHigh := requestedPrevDayHigh
    sourcePrevDayLow := requestedPrevDayLow
    sourceDayOpenHTF := requestedDayOpenHTF
    sourcePrevDayClose := requestedPrevDayClose
    sourcePrevWeekHigh := requestedPrevWeekHigh
    sourcePrevWeekLow := requestedPrevWeekLow
    sourceWeekOpen := requestedWeekOpen
    sourcePrevWeekClose := requestedPrevWeekClose
    sourcePrevMonthHigh := requestedPrevMonthHigh
    sourcePrevMonthLow := requestedPrevMonthLow
    sourceMonthOpen := requestedMonthOpen
    sourcePrevMonthClose := requestedPrevMonthClose
    sourceDayOpenIntraday := request.security(thesisSourceTicker, "5", f_currentRthOpen(), lookahead=barmerge.lookahead_off, calc_bars_count=500)
    sourceDayOpen := f_validSourcePrice(sourceDayOpenHTF) ? sourceDayOpenHTF : sourceDayOpenIntraday
    source1hRthAtr := request.security(thesisSourceTicker, "60", ta.atr(atrLength), lookahead=barmerge.lookahead_off, calc_bars_count=500)
    sourceCloseForConversion := request.security(thesisSourceTicker, timeframe.period, close, lookahead=barmerge.lookahead_off, calc_bars_count=2)
    if includeDailyGapsInAutoThesis
        sourceDailyGaps := request.security(thesisSourceTicker, "1440", getGaps(autoThesisGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=202)

float sourceGapEndPrice = na
float sourceGapEndDistance = na
if useAutoThesis and includeDailyGapsInAutoThesis and f_validSourcePrice(sourceDayOpen) and not na(sourceDailyGaps)
    for [sourceGapKey, sourceGapValue] in sourceDailyGaps
        float gapEndCandidate = f_gapEndPriceFromRecord(sourceGapValue)
        if f_validSourcePrice(gapEndCandidate)
            float gapEndDistance = math.abs(gapEndCandidate - sourceDayOpen)
            if na(sourceGapEndDistance) or gapEndDistance < sourceGapEndDistance
                sourceGapEndPrice := gapEndCandidate
                sourceGapEndDistance := gapEndDistance

sourceAtrThreshold = f_validSourcePrice(source1hRthAtr) ? source1hRthAtr * autoThesisAtrMultiplier : na
float noAutoThesisCandidatePrice = na
string noAutoThesisCandidateName = "N/A"
int noAutoThesisCandidatePriority = 999
float noAutoThesisCandidateDistance = na

[autoAfterLMHPrice, autoAfterLMHName, autoAfterLMHPriority, autoAfterLMHDistance] = f_pickAutoThesisCandidate(sourcePrevMonthHigh, "Last Month High", 1, sourceDayOpen, sourceAtrThreshold, noAutoThesisCandidatePrice, noAutoThesisCandidateName, noAutoThesisCandidatePriority, noAutoThesisCandidateDistance)
[autoAfterLMLPrice, autoAfterLMLName, autoAfterLMLPriority, autoAfterLMLDistance] = f_pickAutoThesisCandidate(sourcePrevMonthLow, "Last Month Low", 1, sourceDayOpen, sourceAtrThreshold, autoAfterLMHPrice, autoAfterLMHName, autoAfterLMHPriority, autoAfterLMHDistance)
[autoAfterMonthOpenPrice, autoAfterMonthOpenName, autoAfterMonthOpenPriority, autoAfterMonthOpenDistance] = f_pickAutoThesisCandidate(sourceMonthOpen, "Monthly Open", 2, sourceDayOpen, sourceAtrThreshold, autoAfterLMLPrice, autoAfterLMLName, autoAfterLMLPriority, autoAfterLMLDistance)
[autoAfterLWHPrice, autoAfterLWHName, autoAfterLWHPriority, autoAfterLWHDistance] = f_pickAutoThesisCandidate(sourcePrevWeekHigh, "Last Week High", 3, sourceDayOpen, sourceAtrThreshold, autoAfterMonthOpenPrice, autoAfterMonthOpenName, autoAfterMonthOpenPriority, autoAfterMonthOpenDistance)
[autoAfterLWLPrice, autoAfterLWLName, autoAfterLWLPriority, autoAfterLWLDistance] = f_pickAutoThesisCandidate(sourcePrevWeekLow, "Last Week Low", 3, sourceDayOpen, sourceAtrThreshold, autoAfterLWHPrice, autoAfterLWHName, autoAfterLWHPriority, autoAfterLWHDistance)
[autoAfterWeekOpenPrice, autoAfterWeekOpenName, autoAfterWeekOpenPriority, autoAfterWeekOpenDistance] = f_pickAutoThesisCandidate(sourceWeekOpen, "Weekly Open", 4, sourceDayOpen, sourceAtrThreshold, autoAfterLWLPrice, autoAfterLWLName, autoAfterLWLPriority, autoAfterLWLDistance)
[autoAfterLDHPrice, autoAfterLDHName, autoAfterLDHPriority, autoAfterLDHDistance] = f_pickAutoThesisCandidate(sourcePrevDayHigh, "Last Day High", 5, sourceDayOpen, sourceAtrThreshold, autoAfterWeekOpenPrice, autoAfterWeekOpenName, autoAfterWeekOpenPriority, autoAfterWeekOpenDistance)
[autoAfterLDLPrice, autoAfterLDLName, autoAfterLDLPriority, autoAfterLDLDistance] = f_pickAutoThesisCandidate(sourcePrevDayLow, "Last Day Low", 5, sourceDayOpen, sourceAtrThreshold, autoAfterLDHPrice, autoAfterLDHName, autoAfterLDHPriority, autoAfterLDHDistance)
// Daily gap starts are intentionally excluded from auto-thesis selection.
[autoAfterGapEndPrice, autoAfterGapEndName, autoAfterGapEndPriority, autoAfterGapEndDistance] = f_pickAutoThesisCandidate(sourceGapEndPrice, "Gap End", 6, sourceDayOpen, sourceAtrThreshold, autoAfterLDLPrice, autoAfterLDLName, autoAfterLDLPriority, autoAfterLDLDistance)

autoHigherPriorityThesisFound = not na(autoAfterGapEndPrice)
selectedAutoThesisSourcePrice = autoHigherPriorityThesisFound ? autoAfterGapEndPrice : sourceDayOpen
selectedAutoThesisName = autoHigherPriorityThesisFound ? autoAfterGapEndName : "Daily Open"
selectedAutoThesisPriority = autoHigherPriorityThesisFound ? autoAfterGapEndPriority : 8
selectedAutoThesisDistance = autoHigherPriorityThesisFound ? autoAfterGapEndDistance : 0.0
selectedAutoThesisAtrThreshold = sourceAtrThreshold
autoThesisSelectionValid = f_validSourcePrice(selectedAutoThesisSourcePrice) and f_validSourcePrice(sourceDayOpen) and not na(selectedAutoThesisAtrThreshold)
autoThesisUsedDailyOpenDefault = autoThesisSelectionValid and not autoHigherPriorityThesisFound

chartDailyOpenForThesis = f_validSourcePrice(autoDailyOpen) ? autoDailyOpen : f_validSourcePrice(effectiveDailyOpen) ? effectiveDailyOpen : na
rthOpenRatioConverted = autoThesisSelectionValid and f_validSourcePrice(autoDailyOpen) and f_validSourcePrice(sourceDayOpen) ? selectedAutoThesisSourcePrice * (autoDailyOpen / sourceDayOpen) : na
currentPriceRatioConverted = autoThesisSelectionValid and f_validSourcePrice(close) and f_validSourcePrice(sourceCloseForConversion) ? selectedAutoThesisSourcePrice * (close / sourceCloseForConversion) : na
anchoredRthRatioConverted = autoThesisSelectionValid and f_validSourcePrice(autoDailyOpen) and f_validSourcePrice(sourceDayOpen) ? autoDailyOpen + (selectedAutoThesisSourcePrice - sourceDayOpen) * (autoDailyOpen / sourceDayOpen) : na
convertedAutoThesisByMode = thesisConversionMode == "Anchored RTH Ratio" ? anchoredRthRatioConverted : thesisConversionMode == "RTH Open Ratio" ? rthOpenRatioConverted : currentPriceRatioConverted
autoThesisUsesChartDailyOpen = selectedAutoThesisName == "Daily Open" and f_validSourcePrice(chartDailyOpenForThesis)
convertedAutoThesisRaw = useAutoThesis and autoThesisSelectionValid ? (autoThesisUsesChartDailyOpen ? chartDailyOpenForThesis : convertedAutoThesisByMode) : na
convertedAutoThesisLevel = f_validSourcePrice(convertedAutoThesisRaw) ? f_roundToScalpTick(convertedAutoThesisRaw) : na
autoThesisConvertedValid = f_validSourcePrice(convertedAutoThesisLevel)
autoThesisConversionMethod = useAutoThesis and autoThesisSelectionValid ? (autoThesisUsesChartDailyOpen ? "Chart RTH Open" : thesisConversionMode) : "N/A"
autoThesisNeedsChartRthOpen = not autoThesisUsesChartDailyOpen and (thesisConversionMode == "Anchored RTH Ratio" or thesisConversionMode == "RTH Open Ratio")
autoThesisNeedsSourceClose = not autoThesisUsesChartDailyOpen and thesisConversionMode == "Current Price Ratio"
autoThesisUnavailableReason = not useAutoThesis ? "Auto disabled" : not f_validSourcePrice(sourceDayOpen) ? "No source daily open" : not f_validSourcePrice(source1hRthAtr) ? "No source ATR" : not autoThesisSelectionValid ? "No source selection" : autoThesisNeedsChartRthOpen and not f_validSourcePrice(autoDailyOpen) ? "No chart RTH open" : autoThesisNeedsSourceClose and not f_validSourcePrice(sourceCloseForConversion) ? "No source close" : not autoThesisConvertedValid ? "Conversion invalid" : "Auto ready"

float effectiveThesisLevel = na
string effectiveThesisSource = "Unavailable"
string effectiveThesisName = "N/A"
string effectiveThesisSourceSymbol = "N/A"
float effectiveThesisSourcePrice = na
bool effectiveThesisIsAuto = false

if useAutoThesis and autoThesisConvertedValid
    effectiveThesisLevel := convertedAutoThesisLevel
    effectiveThesisSource := "Auto"
    effectiveThesisName := selectedAutoThesisName
    effectiveThesisSourceSymbol := thesisSourceSymbol
    effectiveThesisSourcePrice := selectedAutoThesisSourcePrice
    effectiveThesisIsAuto := true
else if useAutoThesis and autoThesisFallbackToManual and thesisLevel > 0
    effectiveThesisLevel := thesisLevel
    effectiveThesisSource := "Manual Fallback"
    effectiveThesisName := "Manual"
    effectiveThesisSourceSymbol := "N/A"
    effectiveThesisSourcePrice := na
    effectiveThesisIsAuto := false
else if not useAutoThesis and thesisLevel > 0
    effectiveThesisLevel := thesisLevel
    effectiveThesisSource := "Manual"
    effectiveThesisName := "Manual"
    effectiveThesisSourceSymbol := "N/A"
    effectiveThesisSourcePrice := na
    effectiveThesisIsAuto := false

var float autoOpeningRangeHigh = na
var float autoOpeningRangeLow = na
var bool openingRangeComplete = false
var bool openingRangeHasBroken = false
var string openingRangeBreakDirection = "None"

if newScalpRTHSession
    autoOpeningRangeHigh := na
    autoOpeningRangeLow := na
    openingRangeComplete := false
    openingRangeHasBroken := false
    openingRangeBreakDirection := "None"

if inOpeningRangeWindow
    autoOpeningRangeHigh := na(autoOpeningRangeHigh) ? high : math.max(autoOpeningRangeHigh, high)
    autoOpeningRangeLow := na(autoOpeningRangeLow) ? low : math.min(autoOpeningRangeLow, low)

if inScalpRTHSession and not inOpeningRangeWindow and not openingRangeComplete and not na(autoOpeningRangeHigh) and not na(autoOpeningRangeLow)
    openingRangeComplete := true

openingRangeHigh = useManualOpeningRangeFallback and manualOpeningRangeHigh > 0 ? manualOpeningRangeHigh : autoOpeningRangeHigh
openingRangeLow = useManualOpeningRangeFallback and manualOpeningRangeLow > 0 ? manualOpeningRangeLow : autoOpeningRangeLow
openingRangeReady = not na(openingRangeHigh) and not na(openingRangeLow)
openingRangeLevelsReady = openingRangeReady and (useManualOpeningRangeFallback or openingRangeComplete)
openingRangeDisplayHigh = openingRangeLevelsReady ? openingRangeHigh : na
openingRangeDisplayLow = openingRangeLevelsReady ? openingRangeLow : na

if barstate.isconfirmed and inScalpRTHSession and openingRangeLevelsReady and not inOpeningRangeWindow
    if not openingRangeHasBroken and close > openingRangeHigh
        openingRangeHasBroken := true
        openingRangeBreakDirection := "First Break Up"
    else if not openingRangeHasBroken and close < openingRangeLow
        openingRangeHasBroken := true
        openingRangeBreakDirection := "First Break Down"

first15FilterAllowsAlerts = not waitFirst15Minutes or (inScalpRTHSession and not inOpeningRangeWindow)

openingRangeAllowsAlerts = not requireOpeningRangeBreak or openingRangeHasBroken

openingRangeStatus = not openingRangeLevelsReady ? "WAITING" : openingRangeHasBroken ? "BROKEN - " + openingRangeBreakDirection : "WAITING FOR ANY BREAK"

// ===================== Untested 5m Swing Target Tracking =====================
int activeCurrentRTHDateKey = inScalpRTHSession ? currentRTHDateKey : na
int activePreviousRTHDateKey = inScalpRTHSession ? previousRTHDateKey : currentRTHDateKey

if newPremarketSession or newScalpRTHSession
    int pruneHighIndex = array.size(swingHighPrices) - 1
    while pruneHighIndex >= 0
        string highSwingSession = array.get(swingHighSessions, pruneHighIndex)
        int highSwingDateKey = array.get(swingHighDateKeys, pruneHighIndex)
        bool keepHighSwing = f_swingTargetSessionAllowed(highSwingSession, highSwingDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepHighSwing
            array.remove(swingHighPrices, pruneHighIndex)
            array.remove(swingHighPivotBars, pruneHighIndex)
            array.remove(swingHighDateKeys, pruneHighIndex)
            array.remove(swingHighSessions, pruneHighIndex)
            array.remove(swingHighActive, pruneHighIndex)
        pruneHighIndex -= 1

    int pruneLowIndex = array.size(swingLowPrices) - 1
    while pruneLowIndex >= 0
        string lowSwingSession = array.get(swingLowSessions, pruneLowIndex)
        int lowSwingDateKey = array.get(swingLowDateKeys, pruneLowIndex)
        bool keepLowSwing = f_swingTargetSessionAllowed(lowSwingSession, lowSwingDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepLowSwing
            array.remove(swingLowPrices, pruneLowIndex)
            array.remove(swingLowPivotBars, pruneLowIndex)
            array.remove(swingLowDateKeys, pruneLowIndex)
            array.remove(swingLowSessions, pruneLowIndex)
            array.remove(swingLowActive, pruneLowIndex)
        pruneLowIndex -= 1

if barstate.isconfirmed
    int testHighIndex = 0
    while testHighIndex < array.size(swingHighPrices)
        if array.get(swingHighActive, testHighIndex) and bar_index > array.get(swingHighPivotBars, testHighIndex) and high >= array.get(swingHighPrices, testHighIndex)
            array.set(swingHighActive, testHighIndex, false)
        testHighIndex += 1

    int testLowIndex = 0
    while testLowIndex < array.size(swingLowPrices)
        if array.get(swingLowActive, testLowIndex) and bar_index > array.get(swingLowPivotBars, testLowIndex) and low <= array.get(swingLowPrices, testLowIndex)
            array.set(swingLowActive, testLowIndex, false)
        testLowIndex += 1

if barstate.isconfirmed and bar_index >= 4
    bool confirmedSwingHigh = high[2] > high[1] and high[2] > high and high[2] > high[3] and high[2] > high[4]
    bool confirmedSwingLow = low[2] < low[1] and low[2] < low and low[2] < low[3] and low[2] < low[4]
    string pivotSession = inPremarketSession[2] ? "PM" : inScalpRTHSession[2] ? "RTH" : "N/A"
    int pivotDateKey = nySessionDateKey[2]
    bool pivotSessionAllowed = pivotSession == "PM" or pivotSession == "RTH"

    if pivotSessionAllowed and confirmedSwingHigh
        array.push(swingHighPrices, high[2])
        array.push(swingHighPivotBars, bar_index - 2)
        array.push(swingHighDateKeys, pivotDateKey)
        array.push(swingHighSessions, pivotSession)
        array.push(swingHighActive, true)

    if pivotSessionAllowed and confirmedSwingLow
        array.push(swingLowPrices, low[2])
        array.push(swingLowPivotBars, bar_index - 2)
        array.push(swingLowDateKeys, pivotDateKey)
        array.push(swingLowSessions, pivotSession)
        array.push(swingLowActive, true)

while array.size(swingHighPrices) > maxTrackedSwingTargets
    array.shift(swingHighPrices)
    array.shift(swingHighPivotBars)
    array.shift(swingHighDateKeys)
    array.shift(swingHighSessions)
    array.shift(swingHighActive)

while array.size(swingLowPrices) > maxTrackedSwingTargets
    array.shift(swingLowPrices)
    array.shift(swingLowPivotBars)
    array.shift(swingLowDateKeys)
    array.shift(swingLowSessions)
    array.shift(swingLowActive)

// ===================== Thesis State Logic =====================
var int thesisState = f_initialThesisState(initialThesis)
var bool pendingBullClearance = false
var bool pendingBearClearance = false
var int pendingBullExpirationBar = na
var int pendingBearExpirationBar = na
var bool thesisInitializedForSession = false

if newScalpRTHSession
    thesisState := f_initialThesisState(initialThesis)
    thesisInitializedForSession := false
    pendingBullClearance := false
    pendingBearClearance := false
    pendingBullExpirationBar := na
    pendingBearExpirationBar := na

validThesisLevel = not na(effectiveThesisLevel) and effectiveThesisLevel > 0
thesisRangeValid = barRange > 0
thesisTolerance = scalpTickSize * 0.1

if inScalpRTHSession and validThesisLevel and not thesisInitializedForSession
    if close > effectiveThesisLevel
        thesisState := 1
    else if close < effectiveThesisLevel
        thesisState := -1
    else
        thesisState := f_initialThesisState(initialThesis)
    thesisInitializedForSession := true

bullLowerThirdBoundaryRaw = low + barRange * (1.0 / 3.0)
bullUpperThirdCloseBoundaryRaw = low + barRange * (2.0 / 3.0)
bearUpperThirdBoundaryRaw = high - barRange * (1.0 / 3.0)
bearLowerThirdCloseBoundaryRaw = low + barRange * (1.0 / 3.0)
bullLowerThirdBoundary = f_roundUpToScalpTick(bullLowerThirdBoundaryRaw)
bullUpperThirdCloseBoundary = f_roundUpToScalpTick(bullUpperThirdCloseBoundaryRaw)
bearUpperThirdBoundary = f_roundDownToScalpTick(bearUpperThirdBoundaryRaw)
bearLowerThirdCloseBoundary = f_roundUpToScalpTick(bearLowerThirdCloseBoundaryRaw)
barRangeTicks = math.max(f_tickCount(barRange), 1)
bodyTicks = f_tickCount(body)
closeAboveLowTicks = f_tickCount(close - low)
bullRangeAboveThesisTicks = f_tickCount(high - effectiveThesisLevel)
bearRangeBelowThesisTicks = f_tickCount(effectiveThesisLevel - low)

strongThesisBody = body + thesisTolerance >= barRange * 0.5 or bodyTicks * 2 >= barRangeTicks
strongBullCloseInUpperThird = close + thesisTolerance >= bullUpperThirdCloseBoundary or closeAboveLowTicks * 3 >= barRangeTicks * 2
strongBearCloseInLowerThird = close - thesisTolerance <= bearLowerThirdCloseBoundary or closeAboveLowTicks * 3 <= barRangeTicks

strongBullThesisBar = validThesisLevel and thesisRangeValid and close > open and strongThesisBody and strongBullCloseInUpperThird and close > effectiveThesisLevel
strongBearThesisBar = validThesisLevel and thesisRangeValid and close < open and strongThesisBody and strongBearCloseInLowerThird and close < effectiveThesisLevel

bullTwoThirdsBeyondLevel = validThesisLevel and thesisRangeValid and effectiveThesisLevel <= bullLowerThirdBoundary + thesisTolerance
bearTwoThirdsBeyondLevel = validThesisLevel and thesisRangeValid and effectiveThesisLevel >= bearUpperThirdBoundary - thesisTolerance

bullDirectClearance = strongBullThesisBar and (bullTwoThirdsBeyondLevel or low > effectiveThesisLevel)
bearDirectClearance = strongBearThesisBar and (bearTwoThirdsBeyondLevel or high < effectiveThesisLevel)
bullPendingFollowThrough = validThesisLevel and pendingBullClearance and not na(pendingBullExpirationBar) and bar_index <= pendingBullExpirationBar and low > effectiveThesisLevel
bearPendingFollowThrough = validThesisLevel and pendingBearClearance and not na(pendingBearExpirationBar) and bar_index <= pendingBearExpirationBar and high < effectiveThesisLevel

if barstate.isconfirmed
    if not inScalpRTHSession
        pendingBullClearance := false
        pendingBearClearance := false
        pendingBullExpirationBar := na
        pendingBearExpirationBar := na
    else
        if pendingBullClearance and not na(pendingBullExpirationBar) and bar_index > pendingBullExpirationBar
            pendingBullClearance := false
            pendingBullExpirationBar := na
        if pendingBearClearance and not na(pendingBearExpirationBar) and bar_index > pendingBearExpirationBar
            pendingBearClearance := false
            pendingBearExpirationBar := na

        bool bullThesisCleared = bullDirectClearance or bullPendingFollowThrough
        bool bearThesisCleared = bearDirectClearance or bearPendingFollowThrough

        if bullThesisCleared and not bearThesisCleared
            thesisState := 1
            pendingBullClearance := false
            pendingBearClearance := false
            pendingBullExpirationBar := na
            pendingBearExpirationBar := na
        else if bearThesisCleared and not bullThesisCleared
            thesisState := -1
            pendingBullClearance := false
            pendingBearClearance := false
            pendingBullExpirationBar := na
            pendingBearExpirationBar := na
        else
            if strongBullThesisBar and not bullDirectClearance
                pendingBullClearance := true
                pendingBearClearance := false
                pendingBullExpirationBar := bar_index + thesisFollowThroughBars
                pendingBearExpirationBar := na
            if strongBearThesisBar and not bearDirectClearance
                pendingBearClearance := true
                pendingBullClearance := false
                pendingBearExpirationBar := bar_index + thesisFollowThroughBars
                pendingBullExpirationBar := na
            if not validThesisLevel
                pendingBullClearance := false
                pendingBearClearance := false
                pendingBullExpirationBar := na
                pendingBearExpirationBar := na

// ===================== Pre-computed Conditions =====================
sufficientVolumeAndVolatility = sufficientVolume and sufficientVolatility

// ===================== Pressure Signal Conditions =====================
pressureRange = f_safeRange(high, low)
closeUpperThird = f_closeInUpperThird(close, low, pressureRange)
closeLowerThird = f_closeInLowerThird(close, low, pressureRange)

isBodyThreshold = f_meetsPct(body, pressureRange, pressureBodyWickThreshold)
isMostlyBody = f_meetsPct(body, pressureRange, 0.5)
isLowerWickThreshold = f_meetsPct(lowerWick, pressureRange, pressureBodyWickThreshold)
isUpperWickThreshold = f_meetsPct(upperWick, pressureRange, pressureBodyWickThreshold)

bullBarQuality = closeUpperThird and (isBodyThreshold or isLowerWickThreshold)
bearBarQuality = closeLowerThird and (isBodyThreshold or isUpperWickThreshold)

[buyPressure, sellPressure] = f_dobruskyPressure()

pressureReady = not na(buyPressure) and not na(sellPressure) and not na(buyPressure[1]) and not na(sellPressure[1])
priorDominantlyBear = pressureReady and (sellPressure[1] > buyPressure[1])
priorDominantlyBull = pressureReady and (buyPressure[1] >= sellPressure[1])

bullPressureA = pressureReady and ((priorDominantlyBear and buyPressure > sellPressure[1]) or (priorDominantlyBull and buyPressure > buyPressure[1]))
bearPressureA = pressureReady and ((priorDominantlyBull and sellPressure > buyPressure[1]) or (priorDominantlyBear and sellPressure > sellPressure[1]))

[midDown, legDownLow, legDownHigh] = f_midPriorLegDown(maxLookback)
[midUp, legUpLow, legUpHigh] = f_midPriorLegUp(maxLookback)

bullFallbackB = not na(midDown) and close > midDown
bearFallbackB = not na(midUp) and close < midUp

bullPressurePass = (bullPressureA and not na(volume)) or (bullFallbackB and isBodyThreshold)
bearPressurePass = (bearPressureA and not na(volume)) or (bearFallbackB and isBodyThreshold)
isHighVolume = not na(volume) and volume > volume[1]

bullSignalBase = sufficientVolumeAndVolatility and bullBarQuality
bearSignalBase = sufficientVolumeAndVolatility and bearBarQuality

bullSignalHighVol = bullSignalBase and isHighVolume
bearSignalHighVol = bearSignalBase and isHighVolume
bullSignalNormalVol = bullSignalBase and bullPressurePass and not isHighVolume and not onlyHighVolumeSignals
bearSignalNormalVol = bearSignalBase and bearPressurePass and not isHighVolume and not onlyHighVolumeSignals

// ===================== Plotting =====================
plotBullSignalHighVol = showBullSignals and bullSignalHighVol
plotBullSignalNormalVol = showBullSignals and bullSignalNormalVol
plotBearSignalHighVol = showBearSignals and bearSignalHighVol
plotBearSignalNormalVol = showBearSignals and bearSignalNormalVol

hasBullSignal = plotBullSignalHighVol or plotBullSignalNormalVol
hasBearSignal = plotBearSignalHighVol or plotBearSignalNormalVol
hasSignal = hasBullSignal or hasBearSignal
onlyBullSignal = hasBullSignal
onlyBearSignal = hasBearSignal

// Confirmed signals close beyond the prior bar extreme; unconfirmed keep signal logic but use alternate markers.
bullSignalConfirmed = close > high[1]
bearSignalConfirmed = close < low[1]

// Signal-tier visibility filters
plotBullHV_diamond  = plotBullSignalHighVol and showStrongIgnitions
plotBullHV_tri      = plotBullSignalHighVol and showIgnitionSignals
plotBullHV_circle   = plotBullSignalHighVol and showSetupSignals
plotBearHV_diamond  = plotBearSignalHighVol and showStrongIgnitions
plotBearHV_tri      = plotBearSignalHighVol and showIgnitionSignals
plotBearHV_circle   = plotBearSignalHighVol and showSetupSignals
plotBullNV_diamond  = plotBullSignalNormalVol and showStrongIgnitions
plotBullNV_tri      = plotBullSignalNormalVol and showIgnitionSignals
plotBullNV_circle   = plotBullSignalNormalVol and showSetupSignals
plotBearNV_diamond  = plotBearSignalNormalVol and showStrongIgnitions
plotBearNV_tri      = plotBearSignalNormalVol and showIgnitionSignals
plotBearNV_circle   = plotBearSignalNormalVol and showSetupSignals

// ===================== Alert Volume Filter Logic =====================
bullHighVolumeAlertSignal = bullSignalHighVol
bearHighVolumeAlertSignal = bearSignalHighVol
bullNormalVolumeAlertSignal = alertVolumeMode == "All" and bullSignalNormalVol
bearNormalVolumeAlertSignal = alertVolumeMode == "All" and bearSignalNormalVol
bullVolumeAllowedSignal = bullHighVolumeAlertSignal or bullNormalVolumeAlertSignal
bearVolumeAllowedSignal = bearHighVolumeAlertSignal or bearNormalVolumeAlertSignal

bullAlertSetupTier = bullVolumeAllowedSignal and not bullSignalConfirmed
bullAlertIgnitionTier = bullVolumeAllowedSignal and bullSignalConfirmed and not isMostlyBody
bullAlertStrongIgnitionTier = bullVolumeAllowedSignal and bullSignalConfirmed and isMostlyBody
bearAlertSetupTier = bearVolumeAllowedSignal and not bearSignalConfirmed
bearAlertIgnitionTier = bearVolumeAllowedSignal and bearSignalConfirmed and not isMostlyBody
bearAlertStrongIgnitionTier = bearVolumeAllowedSignal and bearSignalConfirmed and isMostlyBody

bullTierAllowed = (alertSetupSignals and bullAlertSetupTier) or (alertIgnitionSignals and bullAlertIgnitionTier) or (alertStrongIgnitions and bullAlertStrongIgnitionTier)
bearTierAllowed = (alertSetupSignals and bearAlertSetupTier) or (alertIgnitionSignals and bearAlertIgnitionTier) or (alertStrongIgnitions and bearAlertStrongIgnitionTier)
bullVolumeTextShort = bullHighVolumeAlertSignal ? "HV" : "LV"
bearVolumeTextShort = bearHighVolumeAlertSignal ? "HV" : "LV"
bullSignalTierShort = bullAlertStrongIgnitionTier or bullAlertIgnitionTier ? "IGN" : bullAlertSetupTier ? "FBO" : "N/A"
bearSignalTierShort = bearAlertStrongIgnitionTier or bearAlertIgnitionTier ? "IGN" : bearAlertSetupTier ? "FBO" : "N/A"
bullCompactSignalText = bullVolumeTextShort + " " + bullSignalTierShort
bearCompactSignalText = bearVolumeTextShort + " " + bearSignalTierShort

esImpulseClose = request.security(esImpulseSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off, calc_bars_count=500)
nqImpulseClose = request.security(nqImpulseSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off, calc_bars_count=500)
esImpulseAtr = request.security(esImpulseSymbol, timeframe.period, ta.atr(impulseAtrLength), lookahead=barmerge.lookahead_off, calc_bars_count=500)
nqImpulseAtr = request.security(nqImpulseSymbol, timeframe.period, ta.atr(impulseAtrLength), lookahead=barmerge.lookahead_off, calc_bars_count=500)
esImpulseScore = esImpulseAtr > 0 ? (esImpulseClose - esImpulseClose[impulseLookback]) / esImpulseAtr : na
nqImpulseScore = nqImpulseAtr > 0 ? (nqImpulseClose - nqImpulseClose[impulseLookback]) / nqImpulseAtr : na
selectedImpulseScore = tickerInput == "MES" ? esImpulseScore : nqImpulseScore
impulseReady = not na(selectedImpulseScore)
longFboImpulseOk = not useFboImpulseFilter or not bullAlertSetupTier or not impulseReady or selectedImpulseScore >= -fboImpulseTolerance
shortFboImpulseOk = not useFboImpulseFilter or not bearAlertSetupTier or not impulseReady or selectedImpulseScore <= fboImpulseTolerance

// ===================== Scalp Level Priority Logic =====================
scalpSignalHigh = high
scalpSignalLow = low
scalpSignalClose = close
scalpEntry50Raw = (scalpSignalHigh + scalpSignalLow) / 2.0
longEntry50 = f_roundDownToScalpTick(scalpEntry50Raw)
shortEntry50 = f_roundUpToScalpTick(scalpEntry50Raw)
float noSelectedLevelPrice = na
string noSelectedLevelName = "N/A"

[longGroup1AfterPDHPrice, longGroup1AfterPDHName] = f_pickLongTouchedLevel(usePrevDayHighLevel, effectivePrevDayHigh, "PDH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[longGroup1Price, longGroup1Name] = f_pickLongTouchedLevel(usePrevDayLowLevel, effectivePrevDayLow, "PDL", scalpSignalLow, scalpSignalHigh, longGroup1AfterPDHPrice, longGroup1AfterPDHName)
[longGroup2Price, longGroup2Name] = f_pickLongTouchedLevel(useDailyOpenLevel, effectiveDailyOpen, "OP", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[longGroup3AfterPMHPrice, longGroup3AfterPMHName] = f_pickLongTouchedLevel(usePremarketHighLevel, effectivePremarketHigh, "PMH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[longGroup3Price, longGroup3Name] = f_pickLongTouchedLevel(usePremarketLowLevel, effectivePremarketLow, "PML", scalpSignalLow, scalpSignalHigh, longGroup3AfterPMHPrice, longGroup3AfterPMHName)
[longGroup4AfterORHPrice, longGroup4AfterORHName] = f_pickLongTouchedLevel(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "ORH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[longGroup4Price, longGroup4Name] = f_pickLongTouchedLevel(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "ORL", scalpSignalLow, scalpSignalHigh, longGroup4AfterORHPrice, longGroup4AfterORHName)

[shortGroup1AfterPDHPrice, shortGroup1AfterPDHName] = f_pickShortTouchedLevel(usePrevDayHighLevel, effectivePrevDayHigh, "PDH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[shortGroup1Price, shortGroup1Name] = f_pickShortTouchedLevel(usePrevDayLowLevel, effectivePrevDayLow, "PDL", scalpSignalLow, scalpSignalHigh, shortGroup1AfterPDHPrice, shortGroup1AfterPDHName)
[shortGroup2Price, shortGroup2Name] = f_pickShortTouchedLevel(useDailyOpenLevel, effectiveDailyOpen, "OP", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[shortGroup3AfterPMHPrice, shortGroup3AfterPMHName] = f_pickShortTouchedLevel(usePremarketHighLevel, effectivePremarketHigh, "PMH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[shortGroup3Price, shortGroup3Name] = f_pickShortTouchedLevel(usePremarketLowLevel, effectivePremarketLow, "PML", scalpSignalLow, scalpSignalHigh, shortGroup3AfterPMHPrice, shortGroup3AfterPMHName)
[shortGroup4AfterORHPrice, shortGroup4AfterORHName] = f_pickShortTouchedLevel(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "ORH", scalpSignalLow, scalpSignalHigh, noSelectedLevelPrice, noSelectedLevelName)
[shortGroup4Price, shortGroup4Name] = f_pickShortTouchedLevel(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "ORL", scalpSignalLow, scalpSignalHigh, shortGroup4AfterORHPrice, shortGroup4AfterORHName)

longMostKeyTouchedLevelPrice = not na(longGroup1Price) ? longGroup1Price : not na(longGroup2Price) ? longGroup2Price : not na(longGroup3Price) ? longGroup3Price : longGroup4Price
longMostKeyTouchedLevelName = not na(longGroup1Price) ? longGroup1Name : not na(longGroup2Price) ? longGroup2Name : not na(longGroup3Price) ? longGroup3Name : not na(longGroup4Price) ? longGroup4Name : "N/A"

shortMostKeyTouchedLevelPrice = not na(shortGroup1Price) ? shortGroup1Price : not na(shortGroup2Price) ? shortGroup2Price : not na(shortGroup3Price) ? shortGroup3Price : shortGroup4Price
shortMostKeyTouchedLevelName = not na(shortGroup1Price) ? shortGroup1Name : not na(shortGroup2Price) ? shortGroup2Name : not na(shortGroup3Price) ? shortGroup3Name : not na(shortGroup4Price) ? shortGroup4Name : "N/A"

longAnyEntryLevelTouched = not na(longMostKeyTouchedLevelPrice)
shortAnyEntryLevelTouched = not na(shortMostKeyTouchedLevelPrice)

longMostKeyTouchedLevelBroken = longAnyEntryLevelTouched and scalpSignalClose > longMostKeyTouchedLevelPrice
shortMostKeyTouchedLevelBroken = shortAnyEntryLevelTouched and scalpSignalClose < shortMostKeyTouchedLevelPrice

longSelectedLevelPrice = longMostKeyTouchedLevelBroken ? longMostKeyTouchedLevelPrice : na
longSelectedLevelName = longMostKeyTouchedLevelBroken ? longMostKeyTouchedLevelName : "N/A"

shortSelectedLevelPrice = shortMostKeyTouchedLevelBroken ? shortMostKeyTouchedLevelPrice : na
shortSelectedLevelName = shortMostKeyTouchedLevelBroken ? shortMostKeyTouchedLevelName : "N/A"

// Level-entry retracement validation only applies when the broken level would be the entry.
levelEntryRange = scalpSignalHigh - scalpSignalLow
longLevelEntryRequired = not na(longSelectedLevelPrice) and longSelectedLevelPrice >= longEntry50 and longSelectedLevelPrice < scalpSignalClose
shortLevelEntryRequired = not na(shortSelectedLevelPrice) and shortSelectedLevelPrice <= shortEntry50 and shortSelectedLevelPrice > scalpSignalClose
float longLevelEntryRetracement = (levelEntryRange > 0 and longLevelEntryRequired) ? (scalpSignalHigh - longSelectedLevelPrice) / levelEntryRange : na
float shortLevelEntryRetracement = (levelEntryRange > 0 and shortLevelEntryRequired) ? (shortSelectedLevelPrice - scalpSignalLow) / levelEntryRange : na
longLevelEntryRetracementOk = not longLevelEntryRequired or (not na(longLevelEntryRetracement) and longLevelEntryRetracement >= minLevelEntryRetracement)
shortLevelEntryRetracementOk = not shortLevelEntryRequired or (not na(shortLevelEntryRetracement) and shortLevelEntryRetracement >= minLevelEntryRetracement)

// ===================== Scalp Setup Qualification Logic =====================
// Level-break setups reuse the enabled scalp entry level checks above. A selected
// level only exists after the signal bar range includes that level and closes beyond it.
longLevelBreakSetup = longMostKeyTouchedLevelBroken and longLevelEntryRetracementOk
shortLevelBreakSetup = shortMostKeyTouchedLevelBroken and shortLevelEntryRetracementOk

longPullbackBreak = not na(low[1]) and low < low[1]
shortPullbackBreak = not na(high[1]) and high > high[1]
longNoPullbackBreak = not na(low[1]) and not longPullbackBreak
shortNoPullbackBreak = not na(high[1]) and not shortPullbackBreak
var int longBarsWithoutPullbackBreak = 0
var int shortBarsWithoutPullbackBreak = 0
longBarsWithoutPullbackBreak := longNoPullbackBreak ? nz(longBarsWithoutPullbackBreak[1]) + 1 : 0
shortBarsWithoutPullbackBreak := shortNoPullbackBreak ? nz(shortBarsWithoutPullbackBreak[1]) + 1 : 0

// Two-bar setups are fallback qualifiers: no qualifying level break, a trend-body
// signal bar, and one of the prior two bars closing strongly in the signal direction.
longSignalTrendBar = f_isBullBar(open, close) and isBodyThreshold
shortSignalTrendBar = f_isBearBar(open, close) and isBodyThreshold
priorBullUpperThirdBar = f_bullUpperThirdBar(open[1], high[1], low[1], close[1]) or f_bullUpperThirdBar(open[2], high[2], low[2], close[2])
priorBearLowerThirdBar = f_bearLowerThirdBar(open[1], high[1], low[1], close[1]) or f_bearLowerThirdBar(open[2], high[2], low[2], close[2])
longTwoBarSetupRaw = not longAnyEntryLevelTouched and longSignalTrendBar and priorBullUpperThirdBar
shortTwoBarSetupRaw = not shortAnyEntryLevelTouched and shortSignalTrendBar and priorBearLowerThirdBar
longTwoBarIgnitionOk = not requireTwoBarIgnition or scalpSignalClose > high[1]
shortTwoBarIgnitionOk = not requireTwoBarIgnition or scalpSignalClose < low[1]
longTwoBarSetup = longTwoBarSetupRaw and longTwoBarIgnitionOk
shortTwoBarSetup = shortTwoBarSetupRaw and shortTwoBarIgnitionOk
longSetupTextShort = longLevelBreakSetup ? "LB" : longTwoBarSetup ? "2B" : "None"
shortSetupTextShort = shortLevelBreakSetup ? "LB" : shortTwoBarSetup ? "2B" : "None"
longSetupTextFull = longLevelBreakSetup ? "Level Break" : longTwoBarSetup ? "Two-Bar Play" : "None"
shortSetupTextFull = shortLevelBreakSetup ? "Level Break" : shortTwoBarSetup ? "Two-Bar Play" : "None"

prior1StrongBull = f_isBullBar(open[1], close[1]) and bodyPct[1] >= 0.50 and closeInUpperThird[1]
prior2StrongBull = f_isBullBar(open[2], close[2]) and bodyPct[2] >= 0.50 and closeInUpperThird[2]
prior1StrongBear = f_isBearBar(open[1], close[1]) and bodyPct[1] >= 0.50 and closeInLowerThird[1]
prior2StrongBear = f_isBearBar(open[2], close[2]) and bodyPct[2] >= 0.50 and closeInLowerThird[2]
longFiveBarExtension = longBarsWithoutPullbackBreak >= 5
shortFiveBarExtension = shortBarsWithoutPullbackBreak >= 5
longStrongMicrochannelExtension = longBarsWithoutPullbackBreak >= 3 and prior1StrongBull and prior2StrongBull
shortStrongMicrochannelExtension = shortBarsWithoutPullbackBreak >= 3 and prior1StrongBear and prior2StrongBear
longExtendedSetup = longFiveBarExtension or longStrongMicrochannelExtension
shortExtendedSetup = shortFiveBarExtension or shortStrongMicrochannelExtension
longExtendedSetupBlocked = longExtendedSetup and ((skipFiveBarExtension and longFiveBarExtension) or (skipStrongMicrochannelExtension and longStrongMicrochannelExtension))
shortExtendedSetupBlocked = shortExtendedSetup and ((skipFiveBarExtension and shortFiveBarExtension) or (skipStrongMicrochannelExtension and shortStrongMicrochannelExtension))
longFiveBullBarsInRow = f_isBullBar(open, close) and f_isBullBar(open[1], close[1]) and f_isBullBar(open[2], close[2]) and f_isBullBar(open[3], close[3]) and f_isBullBar(open[4], close[4])
shortFiveBearBarsInRow = f_isBearBar(open, close) and f_isBearBar(open[1], close[1]) and f_isBearBar(open[2], close[2]) and f_isBearBar(open[3], close[3]) and f_isBearBar(open[4], close[4])
longActualSetupIsTwoBar = not longLevelBreakSetup and longTwoBarSetup
shortActualSetupIsTwoBar = not shortLevelBreakSetup and shortTwoBarSetup
longTwoBarSoftExtensionBlocked = skipTwoBarSameColorExtension and longActualSetupIsTwoBar and longFiveBullBarsInRow
shortTwoBarSoftExtensionBlocked = skipTwoBarSameColorExtension and shortActualSetupIsTwoBar and shortFiveBearBarsInRow

// Requirement toggles act as filters. If neither setup is required, preserve the
// original behavior and allow any alert that otherwise passes the alert conditions.
requireAnyScalpSetup = requireLevelBreakSetup or requireTwoBarSetup
longRequiredSetupMatched = (requireLevelBreakSetup and longLevelBreakSetup) or (requireTwoBarSetup and longTwoBarSetup)
shortRequiredSetupMatched = (requireLevelBreakSetup and shortLevelBreakSetup) or (requireTwoBarSetup and shortTwoBarSetup)
longScalpSetupQualified = not requireAnyScalpSetup or longRequiredSetupMatched
shortScalpSetupQualified = not requireAnyScalpSetup or shortRequiredSetupMatched

// ===================== Scalp Entry / Stop / Risk Logic =====================
longUsePriorityLevel = longLevelEntryRequired and longLevelEntryRetracementOk
shortUsePriorityLevel = shortLevelEntryRequired and shortLevelEntryRetracementOk
longEntryType = longUsePriorityLevel ? longSelectedLevelName : "50%"
shortEntryType = shortUsePriorityLevel ? shortSelectedLevelName : "50%"

longEntryPrice = longUsePriorityLevel ? longSelectedLevelPrice : longEntry50
shortEntryPrice = shortUsePriorityLevel ? shortSelectedLevelPrice : shortEntry50
longStopPrice = scalpSignalLow - scalpTickSize
shortStopPrice = scalpSignalHigh + scalpTickSize
longRiskPoints = longEntryPrice - longStopPrice
shortRiskPoints = shortStopPrice - shortEntryPrice
longRiskDollarsPerContract = longRiskPoints > 0 ? longRiskPoints * scalpPointValue + commissionRoundTrip : na
shortRiskDollarsPerContract = shortRiskPoints > 0 ? shortRiskPoints * scalpPointValue + commissionRoundTrip : na
longRawContracts = not na(longRiskDollarsPerContract) and longRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / longRiskDollarsPerContract)) : 0
shortRawContracts = not na(shortRiskDollarsPerContract) and shortRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / shortRiskDollarsPerContract)) : 0
longContracts = useMaxContractCap ? math.min(longRawContracts, maxContracts) : longRawContracts
shortContracts = useMaxContractCap ? math.min(shortRawContracts, maxContracts) : shortRawContracts
longRiskValid = longRiskPoints > 0 and not na(longRiskDollarsPerContract) and longRiskDollarsPerContract > 0 and longContracts >= 1
shortRiskValid = shortRiskPoints > 0 and not na(shortRiskDollarsPerContract) and shortRiskDollarsPerContract > 0 and shortContracts >= 1

// ===================== Scalp Target Selection Logic =====================
float noTargetPrice = na
string noTargetType = "N/A"
float noTargetRR = na

[longTargetAfterPDHPrice, longTargetAfterPDHType, longTargetAfterPDHRR] = f_pickLongTargetCandidate(usePrevDayHighLevel, effectivePrevDayHigh, "Level PDH", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, noTargetPrice, noTargetType, noTargetRR)
[longTargetAfterPDLPrice, longTargetAfterPDLType, longTargetAfterPDLRR] = f_pickLongTargetCandidate(usePrevDayLowLevel, effectivePrevDayLow, "Level PDL", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterPDHPrice, longTargetAfterPDHType, longTargetAfterPDHRR)
[longTargetAfterOPPrice, longTargetAfterOPType, longTargetAfterOPRR] = f_pickLongTargetCandidate(useDailyOpenLevel, effectiveDailyOpen, "Level OP", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterPDLPrice, longTargetAfterPDLType, longTargetAfterPDLRR)
[longTargetAfterPMHPrice, longTargetAfterPMHType, longTargetAfterPMHRR] = f_pickLongTargetCandidate(usePremarketHighLevel, effectivePremarketHigh, "Level PMH", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterOPPrice, longTargetAfterOPType, longTargetAfterOPRR)
[longTargetAfterPMLPrice, longTargetAfterPMLType, longTargetAfterPMLRR] = f_pickLongTargetCandidate(usePremarketLowLevel, effectivePremarketLow, "Level PML", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterPMHPrice, longTargetAfterPMHType, longTargetAfterPMHRR)
[longTargetAfterORHPrice, longTargetAfterORHType, longTargetAfterORHRR] = f_pickLongTargetCandidate(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "Level ORH", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterPMLPrice, longTargetAfterPMLType, longTargetAfterPMLRR)
[longTargetAfterORLPrice, longTargetAfterORLType, longTargetAfterORLRR] = f_pickLongTargetCandidate(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "Level ORL", scalpSignalHigh, longEntryType, longEntryPrice, longRiskPoints, currentRTHHigh, longTargetAfterORHPrice, longTargetAfterORHType, longTargetAfterORHRR)

float longTargetPrice = longTargetAfterORLPrice
string longTargetType = longTargetAfterORLType
float longTargetRR = longTargetAfterORLRR

if array.size(swingHighPrices) > 0
    for swingHighIndex = 0 to array.size(swingHighPrices) - 1
        float swingHighPrice = array.get(swingHighPrices, swingHighIndex)
        bool swingHighAllowed = array.get(swingHighActive, swingHighIndex) and f_swingTargetSessionAllowed(array.get(swingHighSessions, swingHighIndex), array.get(swingHighDateKeys, swingHighIndex), nySessionDateKey, currentRTHDateKey, previousRTHDateKey)
        if swingHighAllowed and f_longTargetQualifies(swingHighPrice, "5m Swing", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and (na(longTargetPrice) or swingHighPrice < longTargetPrice)
            longTargetPrice := swingHighPrice
            longTargetType := "5m Swing"
            longTargetRR := f_targetRRLong(swingHighPrice, longEntryPrice, longRiskPoints)

if f_longTargetQualifies(currentRTHHigh, "HOD", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and (na(longTargetPrice) or currentRTHHigh < longTargetPrice)
    longTargetPrice := currentRTHHigh
    longTargetType := "HOD"
    longTargetRR := f_targetRRLong(currentRTHHigh, longEntryPrice, longRiskPoints)

longTargetValid = not na(longTargetPrice) and longTargetType != "N/A"

[shortTargetAfterPDHPrice, shortTargetAfterPDHType, shortTargetAfterPDHRR] = f_pickShortTargetCandidate(usePrevDayHighLevel, effectivePrevDayHigh, "Level PDH", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, noTargetPrice, noTargetType, noTargetRR)
[shortTargetAfterPDLPrice, shortTargetAfterPDLType, shortTargetAfterPDLRR] = f_pickShortTargetCandidate(usePrevDayLowLevel, effectivePrevDayLow, "Level PDL", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterPDHPrice, shortTargetAfterPDHType, shortTargetAfterPDHRR)
[shortTargetAfterOPPrice, shortTargetAfterOPType, shortTargetAfterOPRR] = f_pickShortTargetCandidate(useDailyOpenLevel, effectiveDailyOpen, "Level OP", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterPDLPrice, shortTargetAfterPDLType, shortTargetAfterPDLRR)
[shortTargetAfterPMHPrice, shortTargetAfterPMHType, shortTargetAfterPMHRR] = f_pickShortTargetCandidate(usePremarketHighLevel, effectivePremarketHigh, "Level PMH", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterOPPrice, shortTargetAfterOPType, shortTargetAfterOPRR)
[shortTargetAfterPMLPrice, shortTargetAfterPMLType, shortTargetAfterPMLRR] = f_pickShortTargetCandidate(usePremarketLowLevel, effectivePremarketLow, "Level PML", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterPMHPrice, shortTargetAfterPMHType, shortTargetAfterPMHRR)
[shortTargetAfterORHPrice, shortTargetAfterORHType, shortTargetAfterORHRR] = f_pickShortTargetCandidate(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "Level ORH", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterPMLPrice, shortTargetAfterPMLType, shortTargetAfterPMLRR)
[shortTargetAfterORLPrice, shortTargetAfterORLType, shortTargetAfterORLRR] = f_pickShortTargetCandidate(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "Level ORL", scalpSignalLow, shortEntryType, shortEntryPrice, shortRiskPoints, currentRTHLow, shortTargetAfterORHPrice, shortTargetAfterORHType, shortTargetAfterORHRR)

float shortTargetPrice = shortTargetAfterORLPrice
string shortTargetType = shortTargetAfterORLType
float shortTargetRR = shortTargetAfterORLRR

if array.size(swingLowPrices) > 0
    for swingLowIndex = 0 to array.size(swingLowPrices) - 1
        float swingLowPrice = array.get(swingLowPrices, swingLowIndex)
        bool swingLowAllowed = array.get(swingLowActive, swingLowIndex) and f_swingTargetSessionAllowed(array.get(swingLowSessions, swingLowIndex), array.get(swingLowDateKeys, swingLowIndex), nySessionDateKey, currentRTHDateKey, previousRTHDateKey)
        if swingLowAllowed and f_shortTargetQualifies(swingLowPrice, "5m Swing", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and (na(shortTargetPrice) or swingLowPrice > shortTargetPrice)
            shortTargetPrice := swingLowPrice
            shortTargetType := "5m Swing"
            shortTargetRR := f_targetRRShort(swingLowPrice, shortEntryPrice, shortRiskPoints)

if f_shortTargetQualifies(currentRTHLow, "LOD", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and (na(shortTargetPrice) or currentRTHLow > shortTargetPrice)
    shortTargetPrice := currentRTHLow
    shortTargetType := "LOD"
    shortTargetRR := f_targetRRShort(currentRTHLow, shortEntryPrice, shortRiskPoints)

shortTargetValid = not na(shortTargetPrice) and shortTargetType != "N/A"
longTargetFilterPassed = not requireValidTarget or longTargetValid
shortTargetFilterPassed = not requireValidTarget or shortTargetValid

// ===================== Alert Conditions =====================
bullScalpAlert = enableScalpAlerts and barstate.isconfirmed and inScalpRTHSession and validThesisLevel and thesisState == 1 and alertOnBullSignals and first15FilterAllowsAlerts and openingRangeAllowsAlerts and bullTierAllowed and longFboImpulseOk and longScalpSetupQualified and not longExtendedSetupBlocked and not longTwoBarSoftExtensionBlocked and longRiskValid and longTargetFilterPassed
bullAlertLabelTitle = "LONG SCALP"

bearScalpAlert = enableScalpAlerts and barstate.isconfirmed and inScalpRTHSession and validThesisLevel and thesisState == -1 and alertOnBearSignals and first15FilterAllowsAlerts and openingRangeAllowsAlerts and bearTierAllowed and shortFboImpulseOk and shortScalpSetupQualified and not shortExtendedSetupBlocked and not shortTwoBarSoftExtensionBlocked and shortRiskValid and shortTargetFilterPassed
bearAlertLabelTitle = "SHORT SCALP"

showHistoricalAlertLabels = alertLabelMode != "Off"
showCompactAlertLabels = alertLabelMode == "Compact"

f_buildMarkerChartLabel(_direction, _compactSignalText, _setupTextFull) =>
    showScalpSignalDetails ? _direction + "\n" + _compactSignalText + " | " + _setupTextFull : _direction

f_buildCompactChartLabel(_direction, _compactSignalText, _setupTextFull, _entryPrice, _targetPrice, _targetType, _targetRR, _contracts) =>
    string detailLine = showScalpSignalDetails ? _compactSignalText + " | " + _setupTextFull + "\n" : ""
    _direction + "\n" +
     detailLine +
     "E " + f_priceText(_entryPrice) + "\n" +
     "T " + f_priceText(_targetPrice) + " " + _targetType + "\n" +
     str.tostring(_contracts) + "ct | " + f_rrText(_targetRR)

if showHistoricalAlertLabels and bullScalpAlert
    string bullChartLabelText = showCompactAlertLabels ? f_buildCompactChartLabel(bullAlertLabelTitle, bullCompactSignalText, longSetupTextFull, longEntryPrice, longTargetPrice, longTargetType, longTargetRR, longContracts) : f_buildMarkerChartLabel(bullAlertLabelTitle, bullCompactSignalText, longSetupTextFull)
    label.new(
         bar_index,
         low,
         bullChartLabelText,
         style=label.style_label_up,
         textcolor=color.white,
         color=color.new(color.lime, 0),
         size=showCompactAlertLabels ? size.small : size.tiny
    )

if showHistoricalAlertLabels and bearScalpAlert
    string bearChartLabelText = showCompactAlertLabels ? f_buildCompactChartLabel(bearAlertLabelTitle, bearCompactSignalText, shortSetupTextFull, shortEntryPrice, shortTargetPrice, shortTargetType, shortTargetRR, shortContracts) : f_buildMarkerChartLabel(bearAlertLabelTitle, bearCompactSignalText, shortSetupTextFull)
    label.new(
         bar_index,
         high,
         bearChartLabelText,
         style=label.style_label_down,
         textcolor=color.white,
         color=color.new(color.red, 0),
         size=showCompactAlertLabels ? size.small : size.tiny
    )

// ===================== Alert Message =====================
f_buildScalpAlertMessage(_directionTitle, _compactSignalText, _setupTextFull, _entryType, _entryPrice, _stopPrice, _targetPrice, _targetType, _targetRR, _riskPoints, _contracts) =>
    string signalDetailLine = showScalpSignalDetails ? "Signal: " + _compactSignalText + " | " + _setupTextFull + "\n" : ""
    "PA ENGINE " + _directionTitle + "\n" +
     signalDetailLine +
     syminfo.ticker + " " + timeframe.period + "\n\n" +
     "Entry: " + f_priceText(_entryPrice) + "\n" +
     "Stop: " + f_priceText(_stopPrice) + "\n" +
     "Target: " + f_priceText(_targetPrice) + "\n" +
     "Target Type: " + _targetType + "\n" +
     "R:R: " + f_rrText(_targetRR) + "\n" +
     "Risk: " + f_pointsText(_riskPoints) + " pts\n" +
     "Contracts: " + str.tostring(_contracts) + "\n" +
     "Entry Type: " + _entryType + "\n\n" +
     "Thesis: " + f_thesisText(thesisState) + "\n" +
     "Thesis Level: " + f_priceText(effectiveThesisLevel) + "\n" +
     "Opening Range: " + openingRangeStatus

if bullScalpAlert
    alert(f_buildScalpAlertMessage(bullAlertLabelTitle, bullCompactSignalText, longSetupTextFull, longEntryType, longEntryPrice, longStopPrice, longTargetPrice, longTargetType, longTargetRR, longRiskPoints, longContracts), alert.freq_once_per_bar_close)
else if bearScalpAlert
    alert(f_buildScalpAlertMessage(bearAlertLabelTitle, bearCompactSignalText, shortSetupTextFull, shortEntryType, shortEntryPrice, shortStopPrice, shortTargetPrice, shortTargetType, shortTargetRR, shortRiskPoints, shortContracts), alert.freq_once_per_bar_close)

thesisPlot = showAutoThesisLevel and inScalpRTHSession and not na(effectiveThesisLevel) and effectiveThesisLevel > 0 ? effectiveThesisLevel : na
plot(thesisPlot, "Effective Thesis Level", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(showOpeningRange ? openingRangeDisplayHigh : na, "15m Opening Range High", color=color.green, linewidth=1, style=plot.style_linebr)
plot(showOpeningRange ? openingRangeDisplayLow : na, "15m Opening Range Low", color=color.green, linewidth=1, style=plot.style_linebr)
pdhPlot = showAutoScalpLevels and inScalpRTHSession and effectivePrevDayHigh > 0 ? effectivePrevDayHigh : na
pdlPlot = showAutoScalpLevels and inScalpRTHSession and effectivePrevDayLow > 0 ? effectivePrevDayLow : na

plot(pdhPlot, "Auto/Effective PDH", color=color.green, linewidth=2, style=plot.style_linebr)
plot(pdlPlot, "Auto/Effective PDL", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showAutoScalpLevels and effectiveDailyOpen > 0 ? effectiveDailyOpen : na, "Auto/Effective OP", color=color.orange, linewidth=1, style=plot.style_linebr)
plot(showAutoScalpLevels and effectivePremarketHigh > 0 ? effectivePremarketHigh : na, "Auto/Effective Premarket High", color=color.blue, linewidth=1, style=plot.style_linebr)
plot(showAutoScalpLevels and effectivePremarketLow > 0 ? effectivePremarketLow : na, "Auto/Effective Premarket Low", color=color.blue, linewidth=1, style=plot.style_linebr)

// Signals
plotshape(plotBullHV_diamond and onlyBullSignal and bullSignalConfirmed and isMostlyBody, style=shape.diamond, size=size.small, location=location.belowbar, color=color.lime)
plotshape(plotBullHV_tri and onlyBullSignal and bullSignalConfirmed and not isMostlyBody, style=shape.triangleup, size=size.small, location=location.belowbar, color=color.lime)
plotshape(plotBullHV_circle and onlyBullSignal and not bullSignalConfirmed, style=shape.circle, size=size.small, location=location.belowbar, color=color.lime)
plotshape(plotBearHV_diamond and onlyBearSignal and bearSignalConfirmed and isMostlyBody, style=shape.diamond, size=size.small, location=location.abovebar, color=color.red)
plotshape(plotBearHV_tri and onlyBearSignal and bearSignalConfirmed and not isMostlyBody, style=shape.triangledown, size=size.small, location=location.abovebar, color=color.red)
plotshape(plotBearHV_circle and onlyBearSignal and not bearSignalConfirmed, style=shape.circle, size=size.small, location=location.abovebar, color=color.red)
plotshape(plotBullNV_diamond and onlyBullSignal and bullSignalConfirmed and isMostlyBody, style=shape.diamond, size=size.tiny, location=location.belowbar, color=color.new(color.lime, 55))
plotshape(plotBullNV_tri and onlyBullSignal and bullSignalConfirmed and not isMostlyBody, style=shape.triangleup, size=size.tiny, location=location.belowbar, color=color.new(color.lime, 55))
plotshape(plotBullNV_circle and onlyBullSignal and not bullSignalConfirmed, style=shape.circle, size=size.tiny, location=location.belowbar, color=color.new(color.lime, 55))
plotshape(plotBearNV_diamond and onlyBearSignal and bearSignalConfirmed and isMostlyBody, style=shape.diamond, size=size.tiny, location=location.abovebar, color=color.new(color.red, 55))
plotshape(plotBearNV_tri and onlyBearSignal and bearSignalConfirmed and not isMostlyBody, style=shape.triangledown, size=size.tiny, location=location.abovebar, color=color.new(color.red, 55))
plotshape(plotBearNV_circle and onlyBearSignal and not bearSignalConfirmed, style=shape.circle, size=size.tiny, location=location.abovebar, color=color.new(color.red, 55))

// ===================== Signal Legend =====================
var table legendTable = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 85), border_width=0)
if barstate.islast and showSignalLegend
    table.cell(legendTable, 0, 0, "○",  text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_center)
    table.cell(legendTable, 1, 0, " Setup",           text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
    table.cell(legendTable, 0, 1, "△",  text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_center)
    table.cell(legendTable, 1, 1, " Ignition",        text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
    table.cell(legendTable, 0, 2, "◇",  text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_center)
    table.cell(legendTable, 1, 2, " Strong Ignition",  text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)

// ===================== Scalp Status Table =====================
var table scalpStatusTable = table.new(position.bottom_right, 2, 25, bgcolor=color.new(color.black, 85), border_width=0)
if barstate.islast
    table.clear(scalpStatusTable, 0, 0, 1, 24)
    if showThesisLabel
        statusTextColor = thesisState == 1 ? color.lime : thesisState == -1 ? color.red : color.rgb(220, 220, 220)
        alertVolumeTableText = alertVolumeMode == "High Volume Only" ? "HIGH VOLUME ONLY" : "ALL"
        int scalpStatusRow = 0
        table.cell(scalpStatusTable, 0, scalpStatusRow, "Thesis", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
        table.cell(scalpStatusTable, 1, scalpStatusRow, f_thesisText(thesisState), text_color=statusTextColor, text_size=size.small, text_halign=text.align_right)
        scalpStatusRow += 1
        table.cell(scalpStatusTable, 0, scalpStatusRow, "Thesis Level", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
        table.cell(scalpStatusTable, 1, scalpStatusRow, f_priceText(effectiveThesisLevel), text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
        scalpStatusRow += 1
        table.cell(scalpStatusTable, 0, scalpStatusRow, "Thesis Name", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
        table.cell(scalpStatusTable, 1, scalpStatusRow, effectiveThesisName, text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
        scalpStatusRow += 1
        table.cell(scalpStatusTable, 0, scalpStatusRow, "Source Symbol", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
        table.cell(scalpStatusTable, 1, scalpStatusRow, effectiveThesisSourceSymbol, text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
        scalpStatusRow += 1
        table.cell(scalpStatusTable, 0, scalpStatusRow, "Opening Range", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
        table.cell(scalpStatusTable, 1, scalpStatusRow, openingRangeStatus, text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
        scalpStatusRow += 1
        table.cell(scalpStatusTable, 0, scalpStatusRow, "Volume Mode", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
        table.cell(scalpStatusTable, 1, scalpStatusRow, alertVolumeTableText, text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
        scalpStatusRow += 1
        if showDetailedLevelStatus
            table.cell(scalpStatusTable, 0, scalpStatusRow, "PDH", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, f_priceText(effectivePrevDayHigh), text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "PDL", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, f_priceText(effectivePrevDayLow), text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "OP", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, f_priceText(effectiveDailyOpen), text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "PMH", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, f_priceText(effectivePremarketHigh), text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "PML", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, f_priceText(effectivePremarketLow), text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "PDH/PDL Source", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, prevDayHighLowSource, text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "OP Source", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, dailyOpenSource, text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "PM Source", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, premarketSource, text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Auto Note", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, "Intraday, ideally 5m", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
        if showAutoThesisDebug
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Conversion Method", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, autoThesisConversionMethod, text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Source Thesis Price", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, useAutoThesis ? f_priceText(selectedAutoThesisSourcePrice) : "N/A", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Source Daily Open", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, useAutoThesis ? f_priceText(sourceDayOpen) : "N/A", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Chart Daily Open", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, useAutoThesis ? f_priceText(chartDailyOpenForThesis) : "N/A", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Raw Converted", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, useAutoThesis ? f_priceText(convertedAutoThesisRaw) : "N/A", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Final Thesis Level", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, useAutoThesis ? f_priceText(convertedAutoThesisLevel) : "N/A", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Auto Distance", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, useAutoThesis ? f_pointsText(selectedAutoThesisDistance) : "N/A", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Daily Open Default", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, useAutoThesis ? f_boolText(autoThesisUsedDailyOpenDefault) : "N/A", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Auto Status", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, autoThesisUnavailableReason, text_color=autoThesisConvertedValid ? color.lime : color.red, text_size=size.small, text_halign=text.align_right)
            scalpStatusRow += 1
            table.cell(scalpStatusTable, 0, scalpStatusRow, "Auto Priority", text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
            table.cell(scalpStatusTable, 1, scalpStatusRow, useAutoThesis and autoThesisSelectionValid ? str.tostring(selectedAutoThesisPriority) : "N/A", text_color=color.rgb(220, 220, 220), text_size=size.small, text_halign=text.align_right)

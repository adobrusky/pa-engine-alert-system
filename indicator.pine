//@version=6
indicator("PA Engine Scalp Alert System", shorttitle = "PA Engine Scalp Alerts", overlay=true, calc_bars_count=500, max_bars_back = 500, max_lines_count=500, max_labels_count=500, max_boxes_count=200, dynamic_requests=true)

// ===================== User Inputs =====================

groupCoreAlerts = "01. Core Alert Controls"
groupSetupFilters = "02. Setup Filters"
groupScalpLevels = "03. Scalp Levels"
groupOpeningRange = "04. Opening Range"
groupRisk = "05. Risk / Position Sizing"
groupTargets = "06. Target Settings"
groupSignalEngine = "07. Signal Engine Tuning"
groupDisplay = "08. Display / Visuals"
groupLatestAlertTracker = "09. Latest Alert Tracker"

// 01. Core Alert Controls
alertScalpSetups         = input.bool(true, title="Alert Scalp Setups", group=groupCoreAlerts, tooltip="Alerts qualified scalp setups. Scalp stops use the signal-bar extreme plus one tick.")
tickerInput              = input.string("MES", title="Ticker", options=["MES", "MNQ"], group=groupCoreAlerts)
alertOnBullSignals       = input.bool(true, title="Alert On Bull Signals", group=groupCoreAlerts)
alertOnBearSignals       = input.bool(true, title="Alert On Bear Signals", group=groupCoreAlerts)
requireValidTarget       = input.bool(true, title="Require Valid Target", group=groupCoreAlerts)
minTargetRR              = input.float(1.4, title="Scalp Minimum Target R:R", minval=0.25, step=0.05, group=groupCoreAlerts, tooltip="Minimum required reward-to-risk for scalp targets. Default is 1.4R. The only exception is the existing HOD/LOD edge exception.")
alertTradingWindow       = input.session("0930-1200", title="Alert Trading Window", group=groupCoreAlerts, tooltip="Only produces scalp alerts during this New York time window. Default is the first two hours of RTH.")
allowPriorBarVolumeReversals = input.bool(true, title="Allow Prior-Bar Volume Reversals", group=groupCoreAlerts, tooltip="Allow the signal when the current bar meets price action pressure criteria and reverses the midpoint of a prior opposite-color high volume bar.")

// 02. Setup Filters
useNineEmaMomentumSetup = input.bool(true, title="Use 9 EMA Momentum Setup", group=groupSetupFilters, tooltip="Allows a no-level-required high-volume momentum continuation setup when the full signal bar is at least one tick beyond the rounded 9 EMA. Uses 50% retracement entry and signal-bar stop.")
useNineEmaReclaimContinuationSetup = input.bool(true, title="Use 9 EMA Reclaim Continuation Setup", group=groupSetupFilters, tooltip="Optional research setup. Allows a high-volume trend-continuation signal when the bar touches the rounded 9 EMA, closes back beyond it with a strong mostly-body close, and the Opening Range bias is aligned.")
useNineEmaLowVolumePullbackSetup = input.bool(false, title="Use 9 EMA Low-Volume Pullback Setup", group=groupSetupFilters, tooltip="Research/backtest setup. Allows a trend-aligned low-volume pullback into/near the 9 EMA to trigger without requiring signal-bar high volume. Disabled by default.")
requirePriorBarBeyondNineEma = input.bool(true, title="Require Prior Bar Beyond 9 EMA", group=groupSetupFilters, tooltip="When enabled, the 9 EMA Momentum Setup requires the prior bar to also be at least one tick beyond the rounded 9 EMA in the trade direction.")
requireRecentStrongCloseForNineEma = input.bool(true, title="Require Recent Strong Close For 9 EMA Setup", group=groupSetupFilters, tooltip="When enabled, the 9 EMA Momentum Setup requires either the prior bar or the bar two bars back to close in the upper third for longs, or in the lower third for shorts.")
blockNineEmaSetupWhenTooFarFromEma = input.bool(true, title="Block 9 EMA Setup When Too Far From EMA", group=groupSetupFilters, tooltip="When enabled, blocks the 9 EMA Momentum Setup if the distance from the signal bar to the rounded 9 EMA is greater than the signal bar's total range.")
nineEmaMaxDistanceBarRangeMultiplier = input.float(0.50, title="9 EMA Max Distance As Bar Range", minval=0.0, maxval=2.0, step=0.05, group=groupSetupFilters, tooltip="Maximum allowed distance between the signal bar and the rounded 9 EMA for 9 EMA Momentum Setups, expressed as a multiple of the signal bar's range. Default 0.50 means the signal bar must be within half of its own range from the EMA.")
nineEmaPriorLaunchMaxDistanceBarRangeMultiplier = input.float(1.00, title="9 EMA Prior Launch Max Distance As Bar Range", minval=0.0, maxval=2.0, step=0.05, group=groupSetupFilters, tooltip="For 9 EMA two-bar impulse setups, maximum allowed distance between the prior launch bar and its own rounded 9 EMA, expressed as a multiple of the prior bar's range. Default 1.00 means the prior strong launch bar can be within one full prior-bar range of the EMA.")
nineEmaLowVolumePullbackMaxDistanceBarRangeMultiplier = input.float(0.5, title="9 EMA Low-Volume Pullback Max Distance As Bar Range", minval=0.0, maxval=2.0, step=0.05, group=groupSetupFilters, tooltip="Maximum allowed distance between the low-volume pullback signal bar and the rounded 9 EMA, expressed as a multiple of the signal bar's range. Default 1.00.")
skipFiveSameColorBarExtension = input.bool(false, title="Skip 5 Same-Color Bar Extension", group=groupSetupFilters, tooltip="Blocks long signals when the signal bar is the 5th consecutive bull bar or later, and blocks short signals when the signal bar is the 5th consecutive bear bar or later.")
skipFiveBarExtension     = input.bool(false, title="Skip 5+ No-Pullback Extension - Legacy", group=groupSetupFilters)
skipStrongMicrochannelExtension = input.bool(false, title="Skip Two Prior Strong-Close Extension", group=groupSetupFilters, tooltip="Blocks long signals after two prior strong bullish closes and blocks short signals after two prior strong bearish closes. This treats back-to-back strong closes as extension even if the sequence is not a strict microchannel.")
skipOppositeFiveBarPressureUnlessStrongReversal = input.bool(true, title="Skip Opposite 5-Bar Pressure Unless Strong Reversal", group=groupSetupFilters, tooltip="Blocks longs after sustained prior bear pressure and shorts after sustained prior bull pressure, unless the setup is a strong HTF reversal exception.")
oppositePressureLookbackBars = input.int(5, title="Opposite Pressure Lookback Bars", minval=3, maxval=10, group=groupSetupFilters)
oppositePressureMinBars = input.int(4, title="Opposite Pressure Minimum Bars", minval=2, maxval=10, group=groupSetupFilters)
oppositePressureMinBodyPct = input.float(0.10, title="Opposite Pressure Min Body %", minval=0.0, maxval=0.75, step=0.05, group=groupSetupFilters)
requireFiveMinuteSwingAcceptance = input.bool(true, title="Require 5m Swing Acceptance", group=groupSetupFilters, tooltip="When enabled, long signals touching an active 5m swing high must close decisively above it, and short signals touching an active 5m swing low must close decisively below it.")
requireOneHourSwingAcceptance = input.bool(true, title="Require 1H Swing Acceptance", group=groupSetupFilters, tooltip="When enabled, long signals touching an active 1H swing high must close decisively above it, and short signals touching an active 1H swing low must close decisively below it. This is separate from the hard 1H swing blocker.")
useOneHourSwingBlockers = input.bool(false, title="Use 1H Swing Blockers", group=groupSetupFilters, tooltip="Blocks longs that touch uncleared 1H swing highs and shorts that touch uncleared 1H swing lows.")
requireWeeklyLevelPriorClose = input.bool(true, title="Require Weekly Level Prior Close", group=groupSetupFilters, tooltip="Legacy compatibility input. Strong HTF reversal exceptions always require the prior bar to close beyond the same reversal level; this setting no longer adds a global weekly prior-close gate.")
requireHtfContinuationState = input.bool(true, title="Require HTF Continuation State", group=groupSetupFilters, tooltip="When enabled, HTF prior-day/prior-week level trades must have valid state: fresh breakout/breakdown, accepted retest, or valid strong reversal exception. Blocks failed-hold and weak reclaim attempts.")
requireOpeningRangeFadePreBreakoutOnly = input.bool(true, title="Require OR Fades Pre-Breakout Only", group=groupSetupFilters, tooltip="When enabled, Opening Range fade setups are only allowed before the Opening Range has registered its first two-close breakout.")
requireHtfReversalFullyOutsideOpeningRange = input.bool(true, title="Require HTF Reversal Fully Outside OR", group=groupSetupFilters, tooltip="When enabled, long HTF reversal exceptions require the signal bar high to be below ORL, and short HTF reversal exceptions require the signal bar low to be above ORH.")
useEntryPriceOverlapFilter = input.bool(
     true,
     title="Block Prior 2-Bar Entry Body Overlap",
     group=groupSetupFilters,
     tooltip="When enabled, blocks scalp alerts when the planned entry price is inside or exactly touching the candle bodies of both prior bars."
)
htfPriorCloseMeaningfulBreakPct = input.float(0.20, title="HTF Prior Close Meaningful Break %", minval=0.0, maxval=1.0, step=0.05, group=groupSetupFilters, tooltip="Prior-close acceptance for PD/PW support/resistance only fails if the prior close meaningfully penetrated beyond the prior bar's level value by at least this percentage of the prior bar range. Default 20%.")
useDailyOpenAsCloseBeyondBlocker = input.bool(false, title="Use Daily Open As Close-Beyond Blocker", group=groupSetupFilters, tooltip="When disabled, touching the daily open will not cause a scalp setup to fail the all-touched-levels close-beyond check. Daily open can still be plotted, used as confluence, filtered by daily-open acceptance, and used as a target.")
minLevelEntryRetracement = input.float(0.20, title="Minimum Level Entry Retracement", minval=0.0, maxval=0.5, step=0.05, group=groupSetupFilters)
requireDailyOpenRangeAcceptance = input.bool(false, title="Require Daily Open Range Acceptance", group=groupSetupFilters, tooltip="When enabled, signals touching the daily open must have enough of both the signal-bar range and candle body accepted beyond the daily open in the trade direction.")
dailyOpenRangeAcceptancePct = input.float(0.50, title="Daily Open Range/Body Acceptance %", minval=0.0, maxval=1.0, step=0.05, group=groupSetupFilters, tooltip="Minimum percentage of both the full signal-bar range and candle body that must be beyond the daily open in the trade direction when the signal bar touches the daily open.")

// 03. Scalp Levels
useAutoPrevDayHighLow            = input.bool(true, title="Use Auto PDH/PDL", group=groupScalpLevels)
usePrevDayHighLevel              = input.bool(true, title="Use PDH Level", group=groupScalpLevels)
prevDayHighLevel                 = input.float(0.0, title="Manual/Fallback PDH Level", step=0.25, group=groupScalpLevels)
usePrevDayLowLevel               = input.bool(true, title="Use PDL Level", group=groupScalpLevels)
prevDayLowLevel                  = input.float(0.0, title="Manual/Fallback PDL Level", step=0.25, group=groupScalpLevels)
useAutoDailyOpen                 = input.bool(true, title="Use Auto Daily Open", group=groupScalpLevels)
useDailyOpenLevel                = input.bool(true, title="Use Daily Open Level", group=groupScalpLevels)
dailyOpenLevel                   = input.float(0.0, title="Manual/Fallback Daily Open", step=0.25, group=groupScalpLevels)
useAutoPremarketHighLow          = input.bool(true, title="Use Auto PMH/PML", group=groupScalpLevels)
usePremarketHighLevel            = input.bool(true, title="Use PMH Level", group=groupScalpLevels)
premarketHighLevel               = input.float(0.0, title="Manual/Fallback PMH Level", step=0.25, group=groupScalpLevels)
usePremarketLowLevel             = input.bool(true, title="Use PML Level", group=groupScalpLevels)
premarketLowLevel                = input.float(0.0, title="Manual/Fallback PML Level", step=0.25, group=groupScalpLevels)
useOpeningRangeHighAsEntryLevel  = input.bool(true, title="Use ORH As Entry Level", group=groupScalpLevels)
useOpeningRangeLowAsEntryLevel   = input.bool(true, title="Use ORL As Entry Level", group=groupScalpLevels)
showAutoScalpLevels              = input.bool(true, title="Show Auto/Effective Scalp Levels", group=groupScalpLevels)
showRawFuturesPrevDayLevels      = input.bool(false, title="Show Raw Futures PDH/PDL", group=groupScalpLevels, tooltip="Shows the raw chart/futures previous day high/low. In converted HTF trade mode these are display/reference only.")
useExpandedScalpLevels           = input.bool(true, title="Use Expanded Converted Levels For Scalp Entries/Targets", group=groupScalpLevels)
useConvertedHtfLevelsForTradeLogic = input.bool(true, title="Use Converted HTF Levels For Trade Logic", group=groupScalpLevels, tooltip="When enabled, converted SPY/QQQ-derived HTF levels are used for higher-timeframe entries, targets, and close-beyond checks. Daily Open trade logic always uses the raw futures RTH open. Futures-derived/manual HTF levels remain available for display/reference/fallback only.")
convertedLevelsSourceMode        = input.string("Auto From Ticker", title="Converted Levels Source Mode", options=["Auto From Ticker", "Manual Source"], group=groupScalpLevels)
manualConvertedLevelsSourceSymbol = input.string("AMEX:SPY", title="Manual Converted Levels Source Symbol", group=groupScalpLevels)
includeDailyGapsInConvertedLevels = input.bool(true, title="Include Daily Gaps In Converted Levels", group=groupScalpLevels)
dailyGapLookback                 = input.int(200, title="Daily Gap Lookback", minval=10, maxval=500, group=groupScalpLevels, tooltip="Number of SPY/QQQ regular-session daily bars to scan for unfilled daily gaps.")

// 04. Opening Range
showOpeningRange                 = input.bool(true, title="Show Opening Range", group=groupOpeningRange)
useManualOpeningRangeFallback    = input.bool(false, title="Use Manual Opening Range Fallback", group=groupOpeningRange)
manualOpeningRangeHigh           = input.float(0.0, title="Manual Opening Range High", step=0.25, group=groupOpeningRange)
manualOpeningRangeLow            = input.float(0.0, title="Manual Opening Range Low", step=0.25, group=groupOpeningRange)

// 05. Risk / Position Sizing
maxRiskDollars      = input.float(500.0, title="Max Risk Dollars", minval=0.0, step=10.0, group=groupRisk)
commissionRoundTrip = input.float(1.24, title="Commission Per Contract, Round Trip", minval=0.0, step=0.01, group=groupRisk)
useMaxContractCap   = input.bool(true, title="Use Max Contract Cap", group=groupRisk)
maxContracts        = input.int(20, title="Max Contracts", minval=1, group=groupRisk)

// 06. Target Settings
allowSignalExtremeHodLodTarget = input.bool(true, title="Allow Signal-Bar HOD/LOD Edge Target", group=groupTargets, tooltip="Allows HOD/LOD as the target when the signal bar itself made HOD/LOD and the entry is a 50% retracement, even if the R:R is slightly below 1:1 because the stop is one tick beyond the signal bar.")
hodLodEdgeToleranceTicks       = input.int(1, title="HOD/LOD Edge Tolerance Ticks", minval=0, maxval=4, group=groupTargets)
minHodLodEdgeRR                = input.float(0.50, title="Minimum HOD/LOD Edge R:R", minval=0.10, maxval=1.40, step=0.05, group=groupTargets, tooltip="Minimum required R:R for the unpromoted signal-bar HOD/LOD edge target exception. Normal targets still use the main minimum target R:R.")
enableTargetPromotion          = input.bool(true, title="Enable Structural Target Promotion", group=groupTargets, tooltip="Promotes OR/HOD/LOD/daily-open targets to the nearest valid structural target level when it is within the configured ATR distance.")
targetPromotionAtrMult         = input.float(1.0, title="Target Promotion ATR Multiplier", minval=0.0, step=0.25, group=groupTargets)
maxPromotedTargetRR            = input.float(6.0, title="Max Promoted Target R:R", minval=1.0, step=0.25, group=groupTargets, tooltip="Sanity guard for promoted targets. Promotion is skipped if the final target would exceed this R:R.")
maxTrackedSwingTargets         = input.int(100, title="Max Tracked 5m Swing Targets", minval=20, maxval=300, group=groupTargets)
useOneHourSwingTargets         = input.bool(true, title="Use 1H Swing Targets", group=groupTargets, tooltip="Allows uncleared 1H swing highs/lows to be used as target candidates without requiring the 1H swing blocker filter to be enabled.")
maxTrackedOneHourSwings        = input.int(50, title="Max Tracked 1H Swings", minval=10, maxval=200, group=groupTargets)
allowRthSwingsBrokenPremarket  = input.bool(true, title="Allow Prior RTH 5m Swings Broken In Premarket", group=groupTargets, tooltip="When enabled, prior RTH 5m swings remain eligible for scalp failed-breakout tracking even if they are tested or broken during the current premarket. They are still invalidated normally if broken during current RTH.")

// 07. Signal Engine Tuning
maxLookback                   = input.int(20, title="Pressure: Max Lookback", group=groupSignalEngine, minval=3, tooltip="Maximum number of bars to scan backward when finding prior up/down legs for fallback midpoint checks.")
pressureBodyWickThreshold     = input.float(0.40, title="Pressure: Body/Wick Range Threshold", group=groupSignalEngine, minval=0.05, maxval=0.95, step=0.05, tooltip="Minimum fraction of the full bar range required for body or wick qualification in pressure bar quality checks (default 40%).")
strongCloseThresholdPct       = input.float(0.33, title="Strong Close Threshold %", minval=0.05, maxval=0.50, step=0.01, group=groupSignalEngine, tooltip="Defines upper/lower strong-close zones as a fraction of bar range. Default 0.33 means upper/lower third.")
acceptableVolumeThreshold     = input(0.33, title="Acceptable Volume Threshold", group=groupSignalEngine, tooltip="Set the minimum volume threshold as a multiple of the volume average (e.g., 0.33x volume average). Bars with volume below this threshold will not display indications.")
volumeMetricLength            = input.int(50, title="Volume SMA Length", group=groupSignalEngine, minval=10, maxval=500, tooltip="Set the length for the volume SMA calculation.")
acceptableVolatilityThreshold = input(0.33, title="Acceptable Volatility Threshold", group=groupSignalEngine, tooltip="Set the minimum volatility threshold as a multiple of the ATR (e.g., 0.5x ATR). Bars with volatility below this threshold will not display indications.")
atrLength                     = input(14, title="ATR Length", group=groupSignalEngine, tooltip="Set the length of the ATR calculation.")

// 08. Display / Visuals
showBullSignals              = input.bool(true, title="Show Bull Signals", group=groupDisplay, tooltip="Enable bullish high-volume signal markers.")
showBearSignals              = input.bool(true, title="Show Bear Signals", group=groupDisplay, tooltip="Enable bearish high-volume signal markers.")
hideSignalPlotsBeforeOpeningRangeCompletes = input.bool(true, title="Hide Signal Plots Before Opening Range Completes", group=groupDisplay, tooltip="Suppresses bullish/bearish price-action signal markers until the configured opening range has completed. This affects plotted markers only, not alert logic.")
alertLabelMode               = input.string("Compact", title="Historical Alert Labels", options=["Off", "Marker Only", "Compact"], group=groupDisplay)
showAlertSignalDetails       = input.bool(false, title="Show Alert Signal Details", group=groupDisplay)
showSwingLevels              = input.bool(true, title="Show Converted Levels", group=groupDisplay, tooltip="Plots converted higher-timeframe levels used for scalp entries and targets.")
showSwingLevelLabels         = input.bool(false, title="Show Converted Level Labels", group=groupDisplay)
maxDisplayedDailyGaps        = input.int(20, title="Max Displayed Daily Gaps", minval=0, maxval=100, group=groupDisplay)
showScalpStatusTable         = input.bool(true, title="Show Scalp Status Table", group=groupDisplay)

// 09. Latest Alert Tracker
trackLatestScalpAlert = input.bool(true, "Track Latest Scalp Alert", group=groupLatestAlertTracker)
alertLatestScalpCancellation = input.bool(true, "Alert Latest Alert Cancellation", group=groupLatestAlertTracker)
showLatestScalpCancellationLabels = input.bool(true, "Show Latest Alert Cancellation Labels", group=groupLatestAlertTracker)
cancelLatestOnTargetBeforeEntry = input.bool(true, "Cancel If Target Hit Before Entry", group=groupLatestAlertTracker)
cancelLatestOnMeasuredMoveBeforeEntry = input.bool(true, "Cancel If Measured Move Hit Before Entry", group=groupLatestAlertTracker)
cancelLatestOnAgeBeforeEntry = input.bool(true, "Cancel If Entry Not Hit After Max Bars", group=groupLatestAlertTracker)
latestScalpMaxBarsAfterSignal = input.int(5, "Latest Alert Max Bars After Signal", minval=1, maxval=20, group=groupLatestAlertTracker, tooltip="Cancels the latest tracked scalp alert if the entry has not been touched after this many completed bars after the signal bar. Default 5.")

scalpPointValue = tickerInput == "MES" ? 5.0 : 2.0
scalpTickSize   = 0.25

majorHighLevelColor = color.rgb(0, 100, 0)
majorLowLevelColor = color.rgb(145, 0, 0)
openLevelColor = color.orange
openingRangeHighColor = color.rgb(70, 190, 105)
openingRangeLowColor = color.rgb(235, 95, 95)
premarketLevelColor = color.blue
paEngineHighLevelColor = color.rgb(8, 153, 129)
paEngineLowLevelColor = color.rgb(242, 54, 69)
paEngineOpenLevelColor = color.rgb(243, 152, 15)
dailyGapLineColor = color.rgb(255, 255, 255)
dailyGapBoxColor = color.rgb(255, 255, 255, 95)
dailyGapBorderColor = color.rgb(255, 255, 255, 30)
latestScalpCancellationLabelColor = color.rgb(245, 180, 45)

// ===================== Volume Calculations =====================
volumeSMA = ta.sma(volume, volumeMetricLength)
sufficientVolume = na(volume) ? true : volume > volumeSMA * acceptableVolumeThreshold

// ===================== Price Action Calculations =====================
body = math.abs(close - open)
bodyHigh = math.max(open, close)
bodyLow = math.min(open, close)
barRange = high - low
bodyPct = barRange > 0 ? body / barRange : 0.0
closeInUpperThird = barRange > 0 and close >= low + barRange * (1.0 - strongCloseThresholdPct)
closeInLowerThird = barRange > 0 and close <= low + barRange * strongCloseThresholdPct
closeInUpperFourth = barRange > 0 and close >= low + barRange * 0.75
closeInLowerFourth = barRange > 0 and close <= low + barRange * 0.25
upperWick = high - bodyHigh
lowerWick = bodyLow - low
greenCandle = close >= open
redCandle = close < open

// ===================== Pressure Signal Helpers =====================
f_safeRange(_high, _low) =>
    _r = _high - _low
    _r > 0 ? _r : na

f_closeInUpperThird(_close, _low, _range) =>
    not na(_range) and _close >= _low + _range * (1.0 - strongCloseThresholdPct)

f_closeInLowerThird(_close, _low, _range) =>
    not na(_range) and _close <= _low + _range * strongCloseThresholdPct

f_meetsPct(_value, _range, _pct) =>
    not na(_range) and _value >= _range * _pct

f_dobruskyPressure() =>
    gapUp   = close[1] < low  ? (low  - close[1]) : 0.0
    gapDown = close[1] > high ? (close[1] - high) : 0.0

    adjLow  = low  - gapUp
    adjHigh = high + gapDown
    rng     = adjHigh - adjLow

    buyPressure  = na(volume) ? na : (rng != 0 ? volume * (close - adjLow) / rng : na)
    sellPressure = volume - buyPressure
    [buyPressure, sellPressure]

f_midPriorLegDown(_maxLookback) =>
    int legStart = na
    bool hasSeq = false

    for i = 0 to _maxLookback - 1
        if na(high[i]) or na(high[i + 1])
            break
        if high[i] < high[i + 1] or (i == 0 and high[i] >= high[i + 1] and high[i + 1] < high[i + 2])
            hasSeq := true
            legStart := i + 1
        else
            break

    float legHigh = na 
    float legLow = na
    float mid = na

    if hasSeq and not na(legStart)
        for j = 0 to _maxLookback - 1
            if j <= legStart
                legLow := na(legLow) ? low[j] : math.min(legLow, low[j])
                if j == legStart
                    legHigh := high[j]
        mid := (legHigh + legLow) / 2.0

    [mid, legLow, legHigh]

f_midPriorLegUp(_maxLookback) =>
    int legStart = na
    bool hasSeq = false

    for i = 0 to _maxLookback - 1
        if na(low[i]) or na(low[i + 1])
            break
        if low[i] > low[i + 1] or (i == 0 and low[i] <= low[i + 1] and low[i + 1] > low[i + 2])
            hasSeq := true
            legStart := i + 1
        else
            break

    float legLow = na
    float legHigh = na
    float mid = na

    if hasSeq and not na(legStart)
        for j = 0 to _maxLookback - 1
            if j <= legStart
                legHigh := na(legHigh) ? high[j] : math.max(legHigh, high[j])
                if j == legStart
                    legLow := low[j]
        mid := (legHigh + legLow) / 2.0

    [mid, legLow, legHigh]

// ===================== Scalp Alert Helpers =====================
f_roundUpToScalpTick(_price) =>
    math.ceil(_price / scalpTickSize) * scalpTickSize

f_roundDownToScalpTick(_price) =>
    math.floor(_price / scalpTickSize) * scalpTickSize

f_priceText(_price) =>
    na(_price) ? "N/A" : str.tostring(_price, format.mintick)

f_rrText(_rr) =>
    na(_rr) ? "N/A" : str.tostring(_rr, "#.00") + "R"

f_abbrevLevelName(string _levelName) =>
    string normalized = str.replace_all(_levelName, "Level ", "")
    normalized == "Previous Month High" ? "PMoH" :
     normalized == "Previous Month Low" ? "PMoL" :
     normalized == "Current Month Open" ? "MO" :
     normalized == "Previous Week High" ? "PWH" :
     normalized == "Previous Week Low" ? "PWL" :
     normalized == "Current Week Open" ? "WO" :
     normalized == "Previous Day High" or normalized == "PDH" ? "PDH" :
     normalized == "Previous Day Low" or normalized == "PDL" ? "PDL" :
     normalized == "Current Day Open" or normalized == "Daily Open" or normalized == "OP" ? "DO" :
     normalized == "Premarket High" or normalized == "PMH" ? "PMH" :
     normalized == "Premarket Low" or normalized == "PML" ? "PML" :
     normalized == "15m Opening Range High" or normalized == "ORH" ? "ORH" :
     normalized == "15m Opening Range Low" or normalized == "ORL" ? "ORL" :
     normalized == "Daily Gap End" ? "DGE" :
     normalized == "Daily Gap Start" ? "DGS" :
     normalized == "5m Swing" ? "5mSw" :
     normalized == "1H Swing" ? "1HSw" :
     normalized == "HOD" ? "HOD" :
     normalized == "LOD" ? "LOD" :
     normalized

f_targetDisplayText(string _targetType, string _promotionBaseType) =>
    string targetText = f_abbrevLevelName(_targetType)
    _promotionBaseType != "N/A" ? targetText + " from " + f_abbrevLevelName(_promotionBaseType) : targetText

f_isScalpRetracementEntryLevel(string _levelName) =>
    string normalized = str.replace_all(_levelName, "Level ", "")
    normalized == "Previous Week High" or
     normalized == "Previous Week Low" or
     normalized == "Previous Day High" or
     normalized == "Previous Day Low" or
     normalized == "PDH" or
     normalized == "PDL" or
     normalized == "Current Day Open" or
     normalized == "Daily Open" or
     normalized == "OP" or
     normalized == "Premarket High" or
     normalized == "Premarket Low" or
     normalized == "PMH" or
     normalized == "PML" or
     normalized == "15m Opening Range High" or
     normalized == "15m Opening Range Low" or
     normalized == "ORH" or
     normalized == "ORL"

f_isPreviousWeekLevel(string _levelName) =>
    string normalized = str.replace_all(_levelName, "Level ", "")
    normalized == "Previous Week High" or
     normalized == "Previous Week Low" or
     normalized == "PWH" or
     normalized == "PWL"

f_isPreviousWeekHighLevel(string _levelName) =>
    string normalized = str.replace_all(_levelName, "Level ", "")
    normalized == "Previous Week High" or
     normalized == "PWH"

f_isPreviousWeekLowLevel(string _levelName) =>
    string normalized = str.replace_all(_levelName, "Level ", "")
    normalized == "Previous Week Low" or
     normalized == "PWL"

f_isPreviousDayHighLevel(string _levelName) =>
    string normalized = str.replace_all(_levelName, "Level ", "")
    normalized == "Previous Day High" or
     normalized == "PDH"

f_isPreviousDayLowLevel(string _levelName) =>
    string normalized = str.replace_all(_levelName, "Level ", "")
    normalized == "Previous Day Low" or
     normalized == "PDL"

f_isLeanScalpTradeLevel(string _levelId) =>
    bool isLeanLevel = false
    isLeanLevel := isLeanLevel or _levelId == "Premarket High"
    isLeanLevel := isLeanLevel or _levelId == "Premarket Low"
    isLeanLevel := isLeanLevel or _levelId == "15m Opening Range High"
    isLeanLevel := isLeanLevel or _levelId == "15m Opening Range Low"
    isLeanLevel := isLeanLevel or _levelId == "HOD"
    isLeanLevel := isLeanLevel or _levelId == "LOD"
    isLeanLevel := isLeanLevel or _levelId == "5m Swing"
    isLeanLevel := isLeanLevel or _levelId == "Previous Day High"
    isLeanLevel := isLeanLevel or _levelId == "Previous Day Low"
    isLeanLevel := isLeanLevel or _levelId == "PDH"
    isLeanLevel := isLeanLevel or _levelId == "PDL"
    isLeanLevel := isLeanLevel or _levelId == "Previous Week High"
    isLeanLevel := isLeanLevel or _levelId == "Previous Week Low"
    isLeanLevel

f_isExtendedContextLevel(string _levelId) =>
    bool isExtendedLevel = false
    isExtendedLevel := isExtendedLevel or _levelId == "Current Week Open"
    isExtendedLevel := isExtendedLevel or _levelId == "Weekly Open"
    isExtendedLevel := isExtendedLevel or _levelId == "Current Month Open"
    isExtendedLevel := isExtendedLevel or _levelId == "Month Open"
    isExtendedLevel := isExtendedLevel or _levelId == "Previous Month High"
    isExtendedLevel := isExtendedLevel or _levelId == "Previous Month Low"
    isExtendedLevel := isExtendedLevel or _levelId == "Daily Gap Start"
    isExtendedLevel := isExtendedLevel or _levelId == "Daily Gap End"
    isExtendedLevel

f_isLevelAllowedForScalpTrade(string _levelId) =>
    f_isLeanScalpTradeLevel(_levelId) and not f_isExtendedContextLevel(_levelId)

f_levelTouched(bool _enabled, float _levelPrice, float _signalLow, float _signalHigh) =>
    _enabled and _levelPrice > 0 and _levelPrice >= _signalLow and _levelPrice <= _signalHigh

f_priceTouchedByBar(float _price, float _low, float _high) =>
    not na(_price) and _price > 0 and not na(_low) and not na(_high) and _price >= _low and _price <= _high

f_priceTouchedByBody(float _price, float _open, float _close) =>
    float _bodyLow = math.min(_open, _close)
    float _bodyHigh = math.max(_open, _close)
    not na(_price) and _price > 0 and not na(_open) and not na(_close) and _price >= _bodyLow and _price <= _bodyHigh

f_levelTouchedByPriorBar(bool _enabled, float _levelPrice, float _priorLow, float _priorHigh, bool _priorOppositeColor) =>
    _priorOppositeColor and not na(_priorLow) and not na(_priorHigh) and f_levelTouched(_enabled, _levelPrice, _priorLow, _priorHigh)

f_roundToScalpTick(_price) =>
    math.round(_price / scalpTickSize) * scalpTickSize

f_validSourcePrice(_price) =>
    not na(_price) and _price > 0


f_levelClosedBeyondLong(_level, _signalClose) =>
    _signalClose > _level

f_levelClosedBeyondShort(_level, _signalClose) =>
    _signalClose < _level

f_longTouchedLevelFailedCloseBeyond(_enabled, _level, _signalLow, _signalHigh, _signalClose) =>
    bool touched = f_levelTouched(_enabled, _level, _signalLow, _signalHigh)
    touched and not f_levelClosedBeyondLong(_level, _signalClose)

f_shortTouchedLevelFailedCloseBeyond(_enabled, _level, _signalLow, _signalHigh, _signalClose) =>
    bool touched = f_levelTouched(_enabled, _level, _signalLow, _signalHigh)
    touched and not f_levelClosedBeyondShort(_level, _signalClose)

f_longLevelTouchedAndCleared(bool _enabled, float _levelPrice, float _signalLow, float _signalHigh, float _signalClose) =>
    f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh) and f_levelClosedBeyondLong(_levelPrice, _signalClose)

f_shortLevelTouchedAndCleared(bool _enabled, float _levelPrice, float _signalLow, float _signalHigh, float _signalClose) =>
    f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh) and f_levelClosedBeyondShort(_levelPrice, _signalClose)

f_longTouchedClearedLevelRetracementOk(bool _enabled, float _levelPrice, float _signalLow, float _signalHigh, float _signalClose, float _minRetracement) =>
    bool touchedAndCleared = f_longLevelTouchedAndCleared(_enabled, _levelPrice, _signalLow, _signalHigh, _signalClose)
    float entryRange = _signalHigh - _signalLow
    not touchedAndCleared or (entryRange > 0 and (_signalHigh - _levelPrice) / entryRange >= _minRetracement)

f_shortTouchedClearedLevelRetracementOk(bool _enabled, float _levelPrice, float _signalLow, float _signalHigh, float _signalClose, float _minRetracement) =>
    bool touchedAndCleared = f_shortLevelTouchedAndCleared(_enabled, _levelPrice, _signalLow, _signalHigh, _signalClose)
    float entryRange = _signalHigh - _signalLow
    not touchedAndCleared or (entryRange > 0 and (_levelPrice - _signalLow) / entryRange >= _minRetracement)

f_longPriorCloseDidNotMeaningfullyBreakSupport(float _priorClose, float _priorLevel, float _priorLow, float _priorHigh, float _breakPct) =>
    float _priorRange = _priorHigh - _priorLow
    bool _levelReady = not na(_priorLevel) and _priorLevel > 0
    bool _rangeReady = not na(_priorRange) and _priorRange > 0
    bool _meaningfulBreak = _levelReady and _rangeReady and _priorClose < _priorLevel and ((_priorLevel - _priorClose) / _priorRange) >= _breakPct
    not _meaningfulBreak

f_shortPriorCloseDidNotMeaningfullyBreakResistance(float _priorClose, float _priorLevel, float _priorLow, float _priorHigh, float _breakPct) =>
    float _priorRange = _priorHigh - _priorLow
    bool _levelReady = not na(_priorLevel) and _priorLevel > 0
    bool _rangeReady = not na(_priorRange) and _priorRange > 0
    bool _meaningfulBreak = _levelReady and _rangeReady and _priorClose > _priorLevel and ((_priorClose - _priorLevel) / _priorRange) >= _breakPct
    not _meaningfulBreak

f_currentRthOpen() =>
    var float rthOpen = na
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    int dateKey = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
    int priorDateKey = bar_index > 0 ? dateKey[1] : dateKey
    bool wasInRth = bar_index > 0 ? inRth[1] : false
    bool newRth = inRth and (not wasInRth or dateKey != priorDateKey)
    if newRth
        rthOpen := open
    else if not inRth and dateKey != priorDateKey
        rthOpen := na
    rthOpen

getHighLowOpen() =>
    [high[1], low[1], open]

getHigherTimeframeData(_timeframe, _ticker) =>
    // Mirrors the PA Engine level request: previous completed H/L plus current HTF open.
    request.security(_ticker, _timeframe, getHighLowOpen(), lookahead=barmerge.lookahead_on, calc_bars_count=500)

getGaps(_lookBack) =>
    map<int, string> gapsDict = map.new<int, string>()
    i = _lookBack
    float atrSumForGaps = 0.0
    // Build the map as it would exist at the current RTH open. Completed daily
    // bars may update/remove old gaps, but the current day only contributes its
    // open-vs-prior-close gap so historical high/low data cannot leak forward.
    while i >= 1
        dailyOpen = open[i]
        dailyLow = low[i]
        dailyHigh = high[i]
        prevClose = close[i + 1]
        if i <= atrLength
            atrSumForGaps := atrSumForGaps + math.max(dailyHigh - dailyLow, math.max(math.abs(dailyHigh - prevClose), math.abs(dailyLow - prevClose)))
        if dailyOpen != prevClose
            gapHigh = str.tostring(math.max(dailyOpen, prevClose))
            gapLow = str.tostring(math.min(dailyOpen, prevClose))
            isGapUp = dailyOpen > prevClose
            dir = isGapUp ? "U" : "D"
            gapsDict.put(time[i], dir + "|" + gapHigh + "," + gapLow + ":" + gapHigh + "," + gapLow)

        keysToRemove = array.new_int(0)
        if not barstate.isrealtime[i]
            for [key, value] in gapsDict
                gapOriginalAndPartial = str.split(value, ":")
                partialGapHighAndLow = str.split(array.get(gapOriginalAndPartial, 1), ",")
                partialGapHigh = str.tonumber(array.get(partialGapHighAndLow, 0))
                partialGapLow = str.tonumber(array.get(partialGapHighAndLow, 1))
                if dailyLow <= partialGapLow and dailyHigh >= partialGapHigh
                    array.push(keysToRemove, key)
                else
                    if dailyLow > partialGapLow and dailyLow < partialGapHigh
                        partialGapHigh := dailyLow
                        gapsDict.put(key, array.get(gapOriginalAndPartial, 0) + ":" + str.tostring(partialGapHigh) + "," + str.tostring(partialGapLow))
                    if dailyHigh < partialGapHigh and dailyHigh > partialGapLow
                        partialGapLow := dailyHigh
                        gapsDict.put(key, array.get(gapOriginalAndPartial, 0) + ":" + str.tostring(partialGapHigh) + "," + str.tostring(partialGapLow))
        for key in keysToRemove
            gapsDict.remove(key)
        i := i - 1

    currentDailyOpen = open
    currentPrevClose = close[1]
    if not na(currentDailyOpen) and not na(currentPrevClose) and currentDailyOpen != currentPrevClose
        currentGapHigh = str.tostring(math.max(currentDailyOpen, currentPrevClose))
        currentGapLow = str.tostring(math.min(currentDailyOpen, currentPrevClose))
        currentIsGapUp = currentDailyOpen > currentPrevClose
        currentDir = currentIsGapUp ? "U" : "D"
        gapsDict.put(time, currentDir + "|" + currentGapHigh + "," + currentGapLow + ":" + currentGapHigh + "," + currentGapLow)

    keysToRemove = array.new_int(0)
    atrForGaps = atrSumForGaps / atrLength
    for [key, value] in gapsDict
        gapOriginalAndPartial = str.split(value, ":")
        partialGapHighAndLow = str.split(array.get(gapOriginalAndPartial, 1), ",")
        gapSize = math.abs(str.tonumber(array.get(partialGapHighAndLow, 0)) - str.tonumber(array.get(partialGapHighAndLow, 1)))
        if gapSize < atrForGaps * 0.1
            array.push(keysToRemove, key)
    for key in keysToRemove
        gapsDict.remove(key)
    gapsDict

f_gapBoundaryPriceFromRecord(string _gapRecord, bool _useHighSide) =>
    float gapBoundaryPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapBoundaryPrice := str.tonumber(array.get(gapHighAndLow, _useHighSide ? 0 : 1))
    gapBoundaryPrice

f_gapHighPriceFromRecord(string _gapRecord) =>
    f_gapBoundaryPriceFromRecord(_gapRecord, true)

f_gapLowPriceFromRecord(string _gapRecord) =>
    f_gapBoundaryPriceFromRecord(_gapRecord, false)

f_gapEndPriceFromRecord(string _gapRecord) =>
    float gapEndPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh = str.tonumber(array.get(gapHighAndLow, 0))
                gapLow = str.tonumber(array.get(gapHighAndLow, 1))
                // Gap end = prior-close side of the gap.
                // Gap up: low side. Gap down: high side.
                gapEndPrice := dir == "U" ? gapLow : gapHigh
    gapEndPrice

f_gapStartPriceFromRecord(string _gapRecord) =>
    float gapStartPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh = str.tonumber(array.get(gapHighAndLow, 0))
                gapLow = str.tonumber(array.get(gapHighAndLow, 1))
                // Gap start = daily-open side of the gap.
                // Gap up: high side. Gap down: low side.
                gapStartPrice := dir == "U" ? gapHigh : gapLow
    gapStartPrice

f_parseGapRecord(string _gapRecord) =>
    bool gapParsed = false
    float gapStart = na
    float gapEnd = na
    float gapHigh = na
    float gapLow = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if (dir == "U" or dir == "D") and array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh := str.tonumber(array.get(gapHighAndLow, 0))
                gapLow := str.tonumber(array.get(gapHighAndLow, 1))
                if not na(gapHigh) and not na(gapLow)
                    gapStart := dir == "U" ? gapHigh : gapLow
                    gapEnd := dir == "U" ? gapLow : gapHigh
                    gapParsed := true
    [gapParsed, gapStart, gapEnd, gapHigh, gapLow]

f_isBullBar(_open, _close) =>
    not na(_open) and not na(_close) and _close > _open

f_isBearBar(_open, _close) =>
    not na(_open) and not na(_close) and _close < _open

f_priorBearPressureCount(int _lookback, float _minBodyPct) =>
    int count = 0
    for pressureIndex = 1 to _lookback
        count += f_isBearBar(open[pressureIndex], close[pressureIndex]) and bodyPct[pressureIndex] >= _minBodyPct ? 1 : 0
    count

f_priorBullPressureCount(int _lookback, float _minBodyPct) =>
    int count = 0
    for pressureIndex = 1 to _lookback
        count += f_isBullBar(open[pressureIndex], close[pressureIndex]) and bodyPct[pressureIndex] >= _minBodyPct ? 1 : 0
    count

f_pickLongQualifiedLevel(bool _enabled, float _levelPrice, string _levelName, int _levelPriority, float _signalLow, float _signalHigh, float _signalClose, float _priorLow, float _priorHigh, bool _priorBear, float _bestPrice, string _bestName, int _bestPriority, bool _bestCurrentTouched, bool _found) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    bool nextCurrentTouched = _bestCurrentTouched
    bool nextFound = _found
    bool currentTouched = f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh)
    bool priorTouched = f_levelTouchedByPriorBar(_enabled, _levelPrice, _priorLow, _priorHigh, _priorBear)
    bool levelQualified = (currentTouched or priorTouched) and _signalClose > _levelPrice
    bool betterLevel = not nextFound or _levelPriority < nextPriority or (_levelPriority == nextPriority and (na(nextPrice) or _levelPrice > nextPrice))
    if levelQualified and betterLevel
        nextPrice := _levelPrice
        nextName := _levelName
        nextPriority := _levelPriority
        nextCurrentTouched := currentTouched
        nextFound := true
    [nextPrice, nextName, nextPriority, nextCurrentTouched, nextFound]

f_pickShortQualifiedLevel(bool _enabled, float _levelPrice, string _levelName, int _levelPriority, float _signalLow, float _signalHigh, float _signalClose, float _priorLow, float _priorHigh, bool _priorBull, float _bestPrice, string _bestName, int _bestPriority, bool _bestCurrentTouched, bool _found) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    bool nextCurrentTouched = _bestCurrentTouched
    bool nextFound = _found
    bool currentTouched = f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh)
    bool priorTouched = f_levelTouchedByPriorBar(_enabled, _levelPrice, _priorLow, _priorHigh, _priorBull)
    bool levelQualified = (currentTouched or priorTouched) and _signalClose < _levelPrice
    bool betterLevel = not nextFound or _levelPriority < nextPriority or (_levelPriority == nextPriority and (na(nextPrice) or _levelPrice < nextPrice))
    if levelQualified and betterLevel
        nextPrice := _levelPrice
        nextName := _levelName
        nextPriority := _levelPriority
        nextCurrentTouched := currentTouched
        nextFound := true
    [nextPrice, nextName, nextPriority, nextCurrentTouched, nextFound]

f_pickLongEntryCandidate(float _candidatePrice, string _candidateName, int _candidatePriority, bool _candidateCurrentTouched, bool _candidateFound, float _bestPrice, string _bestName, int _bestPriority, bool _bestCurrentTouched, bool _bestFound) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    bool nextCurrentTouched = _bestCurrentTouched
    bool nextFound = _bestFound
    bool betterCandidate = _candidateFound and (not nextFound or _candidatePriority < nextPriority or (_candidatePriority == nextPriority and (na(nextPrice) or _candidatePrice > nextPrice)))
    if betterCandidate
        nextPrice := _candidatePrice
        nextName := _candidateName
        nextPriority := _candidatePriority
        nextCurrentTouched := _candidateCurrentTouched
        nextFound := true
    [nextPrice, nextName, nextPriority, nextCurrentTouched, nextFound]

f_pickShortEntryCandidate(float _candidatePrice, string _candidateName, int _candidatePriority, bool _candidateCurrentTouched, bool _candidateFound, float _bestPrice, string _bestName, int _bestPriority, bool _bestCurrentTouched, bool _bestFound) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    bool nextCurrentTouched = _bestCurrentTouched
    bool nextFound = _bestFound
    bool betterCandidate = _candidateFound and (not nextFound or _candidatePriority < nextPriority or (_candidatePriority == nextPriority and (na(nextPrice) or _candidatePrice < nextPrice)))
    if betterCandidate
        nextPrice := _candidatePrice
        nextName := _candidateName
        nextPriority := _candidatePriority
        nextCurrentTouched := _candidateCurrentTouched
        nextFound := true
    [nextPrice, nextName, nextPriority, nextCurrentTouched, nextFound]

f_targetRRLong(float _targetPrice, float _entryPrice, float _riskPoints) =>
    float rewardPoints = _targetPrice - _entryPrice
    not na(_targetPrice) and not na(_entryPrice) and not na(_riskPoints) and rewardPoints > 0 and _riskPoints > 0 ? rewardPoints / _riskPoints : na

f_targetRRShort(float _targetPrice, float _entryPrice, float _riskPoints) =>
    float rewardPoints = _entryPrice - _targetPrice
    not na(_targetPrice) and not na(_entryPrice) and not na(_riskPoints) and rewardPoints > 0 and _riskPoints > 0 ? rewardPoints / _riskPoints : na

f_longHodEdgeQualifies(float _targetPrice, string _targetType, string _entryType, float _signalHigh, float _entryPrice, float _riskPoints, float _currentRTHHigh) =>
    float rewardPoints = _targetPrice - _entryPrice
    float rr = f_targetRRLong(_targetPrice, _entryPrice, _riskPoints)
    bool signalBarMadeHod = not na(_signalHigh) and not na(_currentRTHHigh) and math.abs(_signalHigh - _currentRTHHigh) <= hodLodEdgeToleranceTicks * scalpTickSize
    allowSignalExtremeHodLodTarget and
     _targetType == "HOD" and
     signalBarMadeHod and
     not na(_targetPrice) and
     _targetPrice > 0 and
     not na(_entryPrice) and
     _entryPrice > 0 and
     not na(_riskPoints) and
     _riskPoints > 0 and
     rewardPoints > 0 and
     not na(rr) and
     rr >= minHodLodEdgeRR

f_shortLodEdgeQualifies(float _targetPrice, string _targetType, string _entryType, float _signalLow, float _entryPrice, float _riskPoints, float _currentRTHLow) =>
    float rewardPoints = _entryPrice - _targetPrice
    float rr = f_targetRRShort(_targetPrice, _entryPrice, _riskPoints)
    bool signalBarMadeLod = not na(_signalLow) and not na(_currentRTHLow) and math.abs(_signalLow - _currentRTHLow) <= hodLodEdgeToleranceTicks * scalpTickSize
    allowSignalExtremeHodLodTarget and
     _targetType == "LOD" and
     signalBarMadeLod and
     not na(_targetPrice) and
     _targetPrice > 0 and
     not na(_entryPrice) and
     _entryPrice > 0 and
     not na(_riskPoints) and
     _riskPoints > 0 and
     rewardPoints > 0 and
     not na(rr) and
     rr >= minHodLodEdgeRR

f_longTargetQualifies(float _targetPrice, string _targetType, string _entryType, float _signalHigh, float _entryPrice, float _riskPoints, float _currentRTHHigh) =>
    bool priceReady = not na(_targetPrice) and _targetPrice > 0
    bool locationOk = priceReady and (_targetType == "HOD" ? _targetPrice >= _signalHigh : _targetPrice > _signalHigh)
    float rr = f_targetRRLong(_targetPrice, _entryPrice, _riskPoints)
    bool normalTargetOk = locationOk and not na(rr) and rr >= minTargetRR
    bool edgeTargetOk = locationOk and f_longHodEdgeQualifies(_targetPrice, _targetType, _entryType, _signalHigh, _entryPrice, _riskPoints, _currentRTHHigh)
    normalTargetOk or edgeTargetOk

f_shortTargetQualifies(float _targetPrice, string _targetType, string _entryType, float _signalLow, float _entryPrice, float _riskPoints, float _currentRTHLow) =>
    bool priceReady = not na(_targetPrice) and _targetPrice > 0
    bool locationOk = priceReady and (_targetType == "LOD" ? _targetPrice <= _signalLow : _targetPrice < _signalLow)
    float rr = f_targetRRShort(_targetPrice, _entryPrice, _riskPoints)
    bool normalTargetOk = locationOk and not na(rr) and rr >= minTargetRR
    bool edgeTargetOk = locationOk and f_shortLodEdgeQualifies(_targetPrice, _targetType, _entryType, _signalLow, _entryPrice, _riskPoints, _currentRTHLow)
    normalTargetOk or edgeTargetOk

f_sameRoundedTargetPrice(float _leftPrice, float _rightPrice) =>
    not na(_leftPrice) and not na(_rightPrice) and f_roundToScalpTick(_leftPrice) == f_roundToScalpTick(_rightPrice)

f_longTargetCandidateBetter(float _candidatePrice, int _candidatePriority, float _bestPrice, int _bestPriority) =>
    bool samePrice = f_sameRoundedTargetPrice(_candidatePrice, _bestPrice)
    na(_bestPrice) or (not samePrice and _candidatePrice < _bestPrice) or (samePrice and _candidatePriority < _bestPriority)

f_shortTargetCandidateBetter(float _candidatePrice, int _candidatePriority, float _bestPrice, int _bestPriority) =>
    bool samePrice = f_sameRoundedTargetPrice(_candidatePrice, _bestPrice)
    na(_bestPrice) or (not samePrice and _candidatePrice > _bestPrice) or (samePrice and _candidatePriority < _bestPriority)

f_swingTargetSessionAllowed(string _session, int _dateKey, int _currentDateKey, int _currentRTHDateKey, int _previousRTHDateKey) =>
    bool pmAllowed = _session == "PM" and _dateKey == _currentDateKey
    bool rthCurrentAllowed = _session == "RTH" and not na(_currentRTHDateKey) and _dateKey == _currentRTHDateKey
    bool rthPreviousAllowed = _session == "RTH" and not na(_previousRTHDateKey) and _dateKey == _previousRTHDateKey
    pmAllowed or rthCurrentAllowed or rthPreviousAllowed

f_swingBreakCanInvalidate(bool _allowRthSwingsBrokenPremarket, bool _currentInPremarket, string _swingSession, int _swingDateKey, int _mostRecentCompletedRTHDateKey) =>
    not (_allowRthSwingsBrokenPremarket and _currentInPremarket and _swingSession == "RTH" and not na(_mostRecentCompletedRTHDateKey) and _swingDateKey == _mostRecentCompletedRTHDateKey)

f_hasPivotBar(array<int> _pivotBars, int _pivotBar) =>
    bool found = false
    if array.size(_pivotBars) > 0
        for pivotBarIndex = 0 to array.size(_pivotBars) - 1
            if array.get(_pivotBars, pivotBarIndex) == _pivotBar
                found := true
                break
    found

f_hasIntValue(array<int> _values, int _value) =>
    bool found = false
    if array.size(_values) > 0
        for valueIndex = 0 to array.size(_values) - 1
            if array.get(_values, valueIndex) == _value
                found := true
                break
    found

oneHourSwingSessionRTH = 1
oneHourSwingSessionPM = 2
oneHourSwingSessionON = 3

f_oneHourSwingData() =>
    float pivotHigh = ta.pivothigh(high, 2, 2)
    float pivotLow = ta.pivotlow(low, 2, 2)
    int pivotTime = time[2]
    int pivotMinuteOfDay = hour(time[2], "America/New_York") * 60 + minute(time[2], "America/New_York")
    int pivotSessionCode = pivotMinuteOfDay >= 570 and pivotMinuteOfDay < 960 ? oneHourSwingSessionRTH : pivotMinuteOfDay >= 240 and pivotMinuteOfDay < 570 ? oneHourSwingSessionPM : oneHourSwingSessionON
    int pivotContextTime = pivotSessionCode == oneHourSwingSessionON and pivotMinuteOfDay >= 960 ? pivotTime + 24 * 60 * 60 * 1000 : pivotTime
    int pivotContextDateKey = year(pivotContextTime, "America/New_York") * 10000 + month(pivotContextTime, "America/New_York") * 100 + dayofmonth(pivotContextTime, "America/New_York")
    [pivotHigh, pivotLow, pivotTime, pivotContextDateKey, pivotSessionCode]

f_oneHourSwingSessionAllowed(int _sessionCode, int _dateKey, int _currentDateKey, int _previousRTHDateKey) =>
    bool previousRthAllowed = _sessionCode == oneHourSwingSessionRTH and not na(_previousRTHDateKey) and _dateKey == _previousRTHDateKey
    bool currentPremarketAllowed = _sessionCode == oneHourSwingSessionPM and _dateKey == _currentDateKey
    bool currentOvernightAllowed = _sessionCode == oneHourSwingSessionON and _dateKey == _currentDateKey
    previousRthAllowed or currentPremarketAllowed or currentOvernightAllowed

f_oneHourHighAlreadyCleared(float _pivotHigh, int _pivotTime) =>
    bool cleared = false
    int maxScanBars = 500
    for scanIndex = 0 to maxScanBars
        if not na(time[scanIndex]) and time[scanIndex] > _pivotTime and not na(low[scanIndex]) and low[scanIndex] > _pivotHigh
            cleared := true
            break
    cleared

f_oneHourLowAlreadyCleared(float _pivotLow, int _pivotTime) =>
    bool cleared = false
    int maxScanBars = 500
    for scanIndex = 0 to maxScanBars
        if not na(time[scanIndex]) and time[scanIndex] > _pivotTime and not na(high[scanIndex]) and high[scanIndex] < _pivotLow
            cleared := true
            break
    cleared

// ===================== ATR Calculation (RTH only) =====================
var float atrSum = 0.0
var trArray = array.new_float(0)
isRTH = time(timeframe.period, "0930-1600:23456", "America/New_York") != 0 or timeframe.isdwm
trValue = ta.tr(true)
atrValue = 0.0
if isRTH
    atrSum += trValue
    array.push(trArray, trValue)
    if array.size(trArray) > atrLength
        removed = array.shift(trArray)
        atrSum -= removed
    atrValue := atrSum / array.size(trArray)
else
    atrValue := nz(atrValue[1])

sufficientVolatility = barRange >= atrValue * acceptableVolatilityThreshold

// ===================== RTH / Opening Range Logic =====================
scalpRTHTime = time(timeframe.period, "0930-1600:23456", "America/New_York")
openingRangeTime = time(timeframe.period, "0930-0945:23456", "America/New_York")
premarketTime = time(timeframe.period, "0400-0930:23456", "America/New_York")
inScalpRTHSession = not na(scalpRTHTime)
inPremarketSession = not na(premarketTime)
inOpeningRangeWindow = inScalpRTHSession and not na(openingRangeTime)
inAlertTradingWindow = not na(time(timeframe.period, alertTradingWindow, "America/New_York"))
nySessionDateKey = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
priorNYSessionDateKey = bar_index > 0 ? nySessionDateKey[1] : nySessionDateKey
wasInScalpRTHSession = bar_index > 0 ? inScalpRTHSession[1] : false
wasInPremarketSession = bar_index > 0 ? inPremarketSession[1] : false
newNYSessionDate = bar_index > 0 and nySessionDateKey != priorNYSessionDateKey
newScalpRTHSession = inScalpRTHSession and (not wasInScalpRTHSession or nySessionDateKey != priorNYSessionDateKey)
newPremarketSession = inPremarketSession and (not wasInPremarketSession or nySessionDateKey != priorNYSessionDateKey)

// Auto scalp levels are intended for intraday charts, ideally 5m.
var float currentRTHHigh = na
var float currentRTHLow = na
var float autoPrevDayHigh = na
var float autoPrevDayLow = na
var float autoDailyOpen = na
var float autoPremarketHigh = na
var float autoPremarketLow = na
var float finalizedPremarketHigh = na
var float finalizedPremarketLow = na
var int autoPremarketDateKey = na
var int currentRTHDateKey = na
var int previousRTHDateKey = na
var int currentRTHStartBar = na
var array<float> swingHighPrices = array.new_float(0)
var array<int> swingHighPivotBars = array.new_int(0)
var array<int> swingHighDateKeys = array.new_int(0)
var array<string> swingHighSessions = array.new_string(0)
var array<bool> swingHighActive = array.new_bool(0)
var array<bool> swingHighObstacleActive = array.new_bool(0)
var array<float> swingLowPrices = array.new_float(0)
var array<int> swingLowPivotBars = array.new_int(0)
var array<int> swingLowDateKeys = array.new_int(0)
var array<string> swingLowSessions = array.new_string(0)
var array<bool> swingLowActive = array.new_bool(0)
var array<bool> swingLowObstacleActive = array.new_bool(0)
var array<float> rthSwingHistHighs = array.new_float()
var array<float> rthSwingHistLows = array.new_float()
var array<int> rthSwingHistBarIndexes = array.new_int()
var array<int> rthSwingHistDateKeys = array.new_int()
var array<float> pmSwingHistHighs = array.new_float()
var array<float> pmSwingHistLows = array.new_float()
var array<int> pmSwingHistBarIndexes = array.new_int()
var array<int> pmSwingHistDateKeys = array.new_int()
var array<float> oneHourSwingHighPrices = array.new_float()
var array<int> oneHourSwingHighTimes = array.new_int()
var array<int> oneHourSwingHighDateKeys = array.new_int()
var array<int> oneHourSwingHighSessionCodes = array.new_int()
var array<bool> oneHourSwingHighActive = array.new_bool()
var array<float> oneHourSwingLowPrices = array.new_float()
var array<int> oneHourSwingLowTimes = array.new_int()
var array<int> oneHourSwingLowDateKeys = array.new_int()
var array<int> oneHourSwingLowSessionCodes = array.new_int()
var array<bool> oneHourSwingLowActive = array.new_bool()

if newNYSessionDate and not inScalpRTHSession and not inPremarketSession
    autoDailyOpen := na
    finalizedPremarketHigh := na
    finalizedPremarketLow := na

if newPremarketSession
    autoPremarketHigh := high
    autoPremarketLow := low
    autoDailyOpen := na
    finalizedPremarketHigh := na
    finalizedPremarketLow := na
    autoPremarketDateKey := nySessionDateKey
else if inPremarketSession
    autoPremarketHigh := na(autoPremarketHigh) ? high : math.max(autoPremarketHigh, high)
    autoPremarketLow := na(autoPremarketLow) ? low : math.min(autoPremarketLow, low)
    autoPremarketDateKey := nySessionDateKey

if newScalpRTHSession
    if not na(currentRTHDateKey)
        previousRTHDateKey := currentRTHDateKey
    currentRTHDateKey := nySessionDateKey
    currentRTHStartBar := bar_index
    autoPrevDayHigh := currentRTHHigh
    autoPrevDayLow := currentRTHLow
    currentRTHHigh := high
    currentRTHLow := low
    autoDailyOpen := open
    currentPremarketReady = autoPremarketDateKey == nySessionDateKey and not na(autoPremarketHigh) and not na(autoPremarketLow)
    finalizedPremarketHigh := currentPremarketReady ? autoPremarketHigh : na
    finalizedPremarketLow := currentPremarketReady ? autoPremarketLow : na
else if inScalpRTHSession
    currentRTHHigh := na(currentRTHHigh) ? high : math.max(currentRTHHigh, high)
    currentRTHLow := na(currentRTHLow) ? low : math.min(currentRTHLow, low)

effectivePrevDayHigh = useAutoPrevDayHighLow and not na(autoPrevDayHigh) ? autoPrevDayHigh : prevDayHighLevel
effectivePrevDayLow = useAutoPrevDayHighLow and not na(autoPrevDayLow) ? autoPrevDayLow : prevDayLowLevel
effectiveDailyOpen = useAutoDailyOpen and not na(autoDailyOpen) ? autoDailyOpen : dailyOpenLevel
activeTradeDailyOpen = useDailyOpenLevel ? effectiveDailyOpen : na
activeTradeDailyOpenValid = useDailyOpenLevel and f_validSourcePrice(activeTradeDailyOpen)
effectivePremarketHigh = useAutoPremarketHighLow and not na(finalizedPremarketHigh) ? finalizedPremarketHigh : premarketHighLevel
effectivePremarketLow = useAutoPremarketHighLow and not na(finalizedPremarketLow) ? finalizedPremarketLow : premarketLowLevel
premarketDisplayHigh = showAutoScalpLevels and usePremarketHighLevel and timeframe.isintraday ? (inPremarketSession ? autoPremarketHigh : inScalpRTHSession ? finalizedPremarketHigh : na) : na
premarketDisplayLow = showAutoScalpLevels and usePremarketLowLevel and timeframe.isintraday ? (inPremarketSession ? autoPremarketLow : inScalpRTHSession ? finalizedPremarketLow : na) : na

// ===================== Converted Source Levels =====================
// MES defaults to AMEX:SPY. TradingView alerts may require real-time entitlement
// for the exact feed used by request.security(), even if it appears usable on charts.
defaultConvertedSourceSymbol = tickerInput == "MES" ? "AMEX:SPY" : "NASDAQ:QQQ"
defaultConvertedSourceTicker = tickerInput == "MES" ? ticker.new("AMEX", "SPY", "us_regular:23456") : ticker.new("NASDAQ", "QQQ", "us_regular:23456")
explicitDailyGapSourceTicker = tickerInput == "MES" ? ticker.new("AMEX", "SPY", "us_regular:23456") : ticker.new("NASDAQ", "QQQ", "us_regular:23456")
convertedHtfTradeLevelsEnabled = useConvertedHtfLevelsForTradeLogic
sourceLevelsEnabled = convertedHtfTradeLevelsEnabled or showSwingLevels
convertedLevelSourceSymbol = sourceLevelsEnabled ? (convertedLevelsSourceMode == "Manual Source" ? manualConvertedLevelsSourceSymbol : defaultConvertedSourceSymbol) : "None"
convertedLevelSourceTicker = sourceLevelsEnabled ? (convertedLevelsSourceMode == "Manual Source" ? manualConvertedLevelsSourceSymbol : defaultConvertedSourceTicker) : ""
sourceCloseForConversionNeeded = sourceLevelsEnabled
dailyGapRequestEnabled = sourceLevelsEnabled and includeDailyGapsInConvertedLevels and showSwingLevels and maxDisplayedDailyGaps > 0
activeDailyGapSourceTicker = convertedLevelsSourceMode == "Manual Source" ? manualConvertedLevelsSourceSymbol : explicitDailyGapSourceTicker
activeDailyGapTimeframe = "1440"

// The HTF source values are frozen once per RTH session. Their converted chart
// prices still use currentConversionRatio below, so live ratio drift is preserved.
float sourcePrevDayHigh = na
float sourcePrevDayLow = na
float sourcePrevWeekHigh = na
float sourcePrevWeekLow = na
float sourceWeekOpen = na
float sourcePrevMonthHigh = na
float sourcePrevMonthLow = na
float sourceMonthOpen = na
float sourceDayOpen = na
float sourceCloseForConversion = na
map<int, string> sourceDailyGaps = na
var float lastRthChartCloseForDisplayConversion = na
var float lastRthSourceCloseForDisplayConversion = na
var float cachedSourcePrevDayHigh = na
var float cachedSourcePrevDayLow = na
var float cachedSourceDayOpenHTF = na
var float cachedSourcePrevWeekHigh = na
var float cachedSourcePrevWeekLow = na
var float cachedSourceWeekOpen = na
var float cachedSourcePrevMonthHigh = na
var float cachedSourcePrevMonthLow = na
var float cachedSourceMonthOpen = na
var float cachedSourceDayOpenIntraday = na
var float cachedSourceDayOpen = na
var int convertedSourceCacheSessionDateKey = na
var array<float> cachedSourceDailyGapStarts = array.new_float()
var array<float> cachedSourceDailyGapEnds = array.new_float()
var array<float> cachedSourceDailyGapHighs = array.new_float()
var array<float> cachedSourceDailyGapLows = array.new_float()
var array<int> cachedSourceDailyGapKeys = array.new_int()
var int cachedSourceDailyGapSessionDateKey = na

var array<float> swingLevelPrices = array.new_float()
var array<string> swingLevelNames = array.new_string()
var array<int> swingLevelPriority = array.new_int()
var array<bool> swingLevelAllowedForEntry = array.new_bool()
var array<bool> swingLevelAllowedForTarget = array.new_bool()
var array<bool> swingLevelCloseBeyondRequired = array.new_bool()
var array<float> swingDisplayLevelPrices = array.new_float()
var array<string> swingDisplayLevelLabels = array.new_string()
var array<color> swingDisplayLevelColors = array.new_color()
var array<int> swingDisplayLevelWidths = array.new_int()
var array<int> swingDisplayLevelStyles = array.new_int()
var array<float> swingDisplayGapBoxTops = array.new_float()
var array<float> swingDisplayGapBoxBottoms = array.new_float()
var array<line> swingLevelLines = array.new_line()
var array<label> swingLevelLabels = array.new_label()
var array<box> swingDailyGapBoxes = array.new_box()

sourceSessionCacheShouldRefresh = sourceLevelsEnabled and inScalpRTHSession and (newScalpRTHSession or na(convertedSourceCacheSessionDateKey) or convertedSourceCacheSessionDateKey != nySessionDateKey)
dailyGapSessionCacheShouldRefresh = dailyGapRequestEnabled and inScalpRTHSession and (newScalpRTHSession or na(cachedSourceDailyGapSessionDateKey) or cachedSourceDailyGapSessionDateKey != nySessionDateKey)

if sourceLevelsEnabled
    sourceCloseForConversion := sourceCloseForConversionNeeded ? request.security(convertedLevelSourceTicker, timeframe.period, close, lookahead=barmerge.lookahead_off, calc_bars_count=500) : na
    if sourceSessionCacheShouldRefresh
        [requestedPrevDayHigh, requestedPrevDayLow, requestedDayOpenHTF] = getHigherTimeframeData("1440", convertedLevelSourceTicker)
        [requestedPrevWeekHigh, requestedPrevWeekLow, requestedWeekOpen] = getHigherTimeframeData("W", convertedLevelSourceTicker)
        [requestedPrevMonthHigh, requestedPrevMonthLow, requestedMonthOpen] = getHigherTimeframeData("M", convertedLevelSourceTicker)
        requestedDayOpenIntraday = request.security(convertedLevelSourceTicker, "5", f_currentRthOpen(), lookahead=barmerge.lookahead_off, calc_bars_count=500)
        cachedSourcePrevDayHigh := requestedPrevDayHigh
        cachedSourcePrevDayLow := requestedPrevDayLow
        cachedSourceDayOpenHTF := requestedDayOpenHTF
        cachedSourcePrevWeekHigh := requestedPrevWeekHigh
        cachedSourcePrevWeekLow := requestedPrevWeekLow
        cachedSourceWeekOpen := requestedWeekOpen
        cachedSourcePrevMonthHigh := requestedPrevMonthHigh
        cachedSourcePrevMonthLow := requestedPrevMonthLow
        cachedSourceMonthOpen := requestedMonthOpen
        cachedSourceDayOpenIntraday := requestedDayOpenIntraday
        cachedSourceDayOpen := f_validSourcePrice(cachedSourceDayOpenHTF) ? cachedSourceDayOpenHTF : cachedSourceDayOpenIntraday
        convertedSourceCacheSessionDateKey := nySessionDateKey
    sourcePrevDayHigh := cachedSourcePrevDayHigh
    sourcePrevDayLow := cachedSourcePrevDayLow
    sourcePrevWeekHigh := cachedSourcePrevWeekHigh
    sourcePrevWeekLow := cachedSourcePrevWeekLow
    sourceWeekOpen := cachedSourceWeekOpen
    sourcePrevMonthHigh := cachedSourcePrevMonthHigh
    sourcePrevMonthLow := cachedSourcePrevMonthLow
    sourceMonthOpen := cachedSourceMonthOpen
    sourceDayOpen := cachedSourceDayOpen
    if dailyGapSessionCacheShouldRefresh
        // Request SPY/QQQ RTH daily gaps once for this chart RTH session. getGaps()
        // returns the source gap map known at that session's open.
        sourceDailyGaps := request.security(activeDailyGapSourceTicker, activeDailyGapTimeframe, getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=dailyGapLookback)
        array.clear(cachedSourceDailyGapStarts)
        array.clear(cachedSourceDailyGapEnds)
        array.clear(cachedSourceDailyGapHighs)
        array.clear(cachedSourceDailyGapLows)
        array.clear(cachedSourceDailyGapKeys)
        cachedSourceDailyGapSessionDateKey := nySessionDateKey
        if not na(sourceDailyGaps)
            for [cacheGapKey, cacheGapValue] in sourceDailyGaps
                [cacheGapParsed, cacheGapStart, cacheGapEnd, cacheGapHigh, cacheGapLow] = f_parseGapRecord(cacheGapValue)
                bool cacheGapSourcePricesValid = f_validSourcePrice(cacheGapStart) and f_validSourcePrice(cacheGapEnd) and f_validSourcePrice(cacheGapHigh) and f_validSourcePrice(cacheGapLow)
                if cacheGapParsed and cacheGapSourcePricesValid
                    array.push(cachedSourceDailyGapStarts, cacheGapStart)
                    array.push(cachedSourceDailyGapEnds, cacheGapEnd)
                    array.push(cachedSourceDailyGapHighs, cacheGapHigh)
                    array.push(cachedSourceDailyGapLows, cacheGapLow)
                    array.push(cachedSourceDailyGapKeys, cacheGapKey)

if barstate.isconfirmed and inScalpRTHSession and f_validSourcePrice(close) and f_validSourcePrice(sourceCloseForConversion)
    lastRthChartCloseForDisplayConversion := close
    lastRthSourceCloseForDisplayConversion := sourceCloseForConversion

// Current Price Ratio is the only active source-to-chart conversion. Once an
// RTH ratio exists, premarket and after-hours bars reuse it instead of drifting.
fallbackChartConversionClose = barstate.isconfirmed ? close : close[1]
fallbackSourceConversionClose = barstate.isconfirmed ? sourceCloseForConversion : sourceCloseForConversion[1]
chartConversionBase = f_validSourcePrice(lastRthChartCloseForDisplayConversion) ? lastRthChartCloseForDisplayConversion : f_validSourcePrice(fallbackChartConversionClose) and f_validSourcePrice(fallbackSourceConversionClose) ? fallbackChartConversionClose : na
sourceConversionBase = f_validSourcePrice(lastRthSourceCloseForDisplayConversion) ? lastRthSourceCloseForDisplayConversion : f_validSourcePrice(fallbackSourceConversionClose) ? fallbackSourceConversionClose : na
currentConversionRatio = f_validSourcePrice(chartConversionBase) and f_validSourcePrice(sourceConversionBase) ? chartConversionBase / sourceConversionBase : na
int activeDailyGapCurrentSourceKey = na
if dailyGapRequestEnabled
    activeDailyGapCurrentSourceKey := request.security(activeDailyGapSourceTicker, activeDailyGapTimeframe, time, lookahead=barmerge.lookahead_on, calc_bars_count=500)
dailyGapUsingCurrentSessionCache = dailyGapRequestEnabled and inScalpRTHSession and cachedSourceDailyGapSessionDateKey == nySessionDateKey

if not dailyGapRequestEnabled
    array.clear(cachedSourceDailyGapStarts)
    array.clear(cachedSourceDailyGapEnds)
    array.clear(cachedSourceDailyGapHighs)
    array.clear(cachedSourceDailyGapLows)
    array.clear(cachedSourceDailyGapKeys)
    cachedSourceDailyGapSessionDateKey := na

cachedSourceDailyGapCount = array.size(cachedSourceDailyGapStarts)
sourceDailyGapCount = dailyGapUsingCurrentSessionCache ? cachedSourceDailyGapCount : 0

f_convertSourceLevelToChart(_sourcePrice) =>
    f_validSourcePrice(_sourcePrice) and f_validSourcePrice(currentConversionRatio) ? f_roundToScalpTick(_sourcePrice * currentConversionRatio) : na

f_convertSourceLevelToChartForDisplay(_sourcePrice) =>
    float convertedDisplayPrice = f_validSourcePrice(_sourcePrice) and f_validSourcePrice(currentConversionRatio) ? _sourcePrice * currentConversionRatio : na
    f_validSourcePrice(convertedDisplayPrice) ? f_roundToScalpTick(convertedDisplayPrice) : na

convertedTradePrevWeekHigh = f_convertSourceLevelToChart(sourcePrevWeekHigh)
convertedTradePrevWeekLow = f_convertSourceLevelToChart(sourcePrevWeekLow)
convertedTradePrevDayHigh = f_convertSourceLevelToChart(sourcePrevDayHigh)
convertedTradePrevDayLow = f_convertSourceLevelToChart(sourcePrevDayLow)

f_addSwingDisplayConvertedLevel(_displayPrice, _label, _lineColor, _lineWidth, _lineStyle) =>
    if f_validSourcePrice(_displayPrice)
        array.push(swingDisplayLevelPrices, _displayPrice)
        array.push(swingDisplayLevelLabels, _label)
        array.push(swingDisplayLevelColors, _lineColor)
        array.push(swingDisplayLevelWidths, _lineWidth)
        array.push(swingDisplayLevelStyles, _lineStyle)

f_addSwingLevelWithCloseBeyond(_price, _name, _priority, _entryAllowed, _targetAllowed, _closeBeyondRequired) =>
    bool levelAdded = false
    if f_validSourcePrice(_price) and f_isLevelAllowedForScalpTrade(_name)
        array.push(swingLevelPrices, _price)
        array.push(swingLevelNames, _name)
        array.push(swingLevelPriority, _priority)
        array.push(swingLevelAllowedForEntry, _entryAllowed)
        array.push(swingLevelAllowedForTarget, _targetAllowed)
        array.push(swingLevelCloseBeyondRequired, _closeBeyondRequired)
        levelAdded := true
    levelAdded

f_addSwingLevel(_price, _name, _priority, _entryAllowed, _targetAllowed) =>
    f_addSwingLevelWithCloseBeyond(_price, _name, _priority, _entryAllowed, _targetAllowed, _entryAllowed)

f_addSwingDisplayLevel(_sourcePrice, _label, _lineColor, _lineWidth, _lineStyle) =>
    float displayPrice = f_convertSourceLevelToChartForDisplay(_sourcePrice)
    f_addSwingDisplayConvertedLevel(displayPrice, _label, _lineColor, _lineWidth, _lineStyle)

f_addSwingDisplayConvertedGapBox(_displayHigh, _displayLow) =>
    if f_validSourcePrice(_displayHigh) and f_validSourcePrice(_displayLow)
        array.push(swingDisplayGapBoxTops, math.max(_displayHigh, _displayLow))
        array.push(swingDisplayGapBoxBottoms, math.min(_displayHigh, _displayLow))

f_addSwingDisplayGapBox(_sourceHigh, _sourceLow) =>
    float displayHigh = f_convertSourceLevelToChartForDisplay(_sourceHigh)
    float displayLow = f_convertSourceLevelToChartForDisplay(_sourceLow)
    f_addSwingDisplayConvertedGapBox(displayHigh, displayLow)

f_lineStyleFromCode(_styleCode) =>
    _styleCode == 1 ? line.style_dashed : _styleCode == 2 ? line.style_dotted : line.style_solid

f_trimSwingLevelDrawings(_lineCount, _labelCount) =>
    while array.size(swingLevelLines) > _lineCount
        line staleLine = array.pop(swingLevelLines)
        line.delete(staleLine)
    while array.size(swingLevelLabels) > _labelCount
        label staleLabel = array.pop(swingLevelLabels)
        label.delete(staleLabel)

f_trimSwingGapBoxes(_boxCount) =>
    while array.size(swingDailyGapBoxes) > _boxCount
        box staleBox = array.pop(swingDailyGapBoxes)
        box.delete(staleBox)

array.clear(swingLevelPrices)
array.clear(swingLevelNames)
array.clear(swingLevelPriority)
array.clear(swingLevelAllowedForEntry)
array.clear(swingLevelAllowedForTarget)
array.clear(swingLevelCloseBeyondRequired)
array.clear(swingDisplayLevelPrices)
array.clear(swingDisplayLevelLabels)
array.clear(swingDisplayLevelColors)
array.clear(swingDisplayLevelWidths)
array.clear(swingDisplayLevelStyles)
array.clear(swingDisplayGapBoxTops)
array.clear(swingDisplayGapBoxBottoms)

if sourceLevelsEnabled
    // Converted trade calculations use lean level arrays below. Display-only
    // expanded/context levels are still populated separately for plotting.
    if convertedHtfTradeLevelsEnabled
        if useExpandedScalpLevels
            f_addSwingLevelWithCloseBeyond(convertedTradePrevWeekHigh, "Previous Week High", 1, true, false, true)
            f_addSwingLevelWithCloseBeyond(convertedTradePrevWeekLow, "Previous Week Low", 1, true, false, true)
        if usePrevDayHighLevel
            f_addSwingLevel(convertedTradePrevDayHigh, "Previous Day High", 4, true, true)
        if usePrevDayLowLevel
            f_addSwingLevel(convertedTradePrevDayLow, "Previous Day Low", 4, true, true)
    if showSwingLevels
        // Displayed converted lines are live reference levels. Their current price
        // ratio updates only after confirmed New York RTH closes; they are
        // not intended to behave like historical series plots.
        f_addSwingDisplayLevel(sourcePrevMonthHigh, "PMoH", paEngineHighLevelColor, 4, 1)
        f_addSwingDisplayLevel(sourcePrevMonthLow, "PMoL", paEngineLowLevelColor, 4, 1)
        f_addSwingDisplayLevel(sourceMonthOpen, "MO", paEngineOpenLevelColor, 3, 1)
        f_addSwingDisplayLevel(sourcePrevWeekHigh, "PWH", paEngineHighLevelColor, 3, 0)
        f_addSwingDisplayLevel(sourcePrevWeekLow, "PWL", paEngineLowLevelColor, 3, 0)
        f_addSwingDisplayLevel(sourceWeekOpen, "WO", paEngineOpenLevelColor, 2, 0)
        f_addSwingDisplayLevel(sourcePrevDayHigh, "PDH", paEngineHighLevelColor, 2, 0)
        f_addSwingDisplayLevel(sourcePrevDayLow, "PDL", paEngineLowLevelColor, 2, 0)
        int displayedGapCount = 0
        if maxDisplayedDailyGaps > 0 and sourceDailyGapCount > 0
            // Historical gaps use converted source boundaries. The current
            // session's gap starts at the raw futures RTH open and ends at the
            // converted source prior-close side.
            for displayGapIndex = 0 to sourceDailyGapCount - 1
                if displayedGapCount >= maxDisplayedDailyGaps
                    break
                float sourceGapStartForDisplay = array.get(cachedSourceDailyGapStarts, displayGapIndex)
                float sourceGapEndForDisplay = array.get(cachedSourceDailyGapEnds, displayGapIndex)
                float sourceGapHighForDisplay = array.get(cachedSourceDailyGapHighs, displayGapIndex)
                float sourceGapLowForDisplay = array.get(cachedSourceDailyGapLows, displayGapIndex)
                int sourceGapKeyForDisplay = array.get(cachedSourceDailyGapKeys, displayGapIndex)
                bool sourceGapIsCurrentDayForDisplay = not na(activeDailyGapCurrentSourceKey) and sourceGapKeyForDisplay == activeDailyGapCurrentSourceKey
                float convertedGapStartForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapStartForDisplay)
                float convertedGapEndForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapEndForDisplay)
                float convertedGapHighForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapHighForDisplay)
                float convertedGapLowForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapLowForDisplay)
                float displayedGapStartForBox = sourceGapIsCurrentDayForDisplay ? effectiveDailyOpen : convertedGapStartForDisplay
                float displayedGapHighForBox = sourceGapIsCurrentDayForDisplay ? math.max(displayedGapStartForBox, convertedGapEndForDisplay) : convertedGapHighForDisplay
                float displayedGapLowForBox = sourceGapIsCurrentDayForDisplay ? math.min(displayedGapStartForBox, convertedGapEndForDisplay) : convertedGapLowForDisplay
                bool dailyGapDisplayValid = sourceGapIsCurrentDayForDisplay ? (f_validSourcePrice(effectiveDailyOpen) and f_validSourcePrice(convertedGapEndForDisplay)) : (f_validSourcePrice(convertedGapStartForDisplay) and f_validSourcePrice(convertedGapEndForDisplay) and f_validSourcePrice(convertedGapHighForDisplay) and f_validSourcePrice(convertedGapLowForDisplay))
                if dailyGapDisplayValid
                    if not sourceGapIsCurrentDayForDisplay
                        f_addSwingDisplayConvertedLevel(convertedGapStartForDisplay, "Gap Start", dailyGapLineColor, 2, 1)
                    f_addSwingDisplayConvertedLevel(convertedGapEndForDisplay, "Gap End", dailyGapLineColor, 2, 0)
                    f_addSwingDisplayConvertedGapBox(displayedGapHighForBox, displayedGapLowForBox)
                    displayedGapCount += 1

bool swingDisplayMaintenanceNeeded = showSwingLevels or array.size(swingLevelLines) > 0 or array.size(swingLevelLabels) > 0 or array.size(swingDailyGapBoxes) > 0
if (barstate.isconfirmed or barstate.islast) and swingDisplayMaintenanceNeeded
    int desiredSwingLineCount = showSwingLevels ? array.size(swingDisplayLevelPrices) : 0
    int desiredSwingLabelCount = showSwingLevels and showSwingLevelLabels ? desiredSwingLineCount : 0
    int desiredSwingGapBoxCount = showSwingLevels and maxDisplayedDailyGaps > 0 ? array.size(swingDisplayGapBoxTops) : 0
    int swingLineStartBar = not na(currentRTHStartBar) ? math.max(currentRTHStartBar, bar_index - 9999) : bar_index
    f_trimSwingLevelDrawings(desiredSwingLineCount, desiredSwingLabelCount)
    f_trimSwingGapBoxes(desiredSwingGapBoxCount)
    if desiredSwingGapBoxCount > 0
        for swingGapBoxIndex = 0 to desiredSwingGapBoxCount - 1
            float gapBoxTop = array.get(swingDisplayGapBoxTops, swingGapBoxIndex)
            float gapBoxBottom = array.get(swingDisplayGapBoxBottoms, swingGapBoxIndex)
            box swingDailyGapBox = na
            if array.size(swingDailyGapBoxes) <= swingGapBoxIndex
                swingDailyGapBox := box.new(
                     swingLineStartBar,
                     gapBoxTop,
                     bar_index + 1,
                     gapBoxBottom,
                     xloc=xloc.bar_index,
                     extend=extend.right,
                     border_color=dailyGapBorderColor,
                     border_width=0,
                     bgcolor=dailyGapBoxColor
                )
                array.push(swingDailyGapBoxes, swingDailyGapBox)
            else
                swingDailyGapBox := array.get(swingDailyGapBoxes, swingGapBoxIndex)
            box.set_left(swingDailyGapBox, swingLineStartBar)
            box.set_top(swingDailyGapBox, gapBoxTop)
            box.set_right(swingDailyGapBox, bar_index + 1)
            box.set_bottom(swingDailyGapBox, gapBoxBottom)
            box.set_extend(swingDailyGapBox, extend.right)
            box.set_bgcolor(swingDailyGapBox, dailyGapBoxColor)
            box.set_border_color(swingDailyGapBox, dailyGapBorderColor)
            box.set_border_width(swingDailyGapBox, 0)
    if desiredSwingLineCount > 0
        for swingDisplayIndex = 0 to desiredSwingLineCount - 1
            float swingDisplayPrice = array.get(swingDisplayLevelPrices, swingDisplayIndex)
            color swingDisplayColor = array.get(swingDisplayLevelColors, swingDisplayIndex)
            string swingDisplayLabel = array.get(swingDisplayLevelLabels, swingDisplayIndex)
            int swingDisplayLineStyle = array.get(swingDisplayLevelStyles, swingDisplayIndex)
            int swingDisplayLineWidth = array.get(swingDisplayLevelWidths, swingDisplayIndex)
            line swingDisplayLine = na
            if array.size(swingLevelLines) <= swingDisplayIndex
                swingDisplayLine := line.new(
                     swingLineStartBar,
                     swingDisplayPrice,
                     bar_index + 1,
                     swingDisplayPrice,
                     xloc=xloc.bar_index,
                     extend=extend.right,
                     color=swingDisplayColor,
                     style=f_lineStyleFromCode(swingDisplayLineStyle),
                     width=swingDisplayLineWidth
                )
                array.push(swingLevelLines, swingDisplayLine)
            else
                swingDisplayLine := array.get(swingLevelLines, swingDisplayIndex)
            line.set_x1(swingDisplayLine, swingLineStartBar)
            line.set_y1(swingDisplayLine, swingDisplayPrice)
            line.set_x2(swingDisplayLine, bar_index + 1)
            line.set_y2(swingDisplayLine, swingDisplayPrice)
            line.set_extend(swingDisplayLine, extend.right)
            line.set_color(swingDisplayLine, swingDisplayColor)
            line.set_style(swingDisplayLine, f_lineStyleFromCode(swingDisplayLineStyle))
            line.set_width(swingDisplayLine, swingDisplayLineWidth)
            if showSwingLevelLabels
                label swingDisplayNameLabel = na
                if array.size(swingLevelLabels) <= swingDisplayIndex
                    swingDisplayNameLabel := label.new(
                         bar_index + 1,
                         swingDisplayPrice,
                         swingDisplayLabel,
                         xloc=xloc.bar_index,
                         style=label.style_label_left,
                         textcolor=swingDisplayColor,
                         color=color.new(color.black, 100),
                         size=size.tiny
                    )
                    array.push(swingLevelLabels, swingDisplayNameLabel)
                else
                    swingDisplayNameLabel := array.get(swingLevelLabels, swingDisplayIndex)
                label.set_x(swingDisplayNameLabel, bar_index + 1)
                label.set_y(swingDisplayNameLabel, swingDisplayPrice)
                label.set_text(swingDisplayNameLabel, swingDisplayLabel)
                label.set_textcolor(swingDisplayNameLabel, swingDisplayColor)
                label.set_color(swingDisplayNameLabel, color.new(color.black, 100))
                label.set_style(swingDisplayNameLabel, label.style_label_left)
                label.set_size(swingDisplayNameLabel, size.tiny)

var float autoOpeningRangeHigh = na
var float autoOpeningRangeLow = na
var bool openingRangeComplete = false
var int openingRangeBias = 0
var bool openingRangeHasBrokenOutOnce = false
var bool openingRangeHighAcceptedAbove = false
var bool openingRangeLowAcceptedBelow = false
var int openingRangeConsecutiveClosesAboveHigh = 0
var int openingRangeConsecutiveClosesBelowHigh = 0
var int openingRangeConsecutiveClosesAboveLow = 0
var int openingRangeConsecutiveClosesBelowLow = 0

if newScalpRTHSession
    autoOpeningRangeHigh := na
    autoOpeningRangeLow := na
    openingRangeComplete := false
    openingRangeBias := 0
    openingRangeHasBrokenOutOnce := false
    openingRangeHighAcceptedAbove := false
    openingRangeLowAcceptedBelow := false
    openingRangeConsecutiveClosesAboveHigh := 0
    openingRangeConsecutiveClosesBelowHigh := 0
    openingRangeConsecutiveClosesAboveLow := 0
    openingRangeConsecutiveClosesBelowLow := 0

if inOpeningRangeWindow
    autoOpeningRangeHigh := na(autoOpeningRangeHigh) ? high : math.max(autoOpeningRangeHigh, high)
    autoOpeningRangeLow := na(autoOpeningRangeLow) ? low : math.min(autoOpeningRangeLow, low)

if inScalpRTHSession and not inOpeningRangeWindow and not openingRangeComplete and not na(autoOpeningRangeHigh) and not na(autoOpeningRangeLow)
    openingRangeComplete := true

openingRangeHigh = useManualOpeningRangeFallback and manualOpeningRangeHigh > 0 ? manualOpeningRangeHigh : autoOpeningRangeHigh
openingRangeLow = useManualOpeningRangeFallback and manualOpeningRangeLow > 0 ? manualOpeningRangeLow : autoOpeningRangeLow
openingRangeReady = not na(openingRangeHigh) and not na(openingRangeLow)
openingRangeWindowElapsed = inScalpRTHSession and not inOpeningRangeWindow
openingRangeLevelsReady = openingRangeReady and (openingRangeComplete or (useManualOpeningRangeFallback and openingRangeWindowElapsed))
openingRangeDisplayHigh = inScalpRTHSession and openingRangeLevelsReady ? openingRangeHigh : na
openingRangeDisplayLow = inScalpRTHSession and openingRangeLevelsReady ? openingRangeLow : na

if openingRangeLevelsReady and barstate.isconfirmed and inScalpRTHSession and not inOpeningRangeWindow
    openingRangeConsecutiveClosesAboveHigh := close > openingRangeHigh ? openingRangeConsecutiveClosesAboveHigh + 1 : 0
    openingRangeConsecutiveClosesBelowHigh := close < openingRangeHigh ? openingRangeConsecutiveClosesBelowHigh + 1 : 0
    openingRangeConsecutiveClosesAboveLow := close > openingRangeLow ? openingRangeConsecutiveClosesAboveLow + 1 : 0
    openingRangeConsecutiveClosesBelowLow := close < openingRangeLow ? openingRangeConsecutiveClosesBelowLow + 1 : 0

    bool twoClosesAboveHigh = openingRangeConsecutiveClosesAboveHigh >= 2
    bool twoClosesBelowHigh = openingRangeConsecutiveClosesBelowHigh >= 2
    bool twoClosesAboveLow = openingRangeConsecutiveClosesAboveLow >= 2
    bool twoClosesBelowLow = openingRangeConsecutiveClosesBelowLow >= 2

    if openingRangeBias == 0
        if twoClosesAboveHigh
            openingRangeBias := 1
            openingRangeHasBrokenOutOnce := true
        else if twoClosesBelowLow
            openingRangeBias := -1
            openingRangeHasBrokenOutOnce := true
    else if openingRangeBias == 1
        if twoClosesBelowLow
            openingRangeBias := -1
            openingRangeHasBrokenOutOnce := true
        else if twoClosesBelowHigh
            openingRangeBias := 0
    else if openingRangeBias == -1
        if twoClosesAboveHigh
            openingRangeBias := 1
            openingRangeHasBrokenOutOnce := true
        else if twoClosesAboveLow
            openingRangeBias := 0
    if low > openingRangeHigh
        openingRangeHighAcceptedAbove := true
    if high < openingRangeLow
        openingRangeLowAcceptedBelow := true

openingRangeStatus = not openingRangeLevelsReady ? "Waiting" : "Complete"
openingRangeBiasText =
     not openingRangeLevelsReady ? "Waiting" :
     openingRangeBias == 1 ? "Bullish" :
     openingRangeBias == -1 ? "Bearish" :
     openingRangeHasBrokenOutOnce ? "Neutral" :
     "Pre-Breakout"
openingRangeNeutralAfterBreakout = openingRangeHasBrokenOutOnce and openingRangeBias == 0

// ===================== Untested 5m Swing Target Tracking =====================
int activeCurrentRTHDateKey = inScalpRTHSession ? currentRTHDateKey : na
int activePreviousRTHDateKey = inScalpRTHSession ? previousRTHDateKey : currentRTHDateKey
int oneHourSwingPreviousRTHDateKey = inScalpRTHSession ? previousRTHDateKey : currentRTHDateKey

if newPremarketSession or newScalpRTHSession
    int pruneHighIndex = array.size(swingHighPrices) - 1
    while pruneHighIndex >= 0
        string highSwingSession = array.get(swingHighSessions, pruneHighIndex)
        int highSwingDateKey = array.get(swingHighDateKeys, pruneHighIndex)
        bool keepHighSwing = f_swingTargetSessionAllowed(highSwingSession, highSwingDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepHighSwing
            array.remove(swingHighPrices, pruneHighIndex)
            array.remove(swingHighPivotBars, pruneHighIndex)
            array.remove(swingHighDateKeys, pruneHighIndex)
            array.remove(swingHighSessions, pruneHighIndex)
            array.remove(swingHighActive, pruneHighIndex)
            array.remove(swingHighObstacleActive, pruneHighIndex)
        pruneHighIndex -= 1

    int pruneLowIndex = array.size(swingLowPrices) - 1
    while pruneLowIndex >= 0
        string lowSwingSession = array.get(swingLowSessions, pruneLowIndex)
        int lowSwingDateKey = array.get(swingLowDateKeys, pruneLowIndex)
        bool keepLowSwing = f_swingTargetSessionAllowed(lowSwingSession, lowSwingDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepLowSwing
            array.remove(swingLowPrices, pruneLowIndex)
            array.remove(swingLowPivotBars, pruneLowIndex)
            array.remove(swingLowDateKeys, pruneLowIndex)
            array.remove(swingLowSessions, pruneLowIndex)
            array.remove(swingLowActive, pruneLowIndex)
            array.remove(swingLowObstacleActive, pruneLowIndex)
        pruneLowIndex -= 1

if barstate.isconfirmed
    int testHighIndex = 0
    while testHighIndex < array.size(swingHighPrices)
        string highSwingSession = array.get(swingHighSessions, testHighIndex)
        int highSwingDateKey = array.get(swingHighDateKeys, testHighIndex)
        bool canInvalidateHighSwing = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, highSwingSession, highSwingDateKey, currentRTHDateKey)
        if canInvalidateHighSwing and array.get(swingHighActive, testHighIndex) and bar_index > array.get(swingHighPivotBars, testHighIndex) and high >= array.get(swingHighPrices, testHighIndex)
            array.set(swingHighActive, testHighIndex, false)
        testHighIndex += 1

    int testLowIndex = 0
    while testLowIndex < array.size(swingLowPrices)
        string lowSwingSession = array.get(swingLowSessions, testLowIndex)
        int lowSwingDateKey = array.get(swingLowDateKeys, testLowIndex)
        bool canInvalidateLowSwing = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, lowSwingSession, lowSwingDateKey, currentRTHDateKey)
        if canInvalidateLowSwing and array.get(swingLowActive, testLowIndex) and bar_index > array.get(swingLowPivotBars, testLowIndex) and low <= array.get(swingLowPrices, testLowIndex)
            array.set(swingLowActive, testLowIndex, false)
        testLowIndex += 1

if barstate.isconfirmed
    if allowRthSwingsBrokenPremarket
        if newPremarketSession
            array.clear(pmSwingHistHighs)
            array.clear(pmSwingHistLows)
            array.clear(pmSwingHistBarIndexes)
            array.clear(pmSwingHistDateKeys)

        if inPremarketSession
            array.push(pmSwingHistHighs, high)
            array.push(pmSwingHistLows, low)
            array.push(pmSwingHistBarIndexes, bar_index)
            array.push(pmSwingHistDateKeys, nySessionDateKey)
            while array.size(pmSwingHistHighs) > 200
                array.shift(pmSwingHistHighs)
                array.shift(pmSwingHistLows)
                array.shift(pmSwingHistBarIndexes)
                array.shift(pmSwingHistDateKeys)

            int pmHistorySize = array.size(pmSwingHistHighs)
            if pmHistorySize >= 5
                int pmPivotIndex = pmHistorySize - 3
                float pmPivotHigh = array.get(pmSwingHistHighs, pmPivotIndex)
                float pmPivotLow = array.get(pmSwingHistLows, pmPivotIndex)
                int pmPivotBar = array.get(pmSwingHistBarIndexes, pmPivotIndex)
                int pmPivotDateKey = array.get(pmSwingHistDateKeys, pmPivotIndex)
                bool confirmedPmSwingHigh = pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex - 1) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex - 2) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex + 1) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex + 2)
                bool confirmedPmSwingLow = pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex - 1) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex - 2) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex + 1) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex + 2)

                if confirmedPmSwingHigh
                    if not f_hasPivotBar(swingHighPivotBars, pmPivotBar)
                        array.push(swingHighPrices, pmPivotHigh)
                        array.push(swingHighPivotBars, pmPivotBar)
                        array.push(swingHighDateKeys, pmPivotDateKey)
                        array.push(swingHighSessions, "PM")
                        array.push(swingHighActive, true)
                        array.push(swingHighObstacleActive, true)

                if confirmedPmSwingLow
                    if not f_hasPivotBar(swingLowPivotBars, pmPivotBar)
                        array.push(swingLowPrices, pmPivotLow)
                        array.push(swingLowPivotBars, pmPivotBar)
                        array.push(swingLowDateKeys, pmPivotDateKey)
                        array.push(swingLowSessions, "PM")
                        array.push(swingLowActive, true)
                        array.push(swingLowObstacleActive, true)

        if inScalpRTHSession
            // Keep prior RTH bars so the first/second current-session RTH bars can confirm with RTH-only left bars.
            array.push(rthSwingHistHighs, high)
            array.push(rthSwingHistLows, low)
            array.push(rthSwingHistBarIndexes, bar_index)
            array.push(rthSwingHistDateKeys, nySessionDateKey)
            while array.size(rthSwingHistHighs) > 200
                array.shift(rthSwingHistHighs)
                array.shift(rthSwingHistLows)
                array.shift(rthSwingHistBarIndexes)
                array.shift(rthSwingHistDateKeys)

            int rthHistorySize = array.size(rthSwingHistHighs)
            if rthHistorySize >= 5
                int rthPivotIndex = rthHistorySize - 3
                float rthPivotHigh = array.get(rthSwingHistHighs, rthPivotIndex)
                float rthPivotLow = array.get(rthSwingHistLows, rthPivotIndex)
                int rthPivotBar = array.get(rthSwingHistBarIndexes, rthPivotIndex)
                int rthPivotDateKey = array.get(rthSwingHistDateKeys, rthPivotIndex)
                bool confirmedRthSwingHigh = rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex - 1) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex - 2) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex + 1) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex + 2)
                bool confirmedRthSwingLow = rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex - 1) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex - 2) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex + 1) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex + 2)

                if confirmedRthSwingHigh
                    if not f_hasPivotBar(swingHighPivotBars, rthPivotBar)
                        array.push(swingHighPrices, rthPivotHigh)
                        array.push(swingHighPivotBars, rthPivotBar)
                        array.push(swingHighDateKeys, rthPivotDateKey)
                        array.push(swingHighSessions, "RTH")
                        array.push(swingHighActive, true)
                        array.push(swingHighObstacleActive, true)

                if confirmedRthSwingLow
                    if not f_hasPivotBar(swingLowPivotBars, rthPivotBar)
                        array.push(swingLowPrices, rthPivotLow)
                        array.push(swingLowPivotBars, rthPivotBar)
                        array.push(swingLowDateKeys, rthPivotDateKey)
                        array.push(swingLowSessions, "RTH")
                        array.push(swingLowActive, true)
                        array.push(swingLowObstacleActive, true)

    else if bar_index >= 4
        bool confirmedSwingHigh = high[2] > high[1] and high[2] > high and high[2] > high[3] and high[2] > high[4]
        bool confirmedSwingLow = low[2] < low[1] and low[2] < low and low[2] < low[3] and low[2] < low[4]
        string pivotSession = inPremarketSession[2] ? "PM" : inScalpRTHSession[2] ? "RTH" : "N/A"
        int pivotDateKey = nySessionDateKey[2]
        bool pivotSessionAllowed = pivotSession == "PM" or pivotSession == "RTH"

        if pivotSessionAllowed and confirmedSwingHigh
            array.push(swingHighPrices, high[2])
            array.push(swingHighPivotBars, bar_index - 2)
            array.push(swingHighDateKeys, pivotDateKey)
            array.push(swingHighSessions, pivotSession)
            array.push(swingHighActive, true)
            array.push(swingHighObstacleActive, true)

        if pivotSessionAllowed and confirmedSwingLow
            array.push(swingLowPrices, low[2])
            array.push(swingLowPivotBars, bar_index - 2)
            array.push(swingLowDateKeys, pivotDateKey)
            array.push(swingLowSessions, pivotSession)
            array.push(swingLowActive, true)
            array.push(swingLowObstacleActive, true)

while array.size(swingHighPrices) > maxTrackedSwingTargets
    array.shift(swingHighPrices)
    array.shift(swingHighPivotBars)
    array.shift(swingHighDateKeys)
    array.shift(swingHighSessions)
    array.shift(swingHighActive)
    array.shift(swingHighObstacleActive)

while array.size(swingLowPrices) > maxTrackedSwingTargets
    array.shift(swingLowPrices)
    array.shift(swingLowPivotBars)
    array.shift(swingLowDateKeys)
    array.shift(swingLowSessions)
    array.shift(swingLowActive)
    array.shift(swingLowObstacleActive)

if barstate.isconfirmed
    int clearFiveMinuteHighIndex = 0
    while clearFiveMinuteHighIndex < array.size(swingHighPrices)
        if array.get(swingHighObstacleActive, clearFiveMinuteHighIndex) and bar_index > array.get(swingHighPivotBars, clearFiveMinuteHighIndex) and low > array.get(swingHighPrices, clearFiveMinuteHighIndex)
            array.set(swingHighObstacleActive, clearFiveMinuteHighIndex, false)
        clearFiveMinuteHighIndex += 1

    int clearFiveMinuteLowIndex = 0
    while clearFiveMinuteLowIndex < array.size(swingLowPrices)
        if array.get(swingLowObstacleActive, clearFiveMinuteLowIndex) and bar_index > array.get(swingLowPivotBars, clearFiveMinuteLowIndex) and high < array.get(swingLowPrices, clearFiveMinuteLowIndex)
            array.set(swingLowObstacleActive, clearFiveMinuteLowIndex, false)
        clearFiveMinuteLowIndex += 1

bool longFiveMinuteSwingAcceptanceFailed = false
if requireFiveMinuteSwingAcceptance and array.size(swingHighPrices) > 0
    for fiveMinuteHighIndex = 0 to array.size(swingHighPrices) - 1
        float fiveMinuteSwingHigh = array.get(swingHighPrices, fiveMinuteHighIndex)
        bool fiveMinuteSwingHighRelevant = array.get(swingHighObstacleActive, fiveMinuteHighIndex) and f_swingTargetSessionAllowed(array.get(swingHighSessions, fiveMinuteHighIndex), array.get(swingHighDateKeys, fiveMinuteHighIndex), nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        bool fiveMinuteSwingHighPriorTouched = f_levelTouched(fiveMinuteSwingHighRelevant, fiveMinuteSwingHigh, low[1], high[1])
        bool fiveMinuteSwingHighCurrentTouched = f_levelTouched(fiveMinuteSwingHighRelevant, fiveMinuteSwingHigh, low, high)
        bool fiveMinuteSwingHighNeedsAcceptance = fiveMinuteSwingHighPriorTouched and fiveMinuteSwingHighCurrentTouched
        bool fiveMinuteSwingHighAccepted = close > fiveMinuteSwingHigh and (close - fiveMinuteSwingHigh) > (high - close)
        longFiveMinuteSwingAcceptanceFailed := longFiveMinuteSwingAcceptanceFailed or (fiveMinuteSwingHighNeedsAcceptance and not fiveMinuteSwingHighAccepted)
        if longFiveMinuteSwingAcceptanceFailed
            break

bool shortFiveMinuteSwingAcceptanceFailed = false
if requireFiveMinuteSwingAcceptance and array.size(swingLowPrices) > 0
    for fiveMinuteLowIndex = 0 to array.size(swingLowPrices) - 1
        float fiveMinuteSwingLow = array.get(swingLowPrices, fiveMinuteLowIndex)
        bool fiveMinuteSwingLowRelevant = array.get(swingLowObstacleActive, fiveMinuteLowIndex) and f_swingTargetSessionAllowed(array.get(swingLowSessions, fiveMinuteLowIndex), array.get(swingLowDateKeys, fiveMinuteLowIndex), nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        bool fiveMinuteSwingLowPriorTouched = f_levelTouched(fiveMinuteSwingLowRelevant, fiveMinuteSwingLow, low[1], high[1])
        bool fiveMinuteSwingLowCurrentTouched = f_levelTouched(fiveMinuteSwingLowRelevant, fiveMinuteSwingLow, low, high)
        bool fiveMinuteSwingLowNeedsAcceptance = fiveMinuteSwingLowPriorTouched and fiveMinuteSwingLowCurrentTouched
        bool fiveMinuteSwingLowAccepted = close < fiveMinuteSwingLow and (fiveMinuteSwingLow - close) > (close - low)
        shortFiveMinuteSwingAcceptanceFailed := shortFiveMinuteSwingAcceptanceFailed or (fiveMinuteSwingLowNeedsAcceptance and not fiveMinuteSwingLowAccepted)
        if shortFiveMinuteSwingAcceptanceFailed
            break

longFiveMinuteSwingAcceptancePassed = not requireFiveMinuteSwingAcceptance or not longFiveMinuteSwingAcceptanceFailed
shortFiveMinuteSwingAcceptancePassed = not requireFiveMinuteSwingAcceptance or not shortFiveMinuteSwingAcceptanceFailed

// ===================== 1H Swing Blocker Tracking =====================
[oneHourPivotHigh, oneHourPivotLow, oneHourPivotTime, oneHourPivotDateKey, oneHourPivotSessionCode] = request.security(syminfo.tickerid, "60", f_oneHourSwingData(), lookahead=barmerge.lookahead_off, calc_bars_count=500)

if newPremarketSession or newScalpRTHSession
    int pruneOneHourHighIndex = array.size(oneHourSwingHighPrices) - 1
    while pruneOneHourHighIndex >= 0
        bool keepOneHourHigh = f_oneHourSwingSessionAllowed(array.get(oneHourSwingHighSessionCodes, pruneOneHourHighIndex), array.get(oneHourSwingHighDateKeys, pruneOneHourHighIndex), nySessionDateKey, oneHourSwingPreviousRTHDateKey)
        if not keepOneHourHigh
            array.remove(oneHourSwingHighPrices, pruneOneHourHighIndex)
            array.remove(oneHourSwingHighTimes, pruneOneHourHighIndex)
            array.remove(oneHourSwingHighDateKeys, pruneOneHourHighIndex)
            array.remove(oneHourSwingHighSessionCodes, pruneOneHourHighIndex)
            array.remove(oneHourSwingHighActive, pruneOneHourHighIndex)
        pruneOneHourHighIndex -= 1

    int pruneOneHourLowIndex = array.size(oneHourSwingLowPrices) - 1
    while pruneOneHourLowIndex >= 0
        bool keepOneHourLow = f_oneHourSwingSessionAllowed(array.get(oneHourSwingLowSessionCodes, pruneOneHourLowIndex), array.get(oneHourSwingLowDateKeys, pruneOneHourLowIndex), nySessionDateKey, oneHourSwingPreviousRTHDateKey)
        if not keepOneHourLow
            array.remove(oneHourSwingLowPrices, pruneOneHourLowIndex)
            array.remove(oneHourSwingLowTimes, pruneOneHourLowIndex)
            array.remove(oneHourSwingLowDateKeys, pruneOneHourLowIndex)
            array.remove(oneHourSwingLowSessionCodes, pruneOneHourLowIndex)
            array.remove(oneHourSwingLowActive, pruneOneHourLowIndex)
        pruneOneHourLowIndex -= 1

if barstate.isconfirmed
    if not na(oneHourPivotHigh) and not na(oneHourPivotTime) and not f_hasIntValue(oneHourSwingHighTimes, oneHourPivotTime)
        array.push(oneHourSwingHighPrices, oneHourPivotHigh)
        array.push(oneHourSwingHighTimes, oneHourPivotTime)
        array.push(oneHourSwingHighDateKeys, oneHourPivotDateKey)
        array.push(oneHourSwingHighSessionCodes, oneHourPivotSessionCode)
        bool oneHourHighAlreadyCleared = f_oneHourHighAlreadyCleared(oneHourPivotHigh, oneHourPivotTime)
        array.push(oneHourSwingHighActive, not oneHourHighAlreadyCleared)

    if not na(oneHourPivotLow) and not na(oneHourPivotTime) and not f_hasIntValue(oneHourSwingLowTimes, oneHourPivotTime)
        array.push(oneHourSwingLowPrices, oneHourPivotLow)
        array.push(oneHourSwingLowTimes, oneHourPivotTime)
        array.push(oneHourSwingLowDateKeys, oneHourPivotDateKey)
        array.push(oneHourSwingLowSessionCodes, oneHourPivotSessionCode)
        bool oneHourLowAlreadyCleared = f_oneHourLowAlreadyCleared(oneHourPivotLow, oneHourPivotTime)
        array.push(oneHourSwingLowActive, not oneHourLowAlreadyCleared)

while array.size(oneHourSwingHighPrices) > maxTrackedOneHourSwings
    array.shift(oneHourSwingHighPrices)
    array.shift(oneHourSwingHighTimes)
    array.shift(oneHourSwingHighDateKeys)
    array.shift(oneHourSwingHighSessionCodes)
    array.shift(oneHourSwingHighActive)

while array.size(oneHourSwingLowPrices) > maxTrackedOneHourSwings
    array.shift(oneHourSwingLowPrices)
    array.shift(oneHourSwingLowTimes)
    array.shift(oneHourSwingLowDateKeys)
    array.shift(oneHourSwingLowSessionCodes)
    array.shift(oneHourSwingLowActive)

if barstate.isconfirmed
    int clearOneHourHighIndex = 0
    while clearOneHourHighIndex < array.size(oneHourSwingHighPrices)
        if array.get(oneHourSwingHighActive, clearOneHourHighIndex) and low > array.get(oneHourSwingHighPrices, clearOneHourHighIndex)
            array.set(oneHourSwingHighActive, clearOneHourHighIndex, false)
        clearOneHourHighIndex += 1

    int clearOneHourLowIndex = 0
    while clearOneHourLowIndex < array.size(oneHourSwingLowPrices)
        if array.get(oneHourSwingLowActive, clearOneHourLowIndex) and high < array.get(oneHourSwingLowPrices, clearOneHourLowIndex)
            array.set(oneHourSwingLowActive, clearOneHourLowIndex, false)
        clearOneHourLowIndex += 1

bool longOneHourSwingAcceptanceFailed = false
if requireOneHourSwingAcceptance and array.size(oneHourSwingHighPrices) > 0
    for oneHourAcceptanceHighIndex = 0 to array.size(oneHourSwingHighPrices) - 1
        float oneHourSwingHigh = array.get(oneHourSwingHighPrices, oneHourAcceptanceHighIndex)
        bool oneHourSwingHighRelevant = array.get(oneHourSwingHighActive, oneHourAcceptanceHighIndex) and f_oneHourSwingSessionAllowed(array.get(oneHourSwingHighSessionCodes, oneHourAcceptanceHighIndex), array.get(oneHourSwingHighDateKeys, oneHourAcceptanceHighIndex), nySessionDateKey, oneHourSwingPreviousRTHDateKey)
        bool oneHourSwingHighPriorTouched = f_levelTouched(oneHourSwingHighRelevant, oneHourSwingHigh, low[1], high[1])
        bool oneHourSwingHighCurrentTouched = f_levelTouched(oneHourSwingHighRelevant, oneHourSwingHigh, low, high)
        bool oneHourSwingHighNeedsAcceptance = oneHourSwingHighPriorTouched and oneHourSwingHighCurrentTouched
        bool oneHourSwingHighAccepted = close > oneHourSwingHigh and (close - oneHourSwingHigh) > (high - close)
        longOneHourSwingAcceptanceFailed := longOneHourSwingAcceptanceFailed or (oneHourSwingHighNeedsAcceptance and not oneHourSwingHighAccepted)
        if longOneHourSwingAcceptanceFailed
            break

bool shortOneHourSwingAcceptanceFailed = false
if requireOneHourSwingAcceptance and array.size(oneHourSwingLowPrices) > 0
    for oneHourAcceptanceLowIndex = 0 to array.size(oneHourSwingLowPrices) - 1
        float oneHourSwingLow = array.get(oneHourSwingLowPrices, oneHourAcceptanceLowIndex)
        bool oneHourSwingLowRelevant = array.get(oneHourSwingLowActive, oneHourAcceptanceLowIndex) and f_oneHourSwingSessionAllowed(array.get(oneHourSwingLowSessionCodes, oneHourAcceptanceLowIndex), array.get(oneHourSwingLowDateKeys, oneHourAcceptanceLowIndex), nySessionDateKey, oneHourSwingPreviousRTHDateKey)
        bool oneHourSwingLowPriorTouched = f_levelTouched(oneHourSwingLowRelevant, oneHourSwingLow, low[1], high[1])
        bool oneHourSwingLowCurrentTouched = f_levelTouched(oneHourSwingLowRelevant, oneHourSwingLow, low, high)
        bool oneHourSwingLowNeedsAcceptance = oneHourSwingLowPriorTouched and oneHourSwingLowCurrentTouched
        bool oneHourSwingLowAccepted = close < oneHourSwingLow and (oneHourSwingLow - close) > (close - low)
        shortOneHourSwingAcceptanceFailed := shortOneHourSwingAcceptanceFailed or (oneHourSwingLowNeedsAcceptance and not oneHourSwingLowAccepted)
        if shortOneHourSwingAcceptanceFailed
            break

longOneHourSwingAcceptancePassed = not requireOneHourSwingAcceptance or not longOneHourSwingAcceptanceFailed
shortOneHourSwingAcceptancePassed = not requireOneHourSwingAcceptance or not shortOneHourSwingAcceptanceFailed

bool longOneHourSwingBlockerHit = false
if useOneHourSwingBlockers and array.size(oneHourSwingHighPrices) > 0
    for oneHourHighIndex = 0 to array.size(oneHourSwingHighPrices) - 1
        bool oneHourHighRelevant = array.get(oneHourSwingHighActive, oneHourHighIndex) and f_oneHourSwingSessionAllowed(array.get(oneHourSwingHighSessionCodes, oneHourHighIndex), array.get(oneHourSwingHighDateKeys, oneHourHighIndex), nySessionDateKey, oneHourSwingPreviousRTHDateKey)
        longOneHourSwingBlockerHit := longOneHourSwingBlockerHit or f_levelTouched(oneHourHighRelevant, array.get(oneHourSwingHighPrices, oneHourHighIndex), low, high)
        if longOneHourSwingBlockerHit
            break

bool shortOneHourSwingBlockerHit = false
if useOneHourSwingBlockers and array.size(oneHourSwingLowPrices) > 0
    for oneHourLowIndex = 0 to array.size(oneHourSwingLowPrices) - 1
        bool oneHourLowRelevant = array.get(oneHourSwingLowActive, oneHourLowIndex) and f_oneHourSwingSessionAllowed(array.get(oneHourSwingLowSessionCodes, oneHourLowIndex), array.get(oneHourSwingLowDateKeys, oneHourLowIndex), nySessionDateKey, oneHourSwingPreviousRTHDateKey)
        shortOneHourSwingBlockerHit := shortOneHourSwingBlockerHit or f_levelTouched(oneHourLowRelevant, array.get(oneHourSwingLowPrices, oneHourLowIndex), low, high)
        if shortOneHourSwingBlockerHit
            break

longOneHourSwingBlockerPassed = not useOneHourSwingBlockers or not longOneHourSwingBlockerHit
shortOneHourSwingBlockerPassed = not useOneHourSwingBlockers or not shortOneHourSwingBlockerHit

// ===================== Pre-computed Conditions =====================
sufficientVolumeAndVolatility = sufficientVolume and sufficientVolatility
nineEma = ta.ema(close, 9)
roundedNineEma = f_roundToScalpTick(nineEma)

// ===================== Pressure Signal Conditions =====================
pressureRange = f_safeRange(high, low)
closeUpperThird = f_closeInUpperThird(close, low, pressureRange)
closeLowerThird = f_closeInLowerThird(close, low, pressureRange)

isBodyThreshold = f_meetsPct(body, pressureRange, pressureBodyWickThreshold)
isMostlyBody = f_meetsPct(body, pressureRange, 0.5)
isTwoThirdsBody = f_meetsPct(body, pressureRange, 2.0 / 3.0)
isLowerWickThreshold = f_meetsPct(lowerWick, pressureRange, pressureBodyWickThreshold)
isUpperWickThreshold = f_meetsPct(upperWick, pressureRange, pressureBodyWickThreshold)

bullBarQuality = closeUpperThird and (isBodyThreshold or isLowerWickThreshold)
bearBarQuality = closeLowerThird and (isBodyThreshold or isUpperWickThreshold)

[buyPressure, sellPressure] = f_dobruskyPressure()

pressureReady = not na(buyPressure) and not na(sellPressure) and not na(buyPressure[1]) and not na(sellPressure[1])
priorDominantlyBear = pressureReady and (sellPressure[1] > buyPressure[1])
priorDominantlyBull = pressureReady and (buyPressure[1] >= sellPressure[1])

bullPressureA = pressureReady and ((priorDominantlyBear and buyPressure > sellPressure[1]) or (priorDominantlyBull and buyPressure > buyPressure[1]))
bearPressureA = pressureReady and ((priorDominantlyBull and sellPressure > buyPressure[1]) or (priorDominantlyBear and sellPressure > sellPressure[1]))

[midDown, legDownLow, legDownHigh] = f_midPriorLegDown(maxLookback)
[midUp, legUpLow, legUpHigh] = f_midPriorLegUp(maxLookback)

bullFallbackB = not na(midDown) and close > midDown
bearFallbackB = not na(midUp) and close < midUp

bullPressurePass = (bullPressureA and not na(volume)) or (bullFallbackB and isBodyThreshold)
bearPressurePass = (bearPressureA and not na(volume)) or (bearFallbackB and isBodyThreshold)
isHighVolume = not na(volume) and volume > volume[1]

bullSameColorHighVolumeContinuation =
     isHighVolume and
     isMostlyBody and
     f_isBullBar(open, close) and
     f_isBullBar(open[1], close[1])

bearSameColorHighVolumeContinuation =
     isHighVolume and
     isMostlyBody and
     f_isBearBar(open, close) and
     f_isBearBar(open[1], close[1])

bullDirectionalPressureOk =
     bullPressurePass or bullSameColorHighVolumeContinuation

bearDirectionalPressureOk =
     bearPressurePass or bearSameColorHighVolumeContinuation

bullSignalBase = sufficientVolumeAndVolatility and bullBarQuality
bearSignalBase = sufficientVolumeAndVolatility and bearBarQuality

bullSignalHighVol = bullSignalBase and isHighVolume
bearSignalHighVol = bearSignalBase and isHighVolume

priorBarMidpoint = (high[1] + low[1]) / 2.0
priorBarHighVolume = not na(volume[2]) and volume[1] > volume[2]
priorTwoBarNetMove = not na(open[2]) and not na(close[1]) ? close[1] - open[2] : na
priorTwoBarsNetBearish = not na(priorTwoBarNetMove) and priorTwoBarNetMove < 0
priorTwoBarsNetBullish = not na(priorTwoBarNetMove) and priorTwoBarNetMove > 0

bullSignalPriorBarVolumeReversal =
     allowPriorBarVolumeReversals and
     bullSignalBase and
     greenCandle and
     redCandle[1] and
     priorBarHighVolume and
     priorTwoBarsNetBearish and
     close > priorBarMidpoint
bearSignalPriorBarVolumeReversal =
     allowPriorBarVolumeReversals and
     bearSignalBase and
     redCandle and
     greenCandle[1] and
     priorBarHighVolume and
     priorTwoBarsNetBullish and
     close < priorBarMidpoint

bullSignalFinal = bullSignalHighVol or bullSignalPriorBarVolumeReversal
bearSignalFinal = bearSignalHighVol or bearSignalPriorBarVolumeReversal

// ===================== Plotting =====================
signalPlotOpeningRangePassed = openingRangeLevelsReady and not inOpeningRangeWindow
plotBullSignal = showBullSignals and bullSignalFinal and (not hideSignalPlotsBeforeOpeningRangeCompletes or signalPlotOpeningRangePassed)
plotBearSignal = showBearSignals and bearSignalFinal and (not hideSignalPlotsBeforeOpeningRangeCompletes or signalPlotOpeningRangePassed)

// Confirmed signals close beyond the prior bar extreme and remain part of alert tier qualification.
bullSignalConfirmed = close > high[1]
bearSignalConfirmed = close < low[1]

// ===================== Alert Signal Tier Logic =====================
bullScalpSignalAllowed = bullSignalFinal
bearScalpSignalAllowed = bearSignalFinal

bullScalpSetupTier = bullScalpSignalAllowed and not bullSignalConfirmed
bullScalpIgnitionTier = bullScalpSignalAllowed and bullSignalConfirmed and not isMostlyBody
bullScalpStrongIgnitionTier = bullScalpSignalAllowed and bullSignalConfirmed and isMostlyBody
bearScalpSetupTier = bearScalpSignalAllowed and not bearSignalConfirmed
bearScalpIgnitionTier = bearScalpSignalAllowed and bearSignalConfirmed and not isMostlyBody
bearScalpStrongIgnitionTier = bearScalpSignalAllowed and bearSignalConfirmed and isMostlyBody

bullScalpTierAllowed = bullScalpSetupTier or bullScalpIgnitionTier or bullScalpStrongIgnitionTier
bearScalpTierAllowed = bearScalpSetupTier or bearScalpIgnitionTier or bearScalpStrongIgnitionTier

// ===================== Scalp Level Priority Logic =====================
scalpSignalHigh = high
scalpSignalLow = low
scalpSignalClose = close
scalpEntry50Raw = (scalpSignalHigh + scalpSignalLow) / 2.0
longEntry50 = f_roundDownToScalpTick(scalpEntry50Raw)
shortEntry50 = f_roundUpToScalpTick(scalpEntry50Raw)
useDirectHtfFallbackLevels = not useConvertedHtfLevelsForTradeLogic
useDirectTradePrevDayHighLevel = useDirectHtfFallbackLevels and usePrevDayHighLevel
useDirectTradePrevDayLowLevel = useDirectHtfFallbackLevels and usePrevDayLowLevel
// Daily Open Acceptance requires both signal-bar range and candle body beyond the raw futures RTH daily open.
dailyOpenSignalRange = scalpSignalHigh - scalpSignalLow
dailyOpenSignalBody = bodyHigh - bodyLow
activeDailyOpenTouchedCurrent = f_levelTouched(activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh)
activeRangeAboveDailyOpen = dailyOpenSignalRange > 0 and activeDailyOpenTouchedCurrent ? math.max(scalpSignalHigh - activeTradeDailyOpen, 0.0) : na
activeRangeBelowDailyOpen = dailyOpenSignalRange > 0 and activeDailyOpenTouchedCurrent ? math.max(activeTradeDailyOpen - scalpSignalLow, 0.0) : na
activeBodyAboveDailyOpen = dailyOpenSignalBody > 0 and activeDailyOpenTouchedCurrent ? math.max(bodyHigh - math.max(activeTradeDailyOpen, bodyLow), 0.0) : na
activeBodyBelowDailyOpen = dailyOpenSignalBody > 0 and activeDailyOpenTouchedCurrent ? math.max(math.min(activeTradeDailyOpen, bodyHigh) - bodyLow, 0.0) : na
activeRangeAboveDailyOpenPct = dailyOpenSignalRange > 0 and activeDailyOpenTouchedCurrent ? math.min(activeRangeAboveDailyOpen / dailyOpenSignalRange, 1.0) : na
activeRangeBelowDailyOpenPct = dailyOpenSignalRange > 0 and activeDailyOpenTouchedCurrent ? math.min(activeRangeBelowDailyOpen / dailyOpenSignalRange, 1.0) : na
activeBodyAboveDailyOpenPct = dailyOpenSignalBody > 0 and activeDailyOpenTouchedCurrent ? math.min(activeBodyAboveDailyOpen / dailyOpenSignalBody, 1.0) : na
activeBodyBelowDailyOpenPct = dailyOpenSignalBody > 0 and activeDailyOpenTouchedCurrent ? math.min(activeBodyBelowDailyOpen / dailyOpenSignalBody, 1.0) : na
activeLongDailyOpenRangeAccepted = not activeDailyOpenTouchedCurrent or (dailyOpenSignalRange > 0 and not na(activeRangeAboveDailyOpenPct) and activeRangeAboveDailyOpenPct >= dailyOpenRangeAcceptancePct)
activeShortDailyOpenRangeAccepted = not activeDailyOpenTouchedCurrent or (dailyOpenSignalRange > 0 and not na(activeRangeBelowDailyOpenPct) and activeRangeBelowDailyOpenPct >= dailyOpenRangeAcceptancePct)
activeLongDailyOpenBodyAccepted = not activeDailyOpenTouchedCurrent or (dailyOpenSignalBody > 0 and not na(activeBodyAboveDailyOpenPct) and activeBodyAboveDailyOpenPct >= dailyOpenRangeAcceptancePct)
activeShortDailyOpenBodyAccepted = not activeDailyOpenTouchedCurrent or (dailyOpenSignalBody > 0 and not na(activeBodyBelowDailyOpenPct) and activeBodyBelowDailyOpenPct >= dailyOpenRangeAcceptancePct)
longDailyOpenRangeAcceptancePassed = not requireDailyOpenRangeAcceptance or (activeLongDailyOpenRangeAccepted and activeLongDailyOpenBodyAccepted)
shortDailyOpenRangeAcceptancePassed = not requireDailyOpenRangeAcceptance or (activeShortDailyOpenRangeAccepted and activeShortDailyOpenBodyAccepted)
float noSelectedLevelPrice = na
string noSelectedLevelName = "N/A"
int noSelectedLevelPriority = 999
bool noSelectedLevelTouchedCurrent = false
bool noSelectedLevelFound = false

// ===================== Expanded Scalp Level / 5m Sweep Logic =====================
float longExpandedScalpLevelPrice = na
string longExpandedScalpLevelName = "N/A"
int longExpandedScalpLevelPriority = 999
bool longExpandedScalpLevelTouchedCurrent = false
bool longExpandedScalpLevelFound = false

float shortExpandedScalpLevelPrice = na
string shortExpandedScalpLevelName = "N/A"
int shortExpandedScalpLevelPriority = 999
bool shortExpandedScalpLevelTouchedCurrent = false
bool shortExpandedScalpLevelFound = false
bool longPreviousWeekLowQualified = false
bool shortPreviousWeekHighQualified = false
bool longPreviousDayLowQualified = false
bool shortPreviousDayHighQualified = false
bool longPreviousWeekLowPriorClosePassed = false
bool longPreviousDayLowPriorClosePassed = false
bool shortPreviousWeekHighPriorClosePassed = false
bool shortPreviousDayHighPriorClosePassed = false

priorBarBear = close[1] < open[1]
priorBarBull = close[1] > open[1]

if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
    for expandedEntryLevelIndex = 0 to array.size(swingLevelPrices) - 1
        float expandedEntryLevelPrice = array.get(swingLevelPrices, expandedEntryLevelIndex)
        string expandedEntryLevelName = array.get(swingLevelNames, expandedEntryLevelIndex)
        int expandedEntryLevelPriority = array.get(swingLevelPriority, expandedEntryLevelIndex)
        bool expandedEntryLevelAllowed = array.get(swingLevelAllowedForEntry, expandedEntryLevelIndex)
        bool expandedEntryLevelTouchedCurrent = f_levelTouched(expandedEntryLevelAllowed, expandedEntryLevelPrice, scalpSignalLow, scalpSignalHigh)
        bool expandedEntryLevelTouchedPriorForLong = f_levelTouchedByPriorBar(expandedEntryLevelAllowed, expandedEntryLevelPrice, low[1], high[1], priorBarBear)
        bool expandedEntryLevelTouchedPriorForShort = f_levelTouchedByPriorBar(expandedEntryLevelAllowed, expandedEntryLevelPrice, low[1], high[1], priorBarBull)
        bool longExpandedEntryLevelQualified = (expandedEntryLevelTouchedCurrent or expandedEntryLevelTouchedPriorForLong) and scalpSignalClose > expandedEntryLevelPrice
        bool shortExpandedEntryLevelQualified = (expandedEntryLevelTouchedCurrent or expandedEntryLevelTouchedPriorForShort) and scalpSignalClose < expandedEntryLevelPrice
        bool expandedEntryLevelIsPreviousWeekLow = f_isPreviousWeekLowLevel(expandedEntryLevelName)
        bool expandedEntryLevelIsPreviousWeekHigh = f_isPreviousWeekHighLevel(expandedEntryLevelName)
        bool expandedEntryLevelIsPreviousDayLow = f_isPreviousDayLowLevel(expandedEntryLevelName)
        bool expandedEntryLevelIsPreviousDayHigh = f_isPreviousDayHighLevel(expandedEntryLevelName)
        float expandedEntryLevelPricePrior =
             expandedEntryLevelIsPreviousWeekLow ? convertedTradePrevWeekLow[1] :
             expandedEntryLevelIsPreviousWeekHigh ? convertedTradePrevWeekHigh[1] :
             expandedEntryLevelIsPreviousDayLow ? convertedTradePrevDayLow[1] :
             expandedEntryLevelIsPreviousDayHigh ? convertedTradePrevDayHigh[1] :
             na
        longPreviousWeekLowQualified := longPreviousWeekLowQualified or (expandedEntryLevelIsPreviousWeekLow and longExpandedEntryLevelQualified)
        shortPreviousWeekHighQualified := shortPreviousWeekHighQualified or (expandedEntryLevelIsPreviousWeekHigh and shortExpandedEntryLevelQualified)
        longPreviousDayLowQualified := longPreviousDayLowQualified or (expandedEntryLevelIsPreviousDayLow and longExpandedEntryLevelQualified)
        shortPreviousDayHighQualified := shortPreviousDayHighQualified or (expandedEntryLevelIsPreviousDayHigh and shortExpandedEntryLevelQualified)
        longPreviousWeekLowPriorClosePassed := longPreviousWeekLowPriorClosePassed or (expandedEntryLevelIsPreviousWeekLow and longExpandedEntryLevelQualified and f_longPriorCloseDidNotMeaningfullyBreakSupport(close[1], expandedEntryLevelPricePrior, low[1], high[1], htfPriorCloseMeaningfulBreakPct))
        longPreviousDayLowPriorClosePassed := longPreviousDayLowPriorClosePassed or (expandedEntryLevelIsPreviousDayLow and longExpandedEntryLevelQualified and f_longPriorCloseDidNotMeaningfullyBreakSupport(close[1], expandedEntryLevelPricePrior, low[1], high[1], htfPriorCloseMeaningfulBreakPct))
        shortPreviousWeekHighPriorClosePassed := shortPreviousWeekHighPriorClosePassed or (expandedEntryLevelIsPreviousWeekHigh and shortExpandedEntryLevelQualified and f_shortPriorCloseDidNotMeaningfullyBreakResistance(close[1], expandedEntryLevelPricePrior, low[1], high[1], htfPriorCloseMeaningfulBreakPct))
        shortPreviousDayHighPriorClosePassed := shortPreviousDayHighPriorClosePassed or (expandedEntryLevelIsPreviousDayHigh and shortExpandedEntryLevelQualified and f_shortPriorCloseDidNotMeaningfullyBreakResistance(close[1], expandedEntryLevelPricePrior, low[1], high[1], htfPriorCloseMeaningfulBreakPct))
        bool betterLongExpandedLevel = not longExpandedScalpLevelFound or expandedEntryLevelPriority < longExpandedScalpLevelPriority or (expandedEntryLevelPriority == longExpandedScalpLevelPriority and (na(longExpandedScalpLevelPrice) or expandedEntryLevelPrice > longExpandedScalpLevelPrice))
        bool betterShortExpandedLevel = not shortExpandedScalpLevelFound or expandedEntryLevelPriority < shortExpandedScalpLevelPriority or (expandedEntryLevelPriority == shortExpandedScalpLevelPriority and (na(shortExpandedScalpLevelPrice) or expandedEntryLevelPrice < shortExpandedScalpLevelPrice))
        if longExpandedEntryLevelQualified and betterLongExpandedLevel
            longExpandedScalpLevelPrice := expandedEntryLevelPrice
            longExpandedScalpLevelName := expandedEntryLevelName
            longExpandedScalpLevelPriority := expandedEntryLevelPriority
            longExpandedScalpLevelTouchedCurrent := expandedEntryLevelTouchedCurrent
            longExpandedScalpLevelFound := true
        if shortExpandedEntryLevelQualified and betterShortExpandedLevel
            shortExpandedScalpLevelPrice := expandedEntryLevelPrice
            shortExpandedScalpLevelName := expandedEntryLevelName
            shortExpandedScalpLevelPriority := expandedEntryLevelPriority
            shortExpandedScalpLevelTouchedCurrent := expandedEntryLevelTouchedCurrent
            shortExpandedScalpLevelFound := true

[longGroup1AfterPDHPrice, longGroup1AfterPDHName, longGroup1AfterPDHPriority, longGroup1AfterPDHCurrent, longGroup1AfterPDHFound] = f_pickLongQualifiedLevel(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, "PDH", 4, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longGroup1Price, longGroup1Name, longGroup1Priority, longGroup1Current, longGroup1Found] = f_pickLongQualifiedLevel(useDirectTradePrevDayLowLevel, effectivePrevDayLow, "PDL", 4, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, longGroup1AfterPDHPrice, longGroup1AfterPDHName, longGroup1AfterPDHPriority, longGroup1AfterPDHCurrent, longGroup1AfterPDHFound)
[longGroup3AfterPMHPrice, longGroup3AfterPMHName, longGroup3AfterPMHPriority, longGroup3AfterPMHCurrent, longGroup3AfterPMHFound] = f_pickLongQualifiedLevel(usePremarketHighLevel, effectivePremarketHigh, "PMH", 7, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longGroup3Price, longGroup3Name, longGroup3Priority, longGroup3Current, longGroup3Found] = f_pickLongQualifiedLevel(usePremarketLowLevel, effectivePremarketLow, "PML", 7, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, longGroup3AfterPMHPrice, longGroup3AfterPMHName, longGroup3AfterPMHPriority, longGroup3AfterPMHCurrent, longGroup3AfterPMHFound)
[longGroup4AfterORHPrice, longGroup4AfterORHName, longGroup4AfterORHPriority, longGroup4AfterORHCurrent, longGroup4AfterORHFound] = f_pickLongQualifiedLevel(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "ORH", 8, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longGroup4Price, longGroup4Name, longGroup4Priority, longGroup4Current, longGroup4Found] = f_pickLongQualifiedLevel(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "ORL", 8, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, longGroup4AfterORHPrice, longGroup4AfterORHName, longGroup4AfterORHPriority, longGroup4AfterORHCurrent, longGroup4AfterORHFound)

[shortGroup1AfterPDHPrice, shortGroup1AfterPDHName, shortGroup1AfterPDHPriority, shortGroup1AfterPDHCurrent, shortGroup1AfterPDHFound] = f_pickShortQualifiedLevel(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, "PDH", 4, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortGroup1Price, shortGroup1Name, shortGroup1Priority, shortGroup1Current, shortGroup1Found] = f_pickShortQualifiedLevel(useDirectTradePrevDayLowLevel, effectivePrevDayLow, "PDL", 4, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, shortGroup1AfterPDHPrice, shortGroup1AfterPDHName, shortGroup1AfterPDHPriority, shortGroup1AfterPDHCurrent, shortGroup1AfterPDHFound)
[shortGroup3AfterPMHPrice, shortGroup3AfterPMHName, shortGroup3AfterPMHPriority, shortGroup3AfterPMHCurrent, shortGroup3AfterPMHFound] = f_pickShortQualifiedLevel(usePremarketHighLevel, effectivePremarketHigh, "PMH", 7, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortGroup3Price, shortGroup3Name, shortGroup3Priority, shortGroup3Current, shortGroup3Found] = f_pickShortQualifiedLevel(usePremarketLowLevel, effectivePremarketLow, "PML", 7, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, shortGroup3AfterPMHPrice, shortGroup3AfterPMHName, shortGroup3AfterPMHPriority, shortGroup3AfterPMHCurrent, shortGroup3AfterPMHFound)
[shortGroup4AfterORHPrice, shortGroup4AfterORHName, shortGroup4AfterORHPriority, shortGroup4AfterORHCurrent, shortGroup4AfterORHFound] = f_pickShortQualifiedLevel(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "ORH", 8, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortGroup4Price, shortGroup4Name, shortGroup4Priority, shortGroup4Current, shortGroup4Found] = f_pickShortQualifiedLevel(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "ORL", 8, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, shortGroup4AfterORHPrice, shortGroup4AfterORHName, shortGroup4AfterORHPriority, shortGroup4AfterORHCurrent, shortGroup4AfterORHFound)

bool longDirectPreviousDayLowTouchedForSignal = f_levelTouched(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useDirectTradePrevDayLowLevel, effectivePrevDayLow, low[1], high[1], priorBarBear)
bool shortDirectPreviousDayHighTouchedForSignal = f_levelTouched(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, low[1], high[1], priorBarBull)
bool longDirectPreviousDayLowQualified = longDirectPreviousDayLowTouchedForSignal and scalpSignalClose > effectivePrevDayLow
bool shortDirectPreviousDayHighQualified = shortDirectPreviousDayHighTouchedForSignal and scalpSignalClose < effectivePrevDayHigh
longPreviousDayLowQualified := longPreviousDayLowQualified or longDirectPreviousDayLowQualified
shortPreviousDayHighQualified := shortPreviousDayHighQualified or shortDirectPreviousDayHighQualified
longPreviousDayLowPriorClosePassed := longPreviousDayLowPriorClosePassed or (longDirectPreviousDayLowQualified and f_longPriorCloseDidNotMeaningfullyBreakSupport(close[1], effectivePrevDayLow[1], low[1], high[1], htfPriorCloseMeaningfulBreakPct))
shortPreviousDayHighPriorClosePassed := shortPreviousDayHighPriorClosePassed or (shortDirectPreviousDayHighQualified and f_shortPriorCloseDidNotMeaningfullyBreakResistance(close[1], effectivePrevDayHigh[1], low[1], high[1], htfPriorCloseMeaningfulBreakPct))

longHasNonDailyOpenQualifiedEntryLevel = longExpandedScalpLevelFound or longGroup1Found or longGroup3Found or longGroup4Found
shortHasNonDailyOpenQualifiedEntryLevel = shortExpandedScalpLevelFound or shortGroup1Found or shortGroup3Found or shortGroup4Found

[longGroup2Price, longGroup2Name, longGroup2Priority, longGroup2Current, longGroup2Found] = f_pickLongQualifiedLevel(activeTradeDailyOpenValid and longHasNonDailyOpenQualifiedEntryLevel, activeTradeDailyOpen, "OP", 6, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortGroup2Price, shortGroup2Name, shortGroup2Priority, shortGroup2Current, shortGroup2Found] = f_pickShortQualifiedLevel(activeTradeDailyOpenValid and shortHasNonDailyOpenQualifiedEntryLevel, activeTradeDailyOpen, "OP", 6, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
longDailyOpenConfluenceQualified = longGroup2Found
shortDailyOpenConfluenceQualified = shortGroup2Found

// ORH is valid by itself for longs, and ORL is valid by itself for shorts.
// Counter-direction OR fades require non-OR confluence and are blocked after full acceptance beyond the fade level.
bool longOpeningRangeHighTouchedForSignal = f_levelTouched(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, low[1], high[1], priorBarBear)
bool longOpeningRangeLowTouchedForSignal = f_levelTouched(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, low[1], high[1], priorBarBear)
bool shortOpeningRangeHighTouchedForSignal = f_levelTouched(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, low[1], high[1], priorBarBull)
bool shortOpeningRangeLowTouchedForSignal = f_levelTouched(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, low[1], high[1], priorBarBull)
bool longOpeningRangeHighQualified = longOpeningRangeHighTouchedForSignal and scalpSignalClose > openingRangeHigh
bool longOpeningRangeLowQualified = longOpeningRangeLowTouchedForSignal and scalpSignalClose > openingRangeLow
bool shortOpeningRangeHighQualified = shortOpeningRangeHighTouchedForSignal and scalpSignalClose < openingRangeHigh
bool shortOpeningRangeLowQualified = shortOpeningRangeLowTouchedForSignal and scalpSignalClose < openingRangeLow
bool longNonOpeningRangeEntryLevelQualified = longExpandedScalpLevelFound or longGroup1Found or longGroup3Found or longDailyOpenConfluenceQualified
bool shortNonOpeningRangeEntryLevelQualified = shortExpandedScalpLevelFound or shortGroup1Found or shortGroup3Found or shortDailyOpenConfluenceQualified
bool longOpeningRangeLowFadeRequired = longOpeningRangeLowQualified and not longOpeningRangeHighQualified
bool longOpeningRangeLowFadeAllowed =
     longOpeningRangeLowQualified and
     bullSignalHighVol and
     longNonOpeningRangeEntryLevelQualified and
     not openingRangeLowAcceptedBelow and
     (not requireOpeningRangeFadePreBreakoutOnly or not openingRangeHasBrokenOutOnce)
bool shortOpeningRangeHighFadeRequired = shortOpeningRangeHighQualified and not shortOpeningRangeLowQualified
bool shortOpeningRangeHighFadeAllowed =
     shortOpeningRangeHighQualified and
     bearSignalHighVol and
     shortNonOpeningRangeEntryLevelQualified and
     not openingRangeHighAcceptedAbove and
     (not requireOpeningRangeFadePreBreakoutOnly or not openingRangeHasBrokenOutOnce)
bool longOpeningRangePriorClosePassed =
     (not longOpeningRangeHighQualified or openingRangeBias == 1 or close[1] > openingRangeHigh) and
     (not longOpeningRangeLowQualified or longOpeningRangeLowFadeAllowed or close[1] > openingRangeLow)
bool shortOpeningRangePriorClosePassed =
     (not shortOpeningRangeHighQualified or shortOpeningRangeHighFadeAllowed or close[1] < openingRangeHigh) and
     (not shortOpeningRangeLowQualified or openingRangeBias == -1 or close[1] < openingRangeLow)
longOpeningRangeFilterPassed = not longOpeningRangeLowFadeRequired or longOpeningRangeLowFadeAllowed
shortOpeningRangeFilterPassed = not shortOpeningRangeHighFadeRequired or shortOpeningRangeHighFadeAllowed

[longBestAfterExpandedPrice, longBestAfterExpandedName, longBestAfterExpandedPriority, longBestAfterExpandedCurrent, longBestAfterExpandedFound] = f_pickLongEntryCandidate(longExpandedScalpLevelPrice, longExpandedScalpLevelName, longExpandedScalpLevelPriority, longExpandedScalpLevelTouchedCurrent, longExpandedScalpLevelFound, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longBestAfterGroup1Price, longBestAfterGroup1Name, longBestAfterGroup1Priority, longBestAfterGroup1Current, longBestAfterGroup1Found] = f_pickLongEntryCandidate(longGroup1Price, longGroup1Name, longGroup1Priority, longGroup1Current, longGroup1Found, longBestAfterExpandedPrice, longBestAfterExpandedName, longBestAfterExpandedPriority, longBestAfterExpandedCurrent, longBestAfterExpandedFound)
[longBestAfterGroup2Price, longBestAfterGroup2Name, longBestAfterGroup2Priority, longBestAfterGroup2Current, longBestAfterGroup2Found] = f_pickLongEntryCandidate(longGroup2Price, longGroup2Name, longGroup2Priority, longGroup2Current, longGroup2Found, longBestAfterGroup1Price, longBestAfterGroup1Name, longBestAfterGroup1Priority, longBestAfterGroup1Current, longBestAfterGroup1Found)
[longBestAfterGroup3Price, longBestAfterGroup3Name, longBestAfterGroup3Priority, longBestAfterGroup3Current, longBestAfterGroup3Found] = f_pickLongEntryCandidate(longGroup3Price, longGroup3Name, longGroup3Priority, longGroup3Current, longGroup3Found, longBestAfterGroup2Price, longBestAfterGroup2Name, longBestAfterGroup2Priority, longBestAfterGroup2Current, longBestAfterGroup2Found)
[longBestAfterGroup4Price, longBestAfterGroup4Name, longBestAfterGroup4Priority, longBestAfterGroup4Current, longBestAfterGroup4Found] = f_pickLongEntryCandidate(longGroup4Price, longGroup4Name, longGroup4Priority, longGroup4Current, longGroup4Found, longBestAfterGroup3Price, longBestAfterGroup3Name, longBestAfterGroup3Priority, longBestAfterGroup3Current, longBestAfterGroup3Found)

[shortBestAfterExpandedPrice, shortBestAfterExpandedName, shortBestAfterExpandedPriority, shortBestAfterExpandedCurrent, shortBestAfterExpandedFound] = f_pickShortEntryCandidate(shortExpandedScalpLevelPrice, shortExpandedScalpLevelName, shortExpandedScalpLevelPriority, shortExpandedScalpLevelTouchedCurrent, shortExpandedScalpLevelFound, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortBestAfterGroup1Price, shortBestAfterGroup1Name, shortBestAfterGroup1Priority, shortBestAfterGroup1Current, shortBestAfterGroup1Found] = f_pickShortEntryCandidate(shortGroup1Price, shortGroup1Name, shortGroup1Priority, shortGroup1Current, shortGroup1Found, shortBestAfterExpandedPrice, shortBestAfterExpandedName, shortBestAfterExpandedPriority, shortBestAfterExpandedCurrent, shortBestAfterExpandedFound)
[shortBestAfterGroup2Price, shortBestAfterGroup2Name, shortBestAfterGroup2Priority, shortBestAfterGroup2Current, shortBestAfterGroup2Found] = f_pickShortEntryCandidate(shortGroup2Price, shortGroup2Name, shortGroup2Priority, shortGroup2Current, shortGroup2Found, shortBestAfterGroup1Price, shortBestAfterGroup1Name, shortBestAfterGroup1Priority, shortBestAfterGroup1Current, shortBestAfterGroup1Found)
[shortBestAfterGroup3Price, shortBestAfterGroup3Name, shortBestAfterGroup3Priority, shortBestAfterGroup3Current, shortBestAfterGroup3Found] = f_pickShortEntryCandidate(shortGroup3Price, shortGroup3Name, shortGroup3Priority, shortGroup3Current, shortGroup3Found, shortBestAfterGroup2Price, shortBestAfterGroup2Name, shortBestAfterGroup2Priority, shortBestAfterGroup2Current, shortBestAfterGroup2Found)
[shortBestAfterGroup4Price, shortBestAfterGroup4Name, shortBestAfterGroup4Priority, shortBestAfterGroup4Current, shortBestAfterGroup4Found] = f_pickShortEntryCandidate(shortGroup4Price, shortGroup4Name, shortGroup4Priority, shortGroup4Current, shortGroup4Found, shortBestAfterGroup3Price, shortBestAfterGroup3Name, shortBestAfterGroup3Priority, shortBestAfterGroup3Current, shortBestAfterGroup3Found)

longMostKeyTouchedLevelPrice = longBestAfterGroup4Found ? longBestAfterGroup4Price : na
longMostKeyTouchedLevelName = longBestAfterGroup4Found ? longBestAfterGroup4Name : "N/A"
longMostKeyTouchedLevelCurrent = longBestAfterGroup4Found and longBestAfterGroup4Current

shortMostKeyTouchedLevelPrice = shortBestAfterGroup4Found ? shortBestAfterGroup4Price : na
shortMostKeyTouchedLevelName = shortBestAfterGroup4Found ? shortBestAfterGroup4Name : "N/A"
shortMostKeyTouchedLevelCurrent = shortBestAfterGroup4Found and shortBestAfterGroup4Current

longAnyEntryLevelTouched = not na(longMostKeyTouchedLevelPrice)
shortAnyEntryLevelTouched = not na(shortMostKeyTouchedLevelPrice)

longMostKeyTouchedLevelBroken = longAnyEntryLevelTouched and scalpSignalClose > longMostKeyTouchedLevelPrice
shortMostKeyTouchedLevelBroken = shortAnyEntryLevelTouched and scalpSignalClose < shortMostKeyTouchedLevelPrice

bool longAnyTouchedLevelFailedCloseBeyond = false
bool shortAnyTouchedLevelFailedCloseBeyond = false
bool longNineEmaNoSignalBarLevelTouched = true
bool shortNineEmaNoSignalBarLevelTouched = true
bool longAllCurrentTouchedLevelsRetracementOk = true
bool shortAllCurrentTouchedLevelsRetracementOk = true
if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
    for touchedLevelIndex = 0 to array.size(swingLevelPrices) - 1
        float touchedLevelPrice = array.get(swingLevelPrices, touchedLevelIndex)
        string touchedLevelName = array.get(swingLevelNames, touchedLevelIndex)
        bool touchedLevelAllowedForEntry = array.get(swingLevelAllowedForEntry, touchedLevelIndex)
        bool touchedLevelRequiresCloseBeyond = array.get(swingLevelCloseBeyondRequired, touchedLevelIndex)
        bool touchedLevelRetracementEntry = touchedLevelAllowedForEntry and f_isScalpRetracementEntryLevel(touchedLevelName)
        bool touchedLevelTouchedCurrent = f_levelTouched(touchedLevelRetracementEntry, touchedLevelPrice, scalpSignalLow, scalpSignalHigh)
        longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(touchedLevelRequiresCloseBeyond, touchedLevelPrice, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
        shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(touchedLevelRequiresCloseBeyond, touchedLevelPrice, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
        longNineEmaNoSignalBarLevelTouched := longNineEmaNoSignalBarLevelTouched and not touchedLevelTouchedCurrent
        shortNineEmaNoSignalBarLevelTouched := shortNineEmaNoSignalBarLevelTouched and not touchedLevelTouchedCurrent
        longAllCurrentTouchedLevelsRetracementOk := longAllCurrentTouchedLevelsRetracementOk and f_longTouchedClearedLevelRetracementOk(touchedLevelRetracementEntry, touchedLevelPrice, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
        shortAllCurrentTouchedLevelsRetracementOk := shortAllCurrentTouchedLevelsRetracementOk and f_shortTouchedClearedLevelRetracementOk(touchedLevelRetracementEntry, touchedLevelPrice, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)

longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useDailyOpenAsCloseBeyondBlocker and activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(usePremarketHighLevel, effectivePremarketHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(usePremarketLowLevel, effectivePremarketLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)

shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useDailyOpenAsCloseBeyondBlocker and activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(usePremarketHighLevel, effectivePremarketHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(usePremarketLowLevel, effectivePremarketLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)

longNineEmaNoSignalBarLevelTouched := longNineEmaNoSignalBarLevelTouched and not f_levelTouched(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh)
longNineEmaNoSignalBarLevelTouched := longNineEmaNoSignalBarLevelTouched and not f_levelTouched(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh)
longNineEmaNoSignalBarLevelTouched := longNineEmaNoSignalBarLevelTouched and not f_levelTouched(activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh)
longNineEmaNoSignalBarLevelTouched := longNineEmaNoSignalBarLevelTouched and not f_levelTouched(usePremarketHighLevel, effectivePremarketHigh, scalpSignalLow, scalpSignalHigh)
longNineEmaNoSignalBarLevelTouched := longNineEmaNoSignalBarLevelTouched and not f_levelTouched(usePremarketLowLevel, effectivePremarketLow, scalpSignalLow, scalpSignalHigh)
longNineEmaNoSignalBarLevelTouched := longNineEmaNoSignalBarLevelTouched and not f_levelTouched(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh)
longNineEmaNoSignalBarLevelTouched := longNineEmaNoSignalBarLevelTouched and not f_levelTouched(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh)

shortNineEmaNoSignalBarLevelTouched := shortNineEmaNoSignalBarLevelTouched and not f_levelTouched(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh)
shortNineEmaNoSignalBarLevelTouched := shortNineEmaNoSignalBarLevelTouched and not f_levelTouched(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh)
shortNineEmaNoSignalBarLevelTouched := shortNineEmaNoSignalBarLevelTouched and not f_levelTouched(activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh)
shortNineEmaNoSignalBarLevelTouched := shortNineEmaNoSignalBarLevelTouched and not f_levelTouched(usePremarketHighLevel, effectivePremarketHigh, scalpSignalLow, scalpSignalHigh)
shortNineEmaNoSignalBarLevelTouched := shortNineEmaNoSignalBarLevelTouched and not f_levelTouched(usePremarketLowLevel, effectivePremarketLow, scalpSignalLow, scalpSignalHigh)
shortNineEmaNoSignalBarLevelTouched := shortNineEmaNoSignalBarLevelTouched and not f_levelTouched(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh)
shortNineEmaNoSignalBarLevelTouched := shortNineEmaNoSignalBarLevelTouched and not f_levelTouched(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh)

longAllCurrentTouchedLevelsRetracementOk := longAllCurrentTouchedLevelsRetracementOk and f_longTouchedClearedLevelRetracementOk(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
longAllCurrentTouchedLevelsRetracementOk := longAllCurrentTouchedLevelsRetracementOk and f_longTouchedClearedLevelRetracementOk(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
longAllCurrentTouchedLevelsRetracementOk := longAllCurrentTouchedLevelsRetracementOk and f_longTouchedClearedLevelRetracementOk(activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
longAllCurrentTouchedLevelsRetracementOk := longAllCurrentTouchedLevelsRetracementOk and f_longTouchedClearedLevelRetracementOk(usePremarketHighLevel, effectivePremarketHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
longAllCurrentTouchedLevelsRetracementOk := longAllCurrentTouchedLevelsRetracementOk and f_longTouchedClearedLevelRetracementOk(usePremarketLowLevel, effectivePremarketLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
longAllCurrentTouchedLevelsRetracementOk := longAllCurrentTouchedLevelsRetracementOk and f_longTouchedClearedLevelRetracementOk(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
longAllCurrentTouchedLevelsRetracementOk := longAllCurrentTouchedLevelsRetracementOk and f_longTouchedClearedLevelRetracementOk(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)

shortAllCurrentTouchedLevelsRetracementOk := shortAllCurrentTouchedLevelsRetracementOk and f_shortTouchedClearedLevelRetracementOk(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
shortAllCurrentTouchedLevelsRetracementOk := shortAllCurrentTouchedLevelsRetracementOk and f_shortTouchedClearedLevelRetracementOk(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
shortAllCurrentTouchedLevelsRetracementOk := shortAllCurrentTouchedLevelsRetracementOk and f_shortTouchedClearedLevelRetracementOk(activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
shortAllCurrentTouchedLevelsRetracementOk := shortAllCurrentTouchedLevelsRetracementOk and f_shortTouchedClearedLevelRetracementOk(usePremarketHighLevel, effectivePremarketHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
shortAllCurrentTouchedLevelsRetracementOk := shortAllCurrentTouchedLevelsRetracementOk and f_shortTouchedClearedLevelRetracementOk(usePremarketLowLevel, effectivePremarketLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
shortAllCurrentTouchedLevelsRetracementOk := shortAllCurrentTouchedLevelsRetracementOk and f_shortTouchedClearedLevelRetracementOk(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)
shortAllCurrentTouchedLevelsRetracementOk := shortAllCurrentTouchedLevelsRetracementOk and f_shortTouchedClearedLevelRetracementOk(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose, minLevelEntryRetracement)

longAllTouchedLevelsClosedBeyond = not longAnyTouchedLevelFailedCloseBeyond
shortAllTouchedLevelsClosedBeyond = not shortAnyTouchedLevelFailedCloseBeyond

longSelectedLevelPrice = longMostKeyTouchedLevelBroken ? longMostKeyTouchedLevelPrice : na
longSelectedLevelName = longMostKeyTouchedLevelBroken ? longMostKeyTouchedLevelName : "N/A"
longSelectedLevelTouchedCurrent = longMostKeyTouchedLevelBroken and longMostKeyTouchedLevelCurrent

shortSelectedLevelPrice = shortMostKeyTouchedLevelBroken ? shortMostKeyTouchedLevelPrice : na
shortSelectedLevelName = shortMostKeyTouchedLevelBroken ? shortMostKeyTouchedLevelName : "N/A"
shortSelectedLevelTouchedCurrent = shortMostKeyTouchedLevelBroken and shortMostKeyTouchedLevelCurrent

longCloseBeyondSelectedDistance = not na(longSelectedLevelPrice) and scalpSignalClose > longSelectedLevelPrice ? scalpSignalClose - longSelectedLevelPrice : na
longCloseToHighDistance = not na(longSelectedLevelPrice) and scalpSignalClose > longSelectedLevelPrice ? scalpSignalHigh - scalpSignalClose : na
longSelectedLevelCloseAcceptancePassed = not na(longCloseBeyondSelectedDistance) and not na(longCloseToHighDistance) and longCloseBeyondSelectedDistance > longCloseToHighDistance
shortCloseBeyondSelectedDistance = not na(shortSelectedLevelPrice) and scalpSignalClose < shortSelectedLevelPrice ? shortSelectedLevelPrice - scalpSignalClose : na
shortCloseToLowDistance = not na(shortSelectedLevelPrice) and scalpSignalClose < shortSelectedLevelPrice ? scalpSignalClose - scalpSignalLow : na
shortSelectedLevelCloseAcceptancePassed = not na(shortCloseBeyondSelectedDistance) and not na(shortCloseToLowDistance) and shortCloseBeyondSelectedDistance > shortCloseToLowDistance

// Level-entry retracement validation only applies when the broken level would be the entry.
levelEntryRange = scalpSignalHigh - scalpSignalLow
longLevelEntryRequired = not na(longSelectedLevelPrice) and longSelectedLevelPrice > longEntry50 and longSelectedLevelPrice < scalpSignalClose
shortLevelEntryRequired = not na(shortSelectedLevelPrice) and shortSelectedLevelPrice < shortEntry50 and shortSelectedLevelPrice > scalpSignalClose
float longLevelEntryRetracement = (levelEntryRange > 0 and longLevelEntryRequired) ? (scalpSignalHigh - longSelectedLevelPrice) / levelEntryRange : na
float shortLevelEntryRetracement = (levelEntryRange > 0 and shortLevelEntryRequired) ? (shortSelectedLevelPrice - scalpSignalLow) / levelEntryRange : na
longLevelEntryRetracementOk = not longLevelEntryRequired or (not na(longLevelEntryRetracement) and longLevelEntryRetracement >= minLevelEntryRetracement)
shortLevelEntryRetracementOk = not shortLevelEntryRequired or (not na(shortLevelEntryRetracement) and shortLevelEntryRetracement >= minLevelEntryRetracement)

// ===================== Scalp Setup Qualification Logic =====================
// Level setups reuse the enabled scalp entry level checks above. A selected
// level only exists after the signal or prior bar qualifies and the signal closes beyond it.
longLevelBreakSetup = longMostKeyTouchedLevelBroken and longAllTouchedLevelsClosedBeyond and longLevelEntryRetracementOk and longAllCurrentTouchedLevelsRetracementOk and longSelectedLevelCloseAcceptancePassed
shortLevelBreakSetup = shortMostKeyTouchedLevelBroken and shortAllTouchedLevelsClosedBeyond and shortLevelEntryRetracementOk and shortAllCurrentTouchedLevelsRetracementOk and shortSelectedLevelCloseAcceptancePassed

longPullbackBreak = not na(low[1]) and low < low[1]
shortPullbackBreak = not na(high[1]) and high > high[1]
longNoPullbackBreak = not na(low[1]) and not longPullbackBreak
shortNoPullbackBreak = not na(high[1]) and not shortPullbackBreak
var int longBarsWithoutPullbackBreak = 0
var int shortBarsWithoutPullbackBreak = 0
longBarsWithoutPullbackBreak := longNoPullbackBreak ? nz(longBarsWithoutPullbackBreak[1]) + 1 : 0
shortBarsWithoutPullbackBreak := shortNoPullbackBreak ? nz(shortBarsWithoutPullbackBreak[1]) + 1 : 0

prior1StrongBull = f_isBullBar(open[1], close[1]) and bodyPct[1] >= 0.50 and closeInUpperThird[1]
prior2StrongBull = f_isBullBar(open[2], close[2]) and bodyPct[2] >= 0.50 and closeInUpperThird[2]
prior1StrongBear = f_isBearBar(open[1], close[1]) and bodyPct[1] >= 0.50 and closeInLowerThird[1]
prior2StrongBear = f_isBearBar(open[2], close[2]) and bodyPct[2] >= 0.50 and closeInLowerThird[2]
longFiveBarExtension = longBarsWithoutPullbackBreak >= 5
shortFiveBarExtension = shortBarsWithoutPullbackBreak >= 5
longStrongMicrochannelExtension = prior1StrongBull and prior2StrongBull
shortStrongMicrochannelExtension = prior1StrongBear and prior2StrongBear
longFiveSameColorBarExtension =
     f_isBullBar(open, close) and
     f_isBullBar(open[1], close[1]) and
     f_isBullBar(open[2], close[2]) and
     f_isBullBar(open[3], close[3]) and
     f_isBullBar(open[4], close[4])
shortFiveSameColorBarExtension =
     f_isBearBar(open, close) and
     f_isBearBar(open[1], close[1]) and
     f_isBearBar(open[2], close[2]) and
     f_isBearBar(open[3], close[3]) and
     f_isBearBar(open[4], close[4])
longOppositeFiveBarPressure = f_priorBearPressureCount(oppositePressureLookbackBars, oppositePressureMinBodyPct) >= oppositePressureMinBars
shortOppositeFiveBarPressure = f_priorBullPressureCount(oppositePressureLookbackBars, oppositePressureMinBodyPct) >= oppositePressureMinBars
longExtendedSetup = longFiveBarExtension or longStrongMicrochannelExtension
shortExtendedSetup = shortFiveBarExtension or shortStrongMicrochannelExtension
longExtendedSetupBlocked =
     (skipFiveSameColorBarExtension and longFiveSameColorBarExtension) or
     (skipFiveBarExtension and longFiveBarExtension) or
     (skipStrongMicrochannelExtension and longStrongMicrochannelExtension)
shortExtendedSetupBlocked =
     (skipFiveSameColorBarExtension and shortFiveSameColorBarExtension) or
     (skipFiveBarExtension and shortFiveBarExtension) or
     (skipStrongMicrochannelExtension and shortStrongMicrochannelExtension)

longFboLevelSetupQualified = longLevelBreakSetup and bullScalpSetupTier
longIgnitionLevelSetupQualified = longLevelBreakSetup and bullScalpIgnitionTier
longStrongIgnitionLevelSetupQualified = longLevelBreakSetup and bullScalpStrongIgnitionTier
// Prior bar must use roundedNineEma[1], not current roundedNineEma, so the prior bar is checked against its own EMA value.
longPriorBarBeyondNineEma = not requirePriorBarBeyondNineEma or (not na(roundedNineEma[1]) and low[1] >= roundedNineEma[1] + scalpTickSize)
shortPriorBarBeyondNineEma = not requirePriorBarBeyondNineEma or (not na(roundedNineEma[1]) and high[1] <= roundedNineEma[1] - scalpTickSize)
longRecentStrongCloseForNineEma = not requireRecentStrongCloseForNineEma or closeInUpperThird[1] or closeInUpperThird[2]
shortRecentStrongCloseForNineEma = not requireRecentStrongCloseForNineEma or closeInLowerThird[1] or closeInLowerThird[2]
// Blocks 9 EMA continuation setups only when the signal bar is more than one full bar range away from its rounded EMA.
// Normal 9 EMA distance check uses the signal bar.
// Two-bar impulse exception allows the signal bar to be extended only when the prior bar was the strong launch bar from near its own 9 EMA.
priorBarRange = high[1] - low[1]

longNineEmaDistanceFromEma = low - roundedNineEma
shortNineEmaDistanceFromEma = roundedNineEma - high

longSignalBarNearNineEma =
     barRange > 0 and
     not na(roundedNineEma) and
     longNineEmaDistanceFromEma <= barRange * nineEmaMaxDistanceBarRangeMultiplier

shortSignalBarNearNineEma =
     barRange > 0 and
     not na(roundedNineEma) and
     shortNineEmaDistanceFromEma <= barRange * nineEmaMaxDistanceBarRangeMultiplier

longPriorBarDistanceFromNineEma = low[1] - roundedNineEma[1]
shortPriorBarDistanceFromNineEma = roundedNineEma[1] - high[1]

longPriorBarNearNineEma =
     priorBarRange > 0 and
     not na(roundedNineEma[1]) and
     longPriorBarDistanceFromNineEma <= priorBarRange * nineEmaPriorLaunchMaxDistanceBarRangeMultiplier

shortPriorBarNearNineEma =
     priorBarRange > 0 and
     not na(roundedNineEma[1]) and
     shortPriorBarDistanceFromNineEma <= priorBarRange * nineEmaPriorLaunchMaxDistanceBarRangeMultiplier

longPriorBarStrongNineEmaLaunch =
     f_isBullBar(open[1], close[1]) and
     bodyPct[1] >= 0.50 and
     closeInUpperThird[1] and
     longPriorBarNearNineEma and
     low[1] >= roundedNineEma[1] + scalpTickSize

shortPriorBarStrongNineEmaLaunch =
     f_isBearBar(open[1], close[1]) and
     bodyPct[1] >= 0.50 and
     closeInLowerThird[1] and
     shortPriorBarNearNineEma and
     high[1] <= roundedNineEma[1] - scalpTickSize

longNineEmaTwoBarImpulseDistanceException = longPriorBarStrongNineEmaLaunch and closeInUpperFourth
shortNineEmaTwoBarImpulseDistanceException = shortPriorBarStrongNineEmaLaunch and closeInLowerFourth

longNineEmaDistanceNotTooExtended =
     not blockNineEmaSetupWhenTooFarFromEma or
     longSignalBarNearNineEma or
     longNineEmaTwoBarImpulseDistanceException

shortNineEmaDistanceNotTooExtended =
     not blockNineEmaSetupWhenTooFarFromEma or
     shortSignalBarNearNineEma or
     shortNineEmaTwoBarImpulseDistanceException

priorPullbackRange = high[1] - low[1]
priorPullbackDoji = bodyPct[1] <= 0.25

priorCloseAboveLowerThird =
     priorPullbackRange > 0 and
     close[1] > low[1] + priorPullbackRange * (1.0 / 3.0)

priorCloseBelowUpperThird =
     priorPullbackRange > 0 and
     close[1] < low[1] + priorPullbackRange * (2.0 / 3.0)

longLowVolumePriorPullback =
     (f_isBearBar(open[1], close[1]) or priorPullbackDoji) and
     not na(volume[2]) and
     volume[1] < volume[2] and
     priorCloseAboveLowerThird

shortLowVolumePriorPullback =
     (f_isBullBar(open[1], close[1]) or priorPullbackDoji) and
     not na(volume[2]) and
     volume[1] < volume[2] and
     priorCloseBelowUpperThird

longLowVolumeSignalPaOk =
     sufficientVolatility and
     f_isBullBar(open, close) and
     closeInUpperThird and
     (isBodyThreshold or isLowerWickThreshold)

shortLowVolumeSignalPaOk =
     sufficientVolatility and
     f_isBearBar(open, close) and
     closeInLowerThird and
     (isBodyThreshold or isUpperWickThreshold)

longLowVolumePullbackNearNineEma =
     barRange > 0 and
     not na(roundedNineEma) and
     math.max(low - roundedNineEma, 0.0) <= barRange * nineEmaLowVolumePullbackMaxDistanceBarRangeMultiplier

shortLowVolumePullbackNearNineEma =
     barRange > 0 and
     not na(roundedNineEma) and
     math.max(roundedNineEma - high, 0.0) <= barRange * nineEmaLowVolumePullbackMaxDistanceBarRangeMultiplier

longLowVolumePullbackTrendContext =
     openingRangeLevelsReady and
     openingRangeBias == 1 and
     not na(roundedNineEma) and
     not na(roundedNineEma[1]) and
     roundedNineEma > roundedNineEma[1] and
     close > roundedNineEma and
     close[1] > roundedNineEma[1]

shortLowVolumePullbackTrendContext =
     openingRangeLevelsReady and
     openingRangeBias == -1 and
     not na(roundedNineEma) and
     not na(roundedNineEma[1]) and
     roundedNineEma < roundedNineEma[1] and
     close < roundedNineEma and
     close[1] < roundedNineEma[1]

longLowVolumePullbackHtfRetestStatePassed =
     not requireHtfContinuationState or
     ((not longPreviousDayLowQualified or longPreviousDayLowPriorClosePassed) and
      (not longPreviousWeekLowQualified or longPreviousWeekLowPriorClosePassed))

shortLowVolumePullbackHtfRetestStatePassed =
     not requireHtfContinuationState or
     ((not shortPreviousDayHighQualified or shortPreviousDayHighPriorClosePassed) and
      (not shortPreviousWeekHighQualified or shortPreviousWeekHighPriorClosePassed))

longNineEmaMomentumSetup =
     useNineEmaMomentumSetup and
     bullSignalHighVol and
     isMostlyBody and
     f_isBullBar(open, close) and
     closeInUpperThird and
     not na(roundedNineEma) and
     low >= roundedNineEma + scalpTickSize and
     longPriorBarBeyondNineEma and
     longRecentStrongCloseForNineEma and
     longNineEmaDistanceNotTooExtended and
     longNineEmaNoSignalBarLevelTouched
longNineEmaMomentumSetupQualified = longNineEmaMomentumSetup
longNineEmaReclaimContinuationSetup =
     useNineEmaReclaimContinuationSetup and
     openingRangeLevelsReady and
     openingRangeBias == 1 and
     bullSignalHighVol and
     f_isBullBar(open, close) and
     not na(roundedNineEma) and
     not na(roundedNineEma[1]) and
     low <= roundedNineEma and
     close > roundedNineEma and
     close[1] > roundedNineEma[1] and
     closeInUpperThird[1] and
     closeInUpperFourth and
     isTwoThirdsBody
longNineEmaReclaimContinuationSetupQualified = longNineEmaReclaimContinuationSetup
longNineEmaLowVolumePullbackSetup =
     useNineEmaLowVolumePullbackSetup and
     longLowVolumePullbackTrendContext and
     longLowVolumePriorPullback and
     longLowVolumeSignalPaOk and
     longLowVolumePullbackNearNineEma and
     longAllTouchedLevelsClosedBeyond and
     longLowVolumePullbackHtfRetestStatePassed
longNineEmaLowVolumePullbackSetupQualified = longNineEmaLowVolumePullbackSetup
longLevelScalpSetupQualified = longFboLevelSetupQualified or longIgnitionLevelSetupQualified or longStrongIgnitionLevelSetupQualified
longScalpSetupQualified = longLevelScalpSetupQualified or longNineEmaMomentumSetupQualified or longNineEmaReclaimContinuationSetupQualified or longNineEmaLowVolumePullbackSetupQualified

shortFboLevelSetupQualified = shortLevelBreakSetup and bearScalpSetupTier
shortIgnitionLevelSetupQualified = shortLevelBreakSetup and bearScalpIgnitionTier
shortStrongIgnitionLevelSetupQualified = shortLevelBreakSetup and bearScalpStrongIgnitionTier
shortNineEmaMomentumSetup =
     useNineEmaMomentumSetup and
     bearSignalHighVol and
     isMostlyBody and
     f_isBearBar(open, close) and
     closeInLowerThird and
     not na(roundedNineEma) and
     high <= roundedNineEma - scalpTickSize and
     shortPriorBarBeyondNineEma and
     shortRecentStrongCloseForNineEma and
     shortNineEmaDistanceNotTooExtended and
     shortNineEmaNoSignalBarLevelTouched
shortNineEmaMomentumSetupQualified = shortNineEmaMomentumSetup
shortNineEmaReclaimContinuationSetup =
     useNineEmaReclaimContinuationSetup and
     openingRangeLevelsReady and
     openingRangeBias == -1 and
     bearSignalHighVol and
     f_isBearBar(open, close) and
     not na(roundedNineEma) and
     not na(roundedNineEma[1]) and
     high >= roundedNineEma and
     close < roundedNineEma and
     close[1] < roundedNineEma[1] and
     closeInLowerThird[1] and
     closeInLowerFourth and
     isTwoThirdsBody
shortNineEmaReclaimContinuationSetupQualified = shortNineEmaReclaimContinuationSetup
shortNineEmaLowVolumePullbackSetup =
     useNineEmaLowVolumePullbackSetup and
     shortLowVolumePullbackTrendContext and
     shortLowVolumePriorPullback and
     shortLowVolumeSignalPaOk and
     shortLowVolumePullbackNearNineEma and
     shortAllTouchedLevelsClosedBeyond and
     shortLowVolumePullbackHtfRetestStatePassed
shortNineEmaLowVolumePullbackSetupQualified = shortNineEmaLowVolumePullbackSetup
shortLevelScalpSetupQualified = shortFboLevelSetupQualified or shortIgnitionLevelSetupQualified or shortStrongIgnitionLevelSetupQualified
shortScalpSetupQualified = shortLevelScalpSetupQualified or shortNineEmaMomentumSetupQualified or shortNineEmaReclaimContinuationSetupQualified or shortNineEmaLowVolumePullbackSetupQualified
longStrongHtfReversalOpeningRangeLocationPassed =
     not requireHtfReversalFullyOutsideOpeningRange or
     (openingRangeLevelsReady and scalpSignalHigh < openingRangeLow)
shortStrongHtfReversalOpeningRangeLocationPassed =
     not requireHtfReversalFullyOutsideOpeningRange or
     (openingRangeLevelsReady and scalpSignalLow > openingRangeHigh)
longStrongHtfReversalException =
     openingRangeLevelsReady and
     longStrongHtfReversalOpeningRangeLocationPassed and
     bullSignalHighVol and
     longLevelScalpSetupQualified and
     priorBarBear and
     ((longPreviousWeekLowQualified and longPreviousWeekLowPriorClosePassed) or
      (longPreviousDayLowQualified and longPreviousDayLowPriorClosePassed))
shortStrongHtfReversalException =
     openingRangeLevelsReady and
     shortStrongHtfReversalOpeningRangeLocationPassed and
     bearSignalHighVol and
     shortLevelScalpSetupQualified and
     priorBarBull and
     ((shortPreviousWeekHighQualified and shortPreviousWeekHighPriorClosePassed) or
      (shortPreviousDayHighQualified and shortPreviousDayHighPriorClosePassed))
longOppositePressureBlocked =
     skipOppositeFiveBarPressureUnlessStrongReversal and
     longOppositeFiveBarPressure and
     not longStrongHtfReversalException
shortOppositePressureBlocked =
     skipOppositeFiveBarPressureUnlessStrongReversal and
     shortOppositeFiveBarPressure and
     not shortStrongHtfReversalException
longOpeningRangeMarketStatePassed =
     openingRangeBias == 1 or
     openingRangeNeutralAfterBreakout or
     longOpeningRangeLowFadeAllowed
shortOpeningRangeMarketStatePassed =
     openingRangeBias == -1 or
     openingRangeNeutralAfterBreakout or
     shortOpeningRangeHighFadeAllowed
longOpeningRangeAcceptedBeyondFadeBlockerPassed = not longOpeningRangeLowFadeRequired or not openingRangeLowAcceptedBelow
shortOpeningRangeAcceptedBeyondFadeBlockerPassed = not shortOpeningRangeHighFadeRequired or not openingRangeHighAcceptedAbove
longOpeningRangeFiltersPassed =
     longOpeningRangeAcceptedBeyondFadeBlockerPassed and
     (longStrongHtfReversalException or
      (longOpeningRangeFilterPassed and longOpeningRangePriorClosePassed and longOpeningRangeMarketStatePassed))
shortOpeningRangeFiltersPassed =
     shortOpeningRangeAcceptedBeyondFadeBlockerPassed and
     (shortStrongHtfReversalException or
      (shortOpeningRangeFilterPassed and shortOpeningRangePriorClosePassed and shortOpeningRangeMarketStatePassed))
longNineEmaMomentumActive = longNineEmaMomentumSetupQualified and not longLevelScalpSetupQualified
shortNineEmaMomentumActive = shortNineEmaMomentumSetupQualified and not shortLevelScalpSetupQualified
longNineEmaReclaimContinuationActive = longNineEmaReclaimContinuationSetupQualified and not longLevelScalpSetupQualified and not longNineEmaMomentumSetupQualified
shortNineEmaReclaimContinuationActive = shortNineEmaReclaimContinuationSetupQualified and not shortLevelScalpSetupQualified and not shortNineEmaMomentumSetupQualified
longNineEmaLowVolumePullbackActive = longNineEmaLowVolumePullbackSetupQualified and not longLevelScalpSetupQualified and not longNineEmaMomentumSetupQualified and not longNineEmaReclaimContinuationSetupQualified
shortNineEmaLowVolumePullbackActive = shortNineEmaLowVolumePullbackSetupQualified and not shortLevelScalpSetupQualified and not shortNineEmaMomentumSetupQualified and not shortNineEmaReclaimContinuationSetupQualified
longOpeningRangeFadeActive = longOpeningRangeLowFadeRequired and longOpeningRangeLowFadeAllowed
shortOpeningRangeFadeActive = shortOpeningRangeHighFadeRequired and shortOpeningRangeHighFadeAllowed
longCompactSignalText =
     longNineEmaMomentumActive ? "9EMA" :
     longNineEmaReclaimContinuationActive ? "9EMA RCLM" :
     longNineEmaLowVolumePullbackActive ? "9EMA LV" :
     longOpeningRangeFadeActive and longStrongHtfReversalException ? "ORF HTF REV" :
     longOpeningRangeFadeActive ? "ORF" :
     longStrongHtfReversalException ? "HTF REV" :
     "LVL"
shortCompactSignalText =
     shortNineEmaMomentumActive ? "9EMA" :
     shortNineEmaReclaimContinuationActive ? "9EMA RCLM" :
     shortNineEmaLowVolumePullbackActive ? "9EMA LV" :
     shortOpeningRangeFadeActive and shortStrongHtfReversalException ? "ORF HTF REV" :
     shortOpeningRangeFadeActive ? "ORF" :
     shortStrongHtfReversalException ? "HTF REV" :
     "LVL"

openingRangeAlertText =
     openingRangeBias == 1 ? "OR Bull" :
     openingRangeBias == -1 ? "OR Bear" :
     openingRangeHasBrokenOutOnce ? "OR Neutral" :
     "OR Pre"

// ===================== Scalp Entry / Stop / Risk Logic =====================
longAnyNineEmaSetupActive = longNineEmaMomentumActive or longNineEmaReclaimContinuationActive or longNineEmaLowVolumePullbackActive
shortAnyNineEmaSetupActive = shortNineEmaMomentumActive or shortNineEmaReclaimContinuationActive or shortNineEmaLowVolumePullbackActive
longUsePriorityLevel = not longAnyNineEmaSetupActive and longLevelEntryRequired and longLevelEntryRetracementOk
shortUsePriorityLevel = not shortAnyNineEmaSetupActive and shortLevelEntryRequired and shortLevelEntryRetracementOk
longEntryType = longAnyNineEmaSetupActive ? "50%" : longUsePriorityLevel ? longSelectedLevelName : "50%"
shortEntryType = shortAnyNineEmaSetupActive ? "50%" : shortUsePriorityLevel ? shortSelectedLevelName : "50%"

longEntryPrice = longAnyNineEmaSetupActive ? longEntry50 : longUsePriorityLevel ? longSelectedLevelPrice : longEntry50
shortEntryPrice = shortAnyNineEmaSetupActive ? shortEntry50 : shortUsePriorityLevel ? shortSelectedLevelPrice : shortEntry50
longEntryTouchedPrior1 = f_priceTouchedByBody(longEntryPrice, open[1], close[1])
longEntryTouchedPrior2 = f_priceTouchedByBody(longEntryPrice, open[2], close[2])

shortEntryTouchedPrior1 = f_priceTouchedByBody(shortEntryPrice, open[1], close[1])
shortEntryTouchedPrior2 = f_priceTouchedByBody(shortEntryPrice, open[2], close[2])

longEntryPriceOverlapStale = longEntryTouchedPrior1 and longEntryTouchedPrior2
shortEntryPriceOverlapStale = shortEntryTouchedPrior1 and shortEntryTouchedPrior2

longEntryPriceOverlapPassed = not useEntryPriceOverlapFilter or not longEntryPriceOverlapStale
shortEntryPriceOverlapPassed = not useEntryPriceOverlapFilter or not shortEntryPriceOverlapStale
longStopPrice = scalpSignalLow - scalpTickSize
shortStopPrice = scalpSignalHigh + scalpTickSize
longRiskPoints = longEntryPrice - longStopPrice
shortRiskPoints = shortStopPrice - shortEntryPrice
longRiskDollarsPerContract = longRiskPoints > 0 ? longRiskPoints * scalpPointValue + commissionRoundTrip : na
shortRiskDollarsPerContract = shortRiskPoints > 0 ? shortRiskPoints * scalpPointValue + commissionRoundTrip : na
longRawContracts = not na(longRiskDollarsPerContract) and longRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / longRiskDollarsPerContract)) : 0
shortRawContracts = not na(shortRiskDollarsPerContract) and shortRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / shortRiskDollarsPerContract)) : 0
longContracts = useMaxContractCap ? math.min(longRawContracts, maxContracts) : longRawContracts
shortContracts = useMaxContractCap ? math.min(shortRawContracts, maxContracts) : shortRawContracts
longRiskValid = longRiskPoints > 0 and not na(longRiskDollarsPerContract) and longRiskDollarsPerContract > 0 and longContracts >= 1
shortRiskValid = shortRiskPoints > 0 and not na(shortRiskDollarsPerContract) and shortRiskDollarsPerContract > 0 and shortContracts >= 1

// ===================== Scalp Target Selection Logic =====================
f_selectLongScalpTarget(string _entryType, float _entryPrice, float _riskPoints) =>
    float selectedTargetPrice = na
    string selectedTargetType = "N/A"
    float selectedTargetRR = na
    int selectedTargetPriority = 999

    if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
        for expandedLongTargetIndex = 0 to array.size(swingLevelPrices) - 1
            float expandedLongTargetPrice = array.get(swingLevelPrices, expandedLongTargetIndex)
            string expandedLongTargetName = array.get(swingLevelNames, expandedLongTargetIndex)
            int expandedLongTargetPriority = array.get(swingLevelPriority, expandedLongTargetIndex)
            bool expandedLongTargetAllowed = array.get(swingLevelAllowedForTarget, expandedLongTargetIndex)
            string expandedLongTargetType = "Level " + expandedLongTargetName
            if expandedLongTargetAllowed and f_longTargetQualifies(expandedLongTargetPrice, expandedLongTargetType, _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(expandedLongTargetPrice, expandedLongTargetPriority, selectedTargetPrice, selectedTargetPriority)
                selectedTargetPrice := expandedLongTargetPrice
                selectedTargetType := expandedLongTargetType
                selectedTargetRR := f_targetRRLong(expandedLongTargetPrice, _entryPrice, _riskPoints)
                selectedTargetPriority := expandedLongTargetPriority

    if useDirectTradePrevDayHighLevel and f_longTargetQualifies(effectivePrevDayHigh, "Level PDH", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectivePrevDayHigh, 4, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := effectivePrevDayHigh
        selectedTargetType := "Level PDH"
        selectedTargetRR := f_targetRRLong(effectivePrevDayHigh, _entryPrice, _riskPoints)
        selectedTargetPriority := 4

    if useDirectTradePrevDayLowLevel and f_longTargetQualifies(effectivePrevDayLow, "Level PDL", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectivePrevDayLow, 4, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := effectivePrevDayLow
        selectedTargetType := "Level PDL"
        selectedTargetRR := f_targetRRLong(effectivePrevDayLow, _entryPrice, _riskPoints)
        selectedTargetPriority := 4

    if activeTradeDailyOpenValid and f_longTargetQualifies(activeTradeDailyOpen, "Level OP", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(activeTradeDailyOpen, 6, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := activeTradeDailyOpen
        selectedTargetType := "Level OP"
        selectedTargetRR := f_targetRRLong(activeTradeDailyOpen, _entryPrice, _riskPoints)
        selectedTargetPriority := 6

    if usePremarketHighLevel and f_longTargetQualifies(effectivePremarketHigh, "Level PMH", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectivePremarketHigh, 7, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := effectivePremarketHigh
        selectedTargetType := "Level PMH"
        selectedTargetRR := f_targetRRLong(effectivePremarketHigh, _entryPrice, _riskPoints)
        selectedTargetPriority := 7

    if usePremarketLowLevel and f_longTargetQualifies(effectivePremarketLow, "Level PML", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectivePremarketLow, 7, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := effectivePremarketLow
        selectedTargetType := "Level PML"
        selectedTargetRR := f_targetRRLong(effectivePremarketLow, _entryPrice, _riskPoints)
        selectedTargetPriority := 7

    if useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady and f_longTargetQualifies(openingRangeHigh, "Level ORH", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(openingRangeHigh, 8, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := openingRangeHigh
        selectedTargetType := "Level ORH"
        selectedTargetRR := f_targetRRLong(openingRangeHigh, _entryPrice, _riskPoints)
        selectedTargetPriority := 8

    if useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady and f_longTargetQualifies(openingRangeLow, "Level ORL", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(openingRangeLow, 8, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := openingRangeLow
        selectedTargetType := "Level ORL"
        selectedTargetRR := f_targetRRLong(openingRangeLow, _entryPrice, _riskPoints)
        selectedTargetPriority := 8

    if array.size(swingHighPrices) > 0
        for swingHighIndex = 0 to array.size(swingHighPrices) - 1
            float swingHighPrice = array.get(swingHighPrices, swingHighIndex)
            bool swingHighAllowed = array.get(swingHighActive, swingHighIndex) and f_swingTargetSessionAllowed(array.get(swingHighSessions, swingHighIndex), array.get(swingHighDateKeys, swingHighIndex), nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
            if swingHighAllowed and f_longTargetQualifies(swingHighPrice, "5m Swing", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(swingHighPrice, 9, selectedTargetPrice, selectedTargetPriority)
                selectedTargetPrice := swingHighPrice
                selectedTargetType := "5m Swing"
                selectedTargetRR := f_targetRRLong(swingHighPrice, _entryPrice, _riskPoints)
                selectedTargetPriority := 9

    if useOneHourSwingTargets and array.size(oneHourSwingHighPrices) > 0
        for oneHourTargetHighIndex = 0 to array.size(oneHourSwingHighPrices) - 1
            float oneHourTargetHighPrice = array.get(oneHourSwingHighPrices, oneHourTargetHighIndex)
            bool oneHourTargetHighAllowed = array.get(oneHourSwingHighActive, oneHourTargetHighIndex) and f_oneHourSwingSessionAllowed(array.get(oneHourSwingHighSessionCodes, oneHourTargetHighIndex), array.get(oneHourSwingHighDateKeys, oneHourTargetHighIndex), nySessionDateKey, oneHourSwingPreviousRTHDateKey)
            if oneHourTargetHighAllowed and f_longTargetQualifies(oneHourTargetHighPrice, "1H Swing", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(oneHourTargetHighPrice, 9, selectedTargetPrice, selectedTargetPriority)
                selectedTargetPrice := oneHourTargetHighPrice
                selectedTargetType := "1H Swing"
                selectedTargetRR := f_targetRRLong(oneHourTargetHighPrice, _entryPrice, _riskPoints)
                selectedTargetPriority := 9

    if f_longTargetQualifies(currentRTHHigh, "HOD", _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh) and f_longTargetCandidateBetter(currentRTHHigh, 9, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := currentRTHHigh
        selectedTargetType := "HOD"
        selectedTargetRR := f_targetRRLong(currentRTHHigh, _entryPrice, _riskPoints)
        selectedTargetPriority := 9

    [selectedTargetPrice, selectedTargetType, selectedTargetRR, selectedTargetPriority]

f_selectShortScalpTarget(string _entryType, float _entryPrice, float _riskPoints) =>
    float selectedTargetPrice = na
    string selectedTargetType = "N/A"
    float selectedTargetRR = na
    int selectedTargetPriority = 999

    if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
        for expandedShortTargetIndex = 0 to array.size(swingLevelPrices) - 1
            float expandedShortTargetPrice = array.get(swingLevelPrices, expandedShortTargetIndex)
            string expandedShortTargetName = array.get(swingLevelNames, expandedShortTargetIndex)
            int expandedShortTargetPriority = array.get(swingLevelPriority, expandedShortTargetIndex)
            bool expandedShortTargetAllowed = array.get(swingLevelAllowedForTarget, expandedShortTargetIndex)
            string expandedShortTargetType = "Level " + expandedShortTargetName
            if expandedShortTargetAllowed and f_shortTargetQualifies(expandedShortTargetPrice, expandedShortTargetType, _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(expandedShortTargetPrice, expandedShortTargetPriority, selectedTargetPrice, selectedTargetPriority)
                selectedTargetPrice := expandedShortTargetPrice
                selectedTargetType := expandedShortTargetType
                selectedTargetRR := f_targetRRShort(expandedShortTargetPrice, _entryPrice, _riskPoints)
                selectedTargetPriority := expandedShortTargetPriority

    if useDirectTradePrevDayHighLevel and f_shortTargetQualifies(effectivePrevDayHigh, "Level PDH", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectivePrevDayHigh, 4, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := effectivePrevDayHigh
        selectedTargetType := "Level PDH"
        selectedTargetRR := f_targetRRShort(effectivePrevDayHigh, _entryPrice, _riskPoints)
        selectedTargetPriority := 4

    if useDirectTradePrevDayLowLevel and f_shortTargetQualifies(effectivePrevDayLow, "Level PDL", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectivePrevDayLow, 4, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := effectivePrevDayLow
        selectedTargetType := "Level PDL"
        selectedTargetRR := f_targetRRShort(effectivePrevDayLow, _entryPrice, _riskPoints)
        selectedTargetPriority := 4

    if activeTradeDailyOpenValid and f_shortTargetQualifies(activeTradeDailyOpen, "Level OP", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(activeTradeDailyOpen, 6, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := activeTradeDailyOpen
        selectedTargetType := "Level OP"
        selectedTargetRR := f_targetRRShort(activeTradeDailyOpen, _entryPrice, _riskPoints)
        selectedTargetPriority := 6

    if usePremarketHighLevel and f_shortTargetQualifies(effectivePremarketHigh, "Level PMH", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectivePremarketHigh, 7, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := effectivePremarketHigh
        selectedTargetType := "Level PMH"
        selectedTargetRR := f_targetRRShort(effectivePremarketHigh, _entryPrice, _riskPoints)
        selectedTargetPriority := 7

    if usePremarketLowLevel and f_shortTargetQualifies(effectivePremarketLow, "Level PML", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectivePremarketLow, 7, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := effectivePremarketLow
        selectedTargetType := "Level PML"
        selectedTargetRR := f_targetRRShort(effectivePremarketLow, _entryPrice, _riskPoints)
        selectedTargetPriority := 7

    if useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady and f_shortTargetQualifies(openingRangeHigh, "Level ORH", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(openingRangeHigh, 8, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := openingRangeHigh
        selectedTargetType := "Level ORH"
        selectedTargetRR := f_targetRRShort(openingRangeHigh, _entryPrice, _riskPoints)
        selectedTargetPriority := 8

    if useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady and f_shortTargetQualifies(openingRangeLow, "Level ORL", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(openingRangeLow, 8, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := openingRangeLow
        selectedTargetType := "Level ORL"
        selectedTargetRR := f_targetRRShort(openingRangeLow, _entryPrice, _riskPoints)
        selectedTargetPriority := 8

    if array.size(swingLowPrices) > 0
        for swingLowIndex = 0 to array.size(swingLowPrices) - 1
            float swingLowPrice = array.get(swingLowPrices, swingLowIndex)
            bool swingLowAllowed = array.get(swingLowActive, swingLowIndex) and f_swingTargetSessionAllowed(array.get(swingLowSessions, swingLowIndex), array.get(swingLowDateKeys, swingLowIndex), nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
            if swingLowAllowed and f_shortTargetQualifies(swingLowPrice, "5m Swing", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(swingLowPrice, 9, selectedTargetPrice, selectedTargetPriority)
                selectedTargetPrice := swingLowPrice
                selectedTargetType := "5m Swing"
                selectedTargetRR := f_targetRRShort(swingLowPrice, _entryPrice, _riskPoints)
                selectedTargetPriority := 9

    if useOneHourSwingTargets and array.size(oneHourSwingLowPrices) > 0
        for oneHourTargetLowIndex = 0 to array.size(oneHourSwingLowPrices) - 1
            float oneHourTargetLowPrice = array.get(oneHourSwingLowPrices, oneHourTargetLowIndex)
            bool oneHourTargetLowAllowed = array.get(oneHourSwingLowActive, oneHourTargetLowIndex) and f_oneHourSwingSessionAllowed(array.get(oneHourSwingLowSessionCodes, oneHourTargetLowIndex), array.get(oneHourSwingLowDateKeys, oneHourTargetLowIndex), nySessionDateKey, oneHourSwingPreviousRTHDateKey)
            if oneHourTargetLowAllowed and f_shortTargetQualifies(oneHourTargetLowPrice, "1H Swing", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(oneHourTargetLowPrice, 9, selectedTargetPrice, selectedTargetPriority)
                selectedTargetPrice := oneHourTargetLowPrice
                selectedTargetType := "1H Swing"
                selectedTargetRR := f_targetRRShort(oneHourTargetLowPrice, _entryPrice, _riskPoints)
                selectedTargetPriority := 9

    if f_shortTargetQualifies(currentRTHLow, "LOD", _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow) and f_shortTargetCandidateBetter(currentRTHLow, 9, selectedTargetPrice, selectedTargetPriority)
        selectedTargetPrice := currentRTHLow
        selectedTargetType := "LOD"
        selectedTargetRR := f_targetRRShort(currentRTHLow, _entryPrice, _riskPoints)
        selectedTargetPriority := 9

    [selectedTargetPrice, selectedTargetType, selectedTargetRR, selectedTargetPriority]

f_isPromotableBaseTarget(string _targetType) =>
    string normalized = str.replace_all(_targetType, "Level ", "")
    normalized == "15m Opening Range High" or
     normalized == "15m Opening Range Low" or
     normalized == "ORH" or
     normalized == "ORL" or
     normalized == "Current Day Open" or
     normalized == "Daily Open" or
     normalized == "OP" or
     normalized == "HOD" or
     normalized == "LOD" or
     normalized == "5m Swing"

f_isPromotionCandidateTargetType(string _targetType) =>
    string normalized = str.replace_all(_targetType, "Level ", "")
    bool structuralLevel = str.startswith(_targetType, "Level ")
    bool excludedTarget = normalized == "HOD" or normalized == "LOD" or normalized == "5m Swing" or normalized == "1H Swing"
    structuralLevel and not excludedTarget

f_longTargetPromotionCandidateOk(bool _candidateAllowed, float _candidatePrice, string _candidateType, int _candidatePriority, float _baseTargetPrice, int _baseTargetPriority, string _entryType, float _entryPrice, float _riskPoints, float _promotionAtr) =>
    float candidateDistance = _candidatePrice - _baseTargetPrice
    float candidateRR = f_targetRRLong(_candidatePrice, _entryPrice, _riskPoints)
    _candidateAllowed and
     f_isPromotionCandidateTargetType(_candidateType) and
     f_validSourcePrice(_candidatePrice) and
     f_validSourcePrice(_baseTargetPrice) and
     _candidatePrice > _baseTargetPrice and
     not na(_promotionAtr) and
     _promotionAtr > 0 and
     candidateDistance <= _promotionAtr * targetPromotionAtrMult and
     not na(candidateRR) and
     candidateRR <= maxPromotedTargetRR and
     f_longTargetQualifies(_candidatePrice, _candidateType, _entryType, scalpSignalHigh, _entryPrice, _riskPoints, currentRTHHigh)

f_shortTargetPromotionCandidateOk(bool _candidateAllowed, float _candidatePrice, string _candidateType, int _candidatePriority, float _baseTargetPrice, int _baseTargetPriority, string _entryType, float _entryPrice, float _riskPoints, float _promotionAtr) =>
    float candidateDistance = _baseTargetPrice - _candidatePrice
    float candidateRR = f_targetRRShort(_candidatePrice, _entryPrice, _riskPoints)
    _candidateAllowed and
     f_isPromotionCandidateTargetType(_candidateType) and
     f_validSourcePrice(_candidatePrice) and
     f_validSourcePrice(_baseTargetPrice) and
     _candidatePrice < _baseTargetPrice and
     not na(_promotionAtr) and
     _promotionAtr > 0 and
     candidateDistance <= _promotionAtr * targetPromotionAtrMult and
     not na(candidateRR) and
     candidateRR <= maxPromotedTargetRR and
     f_shortTargetQualifies(_candidatePrice, _candidateType, _entryType, scalpSignalLow, _entryPrice, _riskPoints, currentRTHLow)

f_longTargetPromotionCandidateBetter(float _candidatePrice, int _candidatePriority, float _baseTargetPrice, float _bestPrice, int _bestPriority) =>
    float candidateDistance = _candidatePrice - _baseTargetPrice
    float bestDistance = _bestPrice - _baseTargetPrice
    bool sameRoundedPrice = f_sameRoundedTargetPrice(_candidatePrice, _bestPrice)
    na(_bestPrice) or (not sameRoundedPrice and candidateDistance < bestDistance) or (sameRoundedPrice and _candidatePriority < _bestPriority)

f_shortTargetPromotionCandidateBetter(float _candidatePrice, int _candidatePriority, float _baseTargetPrice, float _bestPrice, int _bestPriority) =>
    float candidateDistance = _baseTargetPrice - _candidatePrice
    float bestDistance = _baseTargetPrice - _bestPrice
    bool sameRoundedPrice = f_sameRoundedTargetPrice(_candidatePrice, _bestPrice)
    na(_bestPrice) or (not sameRoundedPrice and candidateDistance < bestDistance) or (sameRoundedPrice and _candidatePriority < _bestPriority)

f_promoteLongScalpTarget(bool _promotionAllowed, float _baseTargetPrice, string _baseTargetType, float _baseTargetRR, int _baseTargetPriority, string _entryType, float _entryPrice, float _riskPoints, float _promotionAtr) =>
    float finalTargetPrice = _baseTargetPrice
    string finalTargetType = _baseTargetType
    float finalTargetRR = _baseTargetRR
    int finalTargetPriority = _baseTargetPriority
    string promotionBaseType = "N/A"
    float promotedTargetPrice = na
    string promotedTargetType = "N/A"
    int promotedTargetPriority = 999
    bool baseHodPromotionOk = _baseTargetType != "HOD" or (not na(scalpSignalHigh) and not na(currentRTHHigh) and math.abs(scalpSignalHigh - currentRTHHigh) <= hodLodEdgeToleranceTicks * scalpTickSize)
    bool canPromoteTarget = _promotionAllowed and enableTargetPromotion and f_isPromotableBaseTarget(_baseTargetType) and baseHodPromotionOk and f_validSourcePrice(_baseTargetPrice)

    if canPromoteTarget
        if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
            for promotionLevelIndex = 0 to array.size(swingLevelPrices) - 1
                float promotionLevelPrice = array.get(swingLevelPrices, promotionLevelIndex)
                string promotionLevelType = "Level " + array.get(swingLevelNames, promotionLevelIndex)
                int promotionLevelPriority = array.get(swingLevelPriority, promotionLevelIndex)
                bool promotionLevelAllowed = array.get(swingLevelAllowedForTarget, promotionLevelIndex)
                bool promotionLevelOk = f_longTargetPromotionCandidateOk(promotionLevelAllowed, promotionLevelPrice, promotionLevelType, promotionLevelPriority, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
                if promotionLevelOk and f_longTargetPromotionCandidateBetter(promotionLevelPrice, promotionLevelPriority, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
                    promotedTargetPrice := promotionLevelPrice
                    promotedTargetType := promotionLevelType
                    promotedTargetPriority := promotionLevelPriority

        bool directPdhOk = f_longTargetPromotionCandidateOk(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, "Level PDH", 4, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if directPdhOk and f_longTargetPromotionCandidateBetter(effectivePrevDayHigh, 4, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := effectivePrevDayHigh
            promotedTargetType := "Level PDH"
            promotedTargetPriority := 4

        bool directPdlOk = f_longTargetPromotionCandidateOk(useDirectTradePrevDayLowLevel, effectivePrevDayLow, "Level PDL", 4, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if directPdlOk and f_longTargetPromotionCandidateBetter(effectivePrevDayLow, 4, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := effectivePrevDayLow
            promotedTargetType := "Level PDL"
            promotedTargetPriority := 4

        bool dailyOpenOk = f_longTargetPromotionCandidateOk(activeTradeDailyOpenValid, activeTradeDailyOpen, "Level OP", 6, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if dailyOpenOk and f_longTargetPromotionCandidateBetter(activeTradeDailyOpen, 6, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := activeTradeDailyOpen
            promotedTargetType := "Level OP"
            promotedTargetPriority := 6

        bool pmhOk = f_longTargetPromotionCandidateOk(usePremarketHighLevel, effectivePremarketHigh, "Level PMH", 7, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if pmhOk and f_longTargetPromotionCandidateBetter(effectivePremarketHigh, 7, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := effectivePremarketHigh
            promotedTargetType := "Level PMH"
            promotedTargetPriority := 7

        bool pmlOk = f_longTargetPromotionCandidateOk(usePremarketLowLevel, effectivePremarketLow, "Level PML", 7, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if pmlOk and f_longTargetPromotionCandidateBetter(effectivePremarketLow, 7, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := effectivePremarketLow
            promotedTargetType := "Level PML"
            promotedTargetPriority := 7

        bool orhOk = f_longTargetPromotionCandidateOk(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "Level ORH", 8, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if orhOk and f_longTargetPromotionCandidateBetter(openingRangeHigh, 8, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := openingRangeHigh
            promotedTargetType := "Level ORH"
            promotedTargetPriority := 8

        bool orlOk = f_longTargetPromotionCandidateOk(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "Level ORL", 8, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if orlOk and f_longTargetPromotionCandidateBetter(openingRangeLow, 8, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := openingRangeLow
            promotedTargetType := "Level ORL"
            promotedTargetPriority := 8

    if f_validSourcePrice(promotedTargetPrice)
        finalTargetPrice := promotedTargetPrice
        finalTargetType := promotedTargetType
        finalTargetRR := f_targetRRLong(promotedTargetPrice, _entryPrice, _riskPoints)
        finalTargetPriority := promotedTargetPriority
        promotionBaseType := _baseTargetType

    [finalTargetPrice, finalTargetType, finalTargetRR, finalTargetPriority, promotionBaseType]

f_promoteShortScalpTarget(bool _promotionAllowed, float _baseTargetPrice, string _baseTargetType, float _baseTargetRR, int _baseTargetPriority, string _entryType, float _entryPrice, float _riskPoints, float _promotionAtr) =>
    float finalTargetPrice = _baseTargetPrice
    string finalTargetType = _baseTargetType
    float finalTargetRR = _baseTargetRR
    int finalTargetPriority = _baseTargetPriority
    string promotionBaseType = "N/A"
    float promotedTargetPrice = na
    string promotedTargetType = "N/A"
    int promotedTargetPriority = 999
    bool baseLodPromotionOk = _baseTargetType != "LOD" or (not na(scalpSignalLow) and not na(currentRTHLow) and math.abs(scalpSignalLow - currentRTHLow) <= hodLodEdgeToleranceTicks * scalpTickSize)
    bool canPromoteTarget = _promotionAllowed and enableTargetPromotion and f_isPromotableBaseTarget(_baseTargetType) and baseLodPromotionOk and f_validSourcePrice(_baseTargetPrice)

    if canPromoteTarget
        if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
            for promotionLevelIndex = 0 to array.size(swingLevelPrices) - 1
                float promotionLevelPrice = array.get(swingLevelPrices, promotionLevelIndex)
                string promotionLevelType = "Level " + array.get(swingLevelNames, promotionLevelIndex)
                int promotionLevelPriority = array.get(swingLevelPriority, promotionLevelIndex)
                bool promotionLevelAllowed = array.get(swingLevelAllowedForTarget, promotionLevelIndex)
                bool promotionLevelOk = f_shortTargetPromotionCandidateOk(promotionLevelAllowed, promotionLevelPrice, promotionLevelType, promotionLevelPriority, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
                if promotionLevelOk and f_shortTargetPromotionCandidateBetter(promotionLevelPrice, promotionLevelPriority, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
                    promotedTargetPrice := promotionLevelPrice
                    promotedTargetType := promotionLevelType
                    promotedTargetPriority := promotionLevelPriority

        bool directPdhOk = f_shortTargetPromotionCandidateOk(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, "Level PDH", 4, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if directPdhOk and f_shortTargetPromotionCandidateBetter(effectivePrevDayHigh, 4, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := effectivePrevDayHigh
            promotedTargetType := "Level PDH"
            promotedTargetPriority := 4

        bool directPdlOk = f_shortTargetPromotionCandidateOk(useDirectTradePrevDayLowLevel, effectivePrevDayLow, "Level PDL", 4, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if directPdlOk and f_shortTargetPromotionCandidateBetter(effectivePrevDayLow, 4, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := effectivePrevDayLow
            promotedTargetType := "Level PDL"
            promotedTargetPriority := 4

        bool dailyOpenOk = f_shortTargetPromotionCandidateOk(activeTradeDailyOpenValid, activeTradeDailyOpen, "Level OP", 6, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if dailyOpenOk and f_shortTargetPromotionCandidateBetter(activeTradeDailyOpen, 6, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := activeTradeDailyOpen
            promotedTargetType := "Level OP"
            promotedTargetPriority := 6

        bool pmhOk = f_shortTargetPromotionCandidateOk(usePremarketHighLevel, effectivePremarketHigh, "Level PMH", 7, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if pmhOk and f_shortTargetPromotionCandidateBetter(effectivePremarketHigh, 7, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := effectivePremarketHigh
            promotedTargetType := "Level PMH"
            promotedTargetPriority := 7

        bool pmlOk = f_shortTargetPromotionCandidateOk(usePremarketLowLevel, effectivePremarketLow, "Level PML", 7, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if pmlOk and f_shortTargetPromotionCandidateBetter(effectivePremarketLow, 7, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := effectivePremarketLow
            promotedTargetType := "Level PML"
            promotedTargetPriority := 7

        bool orhOk = f_shortTargetPromotionCandidateOk(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "Level ORH", 8, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if orhOk and f_shortTargetPromotionCandidateBetter(openingRangeHigh, 8, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := openingRangeHigh
            promotedTargetType := "Level ORH"
            promotedTargetPriority := 8

        bool orlOk = f_shortTargetPromotionCandidateOk(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "Level ORL", 8, _baseTargetPrice, _baseTargetPriority, _entryType, _entryPrice, _riskPoints, _promotionAtr)
        if orlOk and f_shortTargetPromotionCandidateBetter(openingRangeLow, 8, _baseTargetPrice, promotedTargetPrice, promotedTargetPriority)
            promotedTargetPrice := openingRangeLow
            promotedTargetType := "Level ORL"
            promotedTargetPriority := 8

    if f_validSourcePrice(promotedTargetPrice)
        finalTargetPrice := promotedTargetPrice
        finalTargetType := promotedTargetType
        finalTargetRR := f_targetRRShort(promotedTargetPrice, _entryPrice, _riskPoints)
        finalTargetPriority := promotedTargetPriority
        promotionBaseType := _baseTargetType

    [finalTargetPrice, finalTargetType, finalTargetRR, finalTargetPriority, promotionBaseType]

[longTargetPrice, longTargetType, longTargetRR, longTargetPriority] = f_selectLongScalpTarget(longEntryType, longEntryPrice, longRiskPoints)
[shortTargetPrice, shortTargetType, shortTargetRR, shortTargetPriority] = f_selectShortScalpTarget(shortEntryType, shortEntryPrice, shortRiskPoints)

[longFinalTargetPrice, longFinalTargetType, longFinalTargetRR, longFinalTargetPriority, longTargetPromotionBaseType] = f_promoteLongScalpTarget(true, longTargetPrice, longTargetType, longTargetRR, longTargetPriority, longEntryType, longEntryPrice, longRiskPoints, atrValue)
[shortFinalTargetPrice, shortFinalTargetType, shortFinalTargetRR, shortFinalTargetPriority, shortTargetPromotionBaseType] = f_promoteShortScalpTarget(true, shortTargetPrice, shortTargetType, shortTargetRR, shortTargetPriority, shortEntryType, shortEntryPrice, shortRiskPoints, atrValue)
longTargetPrice := longFinalTargetPrice
longTargetType := longFinalTargetType
longTargetRR := longFinalTargetRR
longTargetPriority := longFinalTargetPriority
shortTargetPrice := shortFinalTargetPrice
shortTargetType := shortFinalTargetType
shortTargetRR := shortFinalTargetRR
shortTargetPriority := shortFinalTargetPriority

if longNineEmaMomentumActive
    longSelectedLevelName := "9 EMA"
else if longNineEmaReclaimContinuationActive
    longSelectedLevelName := "9 EMA Reclaim"
else if longNineEmaLowVolumePullbackActive
    longSelectedLevelName := "9 EMA Low Vol"

if shortNineEmaMomentumActive
    shortSelectedLevelName := "9 EMA"
else if shortNineEmaReclaimContinuationActive
    shortSelectedLevelName := "9 EMA Reclaim"
else if shortNineEmaLowVolumePullbackActive
    shortSelectedLevelName := "9 EMA Low Vol"

longSelectedLevelIsHtfContinuationHigh = f_isPreviousDayHighLevel(longSelectedLevelName) or f_isPreviousWeekHighLevel(longSelectedLevelName)
shortSelectedLevelIsHtfContinuationLow = f_isPreviousDayLowLevel(shortSelectedLevelName) or f_isPreviousWeekLowLevel(shortSelectedLevelName)
longSelectedLevelIsHtfSupportLow = f_isPreviousDayLowLevel(longSelectedLevelName) or f_isPreviousWeekLowLevel(longSelectedLevelName)
shortSelectedLevelIsHtfResistanceHigh = f_isPreviousDayHighLevel(shortSelectedLevelName) or f_isPreviousWeekHighLevel(shortSelectedLevelName)
longSelectedHtfSupportLowPriorClosePassed =
     f_isPreviousWeekLowLevel(longSelectedLevelName) ? longPreviousWeekLowPriorClosePassed :
     f_isPreviousDayLowLevel(longSelectedLevelName) ? longPreviousDayLowPriorClosePassed :
     false
shortSelectedHtfResistanceHighPriorClosePassed =
     f_isPreviousWeekHighLevel(shortSelectedLevelName) ? shortPreviousWeekHighPriorClosePassed :
     f_isPreviousDayHighLevel(shortSelectedLevelName) ? shortPreviousDayHighPriorClosePassed :
     false
longHtfContinuationStatePassed = not requireHtfContinuationState or not longSelectedLevelIsHtfContinuationHigh or (not na(longSelectedLevelPrice) and (close[1] > longSelectedLevelPrice or open[1] < longSelectedLevelPrice))
shortHtfContinuationStatePassed = not requireHtfContinuationState or not shortSelectedLevelIsHtfContinuationLow or (not na(shortSelectedLevelPrice) and (close[1] < shortSelectedLevelPrice or open[1] > shortSelectedLevelPrice))
longHtfSupportLowStatePassed = not requireHtfContinuationState or not longSelectedLevelIsHtfSupportLow or longSelectedHtfSupportLowPriorClosePassed or longStrongHtfReversalException
shortHtfResistanceHighStatePassed = not requireHtfContinuationState or not shortSelectedLevelIsHtfResistanceHigh or shortSelectedHtfResistanceHighPriorClosePassed or shortStrongHtfReversalException

longFinalTargetMeetsMinRR = not na(longTargetRR) and longTargetRR >= minTargetRR
shortFinalTargetMeetsMinRR = not na(shortTargetRR) and shortTargetRR >= minTargetRR
longFinalTargetIsUnpromotedHodEdge = longTargetPromotionBaseType == "N/A" and f_longHodEdgeQualifies(longTargetPrice, longTargetType, longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh)
shortFinalTargetIsUnpromotedLodEdge = shortTargetPromotionBaseType == "N/A" and f_shortLodEdgeQualifies(shortTargetPrice, shortTargetType, shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow)
longTargetValid = not na(longTargetPrice) and longTargetType != "N/A" and (longFinalTargetMeetsMinRR or longFinalTargetIsUnpromotedHodEdge)
shortTargetValid = not na(shortTargetPrice) and shortTargetType != "N/A" and (shortFinalTargetMeetsMinRR or shortFinalTargetIsUnpromotedLodEdge)
longTargetFilterPassed = not requireValidTarget or longTargetValid
shortTargetFilterPassed = not requireValidTarget or shortTargetValid
longSelectedTargetIsLevel = str.startswith(longTargetType, "Level ")
shortSelectedTargetIsLevel = str.startswith(shortTargetType, "Level ")
longSelectedTargetTouchedPriorBar = longSelectedTargetIsLevel and not na(longTargetPrice) and not na(low[1]) and not na(high[1]) and longTargetPrice >= low[1] and longTargetPrice <= high[1]
shortSelectedTargetTouchedPriorBar = shortSelectedTargetIsLevel and not na(shortTargetPrice) and not na(low[1]) and not na(high[1]) and shortTargetPrice >= low[1] and shortTargetPrice <= high[1]
longTargetNotRecentlyTouched = not longSelectedTargetTouchedPriorBar
shortTargetNotRecentlyTouched = not shortSelectedTargetTouchedPriorBar

longSelectedLevelText = f_abbrevLevelName(longSelectedLevelName)
shortSelectedLevelText = f_abbrevLevelName(shortSelectedLevelName)
longEntryTypeText = f_abbrevLevelName(longEntryType)
shortEntryTypeText = f_abbrevLevelName(shortEntryType)
longTargetTypeText = f_targetDisplayText(longTargetType, longTargetPromotionBaseType)
shortTargetTypeText = f_targetDisplayText(shortTargetType, shortTargetPromotionBaseType)

// ===================== Alert Conditions =====================
longScalpTierFilterPassed = longAnyNineEmaSetupActive ? true : bullScalpTierAllowed
shortScalpTierFilterPassed = shortAnyNineEmaSetupActive ? true : bearScalpTierAllowed
bullScalpAlert =
     alertScalpSetups and
     barstate.isconfirmed and
     inScalpRTHSession and
     inAlertTradingWindow and
     openingRangeLevelsReady and
     not inOpeningRangeWindow and
     alertOnBullSignals and
     longOpeningRangeFiltersPassed and
     longScalpTierFilterPassed and
     longScalpSetupQualified and
     not longExtendedSetupBlocked and
     not longOppositePressureBlocked and
     longHtfContinuationStatePassed and
     longHtfSupportLowStatePassed and
     longDailyOpenRangeAcceptancePassed and
     longFiveMinuteSwingAcceptancePassed and
     longOneHourSwingAcceptancePassed and
     longOneHourSwingBlockerPassed and
     longRiskValid and
     longTargetFilterPassed and
     longTargetNotRecentlyTouched and
     longEntryPriceOverlapPassed
bullAlertLabelTitle = longNineEmaMomentumActive ? "LONG 9EMA SCALP" : longNineEmaReclaimContinuationActive ? "LONG 9EMA RCLM SCALP" : longNineEmaLowVolumePullbackActive ? "LONG 9EMA LV SCALP" : "LONG SCALP"

bearScalpAlert =
     alertScalpSetups and
     barstate.isconfirmed and
     inScalpRTHSession and
     inAlertTradingWindow and
     openingRangeLevelsReady and
     not inOpeningRangeWindow and
     alertOnBearSignals and
     shortOpeningRangeFiltersPassed and
     shortScalpTierFilterPassed and
     shortScalpSetupQualified and
     not shortExtendedSetupBlocked and
     not shortOppositePressureBlocked and
     shortHtfContinuationStatePassed and
     shortHtfResistanceHighStatePassed and
     shortDailyOpenRangeAcceptancePassed and
     shortFiveMinuteSwingAcceptancePassed and
     shortOneHourSwingAcceptancePassed and
     shortOneHourSwingBlockerPassed and
     shortRiskValid and
     shortTargetFilterPassed and
     shortTargetNotRecentlyTouched and
     shortEntryPriceOverlapPassed
bearAlertLabelTitle = shortNineEmaMomentumActive ? "SHORT 9EMA SCALP" : shortNineEmaReclaimContinuationActive ? "SHORT 9EMA RCLM SCALP" : shortNineEmaLowVolumePullbackActive ? "SHORT 9EMA LV SCALP" : "SHORT SCALP"

effectiveBullScalpAlert = bullScalpAlert
effectiveBearScalpAlert = not effectiveBullScalpAlert and bearScalpAlert

showHistoricalAlertLabels = alertLabelMode != "Off"
showCompactAlertLabels = alertLabelMode == "Compact"

f_buildMarkerChartLabel(_direction, _compactSignalText, _selectedLevelName) =>
    showAlertSignalDetails ? _direction + "\n" + _compactSignalText + " | " + f_abbrevLevelName(_selectedLevelName) : _direction

f_buildCompactChartLabel(_direction, _compactSignalText, _selectedLevelName, _entryPrice, _stopPrice, _targetPrice, _targetType, _targetRR, _contracts, _managementText) =>
    _direction + "\n" +
     _compactSignalText + " | " + f_abbrevLevelName(_selectedLevelName) + "\n" +
     "E " + f_priceText(_entryPrice) + "\n" +
     "S " + f_priceText(_stopPrice) + "\n" +
     "T " + f_priceText(_targetPrice) + " " + f_abbrevLevelName(_targetType) + "\n" +
     _managementText + "\n" +
     str.tostring(_contracts) + "ct | " + f_rrText(_targetRR)

f_addAlertChartLabel(_price, _text, _style, _color) =>
    label.new(bar_index, _price, _text, style=_style, textcolor=color.white, color=_color, size=showCompactAlertLabels ? size.small : size.tiny)

f_buildManagementText(_oneRPrice, _twoRPrice, _targetRR, _contracts) =>
    string mgmtText = "1R " + f_priceText(_oneRPrice)
    bool showTwoR = not na(_targetRR) and _targetRR >= 2.0 and not na(_twoRPrice)
    bool canTrim = not na(_contracts) and _contracts > 1

    if showTwoR
        mgmtText := mgmtText + " | 2R " + f_priceText(_twoRPrice)

    if canTrim
        if showTwoR
            int trim1R = _contracts == 2 ? 1 : math.max(1, int(math.floor(_contracts / 3.0)))
            int trim2R = _contracts >= 3 ? math.max(1, int(math.floor(_contracts / 3.0))) : 0
            int maxTrimTotal = _contracts - 1
            if trim1R + trim2R > maxTrimTotal
                trim2R := math.max(0, maxTrimTotal - trim1R)
            mgmtText := mgmtText + "\nTrim " + str.tostring(trim1R) + " @1R"
            if trim2R > 0
                mgmtText := mgmtText + " | " + str.tostring(trim2R) + " @2R"
        else
            int trimAtOneR = math.max(1, int(math.floor(_contracts * 0.50)))
            mgmtText := mgmtText + "\nTrim " + str.tostring(trimAtOneR) + " @1R"

    mgmtText

bool newEffectiveScalpAlert = effectiveBullScalpAlert or effectiveBearScalpAlert
alertDirectionTitle = effectiveBullScalpAlert ? bullAlertLabelTitle : effectiveBearScalpAlert ? bearAlertLabelTitle : ""
alertCompactSignalText = effectiveBullScalpAlert ? longCompactSignalText : effectiveBearScalpAlert ? shortCompactSignalText : ""
alertSelectedLevelName = effectiveBullScalpAlert ? longSelectedLevelText : effectiveBearScalpAlert ? shortSelectedLevelText : "N/A"
alertEntryType = effectiveBullScalpAlert ? longEntryTypeText : effectiveBearScalpAlert ? shortEntryTypeText : "N/A"
alertEntryPrice = effectiveBullScalpAlert ? longEntryPrice : effectiveBearScalpAlert ? shortEntryPrice : na
alertStopPrice = effectiveBullScalpAlert ? longStopPrice : effectiveBearScalpAlert ? shortStopPrice : na
alertTargetPrice = effectiveBullScalpAlert ? longTargetPrice : effectiveBearScalpAlert ? shortTargetPrice : na
alertTargetType = effectiveBullScalpAlert ? longTargetTypeText : effectiveBearScalpAlert ? shortTargetTypeText : "N/A"
alertTargetRR = effectiveBullScalpAlert ? longTargetRR : effectiveBearScalpAlert ? shortTargetRR : na
alertContracts = effectiveBullScalpAlert ? longContracts : effectiveBearScalpAlert ? shortContracts : na
alertLabelPrice = effectiveBullScalpAlert ? low : effectiveBearScalpAlert ? high : na
alertLabelStyle = effectiveBullScalpAlert ? label.style_label_up : label.style_label_down
alertLabelColor = effectiveBullScalpAlert ? color.new(color.lime, 0) : color.new(color.red, 0)
alertIsLong = effectiveBullScalpAlert
alertIsShort = effectiveBearScalpAlert
alertManagementRiskPoints = alertIsLong ? alertEntryPrice - scalpSignalLow : alertIsShort ? scalpSignalHigh - alertEntryPrice : na
alertManagementRiskValid = not na(alertManagementRiskPoints) and alertManagementRiskPoints > 0
alertOneRPrice = alertIsLong and alertManagementRiskValid ? alertEntryPrice + alertManagementRiskPoints : alertIsShort and alertManagementRiskValid ? alertEntryPrice - alertManagementRiskPoints : na
alertTwoRPrice = alertIsLong and alertManagementRiskValid ? alertEntryPrice + alertManagementRiskPoints * 2.0 : alertIsShort and alertManagementRiskValid ? alertEntryPrice - alertManagementRiskPoints * 2.0 : na
alertManagementText = newEffectiveScalpAlert ? f_buildManagementText(alertOneRPrice, alertTwoRPrice, alertTargetRR, alertContracts) : ""

if showHistoricalAlertLabels and newEffectiveScalpAlert
    string chartLabelText = showCompactAlertLabels ? f_buildCompactChartLabel(alertDirectionTitle, alertCompactSignalText, alertSelectedLevelName, alertEntryPrice, alertStopPrice, alertTargetPrice, alertTargetType, alertTargetRR, alertContracts, alertManagementText) : f_buildMarkerChartLabel(alertDirectionTitle, alertCompactSignalText, alertSelectedLevelName)
    f_addAlertChartLabel(alertLabelPrice, chartLabelText, alertLabelStyle, alertLabelColor)

// ===================== Alert Message =====================
f_buildScalpAlertMessage(_directionTitle, _compactSignalText, _selectedLevelName, _openingRangeText, _entryType, _entryPrice, _stopPrice, _targetPrice, _targetType, _targetRR, _contracts, _managementText) =>
    "PA ENGINE " + _directionTitle + "\n" +
     _compactSignalText + " | " + f_abbrevLevelName(_selectedLevelName) + "\n" +
     "Opening Range: " + _openingRangeText + "\n" +
     syminfo.ticker + " " + timeframe.period + "\n\n" +
     "E " + f_priceText(_entryPrice) + " " + f_abbrevLevelName(_entryType) + "\n" +
     "S " + f_priceText(_stopPrice) + "\n" +
     "T " + f_priceText(_targetPrice) + " " + f_abbrevLevelName(_targetType) + "\n" +
     _managementText + "\n" +
     str.tostring(_contracts) + "ct | " + f_rrText(_targetRR)

// ===================== Latest Alert Cancellation Tracker =====================
var bool latestScalpAlertActive = false
var int latestScalpAlertId = 0
var int latestScalpDirection = 0
var int latestScalpSignalBar = na
var float latestScalpEntry = na
var float latestScalpTarget = na
var float latestScalpMeasuredMove = na
var string latestScalpTargetType = "N/A"
var string latestScalpSetupText = "N/A"

f_buildLatestScalpCancellationAlertMessage(_direction, _reason, _entryPrice, _targetPrice, _measuredMove, _targetType, _signalId) =>
    "PA ENGINE CANCEL " + (_direction == 1 ? "LONG" : "SHORT") + "\n" +
     "Reason: " + _reason + "\n" +
     syminfo.ticker + " " + timeframe.period + "\n" +
     "E " + f_priceText(_entryPrice) + "\n" +
     "T " + f_priceText(_targetPrice) + " " + _targetType + "\n" +
     "MM " + f_priceText(_measuredMove) + "\n" +
     "ID " + str.tostring(_signalId)

if newEffectiveScalpAlert
    alert(f_buildScalpAlertMessage(alertDirectionTitle, alertCompactSignalText, alertSelectedLevelName, openingRangeAlertText, alertEntryType, alertEntryPrice, alertStopPrice, alertTargetPrice, alertTargetType, alertTargetRR, alertContracts, alertManagementText), alert.freq_once_per_bar_close)

if newScalpRTHSession
    latestScalpAlertActive := false
    latestScalpAlertId := 0
    latestScalpDirection := 0
    latestScalpSignalBar := na
    latestScalpEntry := na
    latestScalpTarget := na
    latestScalpMeasuredMove := na
    latestScalpTargetType := "N/A"
    latestScalpSetupText := "N/A"
else if not inScalpRTHSession
    latestScalpAlertActive := false

if not trackLatestScalpAlert
    latestScalpAlertActive := false
else
    if effectiveBullScalpAlert
        latestScalpAlertActive := true
        latestScalpAlertId += 1
        latestScalpDirection := 1
        latestScalpSignalBar := bar_index
        latestScalpEntry := longEntryPrice
        latestScalpTarget := longTargetPrice
        latestScalpTargetType := longTargetType
        latestScalpSetupText := alertCompactSignalText
        latestScalpMeasuredMove := high + (high - low)
    else if effectiveBearScalpAlert
        latestScalpAlertActive := true
        latestScalpAlertId += 1
        latestScalpDirection := -1
        latestScalpSignalBar := bar_index
        latestScalpEntry := shortEntryPrice
        latestScalpTarget := shortTargetPrice
        latestScalpTargetType := shortTargetType
        latestScalpSetupText := alertCompactSignalText
        latestScalpMeasuredMove := low - (high - low)

    bool canEvaluateLatestScalpAlert = latestScalpAlertActive and bar_index > latestScalpSignalBar and not newEffectiveScalpAlert
    if canEvaluateLatestScalpAlert
        bool latestLongAlert = latestScalpDirection == 1
        bool latestShortAlert = latestScalpDirection == -1
        bool latestEntryTouched = latestLongAlert ? low <= latestScalpEntry : latestShortAlert ? high >= latestScalpEntry : false
        bool latestTargetHit = cancelLatestOnTargetBeforeEntry and not na(latestScalpTarget) and (latestLongAlert ? latestScalpTargetType != "HOD" and high >= latestScalpTarget : latestShortAlert ? latestScalpTargetType != "LOD" and low <= latestScalpTarget : false)
        bool latestTargetIsHod = latestScalpTargetType == "HOD"
        bool latestTargetIsLod = latestScalpTargetType == "LOD"
        bool latestMeasuredMoveCancellationEligible = latestLongAlert ? latestTargetIsHod : latestShortAlert ? latestTargetIsLod : false
        bool latestMeasuredMoveHit = cancelLatestOnMeasuredMoveBeforeEntry and latestMeasuredMoveCancellationEligible and not na(latestScalpMeasuredMove) and (latestLongAlert ? high >= latestScalpMeasuredMove : latestShortAlert ? low <= latestScalpMeasuredMove : false)
        int latestBarsAfterSignal = bar_index - latestScalpSignalBar
        bool latestAgeExpired = cancelLatestOnAgeBeforeEntry and latestBarsAfterSignal >= latestScalpMaxBarsAfterSignal
        bool latestTargetOrMeasuredMoveCancellationHit = latestMeasuredMoveHit or latestTargetHit

        // Historical OHLC bars cannot prove intrabar sequence; if entry and cancellation both print on the same bar, cancellation wins.
        if latestTargetOrMeasuredMoveCancellationHit
            string latestCancellationReason = latestMeasuredMoveHit ? "MM BEFORE ENTRY" : "TGT BEFORE ENTRY"
            string latestCancellationLabelText = (latestLongAlert ? "CXL L\n" : "CXL S\n") + (latestMeasuredMoveHit ? "MM" : "TGT")
            if showLatestScalpCancellationLabels
                label.new(bar_index, latestLongAlert ? high : low, latestCancellationLabelText, style=latestLongAlert ? label.style_label_down : label.style_label_up, textcolor=color.black, color=latestScalpCancellationLabelColor, size=size.tiny)
            if alertLatestScalpCancellation
                alert(f_buildLatestScalpCancellationAlertMessage(latestScalpDirection, latestCancellationReason, latestScalpEntry, latestScalpTarget, latestScalpMeasuredMove, latestScalpTargetType, latestScalpAlertId), alert.freq_once_per_bar)
            latestScalpAlertActive := false
        else if latestEntryTouched
            latestScalpAlertActive := false
        else if latestAgeExpired
            string latestCancellationReason = "AGE EXPIRED"
            string latestCancellationLabelText = (latestLongAlert ? "CXL L\n" : "CXL S\n") + "AGE"
            if showLatestScalpCancellationLabels
                label.new(bar_index, latestLongAlert ? high : low, latestCancellationLabelText, style=latestLongAlert ? label.style_label_down : label.style_label_up, textcolor=color.black, color=latestScalpCancellationLabelColor, size=size.tiny)
            if alertLatestScalpCancellation
                alert(f_buildLatestScalpCancellationAlertMessage(latestScalpDirection, latestCancellationReason, latestScalpEntry, latestScalpTarget, latestScalpMeasuredMove, latestScalpTargetType, latestScalpAlertId), alert.freq_once_per_bar)
            latestScalpAlertActive := false

plot(showOpeningRange ? openingRangeDisplayHigh : na, "15m Opening Range High", color=openingRangeHighColor, linewidth=1, style=plot.style_linebr)
plot(showOpeningRange ? openingRangeDisplayLow : na, "15m Opening Range Low", color=openingRangeLowColor, linewidth=1, style=plot.style_linebr)
pdhPlot = showAutoScalpLevels and showRawFuturesPrevDayLevels and inScalpRTHSession and effectivePrevDayHigh > 0 ? effectivePrevDayHigh : na
pdlPlot = showAutoScalpLevels and showRawFuturesPrevDayLevels and inScalpRTHSession and effectivePrevDayLow > 0 ? effectivePrevDayLow : na

plot(pdhPlot, "Auto/Effective PDH", color=majorHighLevelColor, linewidth=2, style=plot.style_linebr)
plot(pdlPlot, "Auto/Effective PDL", color=majorLowLevelColor, linewidth=2, style=plot.style_linebr)
plot(showAutoScalpLevels and effectiveDailyOpen > 0 ? effectiveDailyOpen : na, "Raw/Effective OP", color=openLevelColor, linewidth=1, style=plot.style_linebr)
plot(premarketDisplayHigh, "Premarket High", color=premarketLevelColor, linewidth=1, style=plot.style_linebr)
plot(premarketDisplayLow, "Premarket Low", color=premarketLevelColor, linewidth=1, style=plot.style_linebr)

// Signals
plotshape(plotBullSignal, title="Bullish Signal", style=shape.triangleup, size=size.small, location=location.belowbar, color=color.lime)
plotshape(plotBearSignal, title="Bearish Signal", style=shape.triangledown, size=size.small, location=location.abovebar, color=color.red)

// ===================== Scalp Status Table =====================
f_addScalpStatusRow(table _statusTable, int _row, string _label, string _value, color _valueColor) =>
    table.cell(_statusTable, 0, _row, _label, text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
    table.cell(_statusTable, 1, _row, _value, text_color=_valueColor, text_size=size.small, text_halign=text.align_right)
    _row + 1

var table scalpStatusTable = table.new(position.bottom_right, 2, 100, bgcolor=color.new(color.black, 85), border_width=0)
if barstate.islast 
    table.clear(scalpStatusTable, 0, 0, 1, 99)
    if showScalpStatusTable
        statusNeutralColor = color.rgb(220, 220, 220)
        alertSetupsTableText = alertScalpSetups ? "Scalp" : "Off"
        int scalpStatusRow = 0
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Opening Range", openingRangeStatus, statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "OR Bias", openingRangeBiasText, statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "ORH Accepted", openingRangeHighAcceptedAbove ? "Yes" : "No", statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "ORL Accepted", openingRangeLowAcceptedBelow ? "Yes" : "No", statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Converted Source", convertedLevelSourceSymbol, statusNeutralColor)

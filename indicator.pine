//@version=6
indicator("PA Engine Scalp Alert System", shorttitle = "PA Engine Scalp Alerts", overlay=true, calc_bars_count=1000, max_bars_back = 1000, max_lines_count=500, max_labels_count=500, max_boxes_count=200, dynamic_requests=true)

// ===================== User Inputs =====================

groupCoreAlerts = "01. Core Alert Controls"
groupSetupFilters = "02. Setup Filters"
groupScalpLevels = "03. Scalp Levels"
groupOpeningRange = "04. Opening Range"
groupRisk = "05. Risk / Position Sizing"
groupTargets = "06. Target Settings"
groupSignalEngine = "07. Signal Engine Tuning"
groupDisplay = "08. Display / Visuals"
groupDebug = "09. Debug / Advanced"

// 01. Core Alert Controls
alertScalpSetups         = input.bool(true, title="Alert Scalp Setups", group=groupCoreAlerts, tooltip="Alerts high-volume scalp setups only. Scalp stops use the signal-bar extreme plus one tick.")
tickerInput              = input.string("MES", title="Ticker", options=["MES", "MNQ"], group=groupCoreAlerts)
alertOnBullSignals       = input.bool(true, title="Alert On Bull Signals", group=groupCoreAlerts)
alertOnBearSignals       = input.bool(true, title="Alert On Bear Signals", group=groupCoreAlerts)
requireValidTarget       = input.bool(true, title="Require Valid Target", group=groupCoreAlerts)
minTargetRR              = input.float(1.0, title="Scalp Minimum Target R:R", minval=0.25, step=0.05, group=groupCoreAlerts, tooltip="Minimum required reward-to-risk for scalp targets. Default is 1.0R. The only exception is the existing HOD/LOD edge exception.")

// 02. Setup Filters
requireFboSwingSweep = input.bool(false, title="Require FBO Swing Sweep", group=groupSetupFilters, tooltip="When enabled, failed breakout scalp setups must sweep a prior tracked 5m swing. When disabled, failed breakout setups only need the normal level-break, signal, body-acceptance, risk, and target filters.")
skipFiveBarExtension     = input.bool(true, title="Skip 5+ Bar Extension", group=groupSetupFilters)
skipStrongMicrochannelExtension = input.bool(true, title="Skip 3+ Bar Strong Extension", group=groupSetupFilters)
minLevelEntryRetracement = input.float(0.20, title="Minimum Level Entry Retracement", minval=0.0, maxval=0.5, step=0.05, group=groupSetupFilters)
requireDailyOpenBodyAcceptance = input.bool(true, title="Require Daily Open Body Acceptance", group=groupSetupFilters)
dailyOpenBodyAcceptancePct = input.float(0.50, title="Daily Open Body Acceptance %", minval=0.0, maxval=1.0, step=0.05, group=groupSetupFilters)
alertSetupSignals        = input.bool(true, title="Allow Setup Signals", group=groupSetupFilters)
alertIgnitionSignals     = input.bool(true, title="Allow Ignition Signals", group=groupSetupFilters)
alertStrongIgnitions     = input.bool(true, title="Allow Strong Ignitions", group=groupSetupFilters)

// 03. Scalp Levels
useAutoPrevDayHighLow            = input.bool(true, title="Use Auto PDH/PDL", group=groupScalpLevels)
usePrevDayHighLevel              = input.bool(true, title="Use PDH Level", group=groupScalpLevels)
prevDayHighLevel                 = input.float(0.0, title="Manual/Fallback PDH Level", step=0.25, group=groupScalpLevels)
usePrevDayLowLevel               = input.bool(true, title="Use PDL Level", group=groupScalpLevels)
prevDayLowLevel                  = input.float(0.0, title="Manual/Fallback PDL Level", step=0.25, group=groupScalpLevels)
useAutoDailyOpen                 = input.bool(true, title="Use Auto Daily Open", group=groupScalpLevels)
useDailyOpenLevel                = input.bool(true, title="Use Daily Open Level", group=groupScalpLevels)
dailyOpenLevel                   = input.float(0.0, title="Manual/Fallback Daily Open", step=0.25, group=groupScalpLevels)
useAutoPremarketHighLow          = input.bool(true, title="Use Auto PMH/PML", group=groupScalpLevels)
usePremarketHighLevel            = input.bool(true, title="Use PMH Level", group=groupScalpLevels)
premarketHighLevel               = input.float(0.0, title="Manual/Fallback PMH Level", step=0.25, group=groupScalpLevels)
usePremarketLowLevel             = input.bool(true, title="Use PML Level", group=groupScalpLevels)
premarketLowLevel                = input.float(0.0, title="Manual/Fallback PML Level", step=0.25, group=groupScalpLevels)
useOpeningRangeHighAsEntryLevel  = input.bool(true, title="Use ORH As Entry Level", group=groupScalpLevels)
useOpeningRangeLowAsEntryLevel   = input.bool(true, title="Use ORL As Entry Level", group=groupScalpLevels)
showAutoScalpLevels              = input.bool(true, title="Show Auto/Effective Scalp Levels", group=groupScalpLevels)
showRawFuturesPrevDayLevels      = input.bool(false, title="Show Raw Futures PDH/PDL", group=groupScalpLevels, tooltip="Shows the raw chart/futures previous day high/low. In converted HTF trade mode these are display/debug only.")
useExpandedScalpLevels           = input.bool(true, title="Use Expanded Converted Levels For Scalp Entries/Targets", group=groupScalpLevels)
useConvertedHtfLevelsForTradeLogic = input.bool(true, title="Use Converted HTF Levels For Trade Logic", group=groupScalpLevels, tooltip="When enabled, converted SPY/QQQ-derived HTF levels are the only higher-timeframe levels used for entries, targets, close-beyond checks, and Daily Open confluence/acceptance. Futures-derived/manual HTF levels remain available for display/debug/fallback only.")
allowWeeklyOpenAsEntry           = input.bool(false, title="Allow Weekly Open As Entry Level", group=groupScalpLevels)
convertedLevelsSourceMode        = input.string("Auto From Ticker", title="Converted Levels Source Mode", options=["Auto From Ticker", "Manual Source"], group=groupScalpLevels)
manualConvertedLevelsSourceSymbol = input.string("AMEX:SPY", title="Manual Converted Levels Source Symbol", group=groupScalpLevels)
includeDailyGapsInConvertedLevels = input.bool(true, title="Include Daily Gaps In Converted Levels", group=groupScalpLevels)
dailyGapLookback                 = input.int(200, title="Daily Gap Lookback", minval=10, maxval=500, group=groupScalpLevels, tooltip="Number of SPY/QQQ regular-session daily bars to scan for unfilled daily gaps.")

// 04. Opening Range
showOpeningRange                 = input.bool(true, title="Show Opening Range", group=groupOpeningRange)
useManualOpeningRangeFallback    = input.bool(false, title="Use Manual Opening Range Fallback", group=groupOpeningRange)
manualOpeningRangeHigh           = input.float(0.0, title="Manual Opening Range High", step=0.25, group=groupOpeningRange)
manualOpeningRangeLow            = input.float(0.0, title="Manual Opening Range Low", step=0.25, group=groupOpeningRange)

// 05. Risk / Position Sizing
maxRiskDollars      = input.float(215.0, title="Max Risk Dollars", minval=0.0, step=10.0, group=groupRisk)
commissionRoundTrip = input.float(1.24, title="Commission Per Contract, Round Trip", minval=0.0, step=0.01, group=groupRisk)
useMaxContractCap   = input.bool(true, title="Use Max Contract Cap", group=groupRisk)
maxContracts        = input.int(20, title="Max Contracts", minval=1, group=groupRisk)

// 06. Target Settings
allowSignalExtremeHodLodTarget = input.bool(true, title="Allow Signal-Bar HOD/LOD Edge Target", group=groupTargets, tooltip="Allows HOD/LOD as the target when the signal bar itself made HOD/LOD and the entry is a 50% retracement, even if the R:R is slightly below 1:1 because the stop is one tick beyond the signal bar.")
hodLodEdgeToleranceTicks       = input.int(1, title="HOD/LOD Edge Tolerance Ticks", minval=0, maxval=4, group=groupTargets)
maxTrackedSwingTargets         = input.int(100, title="Max Tracked 5m Swing Targets", minval=20, maxval=300, group=groupTargets)
allowRthSwingsBrokenPremarket  = input.bool(true, title="Allow Prior RTH 5m Swings Broken In Premarket", group=groupTargets, tooltip="When enabled, prior RTH 5m swings remain eligible for scalp failed-breakout tracking even if they are tested or broken during the current premarket. They are still invalidated normally if broken during current RTH.")

// 07. Signal Engine Tuning
maxLookback                   = input.int(20, title="Pressure: Max Lookback", group=groupSignalEngine, minval=3, tooltip="Maximum number of bars to scan backward when finding prior up/down legs for fallback midpoint checks.")
pressureBodyWickThreshold     = input.float(0.40, title="Pressure: Body/Wick Range Threshold", group=groupSignalEngine, minval=0.05, maxval=0.95, step=0.05, tooltip="Minimum fraction of the full bar range required for body or wick qualification in pressure bar quality checks (default 40%).")
acceptableVolumeThreshold     = input(0.33, title="Acceptable Volume Threshold", group=groupSignalEngine, tooltip="Set the minimum volume threshold as a multiple of the volume average (e.g., 0.33x volume average). Bars with volume below this threshold will not display indications.")
volumeMetricLength            = input.int(50, title="Volume SMA Length", group=groupSignalEngine, minval=10, maxval=500, tooltip="Set the length for the volume SMA calculation.")
acceptableVolatilityThreshold = input(0.33, title="Acceptable Volatility Threshold", group=groupSignalEngine, tooltip="Set the minimum volatility threshold as a multiple of the ATR (e.g., 0.5x ATR). Bars with volatility below this threshold will not display indications.")
atrLength                     = input(14, title="ATR Length", group=groupSignalEngine, tooltip="Set the length of the ATR calculation.")

// 08. Display / Visuals
showBullSignals              = input.bool(true, title="Show Bull Signals", group=groupDisplay, tooltip="Enable bullish high-volume signal markers.")
showBearSignals              = input.bool(true, title="Show Bear Signals", group=groupDisplay, tooltip="Enable bearish high-volume signal markers.")
alertLabelMode               = input.string("Compact", title="Historical Alert Labels", options=["Off", "Marker Only", "Compact"], group=groupDisplay)
showAlertSignalDetails       = input.bool(false, title="Show Alert Signal Details", group=groupDisplay)
showSwingLevels              = input.bool(true, title="Show Converted Levels", group=groupDisplay, tooltip="Plots converted higher-timeframe levels used for scalp entries and targets.")
showSwingLevelLabels         = input.bool(false, title="Show Converted Level Labels", group=groupDisplay)
maxDisplayedDailyGaps        = input.int(20, title="Max Displayed Daily Gaps", minval=0, maxval=100, group=groupDisplay)
showScalpStatusTable         = input.bool(true, title="Show Scalp Status Table", group=groupDisplay)

// 09. Debug / Advanced
showConvertedLevelDebug = input.bool(false, title="Show Converted Level Debug", group=groupDebug)
showDetailedLevelStatus = input.bool(false, title="Show Detailed Level Status", group=groupDebug)
showGapRequestDiagnostics = input.bool(false, title="Show Gap Request Diagnostics", group=groupDebug)

scalpPointValue = tickerInput == "MES" ? 5.0 : 2.0
scalpTickSize   = 0.25

majorHighLevelColor = color.rgb(0, 100, 0)
majorLowLevelColor = color.rgb(145, 0, 0)
openLevelColor = color.orange
openingRangeHighColor = color.rgb(70, 190, 105)
openingRangeLowColor = color.rgb(235, 95, 95)
premarketLevelColor = color.blue
paEngineHighLevelColor = color.rgb(8, 153, 129)
paEngineLowLevelColor = color.rgb(242, 54, 69)
paEngineOpenLevelColor = color.rgb(243, 152, 15)
dailyGapLineColor = color.rgb(255, 255, 255)
dailyGapBoxColor = color.rgb(255, 255, 255, 95)
dailyGapBorderColor = color.rgb(255, 255, 255, 30)

// ===================== Volume Calculations =====================
volumeSMA = ta.sma(volume, volumeMetricLength)
sufficientVolume = na(volume) ? true : volume > volumeSMA * acceptableVolumeThreshold

// ===================== Price Action Calculations =====================
body = math.abs(close - open)
bodyHigh = math.max(open, close)
bodyLow = math.min(open, close)
barRange = high - low
bodyPct = barRange > 0 ? body / barRange : 0.0
closeInUpperThird = barRange > 0 and close >= low + barRange * (2.0 / 3.0)
closeInLowerThird = barRange > 0 and close <= low + barRange * (1.0 / 3.0)
upperWick = high - bodyHigh
lowerWick = bodyLow - low

// ===================== Pressure Signal Helpers =====================
f_safeRange(_high, _low) =>
    _r = _high - _low
    _r > 0 ? _r : na

f_closeInUpperThird(_close, _low, _range) =>
    not na(_range) and _close >= _low + _range * (2.0 / 3.0)

f_closeInLowerThird(_close, _low, _range) =>
    not na(_range) and _close <= _low + _range * (1.0 / 3.0)

f_meetsPct(_value, _range, _pct) =>
    not na(_range) and _value >= _range * _pct

f_dobruskyPressure() =>
    gapUp   = close[1] < low  ? (low  - close[1]) : 0.0
    gapDown = close[1] > high ? (close[1] - high) : 0.0

    adjLow  = low  - gapUp
    adjHigh = high + gapDown
    rng     = adjHigh - adjLow

    buyPressure  = na(volume) ? na : (rng != 0 ? volume * (close - adjLow) / rng : na)
    sellPressure = volume - buyPressure
    [buyPressure, sellPressure]

f_midPriorLegDown(_maxLookback) =>
    int legStart = na
    bool hasSeq = false

    for i = 0 to _maxLookback - 1
        if na(high[i]) or na(high[i + 1])
            break
        if high[i] < high[i + 1] or (i == 0 and high[i] >= high[i + 1] and high[i + 1] < high[i + 2])
            hasSeq := true
            legStart := i + 1
        else
            break

    float legHigh = na 
    float legLow = na
    float mid = na

    if hasSeq and not na(legStart)
        for j = 0 to _maxLookback - 1
            if j <= legStart
                legLow := na(legLow) ? low[j] : math.min(legLow, low[j])
                if j == legStart
                    legHigh := high[j]
        mid := (legHigh + legLow) / 2.0

    [mid, legLow, legHigh]

f_midPriorLegUp(_maxLookback) =>
    int legStart = na
    bool hasSeq = false

    for i = 0 to _maxLookback - 1
        if na(low[i]) or na(low[i + 1])
            break
        if low[i] > low[i + 1] or (i == 0 and low[i] <= low[i + 1] and low[i + 1] > low[i + 2])
            hasSeq := true
            legStart := i + 1
        else
            break

    float legLow = na
    float legHigh = na
    float mid = na

    if hasSeq and not na(legStart)
        for j = 0 to _maxLookback - 1
            if j <= legStart
                legHigh := na(legHigh) ? high[j] : math.max(legHigh, high[j])
                if j == legStart
                    legLow := low[j]
        mid := (legHigh + legLow) / 2.0

    [mid, legLow, legHigh]

// ===================== Scalp Alert Helpers =====================
f_roundUpToScalpTick(_price) =>
    math.ceil(_price / scalpTickSize) * scalpTickSize

f_roundDownToScalpTick(_price) =>
    math.floor(_price / scalpTickSize) * scalpTickSize

f_priceText(_price) =>
    na(_price) ? "N/A" : str.tostring(_price, format.mintick)

f_numberText(_value) =>
    na(_value) ? "N/A" : str.tostring(_value, "#.##")

f_pctText(_value) =>
    na(_value) ? "N/A" : str.tostring(_value * 100.0, "#.##") + "%"

f_pointsText(_value) =>
    na(_value) ? "N/A" : str.tostring(_value, "#.00")

f_rrText(_rr) =>
    na(_rr) ? "N/A" : str.tostring(_rr, "#.00") + "R"

f_boolText(_condition) =>
    _condition ? "true" : "false"

f_dateKeyText(_dateKey) =>
    na(_dateKey) ? "N/A" : str.tostring(_dateKey)

f_timeText(_time) =>
    na(_time) ? "N/A" : str.format_time(_time, "yyyy-MM-dd HH:mm", "America/New_York")

f_abbrevLevelName(string _levelName) =>
    string normalized = str.replace_all(_levelName, "Level ", "")
    normalized == "Previous Month High" ? "PMoH" :
     normalized == "Previous Month Low" ? "PMoL" :
     normalized == "Current Month Open" ? "MO" :
     normalized == "Previous Week High" ? "PWH" :
     normalized == "Previous Week Low" ? "PWL" :
     normalized == "Current Week Open" ? "WO" :
     normalized == "Previous Day High" or normalized == "PDH" ? "PDH" :
     normalized == "Previous Day Low" or normalized == "PDL" ? "PDL" :
     normalized == "Current Day Open" or normalized == "Daily Open" or normalized == "OP" ? "DO" :
     normalized == "Premarket High" or normalized == "PMH" ? "PMH" :
     normalized == "Premarket Low" or normalized == "PML" ? "PML" :
     normalized == "15m Opening Range High" or normalized == "ORH" ? "ORH" :
     normalized == "15m Opening Range Low" or normalized == "ORL" ? "ORL" :
     normalized == "Daily Gap End" ? "DGE" :
     normalized == "Daily Gap Start" ? "DGS" :
     normalized == "5m Swing" ? "5mSw" :
     normalized == "HOD" ? "HOD" :
     normalized == "LOD" ? "LOD" :
     normalized

f_levelTouched(bool _enabled, float _levelPrice, float _signalLow, float _signalHigh) =>
    _enabled and _levelPrice > 0 and _levelPrice >= _signalLow and _levelPrice <= _signalHigh

f_levelTouchedByPriorBar(bool _enabled, float _levelPrice, float _priorLow, float _priorHigh, bool _priorOppositeColor) =>
    _priorOppositeColor and not na(_priorLow) and not na(_priorHigh) and f_levelTouched(_enabled, _levelPrice, _priorLow, _priorHigh)

f_roundToScalpTick(_price) =>
    math.round(_price / scalpTickSize) * scalpTickSize

f_validSourcePrice(_price) =>
    not na(_price) and _price > 0


f_levelClosedBeyondLong(_level, _signalClose) =>
    _signalClose > _level

f_levelClosedBeyondShort(_level, _signalClose) =>
    _signalClose < _level

f_longTouchedLevelFailedCloseBeyond(_enabled, _level, _signalLow, _signalHigh, _signalClose) =>
    bool touched = f_levelTouched(_enabled, _level, _signalLow, _signalHigh)
    touched and not f_levelClosedBeyondLong(_level, _signalClose)

f_shortTouchedLevelFailedCloseBeyond(_enabled, _level, _signalLow, _signalHigh, _signalClose) =>
    bool touched = f_levelTouched(_enabled, _level, _signalLow, _signalHigh)
    touched and not f_levelClosedBeyondShort(_level, _signalClose)

f_currentRthOpen() =>
    var float rthOpen = na
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    int dateKey = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
    int priorDateKey = bar_index > 0 ? dateKey[1] : dateKey
    bool wasInRth = bar_index > 0 ? inRth[1] : false
    bool newRth = inRth and (not wasInRth or dateKey != priorDateKey)
    if newRth
        rthOpen := open
    else if not inRth and dateKey != priorDateKey
        rthOpen := na
    rthOpen

getHighLowOpen() =>
    [high[1], low[1], open]

getHigherTimeframeData(_timeframe, _ticker) =>
    // Mirrors the PA Engine level request: previous completed H/L plus current HTF open.
    request.security(_ticker, _timeframe, getHighLowOpen(), lookahead=barmerge.lookahead_on, calc_bars_count=2)

getGaps(_lookBack) =>
    map<int, string> gapsDict = map.new<int, string>()
    i = _lookBack
    float atrSumForGaps = 0.0
    // Build the map as it would exist at the current RTH open. Completed daily
    // bars may update/remove old gaps, but the current day only contributes its
    // open-vs-prior-close gap so historical high/low data cannot leak forward.
    while i >= 1
        dailyOpen = open[i]
        dailyLow = low[i]
        dailyHigh = high[i]
        prevClose = close[i + 1]
        if i <= atrLength
            atrSumForGaps := atrSumForGaps + math.max(dailyHigh - dailyLow, math.max(math.abs(dailyHigh - prevClose), math.abs(dailyLow - prevClose)))
        if dailyOpen != prevClose
            gapHigh = str.tostring(math.max(dailyOpen, prevClose))
            gapLow = str.tostring(math.min(dailyOpen, prevClose))
            isGapUp = dailyOpen > prevClose
            dir = isGapUp ? "U" : "D"
            gapsDict.put(time[i], dir + "|" + gapHigh + "," + gapLow + ":" + gapHigh + "," + gapLow)

        keysToRemove = array.new_int(0)
        if not barstate.isrealtime[i]
            for [key, value] in gapsDict
                gapOriginalAndPartial = str.split(value, ":")
                partialGapHighAndLow = str.split(array.get(gapOriginalAndPartial, 1), ",")
                partialGapHigh = str.tonumber(array.get(partialGapHighAndLow, 0))
                partialGapLow = str.tonumber(array.get(partialGapHighAndLow, 1))
                if dailyLow <= partialGapLow and dailyHigh >= partialGapHigh
                    array.push(keysToRemove, key)
                else
                    if dailyLow > partialGapLow and dailyLow < partialGapHigh
                        partialGapHigh := dailyLow
                        gapsDict.put(key, array.get(gapOriginalAndPartial, 0) + ":" + str.tostring(partialGapHigh) + "," + str.tostring(partialGapLow))
                    if dailyHigh < partialGapHigh and dailyHigh > partialGapLow
                        partialGapLow := dailyHigh
                        gapsDict.put(key, array.get(gapOriginalAndPartial, 0) + ":" + str.tostring(partialGapHigh) + "," + str.tostring(partialGapLow))
        for key in keysToRemove
            gapsDict.remove(key)
        i := i - 1

    currentDailyOpen = open
    currentPrevClose = close[1]
    if not na(currentDailyOpen) and not na(currentPrevClose) and currentDailyOpen != currentPrevClose
        currentGapHigh = str.tostring(math.max(currentDailyOpen, currentPrevClose))
        currentGapLow = str.tostring(math.min(currentDailyOpen, currentPrevClose))
        currentIsGapUp = currentDailyOpen > currentPrevClose
        currentDir = currentIsGapUp ? "U" : "D"
        gapsDict.put(time, currentDir + "|" + currentGapHigh + "," + currentGapLow + ":" + currentGapHigh + "," + currentGapLow)

    keysToRemove = array.new_int(0)
    atrForGaps = atrSumForGaps / atrLength
    for [key, value] in gapsDict
        gapOriginalAndPartial = str.split(value, ":")
        partialGapHighAndLow = str.split(array.get(gapOriginalAndPartial, 1), ",")
        gapSize = math.abs(str.tonumber(array.get(partialGapHighAndLow, 0)) - str.tonumber(array.get(partialGapHighAndLow, 1)))
        if gapSize < atrForGaps * 0.1
            array.push(keysToRemove, key)
    for key in keysToRemove
        gapsDict.remove(key)
    gapsDict

f_gapBoundaryPriceFromRecord(string _gapRecord, bool _useHighSide) =>
    float gapBoundaryPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapBoundaryPrice := str.tonumber(array.get(gapHighAndLow, _useHighSide ? 0 : 1))
    gapBoundaryPrice

f_gapHighPriceFromRecord(string _gapRecord) =>
    f_gapBoundaryPriceFromRecord(_gapRecord, true)

f_gapLowPriceFromRecord(string _gapRecord) =>
    f_gapBoundaryPriceFromRecord(_gapRecord, false)

f_gapEndPriceFromRecord(string _gapRecord) =>
    float gapEndPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh = str.tonumber(array.get(gapHighAndLow, 0))
                gapLow = str.tonumber(array.get(gapHighAndLow, 1))
                // Gap end = prior-close side of the gap.
                // Gap up: low side. Gap down: high side.
                gapEndPrice := dir == "U" ? gapLow : gapHigh
    gapEndPrice

f_gapStartPriceFromRecord(string _gapRecord) =>
    float gapStartPrice = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh = str.tonumber(array.get(gapHighAndLow, 0))
                gapLow = str.tonumber(array.get(gapHighAndLow, 1))
                // Gap start = daily-open side of the gap.
                // Gap up: high side. Gap down: low side.
                gapStartPrice := dir == "U" ? gapHigh : gapLow
    gapStartPrice

f_parseGapRecord(string _gapRecord) =>
    bool gapParsed = false
    float gapStart = na
    float gapEnd = na
    float gapHigh = na
    float gapLow = na
    parts = str.split(_gapRecord, "|")
    if array.size(parts) == 2
        dir = array.get(parts, 0)
        rest = array.get(parts, 1)
        gapOriginalAndPartial = str.split(rest, ":")
        if (dir == "U" or dir == "D") and array.size(gapOriginalAndPartial) > 0
            gapHighAndLow = str.split(array.get(gapOriginalAndPartial, 0), ",")
            if array.size(gapHighAndLow) == 2
                gapHigh := str.tonumber(array.get(gapHighAndLow, 0))
                gapLow := str.tonumber(array.get(gapHighAndLow, 1))
                if not na(gapHigh) and not na(gapLow)
                    gapStart := dir == "U" ? gapHigh : gapLow
                    gapEnd := dir == "U" ? gapLow : gapHigh
                    gapParsed := true
    [gapParsed, gapStart, gapEnd, gapHigh, gapLow]

f_gapMapDiagnostics(map<int, string> _gapMap) =>
    int gapMapCount = 0
    string firstGapRecord = "N/A"
    if not na(_gapMap)
        for [gapMapKey, gapMapValue] in _gapMap
            gapMapCount += 1
            if gapMapCount == 1
                firstGapRecord := gapMapValue
    [gapMapCount, firstGapRecord]

f_isBullBar(_open, _close) =>
    not na(_open) and not na(_close) and _close > _open

f_isBearBar(_open, _close) =>
    not na(_open) and not na(_close) and _close < _open

f_pickLongQualifiedLevel(bool _enabled, float _levelPrice, string _levelName, int _levelPriority, float _signalLow, float _signalHigh, float _signalClose, float _priorLow, float _priorHigh, bool _priorBear, float _bestPrice, string _bestName, int _bestPriority, bool _bestCurrentTouched, bool _found) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    bool nextCurrentTouched = _bestCurrentTouched
    bool nextFound = _found
    bool currentTouched = f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh)
    bool priorTouched = f_levelTouchedByPriorBar(_enabled, _levelPrice, _priorLow, _priorHigh, _priorBear)
    bool levelQualified = (currentTouched or priorTouched) and _signalClose > _levelPrice
    bool betterLevel = not nextFound or _levelPriority < nextPriority or (_levelPriority == nextPriority and (na(nextPrice) or _levelPrice > nextPrice))
    if levelQualified and betterLevel
        nextPrice := _levelPrice
        nextName := _levelName
        nextPriority := _levelPriority
        nextCurrentTouched := currentTouched
        nextFound := true
    [nextPrice, nextName, nextPriority, nextCurrentTouched, nextFound]

f_pickShortQualifiedLevel(bool _enabled, float _levelPrice, string _levelName, int _levelPriority, float _signalLow, float _signalHigh, float _signalClose, float _priorLow, float _priorHigh, bool _priorBull, float _bestPrice, string _bestName, int _bestPriority, bool _bestCurrentTouched, bool _found) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    bool nextCurrentTouched = _bestCurrentTouched
    bool nextFound = _found
    bool currentTouched = f_levelTouched(_enabled, _levelPrice, _signalLow, _signalHigh)
    bool priorTouched = f_levelTouchedByPriorBar(_enabled, _levelPrice, _priorLow, _priorHigh, _priorBull)
    bool levelQualified = (currentTouched or priorTouched) and _signalClose < _levelPrice
    bool betterLevel = not nextFound or _levelPriority < nextPriority or (_levelPriority == nextPriority and (na(nextPrice) or _levelPrice < nextPrice))
    if levelQualified and betterLevel
        nextPrice := _levelPrice
        nextName := _levelName
        nextPriority := _levelPriority
        nextCurrentTouched := currentTouched
        nextFound := true
    [nextPrice, nextName, nextPriority, nextCurrentTouched, nextFound]

f_pickLongEntryCandidate(float _candidatePrice, string _candidateName, int _candidatePriority, bool _candidateCurrentTouched, bool _candidateFound, float _bestPrice, string _bestName, int _bestPriority, bool _bestCurrentTouched, bool _bestFound) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    bool nextCurrentTouched = _bestCurrentTouched
    bool nextFound = _bestFound
    bool betterCandidate = _candidateFound and (not nextFound or _candidatePriority < nextPriority or (_candidatePriority == nextPriority and (na(nextPrice) or _candidatePrice > nextPrice)))
    if betterCandidate
        nextPrice := _candidatePrice
        nextName := _candidateName
        nextPriority := _candidatePriority
        nextCurrentTouched := _candidateCurrentTouched
        nextFound := true
    [nextPrice, nextName, nextPriority, nextCurrentTouched, nextFound]

f_pickShortEntryCandidate(float _candidatePrice, string _candidateName, int _candidatePriority, bool _candidateCurrentTouched, bool _candidateFound, float _bestPrice, string _bestName, int _bestPriority, bool _bestCurrentTouched, bool _bestFound) =>
    float nextPrice = _bestPrice
    string nextName = _bestName
    int nextPriority = _bestPriority
    bool nextCurrentTouched = _bestCurrentTouched
    bool nextFound = _bestFound
    bool betterCandidate = _candidateFound and (not nextFound or _candidatePriority < nextPriority or (_candidatePriority == nextPriority and (na(nextPrice) or _candidatePrice < nextPrice)))
    if betterCandidate
        nextPrice := _candidatePrice
        nextName := _candidateName
        nextPriority := _candidatePriority
        nextCurrentTouched := _candidateCurrentTouched
        nextFound := true
    [nextPrice, nextName, nextPriority, nextCurrentTouched, nextFound]

f_targetRRLong(float _targetPrice, float _entryPrice, float _riskPoints) =>
    float rewardPoints = _targetPrice - _entryPrice
    not na(_targetPrice) and not na(_entryPrice) and not na(_riskPoints) and rewardPoints > 0 and _riskPoints > 0 ? rewardPoints / _riskPoints : na

f_targetRRShort(float _targetPrice, float _entryPrice, float _riskPoints) =>
    float rewardPoints = _entryPrice - _targetPrice
    not na(_targetPrice) and not na(_entryPrice) and not na(_riskPoints) and rewardPoints > 0 and _riskPoints > 0 ? rewardPoints / _riskPoints : na

f_longHodEdgeQualifies(float _targetPrice, string _targetType, string _entryType, float _signalHigh, float _entryPrice, float _riskPoints, float _currentRTHHigh) =>
    float rewardPoints = _targetPrice - _entryPrice
    bool signalMadeHOD = not na(_currentRTHHigh) and not na(_signalHigh) and (_currentRTHHigh == _signalHigh or math.abs(_currentRTHHigh - _signalHigh) <= scalpTickSize * 0.1)
    bool edgeWithinTolerance = not na(_riskPoints) and not na(rewardPoints) and _riskPoints > 0 and _riskPoints - rewardPoints <= scalpTickSize * hodLodEdgeToleranceTicks + scalpTickSize * 0.1
    allowSignalExtremeHodLodTarget and _targetType == "HOD" and _entryType == "50%" and signalMadeHOD and rewardPoints > 0 and edgeWithinTolerance

f_shortLodEdgeQualifies(float _targetPrice, string _targetType, string _entryType, float _signalLow, float _entryPrice, float _riskPoints, float _currentRTHLow) =>
    float rewardPoints = _entryPrice - _targetPrice
    bool signalMadeLOD = not na(_currentRTHLow) and not na(_signalLow) and (_currentRTHLow == _signalLow or math.abs(_currentRTHLow - _signalLow) <= scalpTickSize * 0.1)
    bool edgeWithinTolerance = not na(_riskPoints) and not na(rewardPoints) and _riskPoints > 0 and _riskPoints - rewardPoints <= scalpTickSize * hodLodEdgeToleranceTicks + scalpTickSize * 0.1
    allowSignalExtremeHodLodTarget and _targetType == "LOD" and _entryType == "50%" and signalMadeLOD and rewardPoints > 0 and edgeWithinTolerance

f_longTargetQualifies(float _targetPrice, string _targetType, string _entryType, float _signalHigh, float _entryPrice, float _riskPoints, float _currentRTHHigh) =>
    bool priceReady = not na(_targetPrice) and _targetPrice > 0
    bool locationOk = priceReady and (_targetType == "HOD" ? _targetPrice >= _signalHigh : _targetPrice > _signalHigh)
    float rr = f_targetRRLong(_targetPrice, _entryPrice, _riskPoints)
    bool normalTargetOk = locationOk and not na(rr) and rr >= minTargetRR
    bool edgeTargetOk = locationOk and f_longHodEdgeQualifies(_targetPrice, _targetType, _entryType, _signalHigh, _entryPrice, _riskPoints, _currentRTHHigh)
    normalTargetOk or edgeTargetOk

f_shortTargetQualifies(float _targetPrice, string _targetType, string _entryType, float _signalLow, float _entryPrice, float _riskPoints, float _currentRTHLow) =>
    bool priceReady = not na(_targetPrice) and _targetPrice > 0
    bool locationOk = priceReady and (_targetType == "LOD" ? _targetPrice <= _signalLow : _targetPrice < _signalLow)
    float rr = f_targetRRShort(_targetPrice, _entryPrice, _riskPoints)
    bool normalTargetOk = locationOk and not na(rr) and rr >= minTargetRR
    bool edgeTargetOk = locationOk and f_shortLodEdgeQualifies(_targetPrice, _targetType, _entryType, _signalLow, _entryPrice, _riskPoints, _currentRTHLow)
    normalTargetOk or edgeTargetOk

f_sameRoundedTargetPrice(float _leftPrice, float _rightPrice) =>
    not na(_leftPrice) and not na(_rightPrice) and f_roundToScalpTick(_leftPrice) == f_roundToScalpTick(_rightPrice)

f_longTargetCandidateBetter(float _candidatePrice, int _candidatePriority, float _bestPrice, int _bestPriority) =>
    bool samePrice = f_sameRoundedTargetPrice(_candidatePrice, _bestPrice)
    na(_bestPrice) or (not samePrice and _candidatePrice < _bestPrice) or (samePrice and _candidatePriority < _bestPriority)

f_shortTargetCandidateBetter(float _candidatePrice, int _candidatePriority, float _bestPrice, int _bestPriority) =>
    bool samePrice = f_sameRoundedTargetPrice(_candidatePrice, _bestPrice)
    na(_bestPrice) or (not samePrice and _candidatePrice > _bestPrice) or (samePrice and _candidatePriority < _bestPriority)

f_swingTargetSessionAllowed(string _session, int _dateKey, int _currentDateKey, int _currentRTHDateKey, int _previousRTHDateKey) =>
    bool pmAllowed = _session == "PM" and _dateKey == _currentDateKey
    bool rthCurrentAllowed = _session == "RTH" and not na(_currentRTHDateKey) and _dateKey == _currentRTHDateKey
    bool rthPreviousAllowed = _session == "RTH" and not na(_previousRTHDateKey) and _dateKey == _previousRTHDateKey
    pmAllowed or rthCurrentAllowed or rthPreviousAllowed

f_swingBreakCanInvalidate(bool _allowRthSwingsBrokenPremarket, bool _currentInPremarket, string _swingSession, int _swingDateKey, int _mostRecentCompletedRTHDateKey) =>
    not (_allowRthSwingsBrokenPremarket and _currentInPremarket and _swingSession == "RTH" and not na(_mostRecentCompletedRTHDateKey) and _swingDateKey == _mostRecentCompletedRTHDateKey)

f_hasPivotBar(array<int> _pivotBars, int _pivotBar) =>
    bool found = false
    if array.size(_pivotBars) > 0
        for pivotBarIndex = 0 to array.size(_pivotBars) - 1
            if array.get(_pivotBars, pivotBarIndex) == _pivotBar
                found := true
    found

// ===================== ATR Calculation (RTH only) =====================
var float atrSum = 0.0
var trArray = array.new_float(0)
isRTH = time(timeframe.period, "0930-1600:23456", "America/New_York") != 0 or timeframe.isdwm
trValue = ta.tr(true)
atrValue = 0.0
if isRTH
    atrSum += trValue
    array.push(trArray, trValue)
    if array.size(trArray) > atrLength
        removed = array.shift(trArray)
        atrSum -= removed
    atrValue := atrSum / array.size(trArray)
else
    atrValue := nz(atrValue[1])

sufficientVolatility = barRange >= atrValue * acceptableVolatilityThreshold

// ===================== RTH / Opening Range Logic =====================
scalpRTHTime = time(timeframe.period, "0930-1600:23456", "America/New_York")
openingRangeTime = time(timeframe.period, "0930-0945:23456", "America/New_York")
premarketTime = time(timeframe.period, "0400-0930:23456", "America/New_York")
inScalpRTHSession = not na(scalpRTHTime)
inPremarketSession = not na(premarketTime)
inOpeningRangeWindow = inScalpRTHSession and not na(openingRangeTime)
nySessionDateKey = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
priorNYSessionDateKey = bar_index > 0 ? nySessionDateKey[1] : nySessionDateKey
wasInScalpRTHSession = bar_index > 0 ? inScalpRTHSession[1] : false
wasInPremarketSession = bar_index > 0 ? inPremarketSession[1] : false
newNYSessionDate = bar_index > 0 and nySessionDateKey != priorNYSessionDateKey
newScalpRTHSession = inScalpRTHSession and (not wasInScalpRTHSession or nySessionDateKey != priorNYSessionDateKey)
newPremarketSession = inPremarketSession and (not wasInPremarketSession or nySessionDateKey != priorNYSessionDateKey)

// Auto scalp levels are intended for intraday charts, ideally 5m.
var float currentRTHHigh = na
var float currentRTHLow = na
var float autoPrevDayHigh = na
var float autoPrevDayLow = na
var float autoDailyOpen = na
var float autoPremarketHigh = na
var float autoPremarketLow = na
var float finalizedPremarketHigh = na
var float finalizedPremarketLow = na
var int autoPremarketDateKey = na
var int currentRTHDateKey = na
var int previousRTHDateKey = na
var int currentRTHStartBar = na
var array<float> swingHighPrices = array.new_float(0)
var array<int> swingHighPivotBars = array.new_int(0)
var array<int> swingHighDateKeys = array.new_int(0)
var array<string> swingHighSessions = array.new_string(0)
var array<bool> swingHighActive = array.new_bool(0)
var array<float> swingLowPrices = array.new_float(0)
var array<int> swingLowPivotBars = array.new_int(0)
var array<int> swingLowDateKeys = array.new_int(0)
var array<string> swingLowSessions = array.new_string(0)
var array<bool> swingLowActive = array.new_bool(0)
var array<float> fboSwingHighPrices = array.new_float()
var array<int> fboSwingHighPivotBars = array.new_int()
var array<int> fboSwingHighDateKeys = array.new_int()
var array<string> fboSwingHighSessions = array.new_string()
var array<bool> fboSwingHighCleared = array.new_bool()
var array<float> fboSwingLowPrices = array.new_float()
var array<int> fboSwingLowPivotBars = array.new_int()
var array<int> fboSwingLowDateKeys = array.new_int()
var array<string> fboSwingLowSessions = array.new_string()
var array<bool> fboSwingLowCleared = array.new_bool()
var array<float> rthSwingHistHighs = array.new_float()
var array<float> rthSwingHistLows = array.new_float()
var array<int> rthSwingHistBarIndexes = array.new_int()
var array<int> rthSwingHistDateKeys = array.new_int()
var array<float> pmSwingHistHighs = array.new_float()
var array<float> pmSwingHistLows = array.new_float()
var array<int> pmSwingHistBarIndexes = array.new_int()
var array<int> pmSwingHistDateKeys = array.new_int()

if newNYSessionDate and not inScalpRTHSession and not inPremarketSession
    autoDailyOpen := na
    finalizedPremarketHigh := na
    finalizedPremarketLow := na

if newPremarketSession
    autoPremarketHigh := high
    autoPremarketLow := low
    autoDailyOpen := na
    finalizedPremarketHigh := na
    finalizedPremarketLow := na
    autoPremarketDateKey := nySessionDateKey
else if inPremarketSession
    autoPremarketHigh := na(autoPremarketHigh) ? high : math.max(autoPremarketHigh, high)
    autoPremarketLow := na(autoPremarketLow) ? low : math.min(autoPremarketLow, low)
    autoPremarketDateKey := nySessionDateKey

if newScalpRTHSession
    if not na(currentRTHDateKey)
        previousRTHDateKey := currentRTHDateKey
    currentRTHDateKey := nySessionDateKey
    currentRTHStartBar := bar_index
    autoPrevDayHigh := currentRTHHigh
    autoPrevDayLow := currentRTHLow
    currentRTHHigh := high
    currentRTHLow := low
    autoDailyOpen := open
    currentPremarketReady = autoPremarketDateKey == nySessionDateKey and not na(autoPremarketHigh) and not na(autoPremarketLow)
    finalizedPremarketHigh := currentPremarketReady ? autoPremarketHigh : na
    finalizedPremarketLow := currentPremarketReady ? autoPremarketLow : na
else if inScalpRTHSession
    currentRTHHigh := na(currentRTHHigh) ? high : math.max(currentRTHHigh, high)
    currentRTHLow := na(currentRTHLow) ? low : math.min(currentRTHLow, low)

effectivePrevDayHigh = useAutoPrevDayHighLow and not na(autoPrevDayHigh) ? autoPrevDayHigh : prevDayHighLevel
effectivePrevDayLow = useAutoPrevDayHighLow and not na(autoPrevDayLow) ? autoPrevDayLow : prevDayLowLevel
effectiveDailyOpen = useAutoDailyOpen and not na(autoDailyOpen) ? autoDailyOpen : dailyOpenLevel
effectivePremarketHigh = useAutoPremarketHighLow and not na(finalizedPremarketHigh) ? finalizedPremarketHigh : premarketHighLevel
effectivePremarketLow = useAutoPremarketHighLow and not na(finalizedPremarketLow) ? finalizedPremarketLow : premarketLowLevel
premarketDisplayHigh = showAutoScalpLevels and usePremarketHighLevel and timeframe.isintraday ? (inPremarketSession ? autoPremarketHigh : inScalpRTHSession ? finalizedPremarketHigh : na) : na
premarketDisplayLow = showAutoScalpLevels and usePremarketLowLevel and timeframe.isintraday ? (inPremarketSession ? autoPremarketLow : inScalpRTHSession ? finalizedPremarketLow : na) : na

prevDayHighLowSource = useAutoPrevDayHighLow ? (not na(autoPrevDayHigh) and not na(autoPrevDayLow) ? "Auto" : "Manual Fallback") : "Manual"
dailyOpenSource = useAutoDailyOpen ? (not na(autoDailyOpen) ? "Auto" : "Manual Fallback") : "Manual"
premarketSource = useAutoPremarketHighLow ? (not na(finalizedPremarketHigh) and not na(finalizedPremarketLow) ? "Auto" : "Manual Fallback") : "Manual"

// ===================== Converted Source Levels =====================
// MES defaults to AMEX:SPY. TradingView alerts may require real-time entitlement
// for the exact feed used by request.security(), even if it appears usable on charts.
defaultConvertedSourceSymbol = tickerInput == "MES" ? "AMEX:SPY" : "NASDAQ:QQQ"
defaultConvertedSourceTicker = tickerInput == "MES" ? ticker.new("AMEX", "SPY", "us_regular:23456") : ticker.new("NASDAQ", "QQQ", "us_regular:23456")
explicitDailyGapSourceTicker = tickerInput == "MES" ? ticker.new("AMEX", "SPY", "us_regular:23456") : ticker.new("NASDAQ", "QQQ", "us_regular:23456")
explicitDailyGapPlainSymbol = tickerInput == "MES" ? "AMEX:SPY" : "NASDAQ:QQQ"
expectedDailyGapSourceSymbol = tickerInput == "MES" ? "SPY" : "QQQ"
convertedHtfTradeLevelsEnabled = useConvertedHtfLevelsForTradeLogic
sourceLevelsEnabled = convertedHtfTradeLevelsEnabled or showSwingLevels
convertedLevelSourceSymbol = sourceLevelsEnabled ? (convertedLevelsSourceMode == "Manual Source" ? manualConvertedLevelsSourceSymbol : defaultConvertedSourceSymbol) : "None"
convertedLevelSourceTicker = sourceLevelsEnabled ? (convertedLevelsSourceMode == "Manual Source" ? manualConvertedLevelsSourceSymbol : defaultConvertedSourceTicker) : ""
sourceCloseForConversionNeeded = sourceLevelsEnabled
dailyGapRequestEnabled = sourceLevelsEnabled and includeDailyGapsInConvertedLevels
activeDailyGapSourceTicker = convertedLevelsSourceMode == "Manual Source" ? manualConvertedLevelsSourceSymbol : explicitDailyGapSourceTicker
activeDailyGapSourceSymbol = convertedLevelsSourceMode == "Manual Source" ? manualConvertedLevelsSourceSymbol : explicitDailyGapPlainSymbol
activeDailyGapSourceType = convertedLevelsSourceMode == "Manual Source" ? "Manual source" : "Explicit RTH ticker"
activeDailyGapSourceDebugText = activeDailyGapSourceType == "Explicit RTH ticker" ? activeDailyGapSourceSymbol + " RTH" : activeDailyGapSourceSymbol
activeDailyGapRequestMode = "RTH session cache"
activeDailyGapTimeframe = "1440"
activeDailyGapCalcBarsCount = 600

// The HTF source values are frozen once per RTH session. Their converted chart
// prices still use currentConversionRatio below, so live ratio drift is preserved.
float sourcePrevDayHigh = na
float sourcePrevDayLow = na
float sourceDayOpenHTF = na
float sourcePrevWeekHigh = na
float sourcePrevWeekLow = na
float sourceWeekOpen = na
float sourcePrevMonthHigh = na
float sourcePrevMonthLow = na
float sourceMonthOpen = na
float sourceDayOpenIntraday = na
float sourceDayOpen = na
float sourceCloseForConversion = na
map<int, string> sourceDailyGaps = na
var float lastRthChartCloseForDisplayConversion = na
var float lastRthSourceCloseForDisplayConversion = na
var float cachedSourcePrevDayHigh = na
var float cachedSourcePrevDayLow = na
var float cachedSourceDayOpenHTF = na
var float cachedSourcePrevWeekHigh = na
var float cachedSourcePrevWeekLow = na
var float cachedSourceWeekOpen = na
var float cachedSourcePrevMonthHigh = na
var float cachedSourcePrevMonthLow = na
var float cachedSourceMonthOpen = na
var float cachedSourceDayOpenIntraday = na
var float cachedSourceDayOpen = na
var int convertedSourceCacheSessionDateKey = na
var int convertedSourceCacheLastRefreshTime = na
var bool convertedSourceCacheInitializedMidSession = false
var array<int> cachedSourceDailyGapTimes = array.new_int()
var array<float> cachedSourceDailyGapStarts = array.new_float()
var array<float> cachedSourceDailyGapEnds = array.new_float()
var array<float> cachedSourceDailyGapHighs = array.new_float()
var array<float> cachedSourceDailyGapLows = array.new_float()
var int cachedSourceDailyGapSessionDateKey = na
var int cachedSourceDailyGapLastRefreshTime = na
var bool cachedSourceDailyGapInitializedMidSession = false
var int lastFreshRequestedSourceDailyGapCount = 0
var int sourceDailyGapParseFailCount = 0
var int sourceDailyGapInvalidPriceCount = 0
var int sourceDailyGapCachedSuccessCount = 0
var string firstRawDailyGapRecord = "N/A"

var array<float> swingLevelPrices = array.new_float()
var array<string> swingLevelNames = array.new_string()
var array<int> swingLevelPriority = array.new_int()
var array<bool> swingLevelAllowedForEntry = array.new_bool()
var array<bool> swingLevelAllowedForTarget = array.new_bool()
var array<bool> swingLevelCloseBeyondRequired = array.new_bool()
var array<float> swingDisplayLevelPrices = array.new_float()
var array<string> swingDisplayLevelLabels = array.new_string()
var array<color> swingDisplayLevelColors = array.new_color()
var array<int> swingDisplayLevelWidths = array.new_int()
var array<int> swingDisplayLevelStyles = array.new_int()
var array<float> swingDisplayGapBoxTops = array.new_float()
var array<float> swingDisplayGapBoxBottoms = array.new_float()
var array<line> swingLevelLines = array.new_line()
var array<label> swingLevelLabels = array.new_label()
var array<box> swingDailyGapBoxes = array.new_box()

currentNYHour = hour(time, "America/New_York")
currentNYMinute = minute(time, "America/New_York")
barStartsAtRthOpen = inScalpRTHSession and currentNYHour == 9 and currentNYMinute == 30
sourceSessionCacheShouldRefresh = sourceLevelsEnabled and inScalpRTHSession and (newScalpRTHSession or na(convertedSourceCacheSessionDateKey) or convertedSourceCacheSessionDateKey != nySessionDateKey)
dailyGapSessionCacheShouldRefresh = dailyGapRequestEnabled and inScalpRTHSession and (newScalpRTHSession or na(cachedSourceDailyGapSessionDateKey) or cachedSourceDailyGapSessionDateKey != nySessionDateKey)

if sourceLevelsEnabled
    sourceCloseForConversion := sourceCloseForConversionNeeded ? request.security(convertedLevelSourceTicker, timeframe.period, close, lookahead=barmerge.lookahead_off, calc_bars_count=500) : na
    if sourceSessionCacheShouldRefresh
        [requestedPrevDayHigh, requestedPrevDayLow, requestedDayOpenHTF] = getHigherTimeframeData("1440", convertedLevelSourceTicker)
        [requestedPrevWeekHigh, requestedPrevWeekLow, requestedWeekOpen] = getHigherTimeframeData("W", convertedLevelSourceTicker)
        [requestedPrevMonthHigh, requestedPrevMonthLow, requestedMonthOpen] = getHigherTimeframeData("M", convertedLevelSourceTicker)
        requestedDayOpenIntraday = request.security(convertedLevelSourceTicker, "5", f_currentRthOpen(), lookahead=barmerge.lookahead_off, calc_bars_count=500)
        cachedSourcePrevDayHigh := requestedPrevDayHigh
        cachedSourcePrevDayLow := requestedPrevDayLow
        cachedSourceDayOpenHTF := requestedDayOpenHTF
        cachedSourcePrevWeekHigh := requestedPrevWeekHigh
        cachedSourcePrevWeekLow := requestedPrevWeekLow
        cachedSourceWeekOpen := requestedWeekOpen
        cachedSourcePrevMonthHigh := requestedPrevMonthHigh
        cachedSourcePrevMonthLow := requestedPrevMonthLow
        cachedSourceMonthOpen := requestedMonthOpen
        cachedSourceDayOpenIntraday := requestedDayOpenIntraday
        cachedSourceDayOpen := f_validSourcePrice(cachedSourceDayOpenHTF) ? cachedSourceDayOpenHTF : cachedSourceDayOpenIntraday
        convertedSourceCacheSessionDateKey := nySessionDateKey
        convertedSourceCacheLastRefreshTime := time
        convertedSourceCacheInitializedMidSession := not barStartsAtRthOpen
    sourcePrevDayHigh := cachedSourcePrevDayHigh
    sourcePrevDayLow := cachedSourcePrevDayLow
    sourceDayOpenHTF := cachedSourceDayOpenHTF
    sourcePrevWeekHigh := cachedSourcePrevWeekHigh
    sourcePrevWeekLow := cachedSourcePrevWeekLow
    sourceWeekOpen := cachedSourceWeekOpen
    sourcePrevMonthHigh := cachedSourcePrevMonthHigh
    sourcePrevMonthLow := cachedSourcePrevMonthLow
    sourceMonthOpen := cachedSourceMonthOpen
    sourceDayOpenIntraday := cachedSourceDayOpenIntraday
    sourceDayOpen := cachedSourceDayOpen
    if dailyGapSessionCacheShouldRefresh
        // Request SPY/QQQ RTH daily gaps once for this chart RTH session. getGaps()
        // returns the source gap map known at that session's open.
        sourceDailyGaps := request.security(activeDailyGapSourceTicker, activeDailyGapTimeframe, getGaps(dailyGapLookback), lookahead=barmerge.lookahead_on, calc_bars_count=activeDailyGapCalcBarsCount)
        [refreshedSourceDailyGapCount, refreshedFirstRawDailyGapRecord] = f_gapMapDiagnostics(sourceDailyGaps)
        array.clear(cachedSourceDailyGapTimes)
        array.clear(cachedSourceDailyGapStarts)
        array.clear(cachedSourceDailyGapEnds)
        array.clear(cachedSourceDailyGapHighs)
        array.clear(cachedSourceDailyGapLows)
        cachedSourceDailyGapSessionDateKey := nySessionDateKey
        cachedSourceDailyGapLastRefreshTime := time
        cachedSourceDailyGapInitializedMidSession := not barStartsAtRthOpen
        lastFreshRequestedSourceDailyGapCount := refreshedSourceDailyGapCount
        sourceDailyGapParseFailCount := 0
        sourceDailyGapInvalidPriceCount := 0
        sourceDailyGapCachedSuccessCount := 0
        firstRawDailyGapRecord := refreshedSourceDailyGapCount > 0 ? refreshedFirstRawDailyGapRecord : "N/A"
        if not na(sourceDailyGaps)
            for [cacheGapKey, cacheGapValue] in sourceDailyGaps
                [cacheGapParsed, cacheGapStart, cacheGapEnd, cacheGapHigh, cacheGapLow] = f_parseGapRecord(cacheGapValue)
                bool cacheGapSourcePricesValid = f_validSourcePrice(cacheGapStart) and f_validSourcePrice(cacheGapEnd) and f_validSourcePrice(cacheGapHigh) and f_validSourcePrice(cacheGapLow)
                if not cacheGapParsed
                    sourceDailyGapParseFailCount += 1
                else if not cacheGapSourcePricesValid
                    sourceDailyGapInvalidPriceCount += 1
                else
                    array.push(cachedSourceDailyGapTimes, cacheGapKey)
                    array.push(cachedSourceDailyGapStarts, cacheGapStart)
                    array.push(cachedSourceDailyGapEnds, cacheGapEnd)
                    array.push(cachedSourceDailyGapHighs, cacheGapHigh)
                    array.push(cachedSourceDailyGapLows, cacheGapLow)
                    sourceDailyGapCachedSuccessCount += 1

if barstate.isconfirmed and inScalpRTHSession and f_validSourcePrice(close) and f_validSourcePrice(sourceCloseForConversion)
    lastRthChartCloseForDisplayConversion := close
    lastRthSourceCloseForDisplayConversion := sourceCloseForConversion

// Current Price Ratio is the only active source-to-chart conversion. Once an
// RTH ratio exists, premarket and after-hours bars reuse it instead of drifting.
fallbackChartConversionClose = barstate.isconfirmed ? close : close[1]
fallbackSourceConversionClose = barstate.isconfirmed ? sourceCloseForConversion : sourceCloseForConversion[1]
chartConversionBase = f_validSourcePrice(lastRthChartCloseForDisplayConversion) ? lastRthChartCloseForDisplayConversion : f_validSourcePrice(fallbackChartConversionClose) and f_validSourcePrice(fallbackSourceConversionClose) ? fallbackChartConversionClose : na
sourceConversionBase = f_validSourcePrice(lastRthSourceCloseForDisplayConversion) ? lastRthSourceCloseForDisplayConversion : f_validSourcePrice(fallbackSourceConversionClose) ? fallbackSourceConversionClose : na
currentConversionRatio = f_validSourcePrice(chartConversionBase) and f_validSourcePrice(sourceConversionBase) ? chartConversionBase / sourceConversionBase : na
swingCurrentPriceRatioReady = f_validSourcePrice(currentConversionRatio)
sourceSessionCacheReady = sourceLevelsEnabled and not na(convertedSourceCacheSessionDateKey)
sourceSessionCacheCurrent = sourceLevelsEnabled and convertedSourceCacheSessionDateKey == nySessionDateKey
dailyGapUsingCurrentSessionCache = dailyGapRequestEnabled and inScalpRTHSession and cachedSourceDailyGapSessionDateKey == nySessionDateKey
requestedSourceDailyGapCount = lastFreshRequestedSourceDailyGapCount
currentFirstRawDailyGapRecord = firstRawDailyGapRecord

if not dailyGapRequestEnabled
    array.clear(cachedSourceDailyGapTimes)
    array.clear(cachedSourceDailyGapStarts)
    array.clear(cachedSourceDailyGapEnds)
    array.clear(cachedSourceDailyGapHighs)
    array.clear(cachedSourceDailyGapLows)
    cachedSourceDailyGapSessionDateKey := na
    cachedSourceDailyGapLastRefreshTime := na
    cachedSourceDailyGapInitializedMidSession := false
    lastFreshRequestedSourceDailyGapCount := 0
    sourceDailyGapParseFailCount := 0
    sourceDailyGapInvalidPriceCount := 0
    sourceDailyGapCachedSuccessCount := 0
    firstRawDailyGapRecord := "N/A"

cachedSourceDailyGapCount = array.size(cachedSourceDailyGapStarts)
sourceDailyGapCount = dailyGapUsingCurrentSessionCache ? cachedSourceDailyGapCount : 0
float firstValidSourceGapStart = na
float firstValidSourceGapEnd = na
float firstValidSourceGapHigh = na
float firstValidSourceGapLow = na
if sourceDailyGapCount > 0
    for countGapIndex = 0 to sourceDailyGapCount - 1
        float countGapStart = array.get(cachedSourceDailyGapStarts, countGapIndex)
        float countGapEnd = array.get(cachedSourceDailyGapEnds, countGapIndex)
        float countGapHigh = array.get(cachedSourceDailyGapHighs, countGapIndex)
        float countGapLow = array.get(cachedSourceDailyGapLows, countGapIndex)
        if na(firstValidSourceGapStart) and f_validSourcePrice(countGapStart) and f_validSourcePrice(countGapEnd)
            firstValidSourceGapStart := countGapStart
            firstValidSourceGapEnd := countGapEnd
            firstValidSourceGapHigh := countGapHigh
            firstValidSourceGapLow := countGapLow

chartDailyOpenForConvertedLevels = f_validSourcePrice(autoDailyOpen) ? autoDailyOpen : f_validSourcePrice(effectiveDailyOpen) ? effectiveDailyOpen : na
convertedLevelStatus = not sourceLevelsEnabled ? "disabled" : inScalpRTHSession and not sourceSessionCacheCurrent ? "source cache missing" : not sourceSessionCacheReady ? "waiting for RTH cache" : not f_validSourcePrice(sourceDayOpen) ? "no source daily open" : not swingCurrentPriceRatioReady ? "conversion ratio missing" : "ready"

f_convertSourceLevelToChart(_sourcePrice) =>
    f_validSourcePrice(_sourcePrice) and f_validSourcePrice(currentConversionRatio) ? f_roundToScalpTick(_sourcePrice * currentConversionRatio) : na

f_convertSourceLevelToChartForDisplay(_sourcePrice) =>
    float convertedDisplayPrice = f_validSourcePrice(_sourcePrice) and f_validSourcePrice(currentConversionRatio) ? _sourcePrice * currentConversionRatio : na
    f_validSourcePrice(convertedDisplayPrice) ? f_roundToScalpTick(convertedDisplayPrice) : na

f_addSwingDisplayConvertedLevel(_displayPrice, _label, _lineColor, _lineWidth, _lineStyle) =>
    if f_validSourcePrice(_displayPrice)
        array.push(swingDisplayLevelPrices, _displayPrice)
        array.push(swingDisplayLevelLabels, _label)
        array.push(swingDisplayLevelColors, _lineColor)
        array.push(swingDisplayLevelWidths, _lineWidth)
        array.push(swingDisplayLevelStyles, _lineStyle)

f_addSwingLevelWithCloseBeyond(_price, _name, _priority, _entryAllowed, _targetAllowed, _closeBeyondRequired) =>
    if f_validSourcePrice(_price)
        array.push(swingLevelPrices, _price)
        array.push(swingLevelNames, _name)
        array.push(swingLevelPriority, _priority)
        array.push(swingLevelAllowedForEntry, _entryAllowed)
        array.push(swingLevelAllowedForTarget, _targetAllowed)
        array.push(swingLevelCloseBeyondRequired, _closeBeyondRequired)

f_addSwingLevel(_price, _name, _priority, _entryAllowed, _targetAllowed) =>
    f_addSwingLevelWithCloseBeyond(_price, _name, _priority, _entryAllowed, _targetAllowed, _entryAllowed)

f_addSwingDisplayLevel(_sourcePrice, _label, _lineColor, _lineWidth, _lineStyle) =>
    float displayPrice = f_convertSourceLevelToChartForDisplay(_sourcePrice)
    f_addSwingDisplayConvertedLevel(displayPrice, _label, _lineColor, _lineWidth, _lineStyle)

f_addSwingDisplayConvertedGapBox(_displayHigh, _displayLow) =>
    if f_validSourcePrice(_displayHigh) and f_validSourcePrice(_displayLow)
        array.push(swingDisplayGapBoxTops, math.max(_displayHigh, _displayLow))
        array.push(swingDisplayGapBoxBottoms, math.min(_displayHigh, _displayLow))

f_addSwingDisplayGapBox(_sourceHigh, _sourceLow) =>
    float displayHigh = f_convertSourceLevelToChartForDisplay(_sourceHigh)
    float displayLow = f_convertSourceLevelToChartForDisplay(_sourceLow)
    f_addSwingDisplayConvertedGapBox(displayHigh, displayLow)

f_lineStyleFromCode(_styleCode) =>
    _styleCode == 1 ? line.style_dashed : _styleCode == 2 ? line.style_dotted : line.style_solid

f_trimSwingLevelDrawings(_lineCount, _labelCount) =>
    while array.size(swingLevelLines) > _lineCount
        line staleLine = array.pop(swingLevelLines)
        line.delete(staleLine)
    while array.size(swingLevelLabels) > _labelCount
        label staleLabel = array.pop(swingLevelLabels)
        label.delete(staleLabel)

f_trimSwingGapBoxes(_boxCount) =>
    while array.size(swingDailyGapBoxes) > _boxCount
        box staleBox = array.pop(swingDailyGapBoxes)
        box.delete(staleBox)

array.clear(swingLevelPrices)
array.clear(swingLevelNames)
array.clear(swingLevelPriority)
array.clear(swingLevelAllowedForEntry)
array.clear(swingLevelAllowedForTarget)
array.clear(swingLevelCloseBeyondRequired)
array.clear(swingDisplayLevelPrices)
array.clear(swingDisplayLevelLabels)
array.clear(swingDisplayLevelColors)
array.clear(swingDisplayLevelWidths)
array.clear(swingDisplayLevelStyles)
array.clear(swingDisplayGapBoxTops)
array.clear(swingDisplayGapBoxBottoms)

int displayedDailyGapCount = 0
int dailyGapConvertedSuccessCount = 0
int swingDailyGapLevelsAdded = 0
float firstValidConvertedGapStart = na
float firstValidConvertedGapEnd = na
float firstValidConvertedGapHigh = na
float firstValidConvertedGapLow = na
string dailyGapUnavailableReason = "N/A"

if sourceDailyGapCount > 0
    for convertGapIndex = 0 to sourceDailyGapCount - 1
        float convertedGapStartForCount = f_convertSourceLevelToChartForDisplay(array.get(cachedSourceDailyGapStarts, convertGapIndex))
        float convertedGapEndForCount = f_convertSourceLevelToChartForDisplay(array.get(cachedSourceDailyGapEnds, convertGapIndex))
        float convertedGapHighForCount = f_convertSourceLevelToChartForDisplay(array.get(cachedSourceDailyGapHighs, convertGapIndex))
        float convertedGapLowForCount = f_convertSourceLevelToChartForDisplay(array.get(cachedSourceDailyGapLows, convertGapIndex))
        bool dailyGapConvertedValid = f_validSourcePrice(convertedGapStartForCount) and f_validSourcePrice(convertedGapEndForCount) and f_validSourcePrice(convertedGapHighForCount) and f_validSourcePrice(convertedGapLowForCount)
        if dailyGapConvertedValid
            dailyGapConvertedSuccessCount += 1
            if na(firstValidConvertedGapStart)
                firstValidConvertedGapStart := convertedGapStartForCount
                firstValidConvertedGapEnd := convertedGapEndForCount
                firstValidConvertedGapHigh := convertedGapHighForCount
                firstValidConvertedGapLow := convertedGapLowForCount

if sourceLevelsEnabled
    // Converted trade calculations use the level arrays below. These keep the
    // current price ratio so scalp logic stays on converted SPY/QQQ levels.
    if convertedHtfTradeLevelsEnabled
        if useExpandedScalpLevels
            f_addSwingLevelWithCloseBeyond(f_convertSourceLevelToChart(sourcePrevMonthHigh), "Previous Month High", 0, false, true, true)
            f_addSwingLevelWithCloseBeyond(f_convertSourceLevelToChart(sourcePrevMonthLow), "Previous Month Low", 0, false, true, true)
            f_addSwingLevelWithCloseBeyond(f_convertSourceLevelToChart(sourceMonthOpen), "Current Month Open", 0, false, true, true)
            f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevWeekHigh), "Previous Week High", 1, true, true)
            f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevWeekLow), "Previous Week Low", 1, true, true)
            f_addSwingLevelWithCloseBeyond(f_convertSourceLevelToChart(sourceWeekOpen), "Current Week Open", 2, allowWeeklyOpenAsEntry, true, true)
        if usePrevDayHighLevel
            f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevDayHigh), "Previous Day High", 4, true, true)
        if usePrevDayLowLevel
            f_addSwingLevel(f_convertSourceLevelToChart(sourcePrevDayLow), "Previous Day Low", 4, true, true)
        if useDailyOpenLevel
            f_addSwingLevelWithCloseBeyond(f_convertSourceLevelToChart(sourceDayOpen), "Current Day Open", 6, false, true, true)
        if includeDailyGapsInConvertedLevels and sourceDailyGapCount > 0
            // Convert cached source gap boundaries to chart prices, then add the
            // daily gap end as entry/target eligible and the start as target only.
            for sourceGapIndex = 0 to sourceDailyGapCount - 1
                float convertedGapEnd = f_convertSourceLevelToChart(array.get(cachedSourceDailyGapEnds, sourceGapIndex))
                float convertedGapStart = f_convertSourceLevelToChart(array.get(cachedSourceDailyGapStarts, sourceGapIndex))
                if f_validSourcePrice(convertedGapEnd)
                    f_addSwingLevelWithCloseBeyond(convertedGapEnd, "Daily Gap End", 5, true, true, true)
                    swingDailyGapLevelsAdded += 1
                if f_validSourcePrice(convertedGapStart)
                    f_addSwingLevelWithCloseBeyond(convertedGapStart, "Daily Gap Start", 0, false, true, true)
                    swingDailyGapLevelsAdded += 1
    if showSwingLevels
        // Displayed converted lines are live reference levels. Their current price
        // ratio updates only after confirmed New York RTH closes; they are
        // not intended to behave like historical series plots.
        f_addSwingDisplayLevel(sourcePrevMonthHigh, "PMoH", paEngineHighLevelColor, 4, 1)
        f_addSwingDisplayLevel(sourcePrevMonthLow, "PMoL", paEngineLowLevelColor, 4, 1)
        f_addSwingDisplayLevel(sourceMonthOpen, "MO", paEngineOpenLevelColor, 5, 1)
        f_addSwingDisplayLevel(sourcePrevWeekHigh, "PWH", paEngineHighLevelColor, 3, 0)
        f_addSwingDisplayLevel(sourcePrevWeekLow, "PWL", paEngineLowLevelColor, 3, 0)
        f_addSwingDisplayLevel(sourceWeekOpen, "WO", paEngineOpenLevelColor, 3, 0)
        f_addSwingDisplayLevel(sourcePrevDayHigh, "PDH", paEngineHighLevelColor, 1, 0)
        f_addSwingDisplayLevel(sourcePrevDayLow, "PDL", paEngineLowLevelColor, 1, 0)
        f_addSwingDisplayLevel(sourceDayOpen, "DO", paEngineOpenLevelColor, 1, 0)
        int displayedGapCount = 0
        if maxDisplayedDailyGaps > 0 and sourceDailyGapCount > 0
            // Draw converted gap lines and boxes from original SPY/QQQ gap
            // boundaries. Partial fills are only used inside getGaps() to
            // remove filled gaps, not to change displayed levels.
            for displayGapIndex = 0 to sourceDailyGapCount - 1
                if displayedGapCount >= maxDisplayedDailyGaps
                    break
                float sourceGapStartForDisplay = array.get(cachedSourceDailyGapStarts, displayGapIndex)
                float sourceGapEndForDisplay = array.get(cachedSourceDailyGapEnds, displayGapIndex)
                float sourceGapHighForDisplay = array.get(cachedSourceDailyGapHighs, displayGapIndex)
                float sourceGapLowForDisplay = array.get(cachedSourceDailyGapLows, displayGapIndex)
                float convertedGapStartForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapStartForDisplay)
                float convertedGapEndForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapEndForDisplay)
                float convertedGapHighForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapHighForDisplay)
                float convertedGapLowForDisplay = f_convertSourceLevelToChartForDisplay(sourceGapLowForDisplay)
                bool dailyGapDisplayValid = f_validSourcePrice(convertedGapStartForDisplay) and f_validSourcePrice(convertedGapEndForDisplay) and f_validSourcePrice(convertedGapHighForDisplay) and f_validSourcePrice(convertedGapLowForDisplay)
                if dailyGapDisplayValid
                    f_addSwingDisplayConvertedLevel(convertedGapStartForDisplay, "Gap Start", dailyGapLineColor, 2, 1)
                    f_addSwingDisplayConvertedLevel(convertedGapEndForDisplay, "Gap End", dailyGapLineColor, 2, 0)
                    f_addSwingDisplayConvertedGapBox(convertedGapHighForDisplay, convertedGapLowForDisplay)
                    if na(firstValidConvertedGapStart)
                        firstValidConvertedGapStart := convertedGapStartForDisplay
                        firstValidConvertedGapEnd := convertedGapEndForDisplay
                    displayedGapCount += 1
                    displayedDailyGapCount := displayedGapCount

if not dailyGapRequestEnabled
    dailyGapUnavailableReason := "daily gaps disabled"
else if inScalpRTHSession and not dailyGapUsingCurrentSessionCache
    dailyGapUnavailableReason := "session cache missing"
else if not inScalpRTHSession
    dailyGapUnavailableReason := "waiting for RTH cache"
else if sourceDailyGapCount == 0
    if requestedSourceDailyGapCount == 0
        dailyGapUnavailableReason := "session request returned 0"
    else if lastFreshRequestedSourceDailyGapCount == 0
        dailyGapUnavailableReason := "last session request returned 0"
    else if sourceDailyGapParseFailCount > 0
        dailyGapUnavailableReason := "raw record parse failed"
    else if sourceDailyGapInvalidPriceCount > 0
        dailyGapUnavailableReason := "source price invalid"
    else
        dailyGapUnavailableReason := "cache empty"
else if not swingCurrentPriceRatioReady
    dailyGapUnavailableReason := "conversion ratio missing"
else if dailyGapConvertedSuccessCount == 0
    dailyGapUnavailableReason := "conversion failed"
else if maxDisplayedDailyGaps <= 0
    dailyGapUnavailableReason := "maxDisplayedDailyGaps = 0"
else if not showSwingLevels
    dailyGapUnavailableReason := "converted level display disabled"
else if displayedDailyGapCount == 0
    dailyGapUnavailableReason := "displayed count 0"
else if displayedDailyGapCount < dailyGapConvertedSuccessCount
    dailyGapUnavailableReason := "ready; display capped"
else
    dailyGapUnavailableReason := "ready"

if barstate.isconfirmed or barstate.islast
    int desiredSwingLineCount = showSwingLevels ? array.size(swingDisplayLevelPrices) : 0
    int desiredSwingLabelCount = showSwingLevels and showSwingLevelLabels ? desiredSwingLineCount : 0
    int desiredSwingGapBoxCount = showSwingLevels ? array.size(swingDisplayGapBoxTops) : 0
    int swingLineStartBar = not na(currentRTHStartBar) ? math.max(currentRTHStartBar, bar_index - 9999) : bar_index
    f_trimSwingLevelDrawings(desiredSwingLineCount, desiredSwingLabelCount)
    f_trimSwingGapBoxes(desiredSwingGapBoxCount)
    if desiredSwingGapBoxCount > 0
        for swingGapBoxIndex = 0 to desiredSwingGapBoxCount - 1
            float gapBoxTop = array.get(swingDisplayGapBoxTops, swingGapBoxIndex)
            float gapBoxBottom = array.get(swingDisplayGapBoxBottoms, swingGapBoxIndex)
            box swingDailyGapBox = na
            if array.size(swingDailyGapBoxes) <= swingGapBoxIndex
                swingDailyGapBox := box.new(
                     swingLineStartBar,
                     gapBoxTop,
                     bar_index + 1,
                     gapBoxBottom,
                     xloc=xloc.bar_index,
                     extend=extend.right,
                     border_color=dailyGapBorderColor,
                     border_width=0,
                     bgcolor=dailyGapBoxColor
                )
                array.push(swingDailyGapBoxes, swingDailyGapBox)
            else
                swingDailyGapBox := array.get(swingDailyGapBoxes, swingGapBoxIndex)
            box.set_left(swingDailyGapBox, swingLineStartBar)
            box.set_top(swingDailyGapBox, gapBoxTop)
            box.set_right(swingDailyGapBox, bar_index + 1)
            box.set_bottom(swingDailyGapBox, gapBoxBottom)
            box.set_extend(swingDailyGapBox, extend.right)
            box.set_bgcolor(swingDailyGapBox, dailyGapBoxColor)
            box.set_border_color(swingDailyGapBox, dailyGapBorderColor)
            box.set_border_width(swingDailyGapBox, 0)
    if desiredSwingLineCount > 0
        for swingDisplayIndex = 0 to desiredSwingLineCount - 1
            float swingDisplayPrice = array.get(swingDisplayLevelPrices, swingDisplayIndex)
            color swingDisplayColor = array.get(swingDisplayLevelColors, swingDisplayIndex)
            string swingDisplayLabel = array.get(swingDisplayLevelLabels, swingDisplayIndex)
            int swingDisplayLineStyle = array.get(swingDisplayLevelStyles, swingDisplayIndex)
            int swingDisplayLineWidth = array.get(swingDisplayLevelWidths, swingDisplayIndex)
            line swingDisplayLine = na
            if array.size(swingLevelLines) <= swingDisplayIndex
                swingDisplayLine := line.new(
                     swingLineStartBar,
                     swingDisplayPrice,
                     bar_index + 1,
                     swingDisplayPrice,
                     xloc=xloc.bar_index,
                     extend=extend.right,
                     color=swingDisplayColor,
                     style=f_lineStyleFromCode(swingDisplayLineStyle),
                     width=swingDisplayLineWidth
                )
                array.push(swingLevelLines, swingDisplayLine)
            else
                swingDisplayLine := array.get(swingLevelLines, swingDisplayIndex)
            line.set_x1(swingDisplayLine, swingLineStartBar)
            line.set_y1(swingDisplayLine, swingDisplayPrice)
            line.set_x2(swingDisplayLine, bar_index + 1)
            line.set_y2(swingDisplayLine, swingDisplayPrice)
            line.set_extend(swingDisplayLine, extend.right)
            line.set_color(swingDisplayLine, swingDisplayColor)
            line.set_style(swingDisplayLine, f_lineStyleFromCode(swingDisplayLineStyle))
            line.set_width(swingDisplayLine, swingDisplayLineWidth)
            if showSwingLevelLabels
                label swingDisplayNameLabel = na
                if array.size(swingLevelLabels) <= swingDisplayIndex
                    swingDisplayNameLabel := label.new(
                         bar_index + 1,
                         swingDisplayPrice,
                         swingDisplayLabel,
                         xloc=xloc.bar_index,
                         style=label.style_label_left,
                         textcolor=swingDisplayColor,
                         color=color.new(color.black, 100),
                         size=size.tiny
                    )
                    array.push(swingLevelLabels, swingDisplayNameLabel)
                else
                    swingDisplayNameLabel := array.get(swingLevelLabels, swingDisplayIndex)
                label.set_x(swingDisplayNameLabel, bar_index + 1)
                label.set_y(swingDisplayNameLabel, swingDisplayPrice)
                label.set_text(swingDisplayNameLabel, swingDisplayLabel)
                label.set_textcolor(swingDisplayNameLabel, swingDisplayColor)
                label.set_color(swingDisplayNameLabel, color.new(color.black, 100))
                label.set_style(swingDisplayNameLabel, label.style_label_left)
                label.set_size(swingDisplayNameLabel, size.tiny)

var float autoOpeningRangeHigh = na
var float autoOpeningRangeLow = na
var bool openingRangeComplete = false
var bool openingRangeOutsideCloseSeen = false

if newScalpRTHSession
    autoOpeningRangeHigh := na
    autoOpeningRangeLow := na
    openingRangeComplete := false
    openingRangeOutsideCloseSeen := false

if inOpeningRangeWindow
    autoOpeningRangeHigh := na(autoOpeningRangeHigh) ? high : math.max(autoOpeningRangeHigh, high)
    autoOpeningRangeLow := na(autoOpeningRangeLow) ? low : math.min(autoOpeningRangeLow, low)

if inScalpRTHSession and not inOpeningRangeWindow and not openingRangeComplete and not na(autoOpeningRangeHigh) and not na(autoOpeningRangeLow)
    openingRangeComplete := true

openingRangeHigh = useManualOpeningRangeFallback and manualOpeningRangeHigh > 0 ? manualOpeningRangeHigh : autoOpeningRangeHigh
openingRangeLow = useManualOpeningRangeFallback and manualOpeningRangeLow > 0 ? manualOpeningRangeLow : autoOpeningRangeLow
openingRangeReady = not na(openingRangeHigh) and not na(openingRangeLow)
openingRangeWindowElapsed = inScalpRTHSession and not inOpeningRangeWindow
openingRangeLevelsReady = openingRangeReady and (openingRangeComplete or (useManualOpeningRangeFallback and openingRangeWindowElapsed))
openingRangeDisplayHigh = inScalpRTHSession and openingRangeLevelsReady ? openingRangeHigh : na
openingRangeDisplayLow = inScalpRTHSession and openingRangeLevelsReady ? openingRangeLow : na

if openingRangeLevelsReady and barstate.isconfirmed and inScalpRTHSession and not inOpeningRangeWindow and (close > openingRangeHigh or close < openingRangeLow)
    openingRangeOutsideCloseSeen := true

longOrlReclaim = openingRangeLevelsReady and low <= openingRangeLow and close > openingRangeLow
shortOrhReclaim = openingRangeLevelsReady and high >= openingRangeHigh and close < openingRangeHigh
longOrhBreakout = openingRangeLevelsReady and close > openingRangeHigh
shortOrlBreakdown = openingRangeLevelsReady and close < openingRangeLow
openingRangeStatus = not openingRangeLevelsReady ? "Waiting" : "Complete"

// ===================== Untested 5m Swing Target Tracking =====================
int activeCurrentRTHDateKey = inScalpRTHSession ? currentRTHDateKey : na
int activePreviousRTHDateKey = inScalpRTHSession ? previousRTHDateKey : currentRTHDateKey

if newPremarketSession or newScalpRTHSession
    int pruneHighIndex = array.size(swingHighPrices) - 1
    while pruneHighIndex >= 0
        string highSwingSession = array.get(swingHighSessions, pruneHighIndex)
        int highSwingDateKey = array.get(swingHighDateKeys, pruneHighIndex)
        bool keepHighSwing = f_swingTargetSessionAllowed(highSwingSession, highSwingDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepHighSwing
            array.remove(swingHighPrices, pruneHighIndex)
            array.remove(swingHighPivotBars, pruneHighIndex)
            array.remove(swingHighDateKeys, pruneHighIndex)
            array.remove(swingHighSessions, pruneHighIndex)
            array.remove(swingHighActive, pruneHighIndex)
        pruneHighIndex -= 1

    int pruneLowIndex = array.size(swingLowPrices) - 1
    while pruneLowIndex >= 0
        string lowSwingSession = array.get(swingLowSessions, pruneLowIndex)
        int lowSwingDateKey = array.get(swingLowDateKeys, pruneLowIndex)
        bool keepLowSwing = f_swingTargetSessionAllowed(lowSwingSession, lowSwingDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepLowSwing
            array.remove(swingLowPrices, pruneLowIndex)
            array.remove(swingLowPivotBars, pruneLowIndex)
            array.remove(swingLowDateKeys, pruneLowIndex)
            array.remove(swingLowSessions, pruneLowIndex)
            array.remove(swingLowActive, pruneLowIndex)
        pruneLowIndex -= 1

    int pruneFboHighIndex = array.size(fboSwingHighPrices) - 1
    while pruneFboHighIndex >= 0
        string highFboSession = array.get(fboSwingHighSessions, pruneFboHighIndex)
        int highFboDateKey = array.get(fboSwingHighDateKeys, pruneFboHighIndex)
        bool keepHighFbo = f_swingTargetSessionAllowed(highFboSession, highFboDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepHighFbo
            array.remove(fboSwingHighPrices, pruneFboHighIndex)
            array.remove(fboSwingHighPivotBars, pruneFboHighIndex)
            array.remove(fboSwingHighDateKeys, pruneFboHighIndex)
            array.remove(fboSwingHighSessions, pruneFboHighIndex)
            array.remove(fboSwingHighCleared, pruneFboHighIndex)
        pruneFboHighIndex -= 1

    int pruneFboLowIndex = array.size(fboSwingLowPrices) - 1
    while pruneFboLowIndex >= 0
        string lowFboSession = array.get(fboSwingLowSessions, pruneFboLowIndex)
        int lowFboDateKey = array.get(fboSwingLowDateKeys, pruneFboLowIndex)
        bool keepLowFbo = f_swingTargetSessionAllowed(lowFboSession, lowFboDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if not keepLowFbo
            array.remove(fboSwingLowPrices, pruneFboLowIndex)
            array.remove(fboSwingLowPivotBars, pruneFboLowIndex)
            array.remove(fboSwingLowDateKeys, pruneFboLowIndex)
            array.remove(fboSwingLowSessions, pruneFboLowIndex)
            array.remove(fboSwingLowCleared, pruneFboLowIndex)
        pruneFboLowIndex -= 1

if barstate.isconfirmed
    int testHighIndex = 0
    while testHighIndex < array.size(swingHighPrices)
        string highSwingSession = array.get(swingHighSessions, testHighIndex)
        int highSwingDateKey = array.get(swingHighDateKeys, testHighIndex)
        bool canInvalidateHighSwing = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, highSwingSession, highSwingDateKey, currentRTHDateKey)
        if canInvalidateHighSwing and array.get(swingHighActive, testHighIndex) and bar_index > array.get(swingHighPivotBars, testHighIndex) and high >= array.get(swingHighPrices, testHighIndex)
            array.set(swingHighActive, testHighIndex, false)
        testHighIndex += 1

    int testLowIndex = 0
    while testLowIndex < array.size(swingLowPrices)
        string lowSwingSession = array.get(swingLowSessions, testLowIndex)
        int lowSwingDateKey = array.get(swingLowDateKeys, testLowIndex)
        bool canInvalidateLowSwing = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, lowSwingSession, lowSwingDateKey, currentRTHDateKey)
        if canInvalidateLowSwing and array.get(swingLowActive, testLowIndex) and bar_index > array.get(swingLowPivotBars, testLowIndex) and low <= array.get(swingLowPrices, testLowIndex)
            array.set(swingLowActive, testLowIndex, false)
        testLowIndex += 1

    int clearFboHighIndex = 0
    while clearFboHighIndex < array.size(fboSwingHighPrices)
        string highFboSession = array.get(fboSwingHighSessions, clearFboHighIndex)
        int highFboDateKey = array.get(fboSwingHighDateKeys, clearFboHighIndex)
        bool canClearHighFbo = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, highFboSession, highFboDateKey, currentRTHDateKey)
        if canClearHighFbo and not array.get(fboSwingHighCleared, clearFboHighIndex) and bar_index > array.get(fboSwingHighPivotBars, clearFboHighIndex) and low > array.get(fboSwingHighPrices, clearFboHighIndex)
            array.set(fboSwingHighCleared, clearFboHighIndex, true)
        clearFboHighIndex += 1

    int clearFboLowIndex = 0
    while clearFboLowIndex < array.size(fboSwingLowPrices)
        string lowFboSession = array.get(fboSwingLowSessions, clearFboLowIndex)
        int lowFboDateKey = array.get(fboSwingLowDateKeys, clearFboLowIndex)
        bool canClearLowFbo = f_swingBreakCanInvalidate(allowRthSwingsBrokenPremarket, inPremarketSession, lowFboSession, lowFboDateKey, currentRTHDateKey)
        if canClearLowFbo and not array.get(fboSwingLowCleared, clearFboLowIndex) and bar_index > array.get(fboSwingLowPivotBars, clearFboLowIndex) and high < array.get(fboSwingLowPrices, clearFboLowIndex)
            array.set(fboSwingLowCleared, clearFboLowIndex, true)
        clearFboLowIndex += 1

if barstate.isconfirmed
    if allowRthSwingsBrokenPremarket
        if newPremarketSession
            array.clear(pmSwingHistHighs)
            array.clear(pmSwingHistLows)
            array.clear(pmSwingHistBarIndexes)
            array.clear(pmSwingHistDateKeys)

        if inPremarketSession
            array.push(pmSwingHistHighs, high)
            array.push(pmSwingHistLows, low)
            array.push(pmSwingHistBarIndexes, bar_index)
            array.push(pmSwingHistDateKeys, nySessionDateKey)
            while array.size(pmSwingHistHighs) > 200
                array.shift(pmSwingHistHighs)
                array.shift(pmSwingHistLows)
                array.shift(pmSwingHistBarIndexes)
                array.shift(pmSwingHistDateKeys)

            int pmHistorySize = array.size(pmSwingHistHighs)
            if pmHistorySize >= 5
                int pmPivotIndex = pmHistorySize - 3
                float pmPivotHigh = array.get(pmSwingHistHighs, pmPivotIndex)
                float pmPivotLow = array.get(pmSwingHistLows, pmPivotIndex)
                int pmPivotBar = array.get(pmSwingHistBarIndexes, pmPivotIndex)
                int pmPivotDateKey = array.get(pmSwingHistDateKeys, pmPivotIndex)
                bool confirmedPmSwingHigh = pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex - 1) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex - 2) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex + 1) and pmPivotHigh > array.get(pmSwingHistHighs, pmPivotIndex + 2)
                bool confirmedPmSwingLow = pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex - 1) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex - 2) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex + 1) and pmPivotLow < array.get(pmSwingHistLows, pmPivotIndex + 2)

                if confirmedPmSwingHigh
                    if not f_hasPivotBar(swingHighPivotBars, pmPivotBar)
                        array.push(swingHighPrices, pmPivotHigh)
                        array.push(swingHighPivotBars, pmPivotBar)
                        array.push(swingHighDateKeys, pmPivotDateKey)
                        array.push(swingHighSessions, "PM")
                        array.push(swingHighActive, true)
                    if not f_hasPivotBar(fboSwingHighPivotBars, pmPivotBar)
                        array.push(fboSwingHighPrices, pmPivotHigh)
                        array.push(fboSwingHighPivotBars, pmPivotBar)
                        array.push(fboSwingHighDateKeys, pmPivotDateKey)
                        array.push(fboSwingHighSessions, "PM")
                        array.push(fboSwingHighCleared, false)

                if confirmedPmSwingLow
                    if not f_hasPivotBar(swingLowPivotBars, pmPivotBar)
                        array.push(swingLowPrices, pmPivotLow)
                        array.push(swingLowPivotBars, pmPivotBar)
                        array.push(swingLowDateKeys, pmPivotDateKey)
                        array.push(swingLowSessions, "PM")
                        array.push(swingLowActive, true)
                    if not f_hasPivotBar(fboSwingLowPivotBars, pmPivotBar)
                        array.push(fboSwingLowPrices, pmPivotLow)
                        array.push(fboSwingLowPivotBars, pmPivotBar)
                        array.push(fboSwingLowDateKeys, pmPivotDateKey)
                        array.push(fboSwingLowSessions, "PM")
                        array.push(fboSwingLowCleared, false)

        if inScalpRTHSession
            // Keep prior RTH bars so the first/second current-session RTH bars can confirm with RTH-only left bars.
            array.push(rthSwingHistHighs, high)
            array.push(rthSwingHistLows, low)
            array.push(rthSwingHistBarIndexes, bar_index)
            array.push(rthSwingHistDateKeys, nySessionDateKey)
            while array.size(rthSwingHistHighs) > 200
                array.shift(rthSwingHistHighs)
                array.shift(rthSwingHistLows)
                array.shift(rthSwingHistBarIndexes)
                array.shift(rthSwingHistDateKeys)

            int rthHistorySize = array.size(rthSwingHistHighs)
            if rthHistorySize >= 5
                int rthPivotIndex = rthHistorySize - 3
                float rthPivotHigh = array.get(rthSwingHistHighs, rthPivotIndex)
                float rthPivotLow = array.get(rthSwingHistLows, rthPivotIndex)
                int rthPivotBar = array.get(rthSwingHistBarIndexes, rthPivotIndex)
                int rthPivotDateKey = array.get(rthSwingHistDateKeys, rthPivotIndex)
                bool confirmedRthSwingHigh = rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex - 1) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex - 2) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex + 1) and rthPivotHigh > array.get(rthSwingHistHighs, rthPivotIndex + 2)
                bool confirmedRthSwingLow = rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex - 1) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex - 2) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex + 1) and rthPivotLow < array.get(rthSwingHistLows, rthPivotIndex + 2)

                if confirmedRthSwingHigh
                    if not f_hasPivotBar(swingHighPivotBars, rthPivotBar)
                        array.push(swingHighPrices, rthPivotHigh)
                        array.push(swingHighPivotBars, rthPivotBar)
                        array.push(swingHighDateKeys, rthPivotDateKey)
                        array.push(swingHighSessions, "RTH")
                        array.push(swingHighActive, true)
                    if not f_hasPivotBar(fboSwingHighPivotBars, rthPivotBar)
                        array.push(fboSwingHighPrices, rthPivotHigh)
                        array.push(fboSwingHighPivotBars, rthPivotBar)
                        array.push(fboSwingHighDateKeys, rthPivotDateKey)
                        array.push(fboSwingHighSessions, "RTH")
                        array.push(fboSwingHighCleared, false)

                if confirmedRthSwingLow
                    if not f_hasPivotBar(swingLowPivotBars, rthPivotBar)
                        array.push(swingLowPrices, rthPivotLow)
                        array.push(swingLowPivotBars, rthPivotBar)
                        array.push(swingLowDateKeys, rthPivotDateKey)
                        array.push(swingLowSessions, "RTH")
                        array.push(swingLowActive, true)
                    if not f_hasPivotBar(fboSwingLowPivotBars, rthPivotBar)
                        array.push(fboSwingLowPrices, rthPivotLow)
                        array.push(fboSwingLowPivotBars, rthPivotBar)
                        array.push(fboSwingLowDateKeys, rthPivotDateKey)
                        array.push(fboSwingLowSessions, "RTH")
                        array.push(fboSwingLowCleared, false)

    else if bar_index >= 4
        bool confirmedSwingHigh = high[2] > high[1] and high[2] > high and high[2] > high[3] and high[2] > high[4]
        bool confirmedSwingLow = low[2] < low[1] and low[2] < low and low[2] < low[3] and low[2] < low[4]
        string pivotSession = inPremarketSession[2] ? "PM" : inScalpRTHSession[2] ? "RTH" : "N/A"
        int pivotDateKey = nySessionDateKey[2]
        bool pivotSessionAllowed = pivotSession == "PM" or pivotSession == "RTH"

        if pivotSessionAllowed and confirmedSwingHigh
            array.push(swingHighPrices, high[2])
            array.push(swingHighPivotBars, bar_index - 2)
            array.push(swingHighDateKeys, pivotDateKey)
            array.push(swingHighSessions, pivotSession)
            array.push(swingHighActive, true)
            array.push(fboSwingHighPrices, high[2])
            array.push(fboSwingHighPivotBars, bar_index - 2)
            array.push(fboSwingHighDateKeys, pivotDateKey)
            array.push(fboSwingHighSessions, pivotSession)
            array.push(fboSwingHighCleared, false)

        if pivotSessionAllowed and confirmedSwingLow
            array.push(swingLowPrices, low[2])
            array.push(swingLowPivotBars, bar_index - 2)
            array.push(swingLowDateKeys, pivotDateKey)
            array.push(swingLowSessions, pivotSession)
            array.push(swingLowActive, true)
            array.push(fboSwingLowPrices, low[2])
            array.push(fboSwingLowPivotBars, bar_index - 2)
            array.push(fboSwingLowDateKeys, pivotDateKey)
            array.push(fboSwingLowSessions, pivotSession)
            array.push(fboSwingLowCleared, false)

while array.size(swingHighPrices) > maxTrackedSwingTargets
    array.shift(swingHighPrices)
    array.shift(swingHighPivotBars)
    array.shift(swingHighDateKeys)
    array.shift(swingHighSessions)
    array.shift(swingHighActive)

while array.size(swingLowPrices) > maxTrackedSwingTargets
    array.shift(swingLowPrices)
    array.shift(swingLowPivotBars)
    array.shift(swingLowDateKeys)
    array.shift(swingLowSessions)
    array.shift(swingLowActive)

while array.size(fboSwingHighPrices) > maxTrackedSwingTargets
    array.shift(fboSwingHighPrices)
    array.shift(fboSwingHighPivotBars)
    array.shift(fboSwingHighDateKeys)
    array.shift(fboSwingHighSessions)
    array.shift(fboSwingHighCleared)

while array.size(fboSwingLowPrices) > maxTrackedSwingTargets
    array.shift(fboSwingLowPrices)
    array.shift(fboSwingLowPivotBars)
    array.shift(fboSwingLowDateKeys)
    array.shift(fboSwingLowSessions)
    array.shift(fboSwingLowCleared)

// ===================== Pre-computed Conditions =====================
sufficientVolumeAndVolatility = sufficientVolume and sufficientVolatility

// ===================== Pressure Signal Conditions =====================
pressureRange = f_safeRange(high, low)
closeUpperThird = f_closeInUpperThird(close, low, pressureRange)
closeLowerThird = f_closeInLowerThird(close, low, pressureRange)

isBodyThreshold = f_meetsPct(body, pressureRange, pressureBodyWickThreshold)
isMostlyBody = f_meetsPct(body, pressureRange, 0.5)
isLowerWickThreshold = f_meetsPct(lowerWick, pressureRange, pressureBodyWickThreshold)
isUpperWickThreshold = f_meetsPct(upperWick, pressureRange, pressureBodyWickThreshold)

bullBarQuality = closeUpperThird and (isBodyThreshold or isLowerWickThreshold)
bearBarQuality = closeLowerThird and (isBodyThreshold or isUpperWickThreshold)

[buyPressure, sellPressure] = f_dobruskyPressure()

pressureReady = not na(buyPressure) and not na(sellPressure) and not na(buyPressure[1]) and not na(sellPressure[1])
priorDominantlyBear = pressureReady and (sellPressure[1] > buyPressure[1])
priorDominantlyBull = pressureReady and (buyPressure[1] >= sellPressure[1])

bullPressureA = pressureReady and ((priorDominantlyBear and buyPressure > sellPressure[1]) or (priorDominantlyBull and buyPressure > buyPressure[1]))
bearPressureA = pressureReady and ((priorDominantlyBull and sellPressure > buyPressure[1]) or (priorDominantlyBear and sellPressure > sellPressure[1]))

[midDown, legDownLow, legDownHigh] = f_midPriorLegDown(maxLookback)
[midUp, legUpLow, legUpHigh] = f_midPriorLegUp(maxLookback)

bullFallbackB = not na(midDown) and close > midDown
bearFallbackB = not na(midUp) and close < midUp

bullPressurePass = (bullPressureA and not na(volume)) or (bullFallbackB and isBodyThreshold)
bearPressurePass = (bearPressureA and not na(volume)) or (bearFallbackB and isBodyThreshold)
isHighVolume = not na(volume) and volume > volume[1]

bullSameColorHighVolumeContinuation =
     isHighVolume and
     isMostlyBody and
     f_isBullBar(open, close) and
     f_isBullBar(open[1], close[1])

bearSameColorHighVolumeContinuation =
     isHighVolume and
     isMostlyBody and
     f_isBearBar(open, close) and
     f_isBearBar(open[1], close[1])

bullDirectionalPressureOk =
     bullPressurePass or bullSameColorHighVolumeContinuation

bearDirectionalPressureOk =
     bearPressurePass or bearSameColorHighVolumeContinuation

bullSignalBase = sufficientVolumeAndVolatility and bullBarQuality
bearSignalBase = sufficientVolumeAndVolatility and bearBarQuality

bullSignalHighVol = bullSignalBase and isHighVolume
bearSignalHighVol = bearSignalBase and isHighVolume

// ===================== Plotting =====================
plotBullSignal = showBullSignals and bullSignalHighVol
plotBearSignal = showBearSignals and bearSignalHighVol

// Confirmed signals close beyond the prior bar extreme and remain part of alert tier qualification.
bullSignalConfirmed = close > high[1]
bearSignalConfirmed = close < low[1]

// ===================== Alert Signal Tier Logic =====================
bullScalpSignalAllowed = bullSignalHighVol
bearScalpSignalAllowed = bearSignalHighVol

bullScalpSetupTier = bullScalpSignalAllowed and not bullSignalConfirmed
bullScalpIgnitionTier = bullScalpSignalAllowed and bullSignalConfirmed and not isMostlyBody
bullScalpStrongIgnitionTier = bullScalpSignalAllowed and bullSignalConfirmed and isMostlyBody
bearScalpSetupTier = bearScalpSignalAllowed and not bearSignalConfirmed
bearScalpIgnitionTier = bearScalpSignalAllowed and bearSignalConfirmed and not isMostlyBody
bearScalpStrongIgnitionTier = bearScalpSignalAllowed and bearSignalConfirmed and isMostlyBody

bullScalpTierAllowed = (alertSetupSignals and bullScalpSetupTier) or (alertIgnitionSignals and bullScalpIgnitionTier) or (alertStrongIgnitions and bullScalpStrongIgnitionTier)
bearScalpTierAllowed = (alertSetupSignals and bearScalpSetupTier) or (alertIgnitionSignals and bearScalpIgnitionTier) or (alertStrongIgnitions and bearScalpStrongIgnitionTier)

bullScalpSignalTierShort = (bullScalpStrongIgnitionTier or bullScalpIgnitionTier) ? "IGN" : bullScalpSetupTier ? "FBO" : "N/A"
bearScalpSignalTierShort = (bearScalpStrongIgnitionTier or bearScalpIgnitionTier) ? "IGN" : bearScalpSetupTier ? "FBO" : "N/A"
bullCompactSignalText = bullScalpSignalTierShort
bearCompactSignalText = bearScalpSignalTierShort

// ===================== Scalp Level Priority Logic =====================
scalpSignalHigh = high
scalpSignalLow = low
scalpSignalClose = close
scalpEntry50Raw = (scalpSignalHigh + scalpSignalLow) / 2.0
longEntry50 = f_roundDownToScalpTick(scalpEntry50Raw)
shortEntry50 = f_roundUpToScalpTick(scalpEntry50Raw)
useDirectHtfFallbackLevels = not useConvertedHtfLevelsForTradeLogic
useDirectTradePrevDayHighLevel = useDirectHtfFallbackLevels and usePrevDayHighLevel
useDirectTradePrevDayLowLevel = useDirectHtfFallbackLevels and usePrevDayLowLevel
useDirectTradeDailyOpenLevel = useDirectHtfFallbackLevels and useDailyOpenLevel
convertedDailyOpenForConfluence = convertedHtfTradeLevelsEnabled and useDailyOpenLevel ? f_convertSourceLevelToChart(sourceDayOpen) : na
convertedDailyOpenValid = useDailyOpenLevel and f_validSourcePrice(convertedDailyOpenForConfluence)
activeTradeDailyOpen = useDailyOpenLevel ? (useConvertedHtfLevelsForTradeLogic ? (convertedDailyOpenValid ? convertedDailyOpenForConfluence : na) : effectiveDailyOpen) : na
activeTradeDailyOpenValid = useDailyOpenLevel and f_validSourcePrice(activeTradeDailyOpen)
dailyOpenTouchedCurrent = f_levelTouched(activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh)
rangeAboveDailyOpen = barRange > 0 and dailyOpenTouchedCurrent ? math.max(scalpSignalHigh - activeTradeDailyOpen, 0.0) : na
rangeBelowDailyOpen = barRange > 0 and dailyOpenTouchedCurrent ? math.max(activeTradeDailyOpen - scalpSignalLow, 0.0) : na
rangeAboveDailyOpenPct = barRange > 0 and dailyOpenTouchedCurrent ? math.min(rangeAboveDailyOpen / barRange, 1.0) : na
rangeBelowDailyOpenPct = barRange > 0 and dailyOpenTouchedCurrent ? math.min(rangeBelowDailyOpen / barRange, 1.0) : na
longDailyOpenBodyAcceptancePassed = not requireDailyOpenBodyAcceptance or not dailyOpenTouchedCurrent or (barRange > 0 and not na(rangeAboveDailyOpenPct) and rangeAboveDailyOpenPct >= dailyOpenBodyAcceptancePct)
shortDailyOpenBodyAcceptancePassed = not requireDailyOpenBodyAcceptance or not dailyOpenTouchedCurrent or (barRange > 0 and not na(rangeBelowDailyOpenPct) and rangeBelowDailyOpenPct >= dailyOpenBodyAcceptancePct)
float noSelectedLevelPrice = na
string noSelectedLevelName = "N/A"
int noSelectedLevelPriority = 999
bool noSelectedLevelTouchedCurrent = false
bool noSelectedLevelFound = false

// ===================== Expanded Scalp Level / 5m Sweep Logic =====================
float longExpandedScalpLevelPrice = na
string longExpandedScalpLevelName = "N/A"
int longExpandedScalpLevelPriority = 999
bool longExpandedScalpLevelTouchedCurrent = false
bool longExpandedScalpLevelFound = false

float shortExpandedScalpLevelPrice = na
string shortExpandedScalpLevelName = "N/A"
int shortExpandedScalpLevelPriority = 999
bool shortExpandedScalpLevelTouchedCurrent = false
bool shortExpandedScalpLevelFound = false

priorBarBear = close[1] < open[1]
priorBarBull = close[1] > open[1]

if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
    for expandedEntryLevelIndex = 0 to array.size(swingLevelPrices) - 1
        float expandedEntryLevelPrice = array.get(swingLevelPrices, expandedEntryLevelIndex)
        string expandedEntryLevelName = array.get(swingLevelNames, expandedEntryLevelIndex)
        int expandedEntryLevelPriority = array.get(swingLevelPriority, expandedEntryLevelIndex)
        bool expandedEntryLevelAllowed = array.get(swingLevelAllowedForEntry, expandedEntryLevelIndex)
        bool expandedEntryLevelTouchedCurrent = f_levelTouched(expandedEntryLevelAllowed, expandedEntryLevelPrice, scalpSignalLow, scalpSignalHigh)
        bool expandedEntryLevelTouchedPriorForLong = f_levelTouchedByPriorBar(expandedEntryLevelAllowed, expandedEntryLevelPrice, low[1], high[1], priorBarBear)
        bool expandedEntryLevelTouchedPriorForShort = f_levelTouchedByPriorBar(expandedEntryLevelAllowed, expandedEntryLevelPrice, low[1], high[1], priorBarBull)
        bool longExpandedEntryLevelQualified = (expandedEntryLevelTouchedCurrent or expandedEntryLevelTouchedPriorForLong) and scalpSignalClose > expandedEntryLevelPrice
        bool shortExpandedEntryLevelQualified = (expandedEntryLevelTouchedCurrent or expandedEntryLevelTouchedPriorForShort) and scalpSignalClose < expandedEntryLevelPrice
        bool betterLongExpandedLevel = not longExpandedScalpLevelFound or expandedEntryLevelPriority < longExpandedScalpLevelPriority or (expandedEntryLevelPriority == longExpandedScalpLevelPriority and (na(longExpandedScalpLevelPrice) or expandedEntryLevelPrice > longExpandedScalpLevelPrice))
        bool betterShortExpandedLevel = not shortExpandedScalpLevelFound or expandedEntryLevelPriority < shortExpandedScalpLevelPriority or (expandedEntryLevelPriority == shortExpandedScalpLevelPriority and (na(shortExpandedScalpLevelPrice) or expandedEntryLevelPrice < shortExpandedScalpLevelPrice))
        if longExpandedEntryLevelQualified and betterLongExpandedLevel
            longExpandedScalpLevelPrice := expandedEntryLevelPrice
            longExpandedScalpLevelName := expandedEntryLevelName
            longExpandedScalpLevelPriority := expandedEntryLevelPriority
            longExpandedScalpLevelTouchedCurrent := expandedEntryLevelTouchedCurrent
            longExpandedScalpLevelFound := true
        if shortExpandedEntryLevelQualified and betterShortExpandedLevel
            shortExpandedScalpLevelPrice := expandedEntryLevelPrice
            shortExpandedScalpLevelName := expandedEntryLevelName
            shortExpandedScalpLevelPriority := expandedEntryLevelPriority
            shortExpandedScalpLevelTouchedCurrent := expandedEntryLevelTouchedCurrent
            shortExpandedScalpLevelFound := true

bool longScalpFboSweepQualified = false
float longScalpFboSweepPrice = na
if bullScalpSetupTier and array.size(fboSwingLowPrices) > 0
    for fboSwingLowIndex = 0 to array.size(fboSwingLowPrices) - 1
        float fboSwingLowPrice = array.get(fboSwingLowPrices, fboSwingLowIndex)
        bool fboSwingLowPrior = bar_index > array.get(fboSwingLowPivotBars, fboSwingLowIndex)
        string fboSwingLowSession = array.get(fboSwingLowSessions, fboSwingLowIndex)
        int fboSwingLowDateKey = array.get(fboSwingLowDateKeys, fboSwingLowIndex)
        bool fboSwingLowAllowed = f_swingTargetSessionAllowed(fboSwingLowSession, fboSwingLowDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        bool fboSwingLowQualified = fboSwingLowAllowed and not array.get(fboSwingLowCleared, fboSwingLowIndex) and fboSwingLowPrior and scalpSignalLow <= fboSwingLowPrice and scalpSignalClose > fboSwingLowPrice
        if fboSwingLowQualified and (na(longScalpFboSweepPrice) or fboSwingLowPrice < longScalpFboSweepPrice)
            longScalpFboSweepQualified := true
            longScalpFboSweepPrice := fboSwingLowPrice

bool shortScalpFboSweepQualified = false
float shortScalpFboSweepPrice = na
if bearScalpSetupTier and array.size(fboSwingHighPrices) > 0
    for fboSwingHighIndex = 0 to array.size(fboSwingHighPrices) - 1
        float fboSwingHighPrice = array.get(fboSwingHighPrices, fboSwingHighIndex)
        bool fboSwingHighPrior = bar_index > array.get(fboSwingHighPivotBars, fboSwingHighIndex)
        string fboSwingHighSession = array.get(fboSwingHighSessions, fboSwingHighIndex)
        int fboSwingHighDateKey = array.get(fboSwingHighDateKeys, fboSwingHighIndex)
        bool fboSwingHighAllowed = f_swingTargetSessionAllowed(fboSwingHighSession, fboSwingHighDateKey, nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        bool fboSwingHighQualified = fboSwingHighAllowed and not array.get(fboSwingHighCleared, fboSwingHighIndex) and fboSwingHighPrior and scalpSignalHigh >= fboSwingHighPrice and scalpSignalClose < fboSwingHighPrice
        if fboSwingHighQualified and (na(shortScalpFboSweepPrice) or fboSwingHighPrice > shortScalpFboSweepPrice)
            shortScalpFboSweepQualified := true
            shortScalpFboSweepPrice := fboSwingHighPrice

[longGroup1AfterPDHPrice, longGroup1AfterPDHName, longGroup1AfterPDHPriority, longGroup1AfterPDHCurrent, longGroup1AfterPDHFound] = f_pickLongQualifiedLevel(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, "PDH", 4, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longGroup1Price, longGroup1Name, longGroup1Priority, longGroup1Current, longGroup1Found] = f_pickLongQualifiedLevel(useDirectTradePrevDayLowLevel, effectivePrevDayLow, "PDL", 4, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, longGroup1AfterPDHPrice, longGroup1AfterPDHName, longGroup1AfterPDHPriority, longGroup1AfterPDHCurrent, longGroup1AfterPDHFound)
// Daily Open is target/confluence only, so it is intentionally disabled as a selectable entry.
[longGroup2Price, longGroup2Name, longGroup2Priority, longGroup2Current, longGroup2Found] = f_pickLongQualifiedLevel(false, effectiveDailyOpen, "OP", 6, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longGroup3AfterPMHPrice, longGroup3AfterPMHName, longGroup3AfterPMHPriority, longGroup3AfterPMHCurrent, longGroup3AfterPMHFound] = f_pickLongQualifiedLevel(usePremarketHighLevel, effectivePremarketHigh, "PMH", 7, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longGroup3Price, longGroup3Name, longGroup3Priority, longGroup3Current, longGroup3Found] = f_pickLongQualifiedLevel(usePremarketLowLevel, effectivePremarketLow, "PML", 7, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, longGroup3AfterPMHPrice, longGroup3AfterPMHName, longGroup3AfterPMHPriority, longGroup3AfterPMHCurrent, longGroup3AfterPMHFound)
[longGroup4AfterORHPrice, longGroup4AfterORHName, longGroup4AfterORHPriority, longGroup4AfterORHCurrent, longGroup4AfterORHFound] = f_pickLongQualifiedLevel(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "ORH", 8, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longGroup4Price, longGroup4Name, longGroup4Priority, longGroup4Current, longGroup4Found] = f_pickLongQualifiedLevel(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "ORL", 8, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBear, longGroup4AfterORHPrice, longGroup4AfterORHName, longGroup4AfterORHPriority, longGroup4AfterORHCurrent, longGroup4AfterORHFound)

[shortGroup1AfterPDHPrice, shortGroup1AfterPDHName, shortGroup1AfterPDHPriority, shortGroup1AfterPDHCurrent, shortGroup1AfterPDHFound] = f_pickShortQualifiedLevel(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, "PDH", 4, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortGroup1Price, shortGroup1Name, shortGroup1Priority, shortGroup1Current, shortGroup1Found] = f_pickShortQualifiedLevel(useDirectTradePrevDayLowLevel, effectivePrevDayLow, "PDL", 4, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, shortGroup1AfterPDHPrice, shortGroup1AfterPDHName, shortGroup1AfterPDHPriority, shortGroup1AfterPDHCurrent, shortGroup1AfterPDHFound)
[shortGroup2Price, shortGroup2Name, shortGroup2Priority, shortGroup2Current, shortGroup2Found] = f_pickShortQualifiedLevel(false, effectiveDailyOpen, "OP", 6, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortGroup3AfterPMHPrice, shortGroup3AfterPMHName, shortGroup3AfterPMHPriority, shortGroup3AfterPMHCurrent, shortGroup3AfterPMHFound] = f_pickShortQualifiedLevel(usePremarketHighLevel, effectivePremarketHigh, "PMH", 7, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortGroup3Price, shortGroup3Name, shortGroup3Priority, shortGroup3Current, shortGroup3Found] = f_pickShortQualifiedLevel(usePremarketLowLevel, effectivePremarketLow, "PML", 7, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, shortGroup3AfterPMHPrice, shortGroup3AfterPMHName, shortGroup3AfterPMHPriority, shortGroup3AfterPMHCurrent, shortGroup3AfterPMHFound)
[shortGroup4AfterORHPrice, shortGroup4AfterORHName, shortGroup4AfterORHPriority, shortGroup4AfterORHCurrent, shortGroup4AfterORHFound] = f_pickShortQualifiedLevel(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, "ORH", 8, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortGroup4Price, shortGroup4Name, shortGroup4Priority, shortGroup4Current, shortGroup4Found] = f_pickShortQualifiedLevel(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, "ORL", 8, scalpSignalLow, scalpSignalHigh, scalpSignalClose, low[1], high[1], priorBarBull, shortGroup4AfterORHPrice, shortGroup4AfterORHName, shortGroup4AfterORHPriority, shortGroup4AfterORHCurrent, shortGroup4AfterORHFound)

longDailyOpenConfluenceQualified = f_levelTouched(activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh) and scalpSignalClose > activeTradeDailyOpen
shortDailyOpenConfluenceQualified = f_levelTouched(activeTradeDailyOpenValid, activeTradeDailyOpen, scalpSignalLow, scalpSignalHigh) and scalpSignalClose < activeTradeDailyOpen
longDailyOpenAnyConfluenceQualified = longDailyOpenConfluenceQualified
shortDailyOpenAnyConfluenceQualified = shortDailyOpenConfluenceQualified

// ORH is valid by itself for longs, and ORL is valid by itself for shorts.
// Fading the opposite OR level is allowed only with another qualified entry/confluence level.
bool longOpeningRangeHighTouchedForSignal = f_levelTouched(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, low[1], high[1], priorBarBear)
bool longOpeningRangeLowTouchedForSignal = f_levelTouched(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, low[1], high[1], priorBarBear)
bool shortOpeningRangeHighTouchedForSignal = f_levelTouched(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, low[1], high[1], priorBarBull)
bool shortOpeningRangeLowTouchedForSignal = f_levelTouched(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh) or f_levelTouchedByPriorBar(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, low[1], high[1], priorBarBull)
bool longOpeningRangeHighQualified = longOpeningRangeHighTouchedForSignal and scalpSignalClose > openingRangeHigh
bool longOpeningRangeLowQualified = longOpeningRangeLowTouchedForSignal and scalpSignalClose > openingRangeLow
bool shortOpeningRangeHighQualified = shortOpeningRangeHighTouchedForSignal and scalpSignalClose < openingRangeHigh
bool shortOpeningRangeLowQualified = shortOpeningRangeLowTouchedForSignal and scalpSignalClose < openingRangeLow
bool longNonOpeningRangeEntryLevelQualified = longExpandedScalpLevelFound or longGroup1Found or longGroup3Found or longDailyOpenAnyConfluenceQualified
bool shortNonOpeningRangeEntryLevelQualified = shortExpandedScalpLevelFound or shortGroup1Found or shortGroup3Found or shortDailyOpenAnyConfluenceQualified
bool longOpeningRangeHighOnly = longOpeningRangeHighQualified and not longOpeningRangeLowQualified and not longNonOpeningRangeEntryLevelQualified
bool longOpeningRangeLowOnly = longOpeningRangeLowQualified and not longOpeningRangeHighQualified and not longNonOpeningRangeEntryLevelQualified
bool longOpeningRangeLowPlusAnotherLevel = longOpeningRangeLowQualified and (longOpeningRangeHighQualified or longNonOpeningRangeEntryLevelQualified)
bool shortOpeningRangeLowOnly = shortOpeningRangeLowQualified and not shortOpeningRangeHighQualified and not shortNonOpeningRangeEntryLevelQualified
bool shortOpeningRangeHighOnly = shortOpeningRangeHighQualified and not shortOpeningRangeLowQualified and not shortNonOpeningRangeEntryLevelQualified
bool shortOpeningRangeHighPlusAnotherLevel = shortOpeningRangeHighQualified and (shortOpeningRangeLowQualified or shortNonOpeningRangeEntryLevelQualified)
longOpeningRangeFilterPassed = not longOpeningRangeLowOnly
shortOpeningRangeFilterPassed = not shortOpeningRangeHighOnly
longOpeningRangeMarketStatePassed = openingRangeOutsideCloseSeen or longOpeningRangeLowPlusAnotherLevel
shortOpeningRangeMarketStatePassed = openingRangeOutsideCloseSeen or shortOpeningRangeHighPlusAnotherLevel

[longBestAfterExpandedPrice, longBestAfterExpandedName, longBestAfterExpandedPriority, longBestAfterExpandedCurrent, longBestAfterExpandedFound] = f_pickLongEntryCandidate(longExpandedScalpLevelPrice, longExpandedScalpLevelName, longExpandedScalpLevelPriority, longExpandedScalpLevelTouchedCurrent, longExpandedScalpLevelFound, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[longBestAfterGroup1Price, longBestAfterGroup1Name, longBestAfterGroup1Priority, longBestAfterGroup1Current, longBestAfterGroup1Found] = f_pickLongEntryCandidate(longGroup1Price, longGroup1Name, longGroup1Priority, longGroup1Current, longGroup1Found, longBestAfterExpandedPrice, longBestAfterExpandedName, longBestAfterExpandedPriority, longBestAfterExpandedCurrent, longBestAfterExpandedFound)
[longBestAfterGroup2Price, longBestAfterGroup2Name, longBestAfterGroup2Priority, longBestAfterGroup2Current, longBestAfterGroup2Found] = f_pickLongEntryCandidate(longGroup2Price, longGroup2Name, longGroup2Priority, longGroup2Current, longGroup2Found, longBestAfterGroup1Price, longBestAfterGroup1Name, longBestAfterGroup1Priority, longBestAfterGroup1Current, longBestAfterGroup1Found)
[longBestAfterGroup3Price, longBestAfterGroup3Name, longBestAfterGroup3Priority, longBestAfterGroup3Current, longBestAfterGroup3Found] = f_pickLongEntryCandidate(longGroup3Price, longGroup3Name, longGroup3Priority, longGroup3Current, longGroup3Found, longBestAfterGroup2Price, longBestAfterGroup2Name, longBestAfterGroup2Priority, longBestAfterGroup2Current, longBestAfterGroup2Found)
[longBestAfterGroup4Price, longBestAfterGroup4Name, longBestAfterGroup4Priority, longBestAfterGroup4Current, longBestAfterGroup4Found] = f_pickLongEntryCandidate(longGroup4Price, longGroup4Name, longGroup4Priority, longGroup4Current, longGroup4Found, longBestAfterGroup3Price, longBestAfterGroup3Name, longBestAfterGroup3Priority, longBestAfterGroup3Current, longBestAfterGroup3Found)

[shortBestAfterExpandedPrice, shortBestAfterExpandedName, shortBestAfterExpandedPriority, shortBestAfterExpandedCurrent, shortBestAfterExpandedFound] = f_pickShortEntryCandidate(shortExpandedScalpLevelPrice, shortExpandedScalpLevelName, shortExpandedScalpLevelPriority, shortExpandedScalpLevelTouchedCurrent, shortExpandedScalpLevelFound, noSelectedLevelPrice, noSelectedLevelName, noSelectedLevelPriority, noSelectedLevelTouchedCurrent, noSelectedLevelFound)
[shortBestAfterGroup1Price, shortBestAfterGroup1Name, shortBestAfterGroup1Priority, shortBestAfterGroup1Current, shortBestAfterGroup1Found] = f_pickShortEntryCandidate(shortGroup1Price, shortGroup1Name, shortGroup1Priority, shortGroup1Current, shortGroup1Found, shortBestAfterExpandedPrice, shortBestAfterExpandedName, shortBestAfterExpandedPriority, shortBestAfterExpandedCurrent, shortBestAfterExpandedFound)
[shortBestAfterGroup2Price, shortBestAfterGroup2Name, shortBestAfterGroup2Priority, shortBestAfterGroup2Current, shortBestAfterGroup2Found] = f_pickShortEntryCandidate(shortGroup2Price, shortGroup2Name, shortGroup2Priority, shortGroup2Current, shortGroup2Found, shortBestAfterGroup1Price, shortBestAfterGroup1Name, shortBestAfterGroup1Priority, shortBestAfterGroup1Current, shortBestAfterGroup1Found)
[shortBestAfterGroup3Price, shortBestAfterGroup3Name, shortBestAfterGroup3Priority, shortBestAfterGroup3Current, shortBestAfterGroup3Found] = f_pickShortEntryCandidate(shortGroup3Price, shortGroup3Name, shortGroup3Priority, shortGroup3Current, shortGroup3Found, shortBestAfterGroup2Price, shortBestAfterGroup2Name, shortBestAfterGroup2Priority, shortBestAfterGroup2Current, shortBestAfterGroup2Found)
[shortBestAfterGroup4Price, shortBestAfterGroup4Name, shortBestAfterGroup4Priority, shortBestAfterGroup4Current, shortBestAfterGroup4Found] = f_pickShortEntryCandidate(shortGroup4Price, shortGroup4Name, shortGroup4Priority, shortGroup4Current, shortGroup4Found, shortBestAfterGroup3Price, shortBestAfterGroup3Name, shortBestAfterGroup3Priority, shortBestAfterGroup3Current, shortBestAfterGroup3Found)

longMostKeyTouchedLevelPrice = longBestAfterGroup4Found ? longBestAfterGroup4Price : na
longMostKeyTouchedLevelName = longBestAfterGroup4Found ? longBestAfterGroup4Name : "N/A"
longMostKeyTouchedLevelCurrent = longBestAfterGroup4Found and longBestAfterGroup4Current

shortMostKeyTouchedLevelPrice = shortBestAfterGroup4Found ? shortBestAfterGroup4Price : na
shortMostKeyTouchedLevelName = shortBestAfterGroup4Found ? shortBestAfterGroup4Name : "N/A"
shortMostKeyTouchedLevelCurrent = shortBestAfterGroup4Found and shortBestAfterGroup4Current

longAnyEntryLevelTouched = not na(longMostKeyTouchedLevelPrice)
shortAnyEntryLevelTouched = not na(shortMostKeyTouchedLevelPrice)

longMostKeyTouchedLevelBroken = longAnyEntryLevelTouched and scalpSignalClose > longMostKeyTouchedLevelPrice
shortMostKeyTouchedLevelBroken = shortAnyEntryLevelTouched and scalpSignalClose < shortMostKeyTouchedLevelPrice

bool longAnyTouchedLevelFailedCloseBeyond = false
bool shortAnyTouchedLevelFailedCloseBeyond = false
if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
    for touchedLevelIndex = 0 to array.size(swingLevelPrices) - 1
        float touchedLevelPrice = array.get(swingLevelPrices, touchedLevelIndex)
        bool touchedLevelRequiresCloseBeyond = array.get(swingLevelCloseBeyondRequired, touchedLevelIndex)
        longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(touchedLevelRequiresCloseBeyond, touchedLevelPrice, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
        shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(touchedLevelRequiresCloseBeyond, touchedLevelPrice, scalpSignalLow, scalpSignalHigh, scalpSignalClose)

longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useDirectTradeDailyOpenLevel, effectiveDailyOpen, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(usePremarketHighLevel, effectivePremarketHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(usePremarketLowLevel, effectivePremarketLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
longAnyTouchedLevelFailedCloseBeyond := longAnyTouchedLevelFailedCloseBeyond or f_longTouchedLevelFailedCloseBeyond(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)

shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useDirectTradePrevDayHighLevel, effectivePrevDayHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useDirectTradePrevDayLowLevel, effectivePrevDayLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useDirectTradeDailyOpenLevel, effectiveDailyOpen, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(usePremarketHighLevel, effectivePremarketHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(usePremarketLowLevel, effectivePremarketLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady, openingRangeHigh, scalpSignalLow, scalpSignalHigh, scalpSignalClose)
shortAnyTouchedLevelFailedCloseBeyond := shortAnyTouchedLevelFailedCloseBeyond or f_shortTouchedLevelFailedCloseBeyond(useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady, openingRangeLow, scalpSignalLow, scalpSignalHigh, scalpSignalClose)

longAllTouchedLevelsClosedBeyond = not longAnyTouchedLevelFailedCloseBeyond
shortAllTouchedLevelsClosedBeyond = not shortAnyTouchedLevelFailedCloseBeyond

longSelectedLevelPrice = longMostKeyTouchedLevelBroken ? longMostKeyTouchedLevelPrice : na
longSelectedLevelName = longMostKeyTouchedLevelBroken ? longMostKeyTouchedLevelName : "N/A"
longSelectedLevelTouchedCurrent = longMostKeyTouchedLevelBroken and longMostKeyTouchedLevelCurrent

shortSelectedLevelPrice = shortMostKeyTouchedLevelBroken ? shortMostKeyTouchedLevelPrice : na
shortSelectedLevelName = shortMostKeyTouchedLevelBroken ? shortMostKeyTouchedLevelName : "N/A"
shortSelectedLevelTouchedCurrent = shortMostKeyTouchedLevelBroken and shortMostKeyTouchedLevelCurrent

longCloseBeyondSelectedDistance = not na(longSelectedLevelPrice) and scalpSignalClose > longSelectedLevelPrice ? scalpSignalClose - longSelectedLevelPrice : na
longCloseToHighDistance = not na(longSelectedLevelPrice) and scalpSignalClose > longSelectedLevelPrice ? scalpSignalHigh - scalpSignalClose : na
longSelectedLevelCloseAcceptancePassed = not na(longCloseBeyondSelectedDistance) and not na(longCloseToHighDistance) and longCloseBeyondSelectedDistance > longCloseToHighDistance
shortCloseBeyondSelectedDistance = not na(shortSelectedLevelPrice) and scalpSignalClose < shortSelectedLevelPrice ? shortSelectedLevelPrice - scalpSignalClose : na
shortCloseToLowDistance = not na(shortSelectedLevelPrice) and scalpSignalClose < shortSelectedLevelPrice ? scalpSignalClose - scalpSignalLow : na
shortSelectedLevelCloseAcceptancePassed = not na(shortCloseBeyondSelectedDistance) and not na(shortCloseToLowDistance) and shortCloseBeyondSelectedDistance > shortCloseToLowDistance

// Level-entry retracement validation only applies when the broken level would be the entry.
levelEntryRange = scalpSignalHigh - scalpSignalLow
longLevelEntryRequired = not na(longSelectedLevelPrice) and longSelectedLevelPrice > longEntry50 and longSelectedLevelPrice < scalpSignalClose
shortLevelEntryRequired = not na(shortSelectedLevelPrice) and shortSelectedLevelPrice < shortEntry50 and shortSelectedLevelPrice > scalpSignalClose
float longLevelEntryRetracement = (levelEntryRange > 0 and longLevelEntryRequired) ? (scalpSignalHigh - longSelectedLevelPrice) / levelEntryRange : na
float shortLevelEntryRetracement = (levelEntryRange > 0 and shortLevelEntryRequired) ? (shortSelectedLevelPrice - scalpSignalLow) / levelEntryRange : na
longLevelEntryRetracementOk = not longLevelEntryRequired or (not na(longLevelEntryRetracement) and longLevelEntryRetracement >= minLevelEntryRetracement)
shortLevelEntryRetracementOk = not shortLevelEntryRequired or (not na(shortLevelEntryRetracement) and shortLevelEntryRetracement >= minLevelEntryRetracement)

// ===================== Scalp Setup Qualification Logic =====================
// Level setups reuse the enabled scalp entry level checks above. A selected
// level only exists after the signal or prior bar qualifies and the signal closes beyond it.
longLevelBreakSetup = longMostKeyTouchedLevelBroken and longAllTouchedLevelsClosedBeyond and longLevelEntryRetracementOk and longSelectedLevelCloseAcceptancePassed
shortLevelBreakSetup = shortMostKeyTouchedLevelBroken and shortAllTouchedLevelsClosedBeyond and shortLevelEntryRetracementOk and shortSelectedLevelCloseAcceptancePassed

longPullbackBreak = not na(low[1]) and low < low[1]
shortPullbackBreak = not na(high[1]) and high > high[1]
longNoPullbackBreak = not na(low[1]) and not longPullbackBreak
shortNoPullbackBreak = not na(high[1]) and not shortPullbackBreak
var int longBarsWithoutPullbackBreak = 0
var int shortBarsWithoutPullbackBreak = 0
longBarsWithoutPullbackBreak := longNoPullbackBreak ? nz(longBarsWithoutPullbackBreak[1]) + 1 : 0
shortBarsWithoutPullbackBreak := shortNoPullbackBreak ? nz(shortBarsWithoutPullbackBreak[1]) + 1 : 0

prior1StrongBull = f_isBullBar(open[1], close[1]) and bodyPct[1] >= 0.50 and closeInUpperThird[1]
prior2StrongBull = f_isBullBar(open[2], close[2]) and bodyPct[2] >= 0.50 and closeInUpperThird[2]
prior1StrongBear = f_isBearBar(open[1], close[1]) and bodyPct[1] >= 0.50 and closeInLowerThird[1]
prior2StrongBear = f_isBearBar(open[2], close[2]) and bodyPct[2] >= 0.50 and closeInLowerThird[2]
longFiveBarExtension = longBarsWithoutPullbackBreak >= 5
shortFiveBarExtension = shortBarsWithoutPullbackBreak >= 5
longStrongMicrochannelExtension = longBarsWithoutPullbackBreak >= 3 and prior1StrongBull and prior2StrongBull
shortStrongMicrochannelExtension = shortBarsWithoutPullbackBreak >= 3 and prior1StrongBear and prior2StrongBear
longExtendedSetup = longFiveBarExtension or longStrongMicrochannelExtension
shortExtendedSetup = shortFiveBarExtension or shortStrongMicrochannelExtension
longExtendedSetupBlocked = longExtendedSetup and ((skipFiveBarExtension and longFiveBarExtension) or (skipStrongMicrochannelExtension and longStrongMicrochannelExtension))
shortExtendedSetupBlocked = shortExtendedSetup and ((skipFiveBarExtension and shortFiveBarExtension) or (skipStrongMicrochannelExtension and shortStrongMicrochannelExtension))

longFboSwingSweepFilterPassed = not requireFboSwingSweep or longScalpFboSweepQualified
shortFboSwingSweepFilterPassed = not requireFboSwingSweep or shortScalpFboSweepQualified
longFboLevelSetupQualified = longLevelBreakSetup and bullScalpSetupTier and alertSetupSignals and longFboSwingSweepFilterPassed
longIgnitionLevelSetupQualified = longLevelBreakSetup and bullScalpIgnitionTier and alertIgnitionSignals
longStrongIgnitionLevelSetupQualified = longLevelBreakSetup and bullScalpStrongIgnitionTier and alertStrongIgnitions
longScalpSetupQualified = longFboLevelSetupQualified or longIgnitionLevelSetupQualified or longStrongIgnitionLevelSetupQualified

shortFboLevelSetupQualified = shortLevelBreakSetup and bearScalpSetupTier and alertSetupSignals and shortFboSwingSweepFilterPassed
shortIgnitionLevelSetupQualified = shortLevelBreakSetup and bearScalpIgnitionTier and alertIgnitionSignals
shortStrongIgnitionLevelSetupQualified = shortLevelBreakSetup and bearScalpStrongIgnitionTier and alertStrongIgnitions
shortScalpSetupQualified = shortFboLevelSetupQualified or shortIgnitionLevelSetupQualified or shortStrongIgnitionLevelSetupQualified

longSetupTextFull = longFboLevelSetupQualified ? "Failed Breakout" : longStrongIgnitionLevelSetupQualified ? "Strong Ignition" : longIgnitionLevelSetupQualified ? "Ignition" : longLevelBreakSetup ? "Level Break" : "None"
shortSetupTextFull = shortFboLevelSetupQualified ? "Failed Breakout" : shortStrongIgnitionLevelSetupQualified ? "Strong Ignition" : shortIgnitionLevelSetupQualified ? "Ignition" : shortLevelBreakSetup ? "Level Break" : "None"

longSetupSourceText = longSelectedLevelTouchedCurrent ? "Direct Touch" : not na(longSelectedLevelPrice) ? "Prior-Bar Touch" : "N/A"
shortSetupSourceText = shortSelectedLevelTouchedCurrent ? "Direct Touch" : not na(shortSelectedLevelPrice) ? "Prior-Bar Touch" : "N/A"
openingRangeAlertText = openingRangeStatus
longStatusSetupSourceText = not longScalpSetupQualified ? "N/A" : longOpeningRangeLowPlusAnotherLevel ? "ORL + Level" : longOpeningRangeLowOnly ? "ORL Only" : longOpeningRangeHighQualified ? "ORH" : longSetupSourceText
shortStatusSetupSourceText = not shortScalpSetupQualified ? "N/A" : shortOpeningRangeHighPlusAnotherLevel ? "ORH + Level" : shortOpeningRangeHighOnly ? "ORH Only" : shortOpeningRangeLowQualified ? "ORL" : shortSetupSourceText

// ===================== Scalp Entry / Stop / Risk Logic =====================
longUsePriorityLevel = longLevelEntryRequired and longLevelEntryRetracementOk
shortUsePriorityLevel = shortLevelEntryRequired and shortLevelEntryRetracementOk
longEntryType = longUsePriorityLevel ? longSelectedLevelName : "50%"
shortEntryType = shortUsePriorityLevel ? shortSelectedLevelName : "50%"

longEntryPrice = longUsePriorityLevel ? longSelectedLevelPrice : longEntry50
shortEntryPrice = shortUsePriorityLevel ? shortSelectedLevelPrice : shortEntry50
longStopPrice = scalpSignalLow - scalpTickSize
shortStopPrice = scalpSignalHigh + scalpTickSize
longRiskPoints = longEntryPrice - longStopPrice
shortRiskPoints = shortStopPrice - shortEntryPrice
longRiskDollarsPerContract = longRiskPoints > 0 ? longRiskPoints * scalpPointValue + commissionRoundTrip : na
shortRiskDollarsPerContract = shortRiskPoints > 0 ? shortRiskPoints * scalpPointValue + commissionRoundTrip : na
longRawContracts = not na(longRiskDollarsPerContract) and longRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / longRiskDollarsPerContract)) : 0
shortRawContracts = not na(shortRiskDollarsPerContract) and shortRiskDollarsPerContract > 0 ? int(math.floor(maxRiskDollars / shortRiskDollarsPerContract)) : 0
longContracts = useMaxContractCap ? math.min(longRawContracts, maxContracts) : longRawContracts
shortContracts = useMaxContractCap ? math.min(shortRawContracts, maxContracts) : shortRawContracts
longRiskValid = longRiskPoints > 0 and not na(longRiskDollarsPerContract) and longRiskDollarsPerContract > 0 and longContracts >= 1
shortRiskValid = shortRiskPoints > 0 and not na(shortRiskDollarsPerContract) and shortRiskDollarsPerContract > 0 and shortContracts >= 1

// ===================== Scalp Target Selection Logic =====================
float noTargetPrice = na
string noTargetType = "N/A"
float noTargetRR = na
int noTargetPriority = 999

float longTargetPrice = noTargetPrice
string longTargetType = noTargetType
float longTargetRR = noTargetRR
int longTargetPriority = noTargetPriority

if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
    for expandedLongTargetIndex = 0 to array.size(swingLevelPrices) - 1
        float expandedLongTargetPrice = array.get(swingLevelPrices, expandedLongTargetIndex)
        string expandedLongTargetName = array.get(swingLevelNames, expandedLongTargetIndex)
        int expandedLongTargetPriority = array.get(swingLevelPriority, expandedLongTargetIndex)
        bool expandedLongTargetAllowed = array.get(swingLevelAllowedForTarget, expandedLongTargetIndex)
        string expandedLongTargetType = "Level " + expandedLongTargetName
        if expandedLongTargetAllowed and f_longTargetQualifies(expandedLongTargetPrice, expandedLongTargetType, longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(expandedLongTargetPrice, expandedLongTargetPriority, longTargetPrice, longTargetPriority)
            longTargetPrice := expandedLongTargetPrice
            longTargetType := expandedLongTargetType
            longTargetRR := f_targetRRLong(expandedLongTargetPrice, longEntryPrice, longRiskPoints)
            longTargetPriority := expandedLongTargetPriority

if useDirectTradePrevDayHighLevel and f_longTargetQualifies(effectivePrevDayHigh, "Level PDH", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectivePrevDayHigh, 4, longTargetPrice, longTargetPriority)
    longTargetPrice := effectivePrevDayHigh
    longTargetType := "Level PDH"
    longTargetRR := f_targetRRLong(effectivePrevDayHigh, longEntryPrice, longRiskPoints)
    longTargetPriority := 4

if useDirectTradePrevDayLowLevel and f_longTargetQualifies(effectivePrevDayLow, "Level PDL", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectivePrevDayLow, 4, longTargetPrice, longTargetPriority)
    longTargetPrice := effectivePrevDayLow
    longTargetType := "Level PDL"
    longTargetRR := f_targetRRLong(effectivePrevDayLow, longEntryPrice, longRiskPoints)
    longTargetPriority := 4

if useDirectTradeDailyOpenLevel and f_longTargetQualifies(effectiveDailyOpen, "Level OP", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectiveDailyOpen, 6, longTargetPrice, longTargetPriority)
    longTargetPrice := effectiveDailyOpen
    longTargetType := "Level OP"
    longTargetRR := f_targetRRLong(effectiveDailyOpen, longEntryPrice, longRiskPoints)
    longTargetPriority := 6

if usePremarketHighLevel and f_longTargetQualifies(effectivePremarketHigh, "Level PMH", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectivePremarketHigh, 7, longTargetPrice, longTargetPriority)
    longTargetPrice := effectivePremarketHigh
    longTargetType := "Level PMH"
    longTargetRR := f_targetRRLong(effectivePremarketHigh, longEntryPrice, longRiskPoints)
    longTargetPriority := 7

if usePremarketLowLevel and f_longTargetQualifies(effectivePremarketLow, "Level PML", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(effectivePremarketLow, 7, longTargetPrice, longTargetPriority)
    longTargetPrice := effectivePremarketLow
    longTargetType := "Level PML"
    longTargetRR := f_targetRRLong(effectivePremarketLow, longEntryPrice, longRiskPoints)
    longTargetPriority := 7

if useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady and f_longTargetQualifies(openingRangeHigh, "Level ORH", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(openingRangeHigh, 8, longTargetPrice, longTargetPriority)
    longTargetPrice := openingRangeHigh
    longTargetType := "Level ORH"
    longTargetRR := f_targetRRLong(openingRangeHigh, longEntryPrice, longRiskPoints)
    longTargetPriority := 8

if useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady and f_longTargetQualifies(openingRangeLow, "Level ORL", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(openingRangeLow, 8, longTargetPrice, longTargetPriority)
    longTargetPrice := openingRangeLow
    longTargetType := "Level ORL"
    longTargetRR := f_targetRRLong(openingRangeLow, longEntryPrice, longRiskPoints)
    longTargetPriority := 8

if array.size(swingHighPrices) > 0
    for swingHighIndex = 0 to array.size(swingHighPrices) - 1
        float swingHighPrice = array.get(swingHighPrices, swingHighIndex)
        bool swingHighAllowed = array.get(swingHighActive, swingHighIndex) and f_swingTargetSessionAllowed(array.get(swingHighSessions, swingHighIndex), array.get(swingHighDateKeys, swingHighIndex), nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if swingHighAllowed and f_longTargetQualifies(swingHighPrice, "5m Swing", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(swingHighPrice, 9, longTargetPrice, longTargetPriority)
            longTargetPrice := swingHighPrice
            longTargetType := "5m Swing"
            longTargetRR := f_targetRRLong(swingHighPrice, longEntryPrice, longRiskPoints)
            longTargetPriority := 9

if f_longTargetQualifies(currentRTHHigh, "HOD", longEntryType, scalpSignalHigh, longEntryPrice, longRiskPoints, currentRTHHigh) and f_longTargetCandidateBetter(currentRTHHigh, 9, longTargetPrice, longTargetPriority)
    longTargetPrice := currentRTHHigh
    longTargetType := "HOD"
    longTargetRR := f_targetRRLong(currentRTHHigh, longEntryPrice, longRiskPoints)
    longTargetPriority := 9

longTargetValid = not na(longTargetPrice) and longTargetType != "N/A"

float shortTargetPrice = noTargetPrice
string shortTargetType = noTargetType
float shortTargetRR = noTargetRR
int shortTargetPriority = noTargetPriority

if convertedHtfTradeLevelsEnabled and array.size(swingLevelPrices) > 0
    for expandedShortTargetIndex = 0 to array.size(swingLevelPrices) - 1
        float expandedShortTargetPrice = array.get(swingLevelPrices, expandedShortTargetIndex)
        string expandedShortTargetName = array.get(swingLevelNames, expandedShortTargetIndex)
        int expandedShortTargetPriority = array.get(swingLevelPriority, expandedShortTargetIndex)
        bool expandedShortTargetAllowed = array.get(swingLevelAllowedForTarget, expandedShortTargetIndex)
        string expandedShortTargetType = "Level " + expandedShortTargetName
        if expandedShortTargetAllowed and f_shortTargetQualifies(expandedShortTargetPrice, expandedShortTargetType, shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(expandedShortTargetPrice, expandedShortTargetPriority, shortTargetPrice, shortTargetPriority)
            shortTargetPrice := expandedShortTargetPrice
            shortTargetType := expandedShortTargetType
            shortTargetRR := f_targetRRShort(expandedShortTargetPrice, shortEntryPrice, shortRiskPoints)
            shortTargetPriority := expandedShortTargetPriority

if useDirectTradePrevDayHighLevel and f_shortTargetQualifies(effectivePrevDayHigh, "Level PDH", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectivePrevDayHigh, 4, shortTargetPrice, shortTargetPriority)
    shortTargetPrice := effectivePrevDayHigh
    shortTargetType := "Level PDH"
    shortTargetRR := f_targetRRShort(effectivePrevDayHigh, shortEntryPrice, shortRiskPoints)
    shortTargetPriority := 4

if useDirectTradePrevDayLowLevel and f_shortTargetQualifies(effectivePrevDayLow, "Level PDL", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectivePrevDayLow, 4, shortTargetPrice, shortTargetPriority)
    shortTargetPrice := effectivePrevDayLow
    shortTargetType := "Level PDL"
    shortTargetRR := f_targetRRShort(effectivePrevDayLow, shortEntryPrice, shortRiskPoints)
    shortTargetPriority := 4

if useDirectTradeDailyOpenLevel and f_shortTargetQualifies(effectiveDailyOpen, "Level OP", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectiveDailyOpen, 6, shortTargetPrice, shortTargetPriority)
    shortTargetPrice := effectiveDailyOpen
    shortTargetType := "Level OP"
    shortTargetRR := f_targetRRShort(effectiveDailyOpen, shortEntryPrice, shortRiskPoints)
    shortTargetPriority := 6

if usePremarketHighLevel and f_shortTargetQualifies(effectivePremarketHigh, "Level PMH", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectivePremarketHigh, 7, shortTargetPrice, shortTargetPriority)
    shortTargetPrice := effectivePremarketHigh
    shortTargetType := "Level PMH"
    shortTargetRR := f_targetRRShort(effectivePremarketHigh, shortEntryPrice, shortRiskPoints)
    shortTargetPriority := 7

if usePremarketLowLevel and f_shortTargetQualifies(effectivePremarketLow, "Level PML", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(effectivePremarketLow, 7, shortTargetPrice, shortTargetPriority)
    shortTargetPrice := effectivePremarketLow
    shortTargetType := "Level PML"
    shortTargetRR := f_targetRRShort(effectivePremarketLow, shortEntryPrice, shortRiskPoints)
    shortTargetPriority := 7

if useOpeningRangeHighAsEntryLevel and openingRangeLevelsReady and f_shortTargetQualifies(openingRangeHigh, "Level ORH", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(openingRangeHigh, 8, shortTargetPrice, shortTargetPriority)
    shortTargetPrice := openingRangeHigh
    shortTargetType := "Level ORH"
    shortTargetRR := f_targetRRShort(openingRangeHigh, shortEntryPrice, shortRiskPoints)
    shortTargetPriority := 8

if useOpeningRangeLowAsEntryLevel and openingRangeLevelsReady and f_shortTargetQualifies(openingRangeLow, "Level ORL", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(openingRangeLow, 8, shortTargetPrice, shortTargetPriority)
    shortTargetPrice := openingRangeLow
    shortTargetType := "Level ORL"
    shortTargetRR := f_targetRRShort(openingRangeLow, shortEntryPrice, shortRiskPoints)
    shortTargetPriority := 8

if array.size(swingLowPrices) > 0
    for swingLowIndex = 0 to array.size(swingLowPrices) - 1
        float swingLowPrice = array.get(swingLowPrices, swingLowIndex)
        bool swingLowAllowed = array.get(swingLowActive, swingLowIndex) and f_swingTargetSessionAllowed(array.get(swingLowSessions, swingLowIndex), array.get(swingLowDateKeys, swingLowIndex), nySessionDateKey, activeCurrentRTHDateKey, activePreviousRTHDateKey)
        if swingLowAllowed and f_shortTargetQualifies(swingLowPrice, "5m Swing", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(swingLowPrice, 9, shortTargetPrice, shortTargetPriority)
            shortTargetPrice := swingLowPrice
            shortTargetType := "5m Swing"
            shortTargetRR := f_targetRRShort(swingLowPrice, shortEntryPrice, shortRiskPoints)
            shortTargetPriority := 9

if f_shortTargetQualifies(currentRTHLow, "LOD", shortEntryType, scalpSignalLow, shortEntryPrice, shortRiskPoints, currentRTHLow) and f_shortTargetCandidateBetter(currentRTHLow, 9, shortTargetPrice, shortTargetPriority)
    shortTargetPrice := currentRTHLow
    shortTargetType := "LOD"
    shortTargetRR := f_targetRRShort(currentRTHLow, shortEntryPrice, shortRiskPoints)
    shortTargetPriority := 9

shortTargetValid = not na(shortTargetPrice) and shortTargetType != "N/A"
longTargetFilterPassed = not requireValidTarget or longTargetValid
shortTargetFilterPassed = not requireValidTarget or shortTargetValid

longSelectedLevelText = f_abbrevLevelName(longSelectedLevelName)
shortSelectedLevelText = f_abbrevLevelName(shortSelectedLevelName)
longEntryTypeText = f_abbrevLevelName(longEntryType)
shortEntryTypeText = f_abbrevLevelName(shortEntryType)
longTargetTypeText = f_abbrevLevelName(longTargetType)
shortTargetTypeText = f_abbrevLevelName(shortTargetType)

// ===================== Alert Conditions =====================
bullScalpAlert = alertScalpSetups and barstate.isconfirmed and inScalpRTHSession and openingRangeLevelsReady and not inOpeningRangeWindow and alertOnBullSignals and longOpeningRangeFilterPassed and longOpeningRangeMarketStatePassed and bullScalpTierAllowed and longScalpSetupQualified and not longExtendedSetupBlocked and longDailyOpenBodyAcceptancePassed and longRiskValid and longTargetFilterPassed
bullAlertLabelTitle = "LONG SCALP"

bearScalpAlert = alertScalpSetups and barstate.isconfirmed and inScalpRTHSession and openingRangeLevelsReady and not inOpeningRangeWindow and alertOnBearSignals and shortOpeningRangeFilterPassed and shortOpeningRangeMarketStatePassed and bearScalpTierAllowed and shortScalpSetupQualified and not shortExtendedSetupBlocked and shortDailyOpenBodyAcceptancePassed and shortRiskValid and shortTargetFilterPassed
bearAlertLabelTitle = "SHORT SCALP"

effectiveBullScalpAlert = bullScalpAlert
effectiveBearScalpAlert = not effectiveBullScalpAlert and bearScalpAlert

showHistoricalAlertLabels = alertLabelMode != "Off"
showCompactAlertLabels = alertLabelMode == "Compact"

f_buildMarkerChartLabel(_direction, _compactSignalText, _selectedLevelName) =>
    showAlertSignalDetails ? _direction + "\n" + _compactSignalText + " | " + f_abbrevLevelName(_selectedLevelName) : _direction

f_buildCompactChartLabel(_direction, _compactSignalText, _selectedLevelName, _entryPrice, _stopPrice, _targetPrice, _targetType, _targetRR, _contracts) =>
    _direction + "\n" +
     _compactSignalText + " | " + f_abbrevLevelName(_selectedLevelName) + "\n" +
     "E " + f_priceText(_entryPrice) + "\n" +
     "S " + f_priceText(_stopPrice) + "\n" +
     "T " + f_priceText(_targetPrice) + " " + f_abbrevLevelName(_targetType) + "\n" +
     str.tostring(_contracts) + "ct | " + f_rrText(_targetRR)

f_addAlertChartLabel(_price, _text, _style, _color) =>
    label.new(bar_index, _price, _text, style=_style, textcolor=color.white, color=_color, size=showCompactAlertLabels ? size.small : size.tiny)

alertDirectionTitle = effectiveBullScalpAlert ? bullAlertLabelTitle : effectiveBearScalpAlert ? bearAlertLabelTitle : ""
alertCompactSignalText = effectiveBullScalpAlert ? bullCompactSignalText : effectiveBearScalpAlert ? bearCompactSignalText : ""
alertSelectedLevelName = effectiveBullScalpAlert ? longSelectedLevelText : effectiveBearScalpAlert ? shortSelectedLevelText : "N/A"
alertEntryType = effectiveBullScalpAlert ? longEntryTypeText : effectiveBearScalpAlert ? shortEntryTypeText : "N/A"
alertEntryPrice = effectiveBullScalpAlert ? longEntryPrice : effectiveBearScalpAlert ? shortEntryPrice : na
alertStopPrice = effectiveBullScalpAlert ? longStopPrice : effectiveBearScalpAlert ? shortStopPrice : na
alertTargetPrice = effectiveBullScalpAlert ? longTargetPrice : effectiveBearScalpAlert ? shortTargetPrice : na
alertTargetType = effectiveBullScalpAlert ? longTargetTypeText : effectiveBearScalpAlert ? shortTargetTypeText : "N/A"
alertTargetRR = effectiveBullScalpAlert ? longTargetRR : effectiveBearScalpAlert ? shortTargetRR : na
alertContracts = effectiveBullScalpAlert ? longContracts : effectiveBearScalpAlert ? shortContracts : na
alertLabelPrice = effectiveBullScalpAlert ? low : effectiveBearScalpAlert ? high : na
alertLabelStyle = effectiveBullScalpAlert ? label.style_label_up : label.style_label_down
alertLabelColor = effectiveBullScalpAlert ? color.new(color.lime, 0) : color.new(color.red, 0)

if showHistoricalAlertLabels and (effectiveBullScalpAlert or effectiveBearScalpAlert)
    string chartLabelText = showCompactAlertLabels ? f_buildCompactChartLabel(alertDirectionTitle, alertCompactSignalText, alertSelectedLevelName, alertEntryPrice, alertStopPrice, alertTargetPrice, alertTargetType, alertTargetRR, alertContracts) : f_buildMarkerChartLabel(alertDirectionTitle, alertCompactSignalText, alertSelectedLevelName)
    f_addAlertChartLabel(alertLabelPrice, chartLabelText, alertLabelStyle, alertLabelColor)

// ===================== Alert Message =====================
f_buildScalpAlertMessage(_directionTitle, _compactSignalText, _selectedLevelName, _openingRangeText, _entryType, _entryPrice, _stopPrice, _targetPrice, _targetType, _targetRR, _contracts) =>
    "PA ENGINE " + _directionTitle + "\n" +
     _compactSignalText + " | " + f_abbrevLevelName(_selectedLevelName) + "\n" +
     "Opening Range: " + _openingRangeText + "\n" +
     syminfo.ticker + " " + timeframe.period + "\n\n" +
     "E " + f_priceText(_entryPrice) + " " + f_abbrevLevelName(_entryType) + "\n" +
     "S " + f_priceText(_stopPrice) + "\n" +
     "T " + f_priceText(_targetPrice) + " " + f_abbrevLevelName(_targetType) + "\n" +
     str.tostring(_contracts) + "ct | " + f_rrText(_targetRR)

if effectiveBullScalpAlert or effectiveBearScalpAlert
    alert(f_buildScalpAlertMessage(alertDirectionTitle, alertCompactSignalText, alertSelectedLevelName, openingRangeAlertText, alertEntryType, alertEntryPrice, alertStopPrice, alertTargetPrice, alertTargetType, alertTargetRR, alertContracts), alert.freq_once_per_bar_close)

plot(showOpeningRange ? openingRangeDisplayHigh : na, "15m Opening Range High", color=openingRangeHighColor, linewidth=1, style=plot.style_linebr)
plot(showOpeningRange ? openingRangeDisplayLow : na, "15m Opening Range Low", color=openingRangeLowColor, linewidth=1, style=plot.style_linebr)
pdhPlot = showAutoScalpLevels and showRawFuturesPrevDayLevels and inScalpRTHSession and effectivePrevDayHigh > 0 ? effectivePrevDayHigh : na
pdlPlot = showAutoScalpLevels and showRawFuturesPrevDayLevels and inScalpRTHSession and effectivePrevDayLow > 0 ? effectivePrevDayLow : na

plot(pdhPlot, "Auto/Effective PDH", color=majorHighLevelColor, linewidth=1, style=plot.style_linebr)
plot(pdlPlot, "Auto/Effective PDL", color=majorLowLevelColor, linewidth=1, style=plot.style_linebr)
plot(showAutoScalpLevels and effectiveDailyOpen > 0 ? effectiveDailyOpen : na, "Raw/Effective OP", color=openLevelColor, linewidth=1, style=plot.style_linebr)
plot(premarketDisplayHigh, "Premarket High", color=premarketLevelColor, linewidth=1, style=plot.style_linebr)
plot(premarketDisplayLow, "Premarket Low", color=premarketLevelColor, linewidth=1, style=plot.style_linebr)

// Signals
plotshape(plotBullSignal, title="Bullish High-Volume Signal", style=shape.triangleup, size=size.small, location=location.belowbar, color=color.lime)
plotshape(plotBearSignal, title="Bearish High-Volume Signal", style=shape.triangledown, size=size.small, location=location.abovebar, color=color.red)

// ===================== Scalp Status Table =====================
f_addScalpStatusRow(table _statusTable, int _row, string _label, string _value, color _valueColor) =>
    table.cell(_statusTable, 0, _row, _label, text_color=color.rgb(180, 180, 180), text_size=size.small, text_halign=text.align_left)
    table.cell(_statusTable, 1, _row, _value, text_color=_valueColor, text_size=size.small, text_halign=text.align_right)
    _row + 1

var table scalpStatusTable = table.new(position.bottom_right, 2, 100, bgcolor=color.new(color.black, 85), border_width=0)
if barstate.islast
    table.clear(scalpStatusTable, 0, 0, 1, 99)
    if showScalpStatusTable
        statusNeutralColor = color.rgb(220, 220, 220)
        alertSetupsTableText = alertScalpSetups ? "Scalp" : "Off"
        int scalpStatusRow = 0
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Opening Range", openingRangeStatus, statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "OR Rule", "Confluence", statusNeutralColor)
        scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Converted Source", convertedLevelSourceSymbol, statusNeutralColor)
        if showDetailedLevelStatus
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "ORH", f_priceText(openingRangeDisplayHigh), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "ORL", f_priceText(openingRangeDisplayLow), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Trade HTF Source", useConvertedHtfLevelsForTradeLogic ? "Converted" : "Direct/Fallback", useConvertedHtfLevelsForTradeLogic ? color.lime : color.orange)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Trade Daily Open", f_priceText(activeTradeDailyOpen), activeTradeDailyOpenValid ? statusNeutralColor : color.orange)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Converted DO Valid", f_boolText(convertedDailyOpenValid), convertedDailyOpenValid ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Raw DO", f_priceText(effectiveDailyOpen), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Converted Levels Count", str.tostring(array.size(swingLevelPrices)), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Direct HTF Fallback", f_boolText(useDirectHtfFallbackLevels), useDirectHtfFallbackLevels ? color.orange : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long OR Filter", f_boolText(longOpeningRangeFilterPassed), longOpeningRangeFilterPassed ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short OR Filter", f_boolText(shortOpeningRangeFilterPassed), shortOpeningRangeFilterPassed ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "OR Outside Close", f_boolText(openingRangeOutsideCloseSeen), openingRangeOutsideCloseSeen ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long OR State", f_boolText(longOpeningRangeMarketStatePassed), longOpeningRangeMarketStatePassed ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short OR State", f_boolText(shortOpeningRangeMarketStatePassed), shortOpeningRangeMarketStatePassed ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long ORL Only", f_boolText(longOpeningRangeLowOnly), longOpeningRangeLowOnly ? color.red : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long ORL + Level", f_boolText(longOpeningRangeLowPlusAnotherLevel), longOpeningRangeLowPlusAnotherLevel ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short ORH Only", f_boolText(shortOpeningRangeHighOnly), shortOpeningRangeHighOnly ? color.red : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short ORH + Level", f_boolText(shortOpeningRangeHighPlusAnotherLevel), shortOpeningRangeHighPlusAnotherLevel ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "ORL Reclaim", f_boolText(longOrlReclaim), longOrlReclaim ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "ORH Reclaim", f_boolText(shortOrhReclaim), shortOrhReclaim ? color.red : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Selected Long Level", longSelectedLevelText + " " + f_priceText(longSelectedLevelPrice), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Selected Short Level", shortSelectedLevelText + " " + f_priceText(shortSelectedLevelPrice), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long Sel Close OK", not na(longSelectedLevelPrice) ? f_boolText(longSelectedLevelCloseAcceptancePassed) : "N/A", na(longSelectedLevelPrice) ? statusNeutralColor : longSelectedLevelCloseAcceptancePassed ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long Close Dist", f_pointsText(longCloseBeyondSelectedDistance) + " / " + f_pointsText(longCloseToHighDistance), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short Sel Close OK", not na(shortSelectedLevelPrice) ? f_boolText(shortSelectedLevelCloseAcceptancePassed) : "N/A", na(shortSelectedLevelPrice) ? statusNeutralColor : shortSelectedLevelCloseAcceptancePassed ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short Close Dist", f_pointsText(shortCloseBeyondSelectedDistance) + " / " + f_pointsText(shortCloseToLowDistance), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "WO Entry", allowWeeklyOpenAsEntry ? "enabled" : "disabled", allowWeeklyOpenAsEntry ? color.orange : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long Setup Source", longStatusSetupSourceText, longScalpSetupQualified ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short Setup Source", shortStatusSetupSourceText, shortScalpSetupQualified ? color.red : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long Target", f_priceText(longTargetPrice) + " " + longTargetTypeText, longTargetValid ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short Target", f_priceText(shortTargetPrice) + " " + shortTargetTypeText, shortTargetValid ? color.red : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long R:R", f_rrText(longTargetRR), longTargetValid ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short R:R", f_rrText(shortTargetRR), shortTargetValid ? color.red : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "OP Touched", f_boolText(dailyOpenTouchedCurrent), dailyOpenTouchedCurrent ? color.orange : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Long OP Range", f_boolText(longDailyOpenBodyAcceptancePassed) + " " + f_pctText(rangeAboveDailyOpenPct), longDailyOpenBodyAcceptancePassed ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Short OP Range", f_boolText(shortDailyOpenBodyAcceptancePassed) + " " + f_pctText(rangeBelowDailyOpenPct), shortDailyOpenBodyAcceptancePassed ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Alert Setups", alertSetupsTableText, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Expanded Levels", f_boolText(useExpandedScalpLevels), useExpandedScalpLevels ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PDH", f_priceText(effectivePrevDayHigh), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PDL", f_priceText(effectivePrevDayLow), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "OP", f_priceText(effectiveDailyOpen), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PMH", f_priceText(effectivePremarketHigh), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PML", f_priceText(effectivePremarketLow), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PDH/PDL Source", prevDayHighLowSource, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "OP Source", dailyOpenSource, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "PM Source", premarketSource, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Auto Note", "Intraday, ideally 5m", statusNeutralColor)
        if showDetailedLevelStatus or showConvertedLevelDebug or showGapRequestDiagnostics
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Chart Symbol", syminfo.tickerid, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Ticker Input", tickerInput, statusNeutralColor)
        if showConvertedLevelDebug
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Daily Open", f_priceText(sourceDayOpen), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Chart RTH Open", f_priceText(chartDailyOpenForConvertedLevels), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Converted Status", convertedLevelStatus, convertedLevelStatus == "ready" ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Converted Levels", str.tostring(array.size(swingLevelPrices)), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conv Chart Close", f_priceText(chartConversionBase), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conv Source Close", f_priceText(sourceConversionBase), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conv Ratio", f_numberText(currentConversionRatio), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Conversion Ready", f_boolText(swingCurrentPriceRatioReady), swingCurrentPriceRatioReady ? color.lime : color.red)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Cache Current", f_boolText(sourceSessionCacheCurrent), sourceSessionCacheCurrent ? color.lime : statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Cache Date", f_dateKeyText(convertedSourceCacheSessionDateKey), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Cache Refresh", f_timeText(convertedSourceCacheLastRefreshTime), statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Source Mid-Session Init", f_boolText(convertedSourceCacheInitializedMidSession), convertedSourceCacheInitializedMidSession ? color.orange : statusNeutralColor)
        if showGapRequestDiagnostics
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Gap Request Source", activeDailyGapSourceDebugText, statusNeutralColor)
            scalpStatusRow := f_addScalpStatusRow(scalpStatusTable, scalpStatusRow, "Expected Source", expectedDailyGapSourceSymbol, statusNeutralColor)

    longPendingRisk := na
    longPendingRiskDollars := na
    longPendingOneRTarget := na
    shortPendingEntry := na
    shortPendingStop := na
    shortPendingTarget := na
    shortPendingRisk := na
    shortPendingRiskDollars := na
    shortPendingOneRTarget := na
    longPendingContracts := na
    shortPendingContracts := na
    longPendingLocation := "N/A"
    shortPendingLocation := "N/A"
    longPendingSetupType := "N/A"
    shortPendingSetupType := "N/A"
    longPendingEntryMode := "N/A"
    shortPendingEntryMode := "N/A"
    if hadPendingOnSessionReset
        lastSignalReason := "Pending cancelled: new session"

// Actual fill tracking: tradesToday increments only when the broker emulator
// opens a position, not when a setup appears or a stop order is submitted.
if longFilledNow
    tradesToday += 1
    lastFillBar := bar_index
    float plannedLongEntry = not na(longPendingEntry) ? longPendingEntry : strategy.position_avg_price
    float plannedLongStop = not na(longPendingStop) ? longPendingStop : activeLongStop
    float plannedLongRisk = not na(longPendingRisk) ? longPendingRisk : plannedLongEntry - plannedLongStop
    activeLongEntry := plannedLongEntry
    activeLongAverageFillPrice := strategy.position_avg_price
    activeLongStop := plannedLongStop
    activeLongRisk := plannedLongRisk
    activeLongOneRTarget := not na(longPendingOneRTarget) ? longPendingOneRTarget : plannedLongEntry + plannedLongRisk
    activeLongTarget := not na(longPendingTarget) ? longPendingTarget : plannedLongEntry + plannedLongRisk * targetR
    activeLongRunnerStop := activeLongStop
    int filledLongContracts = int(math.abs(strategy.position_size))
    activeLongFilledQty := filledLongContracts
    activeLongTrimManagementEligible := managementMode == "Trim 1R + BE" and filledLongContracts >= 2 and not na(activeLongRisk) and activeLongRisk > 0
    activeLongFixedRFallback := managementMode == "Trim 1R + BE" and filledLongContracts < 2
    activeLongTrimFilled := false
    activeLongTrimQty := activeLongTrimManagementEligible ? f_trimContracts(filledLongContracts, trimAtOneRPercent) : na
    activeLongRunnerQty := activeLongTrimManagementEligible ? filledLongContracts - activeLongTrimQty : na
    longOneRReached := false
    activeShortTrimManagementEligible := false
    activeShortFixedRFallback := false
    activeShortTrimFilled := false
    activeShortFilledQty := na
    activeShortTrimQty := na
    activeShortRunnerQty := na
    bool usePlannedLongExcursionBasis = excursionBasisMode == "Planned Entry / Planned Risk"
    activeExcursionDirection := 1
    activeExcursionEntry := usePlannedLongExcursionBasis ? activeLongEntry : activeLongAverageFillPrice
    activeExcursionStop := activeLongStop
    activeExcursionRisk := usePlannedLongExcursionBasis ? activeLongRisk : activeLongAverageFillPrice - activeLongStop
    activeExcursionRiskDollars := activeLongRisk * math.abs(strategy.position_size) * pointValue
    activeExcursionMfeR := 0.0
    activeExcursionMaeR := 0.0
    activeExcursionHigh := high
    activeExcursionLow := low
    activeExcursionEntryBar := bar_index
    activeExcursionSetupType := longPendingSetupType
    activeExcursionLocation := longPendingLocation
    activeExcursionEntryMode := longPendingEntryMode
    if activeLongTrimManagementEligible
        strategy.cancel(LONG_EXIT_ID)
    longPendingOrder := false
    longPendingSignalBar := na
    longPendingEntry := na
    longPendingStop := na
    longPendingTarget := na
    longPendingRisk := na
    longPendingRiskDollars := na
    longPendingOneRTarget := na
    longPendingContracts := na
    longPendingLocation := "N/A"
    longPendingSetupType := "N/A"
    longPendingEntryMode := "N/A"
    if shortPendingOrder
        strategy.cancel(SHORT_ENTRY_ID)
        shortPendingOrder := false
        shortPendingSignalBar := na
        shortPendingEntry := na
        shortPendingStop := na
        shortPendingTarget := na
        shortPendingRisk := na
        shortPendingRiskDollars := na
        shortPendingOneRTarget := na
        shortPendingContracts := na
        shortPendingLocation := "N/A"
        shortPendingSetupType := "N/A"
        shortPendingEntryMode := "N/A"
    lastSignalReason := "Long filled"
    if showStrategyDebugLabels
        string longFillDebugText = activeLongTrimManagementEligible ? "L trim fill\nQty " + str.tostring(filledLongContracts) + " T " + str.tostring(activeLongTrimQty) + " R " + str.tostring(activeLongRunnerQty) + "\nPlan " + f_priceText(activeLongEntry) + " Avg " + f_priceText(activeLongAverageFillPrice) + "\nStop " + f_priceText(activeLongStop) + " 1R " + f_priceText(activeLongOneRTarget) + "\nFinal " + f_priceText(activeLongTarget) + "\nFixed exit cancelled TRUE" : "L fill\nPlan E " + f_priceText(activeLongEntry) + "\nAvg " + f_priceText(activeLongAverageFillPrice) + "\nStop " + f_priceText(activeLongStop) + "\n1R " + f_priceText(activeLongOneRTarget) + "\nQty " + str.tostring(filledLongContracts)
        label.new(bar_index, low, longFillDebugText, style=label.style_label_up, textcolor=color.white, color=color.new(color.green, 20), size=size.tiny)

if shortFilledNow
    tradesToday += 1
    lastFillBar := bar_index
    float plannedShortEntry = not na(shortPendingEntry) ? shortPendingEntry : strategy.position_avg_price
    float plannedShortStop = not na(shortPendingStop) ? shortPendingStop : activeShortStop
    float plannedShortRisk = not na(shortPendingRisk) ? shortPendingRisk : plannedShortStop - plannedShortEntry
    activeShortEntry := plannedShortEntry
    activeShortAverageFillPrice := strategy.position_avg_price
    activeShortStop := plannedShortStop
    activeShortRisk := plannedShortRisk
    activeShortOneRTarget := not na(shortPendingOneRTarget) ? shortPendingOneRTarget : plannedShortEntry - plannedShortRisk
    activeShortTarget := not na(shortPendingTarget) ? shortPendingTarget : plannedShortEntry - plannedShortRisk * targetR
    activeShortRunnerStop := activeShortStop
    int filledShortContracts = int(math.abs(strategy.position_size))
    activeShortFilledQty := filledShortContracts
    activeShortTrimManagementEligible := managementMode == "Trim 1R + BE" and filledShortContracts >= 2 and not na(activeShortRisk) and activeShortRisk > 0
    activeShortFixedRFallback := managementMode == "Trim 1R + BE" and filledShortContracts < 2
    activeShortTrimFilled := false
    activeShortTrimQty := activeShortTrimManagementEligible ? f_trimContracts(filledShortContracts, trimAtOneRPercent) : na
    activeShortRunnerQty := activeShortTrimManagementEligible ? filledShortContracts - activeShortTrimQty : na
    shortOneRReached := false
    activeLongTrimManagementEligible := false
    activeLongFixedRFallback := false
    activeLongTrimFilled := false
    activeLongFilledQty := na
    activeLongTrimQty := na
    activeLongRunnerQty := na
    bool usePlannedShortExcursionBasis = excursionBasisMode == "Planned Entry / Planned Risk"
    activeExcursionDirection := -1
    activeExcursionEntry := usePlannedShortExcursionBasis ? activeShortEntry : activeShortAverageFillPrice
    activeExcursionStop := activeShortStop
    activeExcursionRisk := usePlannedShortExcursionBasis ? activeShortRisk : activeShortStop - activeShortAverageFillPrice
    activeExcursionRiskDollars := activeShortRisk * math.abs(strategy.position_size) * pointValue
    activeExcursionMfeR := 0.0
    activeExcursionMaeR := 0.0
    activeExcursionHigh := high
    activeExcursionLow := low
    activeExcursionEntryBar := bar_index
    activeExcursionSetupType := shortPendingSetupType
    activeExcursionLocation := shortPendingLocation
    activeExcursionEntryMode := shortPendingEntryMode
    if activeShortTrimManagementEligible
        strategy.cancel(SHORT_EXIT_ID)
    shortPendingOrder := false
    shortPendingSignalBar := na
    shortPendingEntry := na
    shortPendingStop := na
    shortPendingTarget := na
    shortPendingRisk := na
    shortPendingRiskDollars := na
    shortPendingOneRTarget := na
    shortPendingContracts := na
    shortPendingLocation := "N/A"
    shortPendingSetupType := "N/A"
    shortPendingEntryMode := "N/A"
    if longPendingOrder
        strategy.cancel(LONG_ENTRY_ID)
        longPendingOrder := false
        longPendingSignalBar := na
        longPendingEntry := na
        longPendingStop := na
        longPendingTarget := na
        longPendingRisk := na
        longPendingRiskDollars := na
        longPendingOneRTarget := na
        longPendingContracts := na
        longPendingLocation := "N/A"
        longPendingSetupType := "N/A"
        longPendingEntryMode := "N/A"
    lastSignalReason := "Short filled"
    if showStrategyDebugLabels
        string shortFillDebugText = activeShortTrimManagementEligible ? "S trim fill\nQty " + str.tostring(filledShortContracts) + " T " + str.tostring(activeShortTrimQty) + " R " + str.tostring(activeShortRunnerQty) + "\nPlan " + f_priceText(activeShortEntry) + " Avg " + f_priceText(activeShortAverageFillPrice) + "\nStop " + f_priceText(activeShortStop) + " 1R " + f_priceText(activeShortOneRTarget) + "\nFinal " + f_priceText(activeShortTarget) + "\nFixed exit cancelled TRUE" : "S fill\nPlan E " + f_priceText(activeShortEntry) + "\nAvg " + f_priceText(activeShortAverageFillPrice) + "\nStop " + f_priceText(activeShortStop) + "\n1R " + f_priceText(activeShortOneRTarget) + "\nQty " + str.tostring(filledShortContracts)
        label.new(bar_index, high, shortFillDebugText, style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 20), size=size.tiny)

if not allowPendingEntryFillsAfterWindow and (longFilledNow or shortFilledNow) and not inAlertTradingWindow
    entryFilledOutsideWindow := true
    f_cancelAllExitOrders()
    if longFilledNow
        strategy.close(LONG_ENTRY_ID, comment="ERROR: Filled outside alert window")
        if showStrategyDebugLabels
            label.new(bar_index, high, "ERROR: Filled outside alert window\nLONG qty " + str.tostring(strategy.position_size), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.small)
    if shortFilledNow
        strategy.close(SHORT_ENTRY_ID, comment="ERROR: Filled outside alert window")
        if showStrategyDebugLabels
            label.new(bar_index, low, "ERROR: Filled outside alert window\nSHORT qty " + str.tostring(math.abs(strategy.position_size)), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0), size=size.small)
    lastSignalReason := "ERROR: Filled outside alert window"

bool longTrimFilledNow = strategy.position_size > 0 and activeLongTrimManagementEligible and not activeLongTrimFilled and not na(activeLongRunnerQty) and int(math.abs(strategy.position_size)) <= activeLongRunnerQty
bool shortTrimFilledNow = strategy.position_size < 0 and activeShortTrimManagementEligible and not activeShortTrimFilled and not na(activeShortRunnerQty) and int(math.abs(strategy.position_size)) <= activeShortRunnerQty
if longTrimFilledNow
    activeLongTrimFilled := true
if shortTrimFilledNow
    activeShortTrimFilled := true

bool positionClosedNow = strategy.position_size == 0 and nz(strategy.position_size[1]) != 0
float lastClosedTradeExitPrice = na
if positionClosedNow and strategy.closedtrades > 0
    lastClosedTradeExitPrice := strategy.closedtrades.exit_price(strategy.closedtrades - 1)

bool validActiveExcursionRisk = not na(activeExcursionRisk) and activeExcursionRisk > 0 and not na(activeExcursionEntry)
bool updateActiveExcursionNow = validActiveExcursionRisk and activeExcursionDirection != 0 and (strategy.position_size != 0 or positionClosedNow)
if updateActiveExcursionNow
    activeExcursionHigh := na(activeExcursionHigh) ? high : math.max(activeExcursionHigh, high)
    activeExcursionLow := na(activeExcursionLow) ? low : math.min(activeExcursionLow, low)
    if activeExcursionDirection == 1
        activeExcursionMfeR := math.max(nz(activeExcursionMfeR, 0.0), math.max(0.0, (activeExcursionHigh - activeExcursionEntry) / activeExcursionRisk))
        activeExcursionMaeR := math.max(nz(activeExcursionMaeR, 0.0), math.max(0.0, (activeExcursionEntry - activeExcursionLow) / activeExcursionRisk))
    else if activeExcursionDirection == -1
        activeExcursionMfeR := math.max(nz(activeExcursionMfeR, 0.0), math.max(0.0, (activeExcursionEntry - activeExcursionLow) / activeExcursionRisk))
        activeExcursionMaeR := math.max(nz(activeExcursionMaeR, 0.0), math.max(0.0, (activeExcursionHigh - activeExcursionEntry) / activeExcursionRisk))
int closedTradesSinceLastSync = strategy.closedtrades - trackedClosedTradesCount
bool latestClosedWasLongTrim = positionClosedNow and strategy.closedtrades > 0 and strategy.closedtrades.exit_id(strategy.closedtrades - 1) == LONG_TRIM_EXIT_ID
bool previousClosedWasLongTrim = positionClosedNow and closedTradesSinceLastSync >= 2 and strategy.closedtrades > 1 and strategy.closedtrades.exit_id(strategy.closedtrades - 2) == LONG_TRIM_EXIT_ID
bool latestClosedWasShortTrim = positionClosedNow and strategy.closedtrades > 0 and strategy.closedtrades.exit_id(strategy.closedtrades - 1) == SHORT_TRIM_EXIT_ID
bool previousClosedWasShortTrim = positionClosedNow and closedTradesSinceLastSync >= 2 and strategy.closedtrades > 1 and strategy.closedtrades.exit_id(strategy.closedtrades - 2) == SHORT_TRIM_EXIT_ID
bool longTrimClosedInLatestBatch = latestClosedWasLongTrim or previousClosedWasLongTrim
bool shortTrimClosedInLatestBatch = latestClosedWasShortTrim or previousClosedWasShortTrim
bool longTrimAlreadyHandled = activeLongTrimFilled or longTrimClosedInLatestBatch
bool shortTrimAlreadyHandled = activeShortTrimFilled or shortTrimClosedInLatestBatch
bool longClosedFromOriginalQty = positionClosedNow and nz(strategy.position_size[1]) > 0 and activeLongTrimManagementEligible and not na(activeLongFilledQty) and int(math.abs(strategy.position_size[1])) >= activeLongFilledQty
bool shortClosedFromOriginalQty = positionClosedNow and nz(strategy.position_size[1]) < 0 and activeShortTrimManagementEligible and not na(activeShortFilledQty) and int(math.abs(strategy.position_size[1])) >= activeShortFilledQty
bool longFullExitAtFinalWithoutTrim = longClosedFromOriginalQty and not longTrimAlreadyHandled and not na(lastClosedTradeExitPrice) and not na(activeLongTarget) and lastClosedTradeExitPrice >= activeLongTarget - tickSize * 0.5
bool shortFullExitAtFinalWithoutTrim = shortClosedFromOriginalQty and not shortTrimAlreadyHandled and not na(lastClosedTradeExitPrice) and not na(activeShortTarget) and lastClosedTradeExitPrice <= activeShortTarget + tickSize * 0.5
bool longFullExitAtOriginalStopAfterOneR = longClosedFromOriginalQty and longOneRReached and not longTrimAlreadyHandled and not na(lastClosedTradeExitPrice) and not na(activeLongStop) and lastClosedTradeExitPrice <= activeLongStop + tickSize * 0.5
bool shortFullExitAtOriginalStopAfterOneR = shortClosedFromOriginalQty and shortOneRReached and not shortTrimAlreadyHandled and not na(lastClosedTradeExitPrice) and not na(activeShortStop) and lastClosedTradeExitPrice >= activeShortStop - tickSize * 0.5
if showStrategyDebugLabels and positionClosedNow and (longTrimClosedInLatestBatch or shortTrimClosedInLatestBatch) and not (activeLongTrimFilled or activeShortTrimFilled)
    label.new(bar_index, close, "Same-bar split exit batch\nTradingView reported trim and close together", style=label.style_label_left, textcolor=color.white, color=color.new(color.gray, 20), size=size.tiny)
if showStrategyDebugLabels and longFullExitAtFinalWithoutTrim
    label.new(bar_index, high, "ERROR: Full qty exited final target without 1R trim\nQty " + str.tostring(activeLongFilledQty) + " Exit " + f_priceText(lastClosedTradeExitPrice) + "\n1R " + f_priceText(activeLongOneRTarget) + " Final " + f_priceText(activeLongTarget), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.small)
if showStrategyDebugLabels and shortFullExitAtFinalWithoutTrim
    label.new(bar_index, low, "ERROR: Full qty exited final target without 1R trim\nQty " + str.tostring(activeShortFilledQty) + " Exit " + f_priceText(lastClosedTradeExitPrice) + "\n1R " + f_priceText(activeShortOneRTarget) + " Final " + f_priceText(activeShortTarget), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0), size=size.small)
if showStrategyDebugLabels and longFullExitAtOriginalStopAfterOneR
    label.new(bar_index, high, "ERROR: Full qty exited original stop after 1R\nQty " + str.tostring(activeLongFilledQty) + " Exit " + f_priceText(lastClosedTradeExitPrice) + "\nOld stop " + f_priceText(activeLongStop) + " BE stop " + f_priceText(activeLongRunnerStop), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.small)
if showStrategyDebugLabels and shortFullExitAtOriginalStopAfterOneR
    label.new(bar_index, low, "ERROR: Full qty exited original stop after 1R\nQty " + str.tostring(activeShortFilledQty) + " Exit " + f_priceText(lastClosedTradeExitPrice) + "\nOld stop " + f_priceText(activeShortStop) + " BE stop " + f_priceText(activeShortRunnerStop), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0), size=size.small)

bool excursionClosedTradesIncreased = strategy.closedtrades > excursionProcessedClosedTradesCount
if excursionClosedTradesIncreased
    for tradeIndex = excursionProcessedClosedTradesCount to strategy.closedtrades - 1
        string closedEntryId = strategy.closedtrades.entry_id(tradeIndex)
        string closedExitId = strategy.closedtrades.exit_id(tradeIndex)
        float closedEntryPrice = strategy.closedtrades.entry_price(tradeIndex)
        float closedExitPrice = strategy.closedtrades.exit_price(tradeIndex)
        float closedTradeSize = strategy.closedtrades.size(tradeIndex)
        float closedAbsSize = math.abs(closedTradeSize)
        float runupDollars = strategy.closedtrades.max_runup(tradeIndex)
        float drawdownDollars = strategy.closedtrades.max_drawdown(tradeIndex)
        float profitDollars = strategy.closedtrades.profit(tradeIndex)
        int closedEntryBarIndex = strategy.closedtrades.entry_bar_index(tradeIndex)
        int closedExitBarIndex = strategy.closedtrades.exit_bar_index(tradeIndex)
        bool closedIsLong = closedTradeSize > 0 or closedEntryId == LONG_ENTRY_ID
        bool closedIsShort = closedTradeSize < 0 or closedEntryId == SHORT_ENTRY_ID
        int closedDirection = closedIsLong ? 1 : closedIsShort ? -1 : 0
        float riskDollars = na
        bool usedFallbackRisk = false

        if activeExcursionDirection == closedDirection and not na(activeExcursionRiskDollars) and activeExcursionRiskDollars > 0
            riskDollars := activeExcursionRiskDollars
        else if closedIsLong and not na(longPendingRiskDollars) and longPendingRiskDollars > 0
            riskDollars := longPendingRiskDollars
        else if closedIsShort and not na(shortPendingRiskDollars) and shortPendingRiskDollars > 0
            riskDollars := shortPendingRiskDollars
        else if closedIsLong and not na(activeLongRisk) and activeLongRisk > 0
            riskDollars := activeLongRisk * closedAbsSize * pointValue
        else if closedIsShort and not na(activeShortRisk) and activeShortRisk > 0
            riskDollars := activeShortRisk * closedAbsSize * pointValue
        else if maxRiskDollars > 0
            riskDollars := maxRiskDollars
            usedFallbackRisk := true

        if usedFallbackRisk
            excursionFallbackRiskTrades += 1

        bool activeMetadataReady = activeExcursionDirection == closedDirection and (activeExcursionSetupType != "N/A" or activeExcursionLocation != "N/A" or activeExcursionEntryMode != "N/A")
        string rawSetupType = "N/A"
        string rawLocation = "Other/N/A"
        string rawEntryMode = "N/A"
        if activeMetadataReady
            rawSetupType := activeExcursionSetupType
            rawLocation := activeExcursionLocation
            rawEntryMode := activeExcursionEntryMode
            excursionActiveMetadataTrades += 1
        else
            rawSetupType := closedIsLong ? longPendingSetupType : closedIsShort ? shortPendingSetupType : "N/A"
            rawLocation := closedIsLong ? longPendingLocation : closedIsShort ? shortPendingLocation : "Other/N/A"
            rawEntryMode := closedIsLong ? longPendingEntryMode : closedIsShort ? shortPendingEntryMode : "N/A"
            excursionFallbackMetadataTrades += 1

        bool validRiskDollars = not na(riskDollars) and riskDollars > 0
        bool validClosedTradeStats = not na(runupDollars) and not na(drawdownDollars) and not na(profitDollars)
        float closedMfeR = validRiskDollars and not na(runupDollars) ? math.max(0.0, runupDollars / riskDollars) : na
        float closedMaeR = validRiskDollars and not na(drawdownDollars) ? math.max(0.0, drawdownDollars / riskDollars) : na
        float closedFinalR = validRiskDollars and not na(profitDollars) ? profitDollars / riskDollars : na
        int closedBarsHeld = not na(closedEntryBarIndex) and not na(closedExitBarIndex) ? closedExitBarIndex - closedEntryBarIndex + 1 : 0
        bool validExcursionRecord = closedDirection != 0 and validRiskDollars and validClosedTradeStats and not na(closedMfeR) and not na(closedMaeR) and not na(closedFinalR)
        string closedSetupType = rawSetupType == "STD" or rawSetupType == "50R" ? rawSetupType : "N/A"
        string closedEntryMode = rawEntryMode == "Immediate" or rawEntryMode == "Delayed" ? rawEntryMode : "N/A"
        string closedLocation = rawLocation == "9EMA" or rawLocation == "20EMA" or rawLocation == "50EMA" or rawLocation == "ORH" or rawLocation == "ORL" or rawLocation == "PDH" or rawLocation == "PDL" or rawLocation == "PMH" or rawLocation == "PML" or rawLocation == "RTH Open" ? rawLocation : "Other/N/A"

        excursionClosedTradeRecordsSeen += 1

        if validExcursionRecord
            int hitMfe05 = closedMfeR >= 0.5 ? 1 : 0
            int hitMfe10 = closedMfeR >= 1.0 ? 1 : 0
            int hitMfe125 = closedMfeR >= 1.25 ? 1 : 0
            int hitMfe15 = closedMfeR >= 1.5 ? 1 : 0
            int hitMfe20 = closedMfeR >= 2.0 ? 1 : 0
            int hitMfe25 = closedMfeR >= 2.5 ? 1 : 0
            int hitMfe30 = closedMfeR >= 3.0 ? 1 : 0
            int hitMfe40 = closedMfeR >= 4.0 ? 1 : 0
            int hitMae05 = closedMaeR >= 0.5 ? 1 : 0
            int hitMae10 = closedMaeR >= 1.0 ? 1 : 0

            excursionCompletedTrades += 1
            excursionSumMfeR += closedMfeR
            excursionSumMaeR += closedMaeR
            excursionSumFinalExitR += closedFinalR
            excursionSumBarsHeld += closedBarsHeld * 1.0
            excursionHitMfe05 += hitMfe05
            excursionHitMfe10 += hitMfe10
            excursionHitMfe125 += hitMfe125
            excursionHitMfe15 += hitMfe15
            excursionHitMfe20 += hitMfe20
            excursionHitMfe25 += hitMfe25
            excursionHitMfe30 += hitMfe30
            excursionHitMfe40 += hitMfe40
            excursionHitMae05 += hitMae05
            excursionHitMae10 += hitMae10
            excursionMfe10To15 += closedMfeR >= 1.0 and closedMfeR < 1.5 ? 1 : 0
            excursionMfe15To20 += closedMfeR >= 1.5 and closedMfeR < 2.0 ? 1 : 0
            excursionMfe20To30 += closedMfeR >= 2.0 and closedMfeR < 3.0 ? 1 : 0
            excursionMfe30Plus += closedMfeR >= 3.0 ? 1 : 0

            if closedDirection == 1
                excursionLongCount += 1
                excursionLongSumMfeR += closedMfeR
                excursionLongSumMaeR += closedMaeR
                excursionLongSumFinalExitR += closedFinalR
                excursionLongHit10 += hitMfe10
                excursionLongHit15 += hitMfe15
                excursionLongHit20 += hitMfe20
                excursionLongHit30 += hitMfe30
            else
                excursionShortCount += 1
                excursionShortSumMfeR += closedMfeR
                excursionShortSumMaeR += closedMaeR
                excursionShortSumFinalExitR += closedFinalR
                excursionShortHit10 += hitMfe10
                excursionShortHit15 += hitMfe15
                excursionShortHit20 += hitMfe20
                excursionShortHit30 += hitMfe30

            if closedSetupType == "STD"
                excursionStdCount += 1
                excursionStdSumMfeR += closedMfeR
                excursionStdSumMaeR += closedMaeR
                excursionStdSumFinalExitR += closedFinalR
                excursionStdHit10 += hitMfe10
                excursionStdHit15 += hitMfe15
                excursionStdHit20 += hitMfe20
                excursionStdHit30 += hitMfe30
            else if closedSetupType == "50R"
                excursionFiftyCount += 1
                excursionFiftySumMfeR += closedMfeR
                excursionFiftySumMaeR += closedMaeR
                excursionFiftySumFinalExitR += closedFinalR
                excursionFiftyHit10 += hitMfe10
                excursionFiftyHit15 += hitMfe15
                excursionFiftyHit20 += hitMfe20
                excursionFiftyHit30 += hitMfe30
            else
                excursionSetupNaCount += 1
                excursionSetupNaSumMfeR += closedMfeR
                excursionSetupNaSumMaeR += closedMaeR
                excursionSetupNaSumFinalExitR += closedFinalR
                excursionSetupNaHit10 += hitMfe10
                excursionSetupNaHit15 += hitMfe15
                excursionSetupNaHit20 += hitMfe20
                excursionSetupNaHit30 += hitMfe30

            if closedEntryMode == "Immediate"
                excursionImmediateCount += 1
                excursionImmediateSumMfeR += closedMfeR
                excursionImmediateSumMaeR += closedMaeR
                excursionImmediateSumFinalExitR += closedFinalR
                excursionImmediateHit10 += hitMfe10
                excursionImmediateHit15 += hitMfe15
                excursionImmediateHit20 += hitMfe20
                excursionImmediateHit30 += hitMfe30
            else if closedEntryMode == "Delayed"
                excursionDelayedCount += 1
                excursionDelayedSumMfeR += closedMfeR
                excursionDelayedSumMaeR += closedMaeR
                excursionDelayedSumFinalExitR += closedFinalR
                excursionDelayedHit10 += hitMfe10
                excursionDelayedHit15 += hitMfe15
                excursionDelayedHit20 += hitMfe20
                excursionDelayedHit30 += hitMfe30
            else
                excursionEntryNaCount += 1
                excursionEntryNaSumMfeR += closedMfeR
                excursionEntryNaSumMaeR += closedMaeR
                excursionEntryNaSumFinalExitR += closedFinalR
                excursionEntryNaHit10 += hitMfe10
                excursionEntryNaHit15 += hitMfe15
                excursionEntryNaHit20 += hitMfe20
                excursionEntryNaHit30 += hitMfe30

            if closedLocation == "9EMA"
                loc9Count += 1
                loc9SumMfeR += closedMfeR
                loc9SumMaeR += closedMaeR
                loc9SumFinalExitR += closedFinalR
                loc9Hit10 += hitMfe10
                loc9Hit15 += hitMfe15
                loc9Hit20 += hitMfe20
            else if closedLocation == "20EMA"
                loc20Count += 1
                loc20SumMfeR += closedMfeR
                loc20SumMaeR += closedMaeR
                loc20SumFinalExitR += closedFinalR
                loc20Hit10 += hitMfe10
                loc20Hit15 += hitMfe15
                loc20Hit20 += hitMfe20
            else if closedLocation == "50EMA"
                loc50Count += 1
                loc50SumMfeR += closedMfeR
                loc50SumMaeR += closedMaeR
                loc50SumFinalExitR += closedFinalR
                loc50Hit10 += hitMfe10
                loc50Hit15 += hitMfe15
                loc50Hit20 += hitMfe20
            else if closedLocation == "ORH"
                locOrhCount += 1
                locOrhSumMfeR += closedMfeR
                locOrhSumMaeR += closedMaeR
                locOrhSumFinalExitR += closedFinalR
                locOrhHit10 += hitMfe10
                locOrhHit15 += hitMfe15
                locOrhHit20 += hitMfe20
            else if closedLocation == "ORL"
                locOrlCount += 1
                locOrlSumMfeR += closedMfeR
                locOrlSumMaeR += closedMaeR
                locOrlSumFinalExitR += closedFinalR
                locOrlHit10 += hitMfe10
                locOrlHit15 += hitMfe15
                locOrlHit20 += hitMfe20
            else if closedLocation == "PDH"
                locPdhCount += 1
                locPdhSumMfeR += closedMfeR
                locPdhSumMaeR += closedMaeR
                locPdhSumFinalExitR += closedFinalR
                locPdhHit10 += hitMfe10
                locPdhHit15 += hitMfe15
                locPdhHit20 += hitMfe20
            else if closedLocation == "PDL"
                locPdlCount += 1
                locPdlSumMfeR += closedMfeR
                locPdlSumMaeR += closedMaeR
                locPdlSumFinalExitR += closedFinalR
                locPdlHit10 += hitMfe10
                locPdlHit15 += hitMfe15
                locPdlHit20 += hitMfe20
            else if closedLocation == "PMH"
                locPmhCount += 1
                locPmhSumMfeR += closedMfeR
                locPmhSumMaeR += closedMaeR
                locPmhSumFinalExitR += closedFinalR
                locPmhHit10 += hitMfe10
                locPmhHit15 += hitMfe15
                locPmhHit20 += hitMfe20
            else if closedLocation == "PML"
                locPmlCount += 1
                locPmlSumMfeR += closedMfeR
                locPmlSumMaeR += closedMaeR
                locPmlSumFinalExitR += closedFinalR
                locPmlHit10 += hitMfe10
                locPmlHit15 += hitMfe15
                locPmlHit20 += hitMfe20
            else if closedLocation == "RTH Open"
                locRthOpenCount += 1
                locRthOpenSumMfeR += closedMfeR
                locRthOpenSumMaeR += closedMaeR
                locRthOpenSumFinalExitR += closedFinalR
                locRthOpenHit10 += hitMfe10
                locRthOpenHit15 += hitMfe15
                locRthOpenHit20 += hitMfe20
            else
                locOtherCount += 1
                locOtherSumMfeR += closedMfeR
                locOtherSumMaeR += closedMaeR
                locOtherSumFinalExitR += closedFinalR
                locOtherHit10 += hitMfe10
                locOtherHit15 += hitMfe15
                locOtherHit20 += hitMfe20

            if showExcursionDebugLabels
                string closedDirectionText = closedDirection == 1 ? "L" : "S"
                string excursionLabelText = closedDirectionText + " " + closedSetupType + " " + closedLocation + "\n" +
                 closedEntryMode + "\n" +
                 "MFE " + f_rText(closedMfeR) + " / MAE " + f_rText(closedMaeR) + "\n" +
                 "Final " + f_rText(closedFinalR) + " / Bars " + str.tostring(closedBarsHeld)
                int labelBarIndex = not na(closedExitBarIndex) ? closedExitBarIndex : bar_index
                float labelPrice = not na(closedExitPrice) ? closedExitPrice : close
                label.new(labelBarIndex, labelPrice, excursionLabelText, style=closedDirection == 1 ? label.style_label_down : label.style_label_up, textcolor=color.white, color=color.new(color.gray, 15), size=size.tiny)
        else if not validRiskDollars
            excursionInvalidTrades += 1

    excursionProcessedClosedTradesCount := strategy.closedtrades

if positionClosedNow
    activeLongStop := na
    activeLongTarget := na
    activeShortStop := na
    activeShortTarget := na
    activeLongEntry := na
    activeShortEntry := na
    activeLongAverageFillPrice := na
    activeShortAverageFillPrice := na
    activeLongRisk := na
    activeShortRisk := na
    activeLongOneRTarget := na
    activeShortOneRTarget := na
    activeLongRunnerStop := na
    activeShortRunnerStop := na
    longOneRReached := false
    shortOneRReached := false
    activeLongTrimManagementEligible := false
    activeShortTrimManagementEligible := false
    activeLongFixedRFallback := false
    activeShortFixedRFallback := false
    activeLongTrimFilled := false
    activeShortTrimFilled := false
    activeLongFilledQty := na
    activeShortFilledQty := na
    activeLongTrimQty := na
    activeLongRunnerQty := na
    activeShortTrimQty := na
    activeShortRunnerQty := na
    if excursionClosedTradesIncreased
        activeExcursionDirection := 0
        activeExcursionEntry := na
        activeExcursionStop := na
        activeExcursionRisk := na
        activeExcursionRiskDollars := na
        activeExcursionMfeR := na
        activeExcursionMaeR := na
        activeExcursionHigh := na
        activeExcursionLow := na
        activeExcursionEntryBar := na
        activeExcursionSetupType := "N/A"
        activeExcursionLocation := "N/A"
        activeExcursionEntryMode := "N/A"
    if lastSignalReason != "RTH close flatten"
        lastSignalReason := "Position closed"

// Closed-trade sync guard: if a stop entry filled and the whole trade closed
// before stale pending flags were cleared, clear state silently before any age
// cancellation branch can print or alert a false cancellation.
bool closedTradeCountIncreased = strategy.closedtrades > trackedClosedTradesCount
if closedTradeCountIncreased
    trackedClosedTradesCount := strategy.closedtrades
    if strategy.position_size == 0
        f_cancelPendingEntryOrders()
        f_cancelAllExitOrders()
        longPendingOrder := false
        shortPendingOrder := false
        longPendingSignalBar := na
        shortPendingSignalBar := na
        longPendingEntry := na
        longPendingStop := na
        longPendingTarget := na
        longPendingRisk := na
        longPendingRiskDollars := na
        longPendingOneRTarget := na
        shortPendingEntry := na
        shortPendingStop := na
        shortPendingTarget := na
        shortPendingRisk := na
        shortPendingRiskDollars := na
        shortPendingOneRTarget := na
        longPendingContracts := na
        shortPendingContracts := na
        longPendingLocation := "N/A"
        shortPendingLocation := "N/A"
        longPendingSetupType := "N/A"
        shortPendingSetupType := "N/A"
        longPendingEntryMode := "N/A"
        shortPendingEntryMode := "N/A"
        pendingLongDelayedSetup := false
        pendingShortDelayedSetup := false
        pendingLongDelayedSetupBar := na
        pendingShortDelayedSetupBar := na
        pendingLongDelayedBreakPrice := na
        pendingShortDelayedBreakPrice := na
        pendingLongDelayedSetupStop := na
        pendingShortDelayedSetupStop := na
        pendingLongPullbackSwingLow := na
        pendingShortPullbackSwingHigh := na
        pendingLongDelayedLocation := "N/A"
        pendingShortDelayedLocation := "N/A"
        activeLongStop := na
        activeLongTarget := na
        activeShortStop := na
        activeShortTarget := na
        activeLongEntry := na
        activeShortEntry := na
        activeLongAverageFillPrice := na
        activeShortAverageFillPrice := na
        activeLongRisk := na
        activeShortRisk := na
        activeLongOneRTarget := na
        activeShortOneRTarget := na
        activeLongRunnerStop := na
        activeShortRunnerStop := na
        longOneRReached := false
        shortOneRReached := false
        activeLongTrimManagementEligible := false
        activeShortTrimManagementEligible := false
        activeLongFixedRFallback := false
        activeShortFixedRFallback := false
        activeLongTrimFilled := false
        activeShortTrimFilled := false
        activeLongFilledQty := na
        activeShortFilledQty := na
        activeLongTrimQty := na
        activeLongRunnerQty := na
        activeShortTrimQty := na
        activeShortRunnerQty := na
        activeExcursionDirection := 0
        activeExcursionEntry := na
        activeExcursionStop := na
        activeExcursionRisk := na
        activeExcursionRiskDollars := na
        activeExcursionMfeR := na
        activeExcursionMaeR := na
        activeExcursionHigh := na
        activeExcursionLow := na
        activeExcursionEntryBar := na
        activeExcursionSetupType := "N/A"
        activeExcursionLocation := "N/A"
        activeExcursionEntryMode := "N/A"
        if lastSignalReason != "RTH close flatten"
            lastSignalReason := "Closed-trade sync"

if rthCloseFlattenNow
    bool hadPendingOnRthFlatten = longPendingOrder or shortPendingOrder or pendingLongDelayedSetup or pendingShortDelayedSetup
    if hadPendingOnRthFlatten
        pendingCancelledRthFlatten := true
        f_addPendingCancellationDebugLabel("RTH flatten")
    f_cancelPendingEntryOrders()
    f_cancelAllExitOrders()
    strategy.close(LONG_ENTRY_ID)
    strategy.close(SHORT_ENTRY_ID)
    longPendingOrder := false
    shortPendingOrder := false
    activeLongStop := na
    activeLongTarget := na
    activeShortStop := na
    activeShortTarget := na
    activeLongEntry := na
    activeShortEntry := na
    activeLongAverageFillPrice := na
    activeShortAverageFillPrice := na
    activeLongRisk := na
    activeShortRisk := na
    activeLongOneRTarget := na
    activeShortOneRTarget := na
    activeLongRunnerStop := na
    activeShortRunnerStop := na
    longOneRReached := false
    shortOneRReached := false
    activeLongTrimManagementEligible := false
    activeShortTrimManagementEligible := false
    activeLongFixedRFallback := false
    activeShortFixedRFallback := false
    activeLongTrimFilled := false
    activeShortTrimFilled := false
    activeLongFilledQty := na
    activeShortFilledQty := na
    activeLongTrimQty := na
    activeLongRunnerQty := na
    activeShortTrimQty := na
    activeShortRunnerQty := na
    longPendingSignalBar := na
    shortPendingSignalBar := na
    longPendingEntry := na
    longPendingStop := na
    longPendingTarget := na
    longPendingRisk := na
    longPendingRiskDollars := na
    longPendingOneRTarget := na
    shortPendingEntry := na
    shortPendingStop := na
    shortPendingTarget := na
    shortPendingRisk := na
    shortPendingRiskDollars := na
    shortPendingOneRTarget := na
    longPendingContracts := na
    shortPendingContracts := na
    longPendingLocation := "N/A"
    shortPendingLocation := "N/A"
    longPendingSetupType := "N/A"
    shortPendingSetupType := "N/A"
    longPendingEntryMode := "N/A"
    shortPendingEntryMode := "N/A"
    pendingLongDelayedSetup := false
    pendingShortDelayedSetup := false
    pendingLongDelayedSetupBar := na
    pendingShortDelayedSetupBar := na
    pendingLongDelayedBreakPrice := na
    pendingShortDelayedBreakPrice := na
    pendingLongDelayedSetupStop := na
    pendingShortDelayedSetupStop := na
    pendingLongPullbackSwingLow := na
    pendingShortPullbackSwingHigh := na
    pendingLongDelayedLocation := "N/A"
    pendingShortDelayedLocation := "N/A"
    if not longPendingOrder
        longPendingSetupType := "N/A"
        longPendingEntryMode := "N/A"
    if not shortPendingOrder
        shortPendingSetupType := "N/A"
        shortPendingEntryMode := "N/A"
    lastSignalReason := "RTH close flatten"

bool pendingInvalidOutsideWindowNow = barstate.isconfirmed and strategy.position_size == 0 and not allowPendingEntryFillsAfterWindow and not inAlertTradingWindow and (longPendingOrder or shortPendingOrder or pendingLongDelayedSetup or pendingShortDelayedSetup)
if pendingInvalidOutsideWindowNow
    pendingCancelledOutsideWindow := true
    if longPendingOrder
        longOrderCancelledEvent := true
        longCancelAlertEntry := longPendingEntry
        longCancelAlertStop := longPendingStop
        longCancelAlertTarget := longPendingTarget
        longCancelAlertRisk := longPendingEntry - longPendingStop
        longCancelAlertReasonCode := 3.0
    if shortPendingOrder
        shortOrderCancelledEvent := true
        shortCancelAlertEntry := shortPendingEntry
        shortCancelAlertStop := shortPendingStop
        shortCancelAlertTarget := shortPendingTarget
        shortCancelAlertRisk := shortPendingStop - shortPendingEntry
        shortCancelAlertReasonCode := 3.0
    f_cancelPendingEntryOrders()
    f_cancelAllExitOrders()
    f_addPendingCancellationDebugLabel("outside alert window")
    pendingLongDelayedSetup := false
    pendingShortDelayedSetup := false
    pendingLongDelayedSetupBar := na
    pendingShortDelayedSetupBar := na
    pendingLongDelayedBreakPrice := na
    pendingShortDelayedBreakPrice := na
    pendingLongDelayedSetupStop := na
    pendingShortDelayedSetupStop := na
    pendingLongPullbackSwingLow := na
    pendingShortPullbackSwingHigh := na
    pendingLongDelayedLocation := "N/A"
    pendingShortDelayedLocation := "N/A"
    longPendingOrder := false
    shortPendingOrder := false
    longPendingSignalBar := na
    shortPendingSignalBar := na
    longPendingEntry := na
    longPendingStop := na
    longPendingTarget := na
    longPendingRisk := na
    longPendingRiskDollars := na
    longPendingOneRTarget := na
    shortPendingEntry := na
    shortPendingStop := na
    shortPendingTarget := na
    shortPendingRisk := na
    shortPendingRiskDollars := na
    shortPendingOneRTarget := na
    longPendingContracts := na
    shortPendingContracts := na
    longPendingLocation := "N/A"
    shortPendingLocation := "N/A"
    longPendingSetupType := "N/A"
    shortPendingSetupType := "N/A"
    longPendingEntryMode := "N/A"
    shortPendingEntryMode := "N/A"
    lastSignalReason := "Pending cancelled: outside alert window"

// Cancellation logic: unfilled stop entries are cancelled after the configured
// age or if the planned stop breaks before entry. Same-bar entry/stop ambiguity
// uses the requested arbitration mode when the fill state is still flat.
if barstate.isconfirmed and strategy.position_size == 0
    if longPendingOrder and (na(longPendingSignalBar) or na(longPendingEntry) or na(longPendingStop))
        longPendingOrder := false
        longPendingRiskDollars := na
        longPendingSetupType := "N/A"
        longPendingEntryMode := "N/A"
    if longPendingOrder and bar_index > longPendingSignalBar
        bool longEntryTouched = high >= longPendingEntry
        bool longStopTouched = low <= longPendingStop
        bool longBothTouched = longEntryTouched and longStopTouched
        bool longStopCancel = longStopTouched and (not longEntryTouched or (longBothTouched and cancelWinsSameBar))
        bool longAgeCancel = not longEntryTouched and bar_index - longPendingSignalBar >= cancelUnfilledAfterBars
        if longStopCancel or longAgeCancel
            string cancelReason = longStopCancel ? "CXL Stop" : "CXL Age"
            longOrderCancelledEvent := true
            longCancelAlertEntry := longPendingEntry
            longCancelAlertStop := longPendingStop
            longCancelAlertTarget := longPendingTarget
            longCancelAlertRisk := longPendingEntry - longPendingStop
            longCancelAlertReasonCode := longStopCancel ? 2.0 : 1.0
            strategy.cancel(LONG_ENTRY_ID)
            f_cancelLongExitOrders()
            if showCancellationLabels
                f_addCancellationChartLabel(true, cancelReason)
            alert(f_buildCancelAlertMessage("LONG", longPendingLocation, cancelReason, longPendingEntry, longPendingStop, longPendingTarget, longPendingEntry - longPendingStop, targetR), alert.freq_once_per_bar_close)
            longPendingOrder := false
            longPendingSignalBar := na
            longPendingEntry := na
            longPendingStop := na
            longPendingTarget := na
            longPendingRisk := na
            longPendingRiskDollars := na
            longPendingOneRTarget := na
            longPendingContracts := na
            longPendingLocation := "N/A"
            longPendingSetupType := "N/A"
            longPendingEntryMode := "N/A"
            lastSignalReason := "Long " + cancelReason

    if shortPendingOrder and (na(shortPendingSignalBar) or na(shortPendingEntry) or na(shortPendingStop))
        shortPendingOrder := false
        shortPendingRiskDollars := na
        shortPendingSetupType := "N/A"
        shortPendingEntryMode := "N/A"
    if shortPendingOrder and bar_index > shortPendingSignalBar
        bool shortEntryTouched = low <= shortPendingEntry
        bool shortStopTouched = high >= shortPendingStop
        bool shortBothTouched = shortEntryTouched and shortStopTouched
        bool shortStopCancel = shortStopTouched and (not shortEntryTouched or (shortBothTouched and cancelWinsSameBar))
        bool shortAgeCancel = not shortEntryTouched and bar_index - shortPendingSignalBar >= cancelUnfilledAfterBars
        if shortStopCancel or shortAgeCancel
            string cancelReason = shortStopCancel ? "CXL Stop" : "CXL Age"
            shortOrderCancelledEvent := true
            shortCancelAlertEntry := shortPendingEntry
            shortCancelAlertStop := shortPendingStop
            shortCancelAlertTarget := shortPendingTarget
            shortCancelAlertRisk := shortPendingStop - shortPendingEntry
            shortCancelAlertReasonCode := shortStopCancel ? 2.0 : 1.0
            strategy.cancel(SHORT_ENTRY_ID)
            f_cancelShortExitOrders()
            if showCancellationLabels
                f_addCancellationChartLabel(false, cancelReason)
            alert(f_buildCancelAlertMessage("SHORT", shortPendingLocation, cancelReason, shortPendingEntry, shortPendingStop, shortPendingTarget, shortPendingStop - shortPendingEntry, targetR), alert.freq_once_per_bar_close)
            shortPendingOrder := false
            shortPendingSignalBar := na
            shortPendingEntry := na
            shortPendingStop := na
            shortPendingTarget := na
            shortPendingRisk := na
            shortPendingRiskDollars := na
            shortPendingOneRTarget := na
            shortPendingContracts := na
            shortPendingLocation := "N/A"
            shortPendingSetupType := "N/A"
            shortPendingEntryMode := "N/A"
            lastSignalReason := "Short " + cancelReason

// ===================== Setup Evaluation =====================

bool hasOpenPosition = strategy.position_size != 0
bool anyPendingOrder = longPendingOrder or shortPendingOrder
bool canEvaluateSignals = barstate.isconfirmed and enableStrategyBacktest and inRthSession and inAlertTradingWindow and openingRangeComplete and tradesToday < maxTradesPerDay and not rthCloseFlattenNow
bool canPlaceLongOrder = canEvaluateSignals and useLongs and strategy.position_size == 0 and not longPendingOrder and (not onlyOneActiveTradeOrOrder or not anyPendingOrder)
bool canPlaceShortOrder = canEvaluateSignals and useShorts and strategy.position_size == 0 and not shortPendingOrder and (not onlyOneActiveTradeOrOrder or not anyPendingOrder)

// Stored pullback candidates are only structure bars. Confirmation happens on
// the first later break of that structure, not on second/third continuation bars.
if not delayedEntryMode
    pendingLongDelayedSetup := false
    pendingShortDelayedSetup := false
    pendingLongDelayedSetupBar := na
    pendingShortDelayedSetupBar := na
    pendingLongDelayedSetupStop := na
    pendingShortDelayedSetupStop := na
    pendingLongDelayedBreakPrice := na
    pendingShortDelayedBreakPrice := na
    pendingLongPullbackSwingLow := na
    pendingShortPullbackSwingHigh := na
    pendingLongDelayedLocation := "N/A"
    pendingShortDelayedLocation := "N/A"
    if not longPendingOrder
        longPendingSetupType := "N/A"
        longPendingEntryMode := "N/A"
    if not shortPendingOrder
        shortPendingSetupType := "N/A"
        shortPendingEntryMode := "N/A"

bool longPullbackCandidateExpired = delayedEntryMode and pendingLongDelayedSetup and bar_index - pendingLongDelayedSetupBar > pullbackLookbackBars
bool shortPullbackCandidateExpired = delayedEntryMode and pendingShortDelayedSetup and bar_index - pendingShortDelayedSetupBar > pullbackLookbackBars

if longPullbackCandidateExpired
    pendingLongDelayedSetup := false
    pendingLongDelayedSetupBar := na
    pendingLongDelayedSetupStop := na
    pendingLongDelayedBreakPrice := na
    pendingLongPullbackSwingLow := na
    pendingLongDelayedLocation := "N/A"
    if not longPendingOrder
        longPendingSetupType := "N/A"
        longPendingEntryMode := "N/A"

if shortPullbackCandidateExpired
    pendingShortDelayedSetup := false
    pendingShortDelayedSetupBar := na
    pendingShortDelayedSetupStop := na
    pendingShortDelayedBreakPrice := na
    pendingShortPullbackSwingHigh := na
    pendingShortDelayedLocation := "N/A"
    if not shortPendingOrder
        shortPendingSetupType := "N/A"
        shortPendingEntryMode := "N/A"

bool longStoredPullbackCandidateActive = delayedEntryMode and pendingLongDelayedSetup
bool shortStoredPullbackCandidateActive = delayedEntryMode and pendingShortDelayedSetup
bool longFirstBreakAttempted = longStoredPullbackCandidateActive and bar_index > pendingLongDelayedSetupBar and high > pendingLongDelayedBreakPrice
bool shortFirstBreakAttempted = shortStoredPullbackCandidateActive and bar_index > pendingShortDelayedSetupBar and low < pendingShortDelayedBreakPrice
float delayedConfirmationBarMidpoint = (high + low) / 2.0
bool useDelayedMidpointClose = delayedConfirmationCloseMode == "Close Beyond Bar Midpoint"
bool longDelayedClosePass = longFirstBreakAttempted and (useDelayedMidpointClose ? close > delayedConfirmationBarMidpoint : close > pendingLongDelayedBreakPrice)
bool shortDelayedClosePass = shortFirstBreakAttempted and (useDelayedMidpointClose ? close < delayedConfirmationBarMidpoint : close < pendingShortDelayedBreakPrice)
bool longConfirmationMadeNewSwingLow = longFirstBreakAttempted and not na(low[1]) and low < low[1]
bool shortConfirmationMadeNewSwingHigh = shortFirstBreakAttempted and not na(high[1]) and high > high[1]

float longConfirmationEntryPrice = high + tickSize
float shortConfirmationEntryPrice = low - tickSize
float longConfirmationPullbackStop = longFirstBreakAttempted ? (longConfirmationMadeNewSwingLow and longPullbackStopValid ? longPullbackSwingStop : pendingLongDelayedSetupStop) : na
float shortConfirmationPullbackStop = shortFirstBreakAttempted ? (shortConfirmationMadeNewSwingHigh and shortPullbackStopValid ? shortPullbackSwingStop : pendingShortDelayedSetupStop) : na
bool longConfirmationPullbackStopValid = not na(longConfirmationPullbackStop)
bool shortConfirmationPullbackStopValid = not na(shortConfirmationPullbackStop)
bool longConfirmationSelectedStopValid = stopMode == "Trigger Bar" or longConfirmationPullbackStopValid
bool shortConfirmationSelectedStopValid = stopMode == "Trigger Bar" or shortConfirmationPullbackStopValid
float longConfirmationStopPrice = stopMode == "Trigger Bar" ? longTriggerStop : longConfirmationPullbackStop
float shortConfirmationStopPrice = stopMode == "Trigger Bar" ? shortTriggerStop : shortConfirmationPullbackStop
float longConfirmationRiskPoints = longConfirmationEntryPrice - longConfirmationStopPrice
float shortConfirmationRiskPoints = shortConfirmationStopPrice - shortConfirmationEntryPrice
bool longConfirmationRiskPass = longConfirmationSelectedStopValid and f_riskPass(longConfirmationRiskPoints, atrValue)
bool shortConfirmationRiskPass = shortConfirmationSelectedStopValid and f_riskPass(shortConfirmationRiskPoints, atrValue)
float longConfirmationTargetPrice = longConfirmationEntryPrice + longConfirmationRiskPoints * targetR
float shortConfirmationTargetPrice = shortConfirmationEntryPrice - shortConfirmationRiskPoints * targetR
int longConfirmationContracts = f_positionSize(longConfirmationRiskPoints)
int shortConfirmationContracts = f_positionSize(shortConfirmationRiskPoints)
bool longConfirmationTriggerQualityPass = not na(atrValue) and barRange <= atrValue * maxTriggerBarAtrMultiplier and not closeInBottomQuarter and close >= ema20 - tickSize and longConfirmationRiskPass
bool shortConfirmationTriggerQualityPass = not na(atrValue) and barRange <= atrValue * maxTriggerBarAtrMultiplier and not closeInTopQuarter and close <= ema20 + tickSize and shortConfirmationRiskPass

float maxDistanceFromMidEmaThreshold = not na(atrValue) ? atrValue * maxDistanceFromMidEmaAtrMultiplier : na
float longDistanceFromMidEma = math.abs(longEntryPrice - ema20)
float shortDistanceFromMidEma = math.abs(shortEntryPrice - ema20)
float longConfirmationDistanceFromMidEma = math.abs(longConfirmationEntryPrice - ema20)
float shortConfirmationDistanceFromMidEma = math.abs(shortConfirmationEntryPrice - ema20)
bool longMaxDistanceFromMidEmaPass = f_maxDistanceFromMidEmaPass(longEntryPrice, ema20, atrValue)
bool shortMaxDistanceFromMidEmaPass = f_maxDistanceFromMidEmaPass(shortEntryPrice, ema20, atrValue)
bool longConfirmationMaxDistanceFromMidEmaPass = f_maxDistanceFromMidEmaPass(longConfirmationEntryPrice, ema20, atrValue)
bool shortConfirmationMaxDistanceFromMidEmaPass = f_maxDistanceFromMidEmaPass(shortConfirmationEntryPrice, ema20, atrValue)

float longBadLevelBlockerThreshold = f_badLevelBlockDistance(longRiskPoints, atrValue)
float shortBadLevelBlockerThreshold = f_badLevelBlockDistance(shortRiskPoints, atrValue)
float longConfirmationBadLevelBlockerThreshold = f_badLevelBlockDistance(longConfirmationRiskPoints, atrValue)
float shortConfirmationBadLevelBlockerThreshold = f_badLevelBlockDistance(shortConfirmationRiskPoints, atrValue)
bool longBadLevelBlockerBlocked = f_longHasNearbyOverheadBlocker(longEntryPrice, longRiskPoints, atrValue)
bool shortBadLevelBlockerBlocked = f_shortHasNearbyDownsideBlocker(shortEntryPrice, shortRiskPoints, atrValue)
bool longConfirmationBadLevelBlockerBlocked = f_longHasNearbyOverheadBlocker(longConfirmationEntryPrice, longConfirmationRiskPoints, atrValue)
bool shortConfirmationBadLevelBlockerBlocked = f_shortHasNearbyDownsideBlocker(shortConfirmationEntryPrice, shortConfirmationRiskPoints, atrValue)
bool longBadLevelBlockerPass = not longBadLevelBlockerBlocked
bool shortBadLevelBlockerPass = not shortBadLevelBlockerBlocked
bool longConfirmationBadLevelBlockerPass = not longConfirmationBadLevelBlockerBlocked
bool shortConfirmationBadLevelBlockerPass = not shortConfirmationBadLevelBlockerBlocked

bool longPullbackStructureGatePass = longCurrentBarIsPullbackStructure
bool shortPullbackStructureGatePass = shortCurrentBarIsPullbackStructure

bool longStandardSetupQualifies = canPlaceLongOrder and longOpeningRangeBiasPass and longContextPass and longLocationPass and longFinalEmaClosePass and longTouchedAcceptancePass and longMaxDistanceFromMidEmaPass and longBadLevelBlockerPass and longTriggerQualityPass and longContracts >= 1
bool shortStandardSetupQualifies = canPlaceShortOrder and shortOpeningRangeBiasPass and shortContextPass and shortLocationPass and shortFinalEmaClosePass and shortTouchedAcceptancePass and shortMaxDistanceFromMidEmaPass and shortBadLevelBlockerPass and shortTriggerQualityPass and shortContracts >= 1
bool longStandardConfirmationQualifies = canPlaceLongOrder and longDelayedClosePass and longOpeningRangeBiasPass and longContextPass and longLocationPass and longFinalEmaClosePass and longTouchedAcceptancePass and longConfirmationMaxDistanceFromMidEmaPass and longConfirmationBadLevelBlockerPass and longConfirmationTriggerQualityPass and longConfirmationContracts >= 1
bool shortStandardConfirmationQualifies = canPlaceShortOrder and shortDelayedClosePass and shortOpeningRangeBiasPass and shortContextPass and shortLocationPass and shortFinalEmaClosePass and shortTouchedAcceptancePass and shortConfirmationMaxDistanceFromMidEmaPass and shortConfirmationBadLevelBlockerPass and shortConfirmationTriggerQualityPass and shortConfirmationContracts >= 1

bool longFiftyRejectionStackPass = f_geWithTolerance(ema9, ema20) and f_geWithTolerance(ema20, ema50)
bool shortFiftyRejectionStackPass = f_leWithTolerance(ema9, ema20) and f_leWithTolerance(ema20, ema50)
bool longFiftyRejectionContextPass = longFiftyRejectionStackPass and longEmaSlopePass and not longEmaChopBlocked and not twentyEmaCrossChopBlocked
bool shortFiftyRejectionContextPass = shortFiftyRejectionStackPass and shortEmaSlopePass and not shortEmaChopBlocked and not twentyEmaCrossChopBlocked
bool longFiftyRejectionLocationPass = f_directionalPriceInteraction(ema50, open, high, low, close, atrValue, proximityAtrMultiplier, true)
bool shortFiftyRejectionLocationPass = f_directionalPriceInteraction(ema50, open, high, low, close, atrValue, proximityAtrMultiplier, false)
bool longFiftyRejectionCleanPullback = not na(ema9) and not na(ema20) and high < math.min(ema9, ema20) - tickSize * 0.05
bool shortFiftyRejectionCleanPullback = not na(ema9) and not na(ema20) and low > math.max(ema9, ema20) + tickSize * 0.05
bool longFiftyRejectionTriggerQualityPass = not na(atrValue) and barRange <= atrValue * maxTriggerBarAtrMultiplier and not closeInBottomQuarter and longRiskPass
bool shortFiftyRejectionTriggerQualityPass = not na(atrValue) and barRange <= atrValue * maxTriggerBarAtrMultiplier and not closeInTopQuarter and shortRiskPass
bool longFiftyRejectionConfirmationQualityPass = not na(atrValue) and barRange <= atrValue * maxTriggerBarAtrMultiplier and not closeInBottomQuarter and longConfirmationRiskPass
bool shortFiftyRejectionConfirmationQualityPass = not na(atrValue) and barRange <= atrValue * maxTriggerBarAtrMultiplier and not closeInTopQuarter and shortConfirmationRiskPass
bool longFiftyRejectionSetupQualifies = useFiftyEmaRejectionSetup and canPlaceLongOrder and longOpeningRangeBiasPass and longFiftyRejectionContextPass and longFiftyRejectionLocationPass and longFiftyRejectionCleanPullback and longTouchedAcceptancePass and longMaxDistanceFromMidEmaPass and longBadLevelBlockerPass and longFiftyRejectionTriggerQualityPass and longContracts >= 1
bool shortFiftyRejectionSetupQualifies = useFiftyEmaRejectionSetup and canPlaceShortOrder and shortOpeningRangeBiasPass and shortFiftyRejectionContextPass and shortFiftyRejectionLocationPass and shortFiftyRejectionCleanPullback and shortTouchedAcceptancePass and shortMaxDistanceFromMidEmaPass and shortBadLevelBlockerPass and shortFiftyRejectionTriggerQualityPass and shortContracts >= 1
bool longFiftyRejectionConfirmationQualifies = useFiftyEmaRejectionSetup and canPlaceLongOrder and longDelayedClosePass and longOpeningRangeBiasPass and longFiftyRejectionContextPass and longFiftyRejectionLocationPass and longFiftyRejectionCleanPullback and longTouchedAcceptancePass and longConfirmationMaxDistanceFromMidEmaPass and longConfirmationBadLevelBlockerPass and longFiftyRejectionConfirmationQualityPass and longConfirmationContracts >= 1
bool shortFiftyRejectionConfirmationQualifies = useFiftyEmaRejectionSetup and canPlaceShortOrder and shortDelayedClosePass and shortOpeningRangeBiasPass and shortFiftyRejectionContextPass and shortFiftyRejectionLocationPass and shortFiftyRejectionCleanPullback and shortTouchedAcceptancePass and shortConfirmationMaxDistanceFromMidEmaPass and shortConfirmationBadLevelBlockerPass and shortFiftyRejectionConfirmationQualityPass and shortConfirmationContracts >= 1

bool longAnySetupQualifies = longStandardSetupQualifies or longFiftyRejectionSetupQualifies
bool shortAnySetupQualifies = shortStandardSetupQualifies or shortFiftyRejectionSetupQualifies
bool longAnyConfirmationQualifies = longStandardConfirmationQualifies or longFiftyRejectionConfirmationQualifies
bool shortAnyConfirmationQualifies = shortStandardConfirmationQualifies or shortFiftyRejectionConfirmationQualifies
string longSetupType = longStandardSetupQualifies ? "STD" : longFiftyRejectionSetupQualifies ? "50R" : "N/A"
string shortSetupType = shortStandardSetupQualifies ? "STD" : shortFiftyRejectionSetupQualifies ? "50R" : "N/A"
string longConfirmationSetupType = longStandardConfirmationQualifies ? "STD" : longFiftyRejectionConfirmationQualifies ? "50R" : "N/A"
string shortConfirmationSetupType = shortStandardConfirmationQualifies ? "STD" : shortFiftyRejectionConfirmationQualifies ? "50R" : "N/A"
string longSetupLocation = longSetupType == "50R" ? "50EMA" : longLocationName
string shortSetupLocation = shortSetupType == "50R" ? "50EMA" : shortLocationName
string longConfirmationLocation = longConfirmationSetupType == "50R" ? "50EMA" : longLocationName
string shortConfirmationLocation = shortConfirmationSetupType == "50R" ? "50EMA" : shortLocationName
bool longCandidateSetup = longPullbackStructureGatePass and longAnySetupQualifies and not longFirstBreakAttempted
bool shortCandidateSetup = shortPullbackStructureGatePass and shortAnySetupQualifies and not shortFirstBreakAttempted
bool longDelayedConfirmationSetup = longDelayedClosePass and longAnyConfirmationQualifies
bool shortDelayedConfirmationSetup = shortDelayedClosePass and shortAnyConfirmationQualifies
bool longFirstBreakFailed = longFirstBreakAttempted and not longDelayedConfirmationSetup
bool shortFirstBreakFailed = shortFirstBreakAttempted and not shortDelayedConfirmationSetup
bool longChasingBlocked = requirePullback and canPlaceLongOrder and not longCurrentBarIsPullbackStructure and not longStoredPullbackCandidateActive and not na(high[1]) and high > high[1] and longPullbackPass
bool shortChasingBlocked = requirePullback and canPlaceShortOrder and not shortCurrentBarIsPullbackStructure and not shortStoredPullbackCandidateActive and not na(low[1]) and low < low[1] and shortPullbackPass
bool longDebugRiskPass = longFirstBreakAttempted ? longConfirmationRiskPass : longRiskPass
bool shortDebugRiskPass = shortFirstBreakAttempted ? shortConfirmationRiskPass : shortRiskPass
bool longDebugTriggerQualityPass = longFirstBreakAttempted ? longConfirmationTriggerQualityPass : longTriggerQualityPass
bool shortDebugTriggerQualityPass = shortFirstBreakAttempted ? shortConfirmationTriggerQualityPass : shortTriggerQualityPass
float longDebugRiskPoints = longFirstBreakAttempted ? longConfirmationRiskPoints : longRiskPoints
float shortDebugRiskPoints = shortFirstBreakAttempted ? shortConfirmationRiskPoints : shortRiskPoints
int longDebugContracts = longFirstBreakAttempted ? longConfirmationContracts : longContracts
int shortDebugContracts = shortFirstBreakAttempted ? shortConfirmationContracts : shortContracts
bool longDebugMaxDistanceFromMidEmaPass = longFirstBreakAttempted ? longConfirmationMaxDistanceFromMidEmaPass : longMaxDistanceFromMidEmaPass
bool shortDebugMaxDistanceFromMidEmaPass = shortFirstBreakAttempted ? shortConfirmationMaxDistanceFromMidEmaPass : shortMaxDistanceFromMidEmaPass
float longDebugDistanceFromMidEma = longFirstBreakAttempted ? longConfirmationDistanceFromMidEma : longDistanceFromMidEma
float shortDebugDistanceFromMidEma = shortFirstBreakAttempted ? shortConfirmationDistanceFromMidEma : shortDistanceFromMidEma
bool longDebugBadLevelBlockerBlocked = longFirstBreakAttempted ? longConfirmationBadLevelBlockerBlocked : longBadLevelBlockerBlocked
bool shortDebugBadLevelBlockerBlocked = shortFirstBreakAttempted ? shortConfirmationBadLevelBlockerBlocked : shortBadLevelBlockerBlocked
bool longDebugBadLevelBlockerPass = not longDebugBadLevelBlockerBlocked
bool shortDebugBadLevelBlockerPass = not shortDebugBadLevelBlockerBlocked
float longDebugBadLevelBlockerThreshold = longFirstBreakAttempted ? longConfirmationBadLevelBlockerThreshold : longBadLevelBlockerThreshold
float shortDebugBadLevelBlockerThreshold = shortFirstBreakAttempted ? shortConfirmationBadLevelBlockerThreshold : shortBadLevelBlockerThreshold

if showBadLevelBlockerDebug and barstate.isconfirmed and canEvaluateSignals and useBadLevelContinuationBlocker
    if (longCurrentBarIsPullbackStructure or longFirstBreakAttempted) and longDebugBadLevelBlockerBlocked
        label.new(bar_index, high, "L blocked: nearby continuation obstacle\nEntry " + f_priceText(longFirstBreakAttempted ? longConfirmationEntryPrice : longEntryPrice) + "\nRisk " + f_pointsText(longDebugRiskPoints) + " Threshold " + f_pointsText(longDebugBadLevelBlockerThreshold), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.tiny)
    if (shortCurrentBarIsPullbackStructure or shortFirstBreakAttempted) and shortDebugBadLevelBlockerBlocked
        label.new(bar_index, low, "S blocked: nearby continuation obstacle\nEntry " + f_priceText(shortFirstBreakAttempted ? shortConfirmationEntryPrice : shortEntryPrice) + "\nRisk " + f_pointsText(shortDebugRiskPoints) + " Threshold " + f_pointsText(shortDebugBadLevelBlockerThreshold), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0), size=size.tiny)

// Stop-entry logic: a confirmed setup submits a buy stop one tick above the
// trigger bar high, or a sell stop one tick below the trigger bar low.
if longDelayedConfirmationSetup
    longPendingOrder := true
    longPendingSignalBar := bar_index
    longPendingEntry := longConfirmationEntryPrice
    longPendingStop := longConfirmationStopPrice
    longPendingTarget := longConfirmationTargetPrice
    longPendingRisk := longConfirmationRiskPoints
    longPendingOneRTarget := longConfirmationEntryPrice + longConfirmationRiskPoints
    longPendingContracts := longConfirmationContracts
    longPendingRiskDollars := longPendingRisk * longPendingContracts * pointValue
    longPendingLocation := longConfirmationLocation
    longPendingSetupType := longConfirmationSetupType
    longPendingEntryMode := "Delayed"
    activeLongStop := longConfirmationStopPrice
    activeLongTarget := longConfirmationTargetPrice
    longSetupPlacedEvent := true
    longSetupAlertEntry := longConfirmationEntryPrice
    longSetupAlertStop := longConfirmationStopPrice
    longSetupAlertTarget := longConfirmationTargetPrice
    longSetupAlertRisk := longConfirmationRiskPoints
    longSetupAlertTargetR := targetR
    longSetupAlertLocationCode := f_locationCode(longConfirmationLocation)
    string longAlertMessage = f_buildSetupAlertMessage("LONG", longConfirmationLocation, longConfirmationEntryPrice, longConfirmationStopPrice, longConfirmationTargetPrice, longConfirmationRiskPoints, targetR, longConfirmationContracts)
    strategy.entry(LONG_ENTRY_ID, strategy.long, qty=longConfirmationContracts, stop=longConfirmationEntryPrice, alert_message=longAlertMessage)
    alert(longAlertMessage, alert.freq_once_per_bar_close)
    if alertLabelMode == "Compact" and showBullSignals
        f_addSetupChartLabel(true, f_buildSetupLabelText("LONG " + longConfirmationSetupType, longConfirmationLocation, longConfirmationEntryPrice, longConfirmationStopPrice, longConfirmationTargetPrice, targetR))
    lastSignalReason := "Long first-break " + longConfirmationSetupType + " placed: " + longConfirmationLocation
    pendingLongDelayedSetup := false
    pendingLongDelayedSetupBar := na
    pendingLongDelayedSetupStop := na
    pendingLongDelayedBreakPrice := na
    pendingLongPullbackSwingLow := na
    pendingLongDelayedLocation := "N/A"

if shortDelayedConfirmationSetup and (not onlyOneActiveTradeOrOrder or not longPendingOrder)
    shortPendingOrder := true
    shortPendingSignalBar := bar_index
    shortPendingEntry := shortConfirmationEntryPrice
    shortPendingStop := shortConfirmationStopPrice
    shortPendingTarget := shortConfirmationTargetPrice
    shortPendingRisk := shortConfirmationRiskPoints
    shortPendingOneRTarget := shortConfirmationEntryPrice - shortConfirmationRiskPoints
    shortPendingContracts := shortConfirmationContracts
    shortPendingRiskDollars := shortPendingRisk * shortPendingContracts * pointValue
    shortPendingLocation := shortConfirmationLocation
    shortPendingSetupType := shortConfirmationSetupType
    shortPendingEntryMode := "Delayed"
    activeShortStop := shortConfirmationStopPrice
    activeShortTarget := shortConfirmationTargetPrice
    shortSetupPlacedEvent := true
    shortSetupAlertEntry := shortConfirmationEntryPrice
    shortSetupAlertStop := shortConfirmationStopPrice
    shortSetupAlertTarget := shortConfirmationTargetPrice
    shortSetupAlertRisk := shortConfirmationRiskPoints
    shortSetupAlertTargetR := targetR
    shortSetupAlertLocationCode := f_locationCode(shortConfirmationLocation)
    string shortAlertMessage = f_buildSetupAlertMessage("SHORT", shortConfirmationLocation, shortConfirmationEntryPrice, shortConfirmationStopPrice, shortConfirmationTargetPrice, shortConfirmationRiskPoints, targetR, shortConfirmationContracts)
    strategy.entry(SHORT_ENTRY_ID, strategy.short, qty=shortConfirmationContracts, stop=shortConfirmationEntryPrice, alert_message=shortAlertMessage)
    alert(shortAlertMessage, alert.freq_once_per_bar_close)
    if alertLabelMode == "Compact" and showBearSignals
        f_addSetupChartLabel(false, f_buildSetupLabelText("SHORT " + shortConfirmationSetupType, shortConfirmationLocation, shortConfirmationEntryPrice, shortConfirmationStopPrice, shortConfirmationTargetPrice, targetR))
    lastSignalReason := "Short first-break " + shortConfirmationSetupType + " placed: " + shortConfirmationLocation
    pendingShortDelayedSetup := false
    pendingShortDelayedSetupBar := na
    pendingShortDelayedSetupStop := na
    pendingShortDelayedBreakPrice := na
    pendingShortPullbackSwingHigh := na
    pendingShortDelayedLocation := "N/A"

bool longImmediateCanStillPlace = longCandidateSetup and not longPendingOrder and (not onlyOneActiveTradeOrOrder or not shortPendingOrder)
bool shortImmediateCanStillPlace = shortCandidateSetup and not shortPendingOrder and (not onlyOneActiveTradeOrOrder or not longPendingOrder)

if longImmediateCanStillPlace
    longPendingOrder := true
    longPendingSignalBar := bar_index
    longPendingEntry := longEntryPrice
    longPendingStop := longStopPrice
    longPendingTarget := longTargetPrice
    longPendingRisk := longRiskPoints
    longPendingOneRTarget := longEntryPrice + longRiskPoints
    longPendingContracts := longContracts
    longPendingRiskDollars := longPendingRisk * longPendingContracts * pointValue
    longPendingLocation := longSetupLocation
    longPendingSetupType := longSetupType
    longPendingEntryMode := "Immediate"
    activeLongStop := longStopPrice
    activeLongTarget := longTargetPrice
    longSetupPlacedEvent := true
    longSetupAlertEntry := longEntryPrice
    longSetupAlertStop := longStopPrice
    longSetupAlertTarget := longTargetPrice
    longSetupAlertRisk := longRiskPoints
    longSetupAlertTargetR := targetR
    longSetupAlertLocationCode := f_locationCode(longSetupLocation)
    string longAlertMessage = f_buildSetupAlertMessage("LONG", longSetupLocation, longEntryPrice, longStopPrice, longTargetPrice, longRiskPoints, targetR, longContracts)
    strategy.entry(LONG_ENTRY_ID, strategy.long, qty=longContracts, stop=longEntryPrice, alert_message=longAlertMessage)
    alert(longAlertMessage, alert.freq_once_per_bar_close)
    if alertLabelMode == "Compact" and showBullSignals
        f_addSetupChartLabel(true, f_buildSetupLabelText("LONG " + longSetupType, longSetupLocation, longEntryPrice, longStopPrice, longTargetPrice, targetR))
    pendingLongDelayedSetup := false
    pendingLongDelayedSetupBar := na
    pendingLongDelayedSetupStop := na
    pendingLongDelayedBreakPrice := na
    pendingLongPullbackSwingLow := na
    pendingLongDelayedLocation := "N/A"
    lastSignalReason := "Long " + longSetupType + " placed: " + longSetupLocation

if shortImmediateCanStillPlace and (not onlyOneActiveTradeOrOrder or not longPendingOrder)
    shortPendingOrder := true
    shortPendingSignalBar := bar_index
    shortPendingEntry := shortEntryPrice
    shortPendingStop := shortStopPrice
    shortPendingTarget := shortTargetPrice
    shortPendingRisk := shortRiskPoints
    shortPendingOneRTarget := shortEntryPrice - shortRiskPoints
    shortPendingContracts := shortContracts
    shortPendingRiskDollars := shortPendingRisk * shortPendingContracts * pointValue
    shortPendingLocation := shortSetupLocation
    shortPendingSetupType := shortSetupType
    shortPendingEntryMode := "Immediate"
    activeShortStop := shortStopPrice
    activeShortTarget := shortTargetPrice
    shortSetupPlacedEvent := true
    shortSetupAlertEntry := shortEntryPrice
    shortSetupAlertStop := shortStopPrice
    shortSetupAlertTarget := shortTargetPrice
    shortSetupAlertRisk := shortRiskPoints
    shortSetupAlertTargetR := targetR
    shortSetupAlertLocationCode := f_locationCode(shortSetupLocation)
    string shortAlertMessage = f_buildSetupAlertMessage("SHORT", shortSetupLocation, shortEntryPrice, shortStopPrice, shortTargetPrice, shortRiskPoints, targetR, shortContracts)
    strategy.entry(SHORT_ENTRY_ID, strategy.short, qty=shortContracts, stop=shortEntryPrice, alert_message=shortAlertMessage)
    alert(shortAlertMessage, alert.freq_once_per_bar_close)
    if alertLabelMode == "Compact" and showBearSignals
        f_addSetupChartLabel(false, f_buildSetupLabelText("SHORT " + shortSetupType, shortSetupLocation, shortEntryPrice, shortStopPrice, shortTargetPrice, targetR))
    pendingShortDelayedSetup := false
    pendingShortDelayedSetupBar := na
    pendingShortDelayedSetupStop := na
    pendingShortDelayedBreakPrice := na
    pendingShortPullbackSwingHigh := na
    pendingShortDelayedLocation := "N/A"
    lastSignalReason := "Short " + shortSetupType + " placed: " + shortSetupLocation

if longFirstBreakAttempted and not longSetupPlacedEvent
    pendingLongDelayedSetup := false
    pendingLongDelayedSetupBar := na
    pendingLongDelayedSetupStop := na
    pendingLongDelayedBreakPrice := na
    pendingLongPullbackSwingLow := na
    pendingLongDelayedLocation := "N/A"
    if not longPendingOrder
        longPendingSetupType := "N/A"
        longPendingEntryMode := "N/A"
    if not longSetupPlacedEvent and not shortSetupPlacedEvent
        lastSignalReason := longFirstBreakFailed ? "Long first-break failed" : "Long first-break blocked"

if shortFirstBreakAttempted and not shortSetupPlacedEvent
    pendingShortDelayedSetup := false
    pendingShortDelayedSetupBar := na
    pendingShortDelayedSetupStop := na
    pendingShortDelayedBreakPrice := na
    pendingShortPullbackSwingHigh := na
    pendingShortDelayedLocation := "N/A"
    if not shortPendingOrder
        shortPendingSetupType := "N/A"
        shortPendingEntryMode := "N/A"
    if not longSetupPlacedEvent and not shortSetupPlacedEvent
        lastSignalReason := shortFirstBreakFailed ? "Short first-break failed" : "Short first-break blocked"

bool longPullbackCandidateStoredEvent = delayedEntryMode and canPlaceLongOrder and longCurrentBarIsPullbackStructure and not longFirstBreakAttempted and not longSetupPlacedEvent and not shortSetupPlacedEvent and not longPendingOrder and (not onlyOneActiveTradeOrOrder or not shortPendingOrder)
bool shortPullbackCandidateStoredEvent = delayedEntryMode and canPlaceShortOrder and shortCurrentBarIsPullbackStructure and not shortFirstBreakAttempted and not longSetupPlacedEvent and not shortSetupPlacedEvent and not shortPendingOrder and (not onlyOneActiveTradeOrOrder or not longPendingOrder)

if longPullbackCandidateStoredEvent
    pendingLongDelayedSetup := true
    pendingLongDelayedSetupBar := bar_index
    pendingLongDelayedBreakPrice := high
    pendingLongDelayedSetupStop := longPullbackSwingStop
    pendingLongPullbackSwingLow := longPullbackSwingLow
    pendingLongDelayedLocation := longLocationPass ? longLocationName : "N/A"
    lastSignalReason := "Long pullback stored"

if shortPullbackCandidateStoredEvent
    pendingShortDelayedSetup := true
    pendingShortDelayedSetupBar := bar_index
    pendingShortDelayedBreakPrice := low
    pendingShortDelayedSetupStop := shortPullbackSwingStop
    pendingShortPullbackSwingHigh := shortPullbackSwingHigh
    pendingShortDelayedLocation := shortLocationPass ? shortLocationName : "N/A"
    lastSignalReason := "Short pullback stored"

if canEvaluateSignals and not longSetupPlacedEvent and not shortSetupPlacedEvent and not longPullbackCandidateStoredEvent and not shortPullbackCandidateStoredEvent
    if longFirstBreakFailed
        lastSignalReason := "Long first-break failed"
    else if shortFirstBreakFailed
        lastSignalReason := "Short first-break failed"
    else if longChasingBlocked
        lastSignalReason := "Long chasing blocked"
    else if shortChasingBlocked
        lastSignalReason := "Short chasing blocked"
    else if longCurrentBarIsPullbackStructure and not longAnySetupQualifies
        lastSignalReason := "Long pullback bar blocked"
    else if shortCurrentBarIsPullbackStructure and not shortAnySetupQualifies
        lastSignalReason := "Short pullback bar blocked"
    else if longCurrentBarIsPullbackStructure and not longCandidateSetup
        lastSignalReason := "Long structure lacks setup"
    else if shortCurrentBarIsPullbackStructure and not shortCandidateSetup
        lastSignalReason := "Short structure lacks setup"
    else if not longCandidateSetup and not shortCandidateSetup
        lastSignalReason := not useLongs and not useShorts ? "Directions disabled" :
         not inAlertTradingWindow ? "Outside trading window" :
         tradesToday >= maxTradesPerDay ? "Max trades reached" :
         anyPendingOrder ? "Pending order active" :
         hasOpenPosition ? "Position active" :
         "No complete setup"

bool trimManagementMode = managementMode == "Trim 1R + BE"
int activeLongPositionQty = strategy.position_size > 0 ? int(math.abs(strategy.position_size)) : 0
int activeShortPositionQty = strategy.position_size < 0 ? int(math.abs(strategy.position_size)) : 0
bool longTrimStateMissing = trimManagementMode and activeLongPositionQty >= 2 and (not activeLongTrimManagementEligible or na(activeLongTrimQty) or na(activeLongRunnerQty) or na(activeLongOneRTarget) or na(activeLongRunnerStop) or na(activeLongFilledQty))
bool shortTrimStateMissing = trimManagementMode and activeShortPositionQty >= 2 and (not activeShortTrimManagementEligible or na(activeShortTrimQty) or na(activeShortRunnerQty) or na(activeShortOneRTarget) or na(activeShortRunnerStop) or na(activeShortFilledQty))
bool longPositionNeedsActiveInit = strategy.position_size > 0 and (na(activeLongAverageFillPrice) or na(activeLongEntry) or na(activeLongStop) or na(activeLongTarget) or na(activeLongRisk) or activeLongRisk <= 0 or na(activeLongFilledQty) or longTrimStateMissing)
bool shortPositionNeedsActiveInit = strategy.position_size < 0 and (na(activeShortAverageFillPrice) or na(activeShortEntry) or na(activeShortStop) or na(activeShortTarget) or na(activeShortRisk) or activeShortRisk <= 0 or na(activeShortFilledQty) or shortTrimStateMissing)

if longPositionNeedsActiveInit
    float recoveredLongAvg = strategy.position_avg_price
    float recoveredLongEntry = not na(activeLongEntry) ? activeLongEntry : not na(longPendingEntry) ? longPendingEntry : recoveredLongAvg
    float recoveredLongStop = not na(activeLongStop) ? activeLongStop : longPendingStop
    float recoveredLongRisk = not na(activeLongRisk) and activeLongRisk > 0 ? activeLongRisk : not na(recoveredLongStop) ? recoveredLongAvg - recoveredLongStop : na
    float recoveredLongOneR = not na(activeLongOneRTarget) ? activeLongOneRTarget : not na(longPendingOneRTarget) ? longPendingOneRTarget : not na(recoveredLongRisk) and recoveredLongRisk > 0 ? recoveredLongAvg + recoveredLongRisk : na
    float recoveredLongTarget = not na(activeLongTarget) ? activeLongTarget : not na(longPendingTarget) ? longPendingTarget : not na(recoveredLongRisk) and recoveredLongRisk > 0 ? recoveredLongAvg + recoveredLongRisk * targetR : na
    activeLongEntry := recoveredLongEntry
    activeLongAverageFillPrice := recoveredLongAvg
    activeLongStop := recoveredLongStop
    activeLongRisk := recoveredLongRisk
    activeLongOneRTarget := recoveredLongOneR
    activeLongTarget := recoveredLongTarget
    activeLongFilledQty := activeLongPositionQty
    activeLongTrimManagementEligible := trimManagementMode and activeLongPositionQty >= 2 and not na(activeLongRisk) and activeLongRisk > 0 and not na(activeLongStop) and not na(activeLongOneRTarget) and not na(activeLongTarget)
    activeLongFixedRFallback := trimManagementMode and activeLongPositionQty < 2
    activeLongTrimQty := activeLongTrimManagementEligible ? f_trimContracts(activeLongPositionQty, trimAtOneRPercent) : na
    activeLongRunnerQty := activeLongTrimManagementEligible ? activeLongPositionQty - activeLongTrimQty : na
    activeLongRunnerStop := activeLongTrimManagementEligible ? (longOneRReached ? math.max(activeLongStop, recoveredLongAvg + tickSize) : activeLongStop) : activeLongStop
    activeShortTrimManagementEligible := false
    activeShortFixedRFallback := false
    activeShortTrimQty := na
    activeShortRunnerQty := na
    string longRecoveryIssue = f_trimStateIssueText(activeLongPositionQty, activeLongStop, activeLongRisk, activeLongOneRTarget, activeLongTarget, activeLongTrimQty, activeLongRunnerQty)
    if showStrategyDebugLabels and activeLongTrimManagementEligible
        label.new(bar_index, low, "Recovered active long trim state\nQty " + str.tostring(activeLongPositionQty) + " T " + str.tostring(activeLongTrimQty) + " R " + str.tostring(activeLongRunnerQty) + "\nEntry " + f_priceText(activeLongEntry) + " Avg " + f_priceText(activeLongAverageFillPrice) + "\nStop " + f_priceText(activeLongStop) + " Risk " + f_pointsText(activeLongRisk) + "\n1R " + f_priceText(activeLongOneRTarget) + " Target " + f_priceText(activeLongTarget), style=label.style_label_up, textcolor=color.white, color=color.new(color.green, 0), size=size.tiny)
    if showStrategyDebugLabels and trimManagementMode and activeLongPositionQty >= 2 and not activeLongTrimManagementEligible
        label.new(bar_index, high, "ERROR: Could not recover active long trim state\nReason: " + longRecoveryIssue + "\nQty " + str.tostring(activeLongPositionQty) + "\nEntry " + f_priceText(activeLongEntry) + " Avg " + f_priceText(activeLongAverageFillPrice) + "\nStop " + f_priceText(activeLongStop) + " Risk " + f_pointsText(activeLongRisk) + "\n1R " + f_priceText(activeLongOneRTarget) + " Target " + f_priceText(activeLongTarget), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.small)

if shortPositionNeedsActiveInit
    float recoveredShortAvg = strategy.position_avg_price
    float recoveredShortEntry = not na(activeShortEntry) ? activeShortEntry : not na(shortPendingEntry) ? shortPendingEntry : recoveredShortAvg
    float recoveredShortStop = not na(activeShortStop) ? activeShortStop : shortPendingStop
    float recoveredShortRisk = not na(activeShortRisk) and activeShortRisk > 0 ? activeShortRisk : not na(recoveredShortStop) ? recoveredShortStop - recoveredShortAvg : na
    float recoveredShortOneR = not na(activeShortOneRTarget) ? activeShortOneRTarget : not na(shortPendingOneRTarget) ? shortPendingOneRTarget : not na(recoveredShortRisk) and recoveredShortRisk > 0 ? recoveredShortAvg - recoveredShortRisk : na
    float recoveredShortTarget = not na(activeShortTarget) ? activeShortTarget : not na(shortPendingTarget) ? shortPendingTarget : not na(recoveredShortRisk) and recoveredShortRisk > 0 ? recoveredShortAvg - recoveredShortRisk * targetR : na
    activeShortEntry := recoveredShortEntry
    activeShortAverageFillPrice := recoveredShortAvg
    activeShortStop := recoveredShortStop
    activeShortRisk := recoveredShortRisk
    activeShortOneRTarget := recoveredShortOneR
    activeShortTarget := recoveredShortTarget
    activeShortFilledQty := activeShortPositionQty
    activeShortTrimManagementEligible := trimManagementMode and activeShortPositionQty >= 2 and not na(activeShortRisk) and activeShortRisk > 0 and not na(activeShortStop) and not na(activeShortOneRTarget) and not na(activeShortTarget)
    activeShortFixedRFallback := trimManagementMode and activeShortPositionQty < 2
    activeShortTrimQty := activeShortTrimManagementEligible ? f_trimContracts(activeShortPositionQty, trimAtOneRPercent) : na
    activeShortRunnerQty := activeShortTrimManagementEligible ? activeShortPositionQty - activeShortTrimQty : na
    activeShortRunnerStop := activeShortTrimManagementEligible ? (shortOneRReached ? math.min(activeShortStop, recoveredShortAvg - tickSize) : activeShortStop) : activeShortStop
    activeLongTrimManagementEligible := false
    activeLongFixedRFallback := false
    activeLongTrimQty := na
    activeLongRunnerQty := na
    string shortRecoveryIssue = f_trimStateIssueText(activeShortPositionQty, activeShortStop, activeShortRisk, activeShortOneRTarget, activeShortTarget, activeShortTrimQty, activeShortRunnerQty)
    if showStrategyDebugLabels and activeShortTrimManagementEligible
        label.new(bar_index, high, "Recovered active short trim state\nQty " + str.tostring(activeShortPositionQty) + " T " + str.tostring(activeShortTrimQty) + " R " + str.tostring(activeShortRunnerQty) + "\nEntry " + f_priceText(activeShortEntry) + " Avg " + f_priceText(activeShortAverageFillPrice) + "\nStop " + f_priceText(activeShortStop) + " Risk " + f_pointsText(activeShortRisk) + "\n1R " + f_priceText(activeShortOneRTarget) + " Target " + f_priceText(activeShortTarget), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.tiny)
    if showStrategyDebugLabels and trimManagementMode and activeShortPositionQty >= 2 and not activeShortTrimManagementEligible
        label.new(bar_index, low, "ERROR: Could not recover active short trim state\nReason: " + shortRecoveryIssue + "\nQty " + str.tostring(activeShortPositionQty) + "\nEntry " + f_priceText(activeShortEntry) + " Avg " + f_priceText(activeShortAverageFillPrice) + "\nStop " + f_priceText(activeShortStop) + " Risk " + f_pointsText(activeShortRisk) + "\n1R " + f_priceText(activeShortOneRTarget) + " Target " + f_priceText(activeShortTarget), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0), size=size.small)

// Historical bars cannot prove the true sequence when entry, 1R, and stop all
// occur inside the same candle. With later-bar 1R touches, this moves the runner
// stop on the confirmed bar after 1R/trim becomes available to the emulator.
bool longOneRReachedNow = barstate.isconfirmed and strategy.position_size > 0 and activeLongTrimManagementEligible and not longOneRReached and not na(activeLongOneRTarget) and high >= activeLongOneRTarget
bool shortOneRReachedNow = barstate.isconfirmed and strategy.position_size < 0 and activeShortTrimManagementEligible and not shortOneRReached and not na(activeShortOneRTarget) and low <= activeShortOneRTarget

if longOneRReachedNow
    longOneRReached := true
if shortOneRReachedNow
    shortOneRReached := true

float longBreakEvenStop = not na(activeLongAverageFillPrice) ? activeLongAverageFillPrice + tickSize : activeLongEntry + tickSize
float shortBreakEvenStop = not na(activeShortAverageFillPrice) ? activeShortAverageFillPrice - tickSize : activeShortEntry - tickSize
activeLongRunnerStop := strategy.position_size > 0 and activeLongTrimManagementEligible ? (longOneRReached ? math.max(activeLongStop, longBreakEvenStop) : activeLongStop) : activeLongStop
activeShortRunnerStop := strategy.position_size < 0 and activeShortTrimManagementEligible ? (shortOneRReached ? math.min(activeShortStop, shortBreakEvenStop) : activeShortStop) : activeShortStop
bool longRunnerStopMovedNow = longOneRReachedNow and not na(activeLongRunnerStop) and not na(activeLongStop) and activeLongRunnerStop > activeLongStop
bool shortRunnerStopMovedNow = shortOneRReachedNow and not na(activeShortRunnerStop) and not na(activeShortStop) and activeShortRunnerStop < activeShortStop

bool longFullPositionOpenAfterOneR = longOneRReachedNow and not activeLongTrimFilled and not na(activeLongFilledQty) and int(math.abs(strategy.position_size)) >= activeLongFilledQty
bool shortFullPositionOpenAfterOneR = shortOneRReachedNow and not activeShortTrimFilled and not na(activeShortFilledQty) and int(math.abs(strategy.position_size)) >= activeShortFilledQty

if showStrategyDebugLabels and longOneRReachedNow
    label.new(bar_index, high, "L 1R reached\n1R " + f_priceText(activeLongOneRTarget) + " Pos " + str.tostring(strategy.position_size) + "\nT " + str.tostring(activeLongTrimQty) + " R " + str.tostring(activeLongRunnerQty) + "\nOld stop " + f_priceText(activeLongStop) + "\nNew stop " + f_priceText(activeLongRunnerStop), style=label.style_label_down, textcolor=color.white, color=color.new(color.green, 10), size=size.tiny)
if showStrategyDebugLabels and longRunnerStopMovedNow
    label.new(bar_index, low, "L runner stop to BE\nSubmitting stop " + f_priceText(activeLongRunnerStop), style=label.style_label_up, textcolor=color.white, color=color.new(color.green, 0), size=size.tiny)
if showStrategyDebugLabels and longFullPositionOpenAfterOneR
    string longFullOpenAfterOneRText = lastFillBar == bar_index ? "AMBIGUOUS: entry and 1R same bar\nFull qty still open after calculation" : "ERROR: 1R reached but full qty still open"
    label.new(bar_index, high, longFullOpenAfterOneRText + "\nPos " + str.tostring(strategy.position_size) + " Original " + str.tostring(activeLongFilledQty) + "\nTrim eligible " + f_boolText(activeLongTrimManagementEligible), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.small)
if showStrategyDebugLabels and shortOneRReachedNow
    label.new(bar_index, low, "S 1R reached\n1R " + f_priceText(activeShortOneRTarget) + " Pos " + str.tostring(math.abs(strategy.position_size)) + "\nT " + str.tostring(activeShortTrimQty) + " R " + str.tostring(activeShortRunnerQty) + "\nOld stop " + f_priceText(activeShortStop) + "\nNew stop " + f_priceText(activeShortRunnerStop), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 10), size=size.tiny)
if showStrategyDebugLabels and shortRunnerStopMovedNow
    label.new(bar_index, high, "S runner stop to BE\nSubmitting stop " + f_priceText(activeShortRunnerStop), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.tiny)
if showStrategyDebugLabels and shortFullPositionOpenAfterOneR
    string shortFullOpenAfterOneRText = lastFillBar == bar_index ? "AMBIGUOUS: entry and 1R same bar\nFull qty still open after calculation" : "ERROR: 1R reached but full qty still open"
    label.new(bar_index, low, shortFullOpenAfterOneRText + "\nPos " + str.tostring(math.abs(strategy.position_size)) + " Original " + str.tostring(activeShortFilledQty) + "\nTrim eligible " + f_boolText(activeShortTrimManagementEligible), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0), size=size.small)

// Exit orders are managed from active fill state only. Pending stop entries do
// not submit brackets, which prevents stale fixed exits from reserving quantity
// against a later trim/runner trade.
if strategy.position_size == 0
    f_cancelAllExitOrders()

bool canManageLongExits = not entryFilledOutsideWindow and strategy.position_size > 0 and not na(activeLongStop) and not na(activeLongTarget)
bool validLongSplitExit = canManageLongExits and trimManagementMode and activeLongTrimManagementEligible and not na(activeLongTrimQty) and not na(activeLongRunnerQty) and activeLongTrimQty >= 1 and activeLongRunnerQty >= 1 and not na(activeLongOneRTarget) and not na(activeLongRunnerStop)
string longFixedRReason = trimManagementMode ? f_trimStateIssueText(activeLongPositionQty, activeLongStop, activeLongRisk, activeLongOneRTarget, activeLongTarget, activeLongTrimQty, activeLongRunnerQty) : "Fixed R mode"
bool longAllowFixedExit = canManageLongExits and (not trimManagementMode or activeLongPositionQty < 2 or (activeLongPositionQty >= 2 and (na(activeLongRisk) or activeLongRisk <= 0)))
if canManageLongExits
    longTrimExitSubmitted := validLongSplitExit and strategy.position_size > activeLongRunnerQty
    longRunnerExitSubmitted := validLongSplitExit
    longFixedExitSubmitted := not validLongSplitExit and longAllowFixedExit
    if showStrategyDebugLabels and trimManagementMode and longFixedExitSubmitted
        label.new(bar_index, high, "Fixed R submitted in Trim 1R + BE\nReason: " + longFixedRReason + "\nQty " + str.tostring(activeLongPositionQty) + "\nStop " + f_priceText(activeLongStop) + " Target " + f_priceText(activeLongTarget), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, activeLongPositionQty >= 2 ? 0 : 35), size=size.tiny)
    if showStrategyDebugLabels and trimManagementMode and activeLongPositionQty >= 2 and not validLongSplitExit and not longAllowFixedExit
        label.new(bar_index, high, "ERROR: Fixed R blocked in trim mode\nReason: " + longFixedRReason + "\nQty " + str.tostring(activeLongPositionQty) + " T " + str.tostring(activeLongTrimQty) + " R " + str.tostring(activeLongRunnerQty), style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0), size=size.small)
    f_manageLongExits(trimManagementMode, activeLongTrimManagementEligible, activeLongFixedRFallback, longAllowFixedExit, activeLongTrimQty, activeLongRunnerQty, activeLongStop, activeLongOneRTarget, activeLongRunnerStop, activeLongTarget, longOneRReached)

bool canManageShortExits = not entryFilledOutsideWindow and strategy.position_size < 0 and not na(activeShortStop) and not na(activeShortTarget)
bool validShortSplitExit = canManageShortExits and trimManagementMode and activeShortTrimManagementEligible and not na(activeShortTrimQty) and not na(activeShortRunnerQty) and activeShortTrimQty >= 1 and activeShortRunnerQty >= 1 and not na(activeShortOneRTarget) and not na(activeShortRunnerStop)
string shortFixedRReason = trimManagementMode ? f_trimStateIssueText(activeShortPositionQty, activeShortStop, activeShortRisk, activeShortOneRTarget, activeShortTarget, activeShortTrimQty, activeShortRunnerQty) : "Fixed R mode"
bool shortAllowFixedExit = canManageShortExits and (not trimManagementMode or activeShortPositionQty < 2 or (activeShortPositionQty >= 2 and (na(activeShortRisk) or activeShortRisk <= 0)))
if canManageShortExits
    shortTrimExitSubmitted := validShortSplitExit and math.abs(strategy.position_size) > activeShortRunnerQty
    shortRunnerExitSubmitted := validShortSplitExit
    shortFixedExitSubmitted := not validShortSplitExit and shortAllowFixedExit
    if showStrategyDebugLabels and trimManagementMode and shortFixedExitSubmitted
        label.new(bar_index, low, "Fixed R submitted in Trim 1R + BE\nReason: " + shortFixedRReason + "\nQty " + str.tostring(activeShortPositionQty) + "\nStop " + f_priceText(activeShortStop) + " Target " + f_priceText(activeShortTarget), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, activeShortPositionQty >= 2 ? 0 : 35), size=size.tiny)
    if showStrategyDebugLabels and trimManagementMode and activeShortPositionQty >= 2 and not validShortSplitExit and not shortAllowFixedExit
        label.new(bar_index, low, "ERROR: Fixed R blocked in trim mode\nReason: " + shortFixedRReason + "\nQty " + str.tostring(activeShortPositionQty) + " T " + str.tostring(activeShortTrimQty) + " R " + str.tostring(activeShortRunnerQty), style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0), size=size.small)
    f_manageShortExits(trimManagementMode, activeShortTrimManagementEligible, activeShortFixedRFallback, shortAllowFixedExit, activeShortTrimQty, activeShortRunnerQty, activeShortStop, activeShortOneRTarget, activeShortRunnerStop, activeShortTarget, shortOneRReached)

// ===================== Alert Conditions =====================

plot(longSetupPlacedEvent ? longSetupAlertEntry : na, "Long Setup Entry", display=display.none)
plot(longSetupPlacedEvent ? longSetupAlertStop : na, "Long Setup Stop", display=display.none)
plot(longSetupPlacedEvent ? longSetupAlertTarget : na, "Long Setup Target", display=display.none)
plot(longSetupPlacedEvent ? longSetupAlertRisk : na, "Long Setup Risk", display=display.none)
plot(longSetupPlacedEvent ? longSetupAlertTargetR : na, "Long Setup Target R", display=display.none)
plot(longSetupPlacedEvent ? longSetupAlertLocationCode : na, "Long Setup Location Code", display=display.none)
plot(shortSetupPlacedEvent ? shortSetupAlertEntry : na, "Short Setup Entry", display=display.none)
plot(shortSetupPlacedEvent ? shortSetupAlertStop : na, "Short Setup Stop", display=display.none)
plot(shortSetupPlacedEvent ? shortSetupAlertTarget : na, "Short Setup Target", display=display.none)
plot(shortSetupPlacedEvent ? shortSetupAlertRisk : na, "Short Setup Risk", display=display.none)
plot(shortSetupPlacedEvent ? shortSetupAlertTargetR : na, "Short Setup Target R", display=display.none)
plot(shortSetupPlacedEvent ? shortSetupAlertLocationCode : na, "Short Setup Location Code", display=display.none)
plot(longOrderCancelledEvent ? longCancelAlertEntry : na, "Long Cancel Entry", display=display.none)
plot(longOrderCancelledEvent ? longCancelAlertStop : na, "Long Cancel Stop", display=display.none)
plot(longOrderCancelledEvent ? longCancelAlertTarget : na, "Long Cancel Target", display=display.none)
plot(longOrderCancelledEvent ? longCancelAlertRisk : na, "Long Cancel Risk", display=display.none)
plot(longOrderCancelledEvent ? longCancelAlertReasonCode : na, "Long Cancel Reason Code", display=display.none)
plot(shortOrderCancelledEvent ? shortCancelAlertEntry : na, "Short Cancel Entry", display=display.none)
plot(shortOrderCancelledEvent ? shortCancelAlertStop : na, "Short Cancel Stop", display=display.none)
plot(shortOrderCancelledEvent ? shortCancelAlertTarget : na, "Short Cancel Target", display=display.none)
plot(shortOrderCancelledEvent ? shortCancelAlertRisk : na, "Short Cancel Risk", display=display.none)
plot(shortOrderCancelledEvent ? shortCancelAlertReasonCode : na, "Short Cancel Reason Code", display=display.none)
plot(managementMode == "Trim 1R + BE" ? 1.0 : 0.0, "Management Mode Trim 1R BE", display=display.none)
plot(inAlertTradingWindow ? 1.0 : 0.0, "In Alert Trading Window", display=display.none)
plot(longPendingOrder ? 1.0 : 0.0, "Long Pending Order", display=display.none)
plot(shortPendingOrder ? 1.0 : 0.0, "Short Pending Order", display=display.none)
plot(pendingCancelledOutsideWindow ? 1.0 : 0.0, "Pending Cancelled Outside Window", display=display.none)
plot(pendingCancelledNewSession ? 1.0 : 0.0, "Pending Cancelled New Session", display=display.none)
plot(pendingCancelledRthFlatten ? 1.0 : 0.0, "Pending Cancelled RTH Flatten", display=display.none)
plot(entryFilledOutsideWindow ? 1.0 : 0.0, "Entry Filled Outside Window", display=display.none)
plot(strategy.position_size > 0 ? activeLongEntry : strategy.position_size < 0 ? activeShortEntry : na, "Active Planned Entry", display=display.none)
plot(strategy.position_size > 0 ? activeLongAverageFillPrice : strategy.position_size < 0 ? activeShortAverageFillPrice : na, "Active Average Fill Price", display=display.none)
plot(strategy.position_size > 0 ? activeLongStop : strategy.position_size < 0 ? activeShortStop : na, "Active Original Stop", display=display.none)
plot(strategy.position_size > 0 ? activeLongRisk : strategy.position_size < 0 ? activeShortRisk : na, "Active Planned Risk", display=display.none)
plot(strategy.position_size > 0 ? activeLongOneRTarget : strategy.position_size < 0 ? activeShortOneRTarget : na, "Active 1R Target", display=display.none)
plot(strategy.position_size > 0 ? activeLongTarget : strategy.position_size < 0 ? activeShortTarget : na, "Active Final Target", display=display.none)
plot(strategy.position_size > 0 ? activeLongRunnerStop : strategy.position_size < 0 ? activeShortRunnerStop : na, "Active Runner Stop", display=display.none)
plot(strategy.position_size > 0 ? float(activeLongFilledQty) : strategy.position_size < 0 ? float(activeShortFilledQty) : na, "Active Filled Qty", display=display.none)
plot(strategy.position_size > 0 ? float(activeLongTrimQty) : strategy.position_size < 0 ? float(activeShortTrimQty) : na, "Active Trim Qty", display=display.none)
plot(strategy.position_size > 0 ? float(activeLongRunnerQty) : strategy.position_size < 0 ? float(activeShortRunnerQty) : na, "Active Runner Qty", display=display.none)
plot((strategy.position_size > 0 and activeLongTrimManagementEligible) or (strategy.position_size < 0 and activeShortTrimManagementEligible) ? 1.0 : 0.0, "Active Trim Eligible", display=display.none)
plot((strategy.position_size > 0 and longOneRReached) or (strategy.position_size < 0 and shortOneRReached) ? 1.0 : 0.0, "Active 1R Reached", display=display.none)
plot((strategy.position_size > 0 and activeLongFixedRFallback) or (strategy.position_size < 0 and activeShortFixedRFallback) ? 1.0 : 0.0, "Active FixedR Fallback", display=display.none)
plot(longTrimExitSubmitted or shortTrimExitSubmitted ? 1.0 : 0.0, "Trim Exit Submitted", display=display.none)
plot(longRunnerExitSubmitted or shortRunnerExitSubmitted ? 1.0 : 0.0, "Runner Exit Submitted", display=display.none)
plot(longFixedExitSubmitted or shortFixedExitSubmitted ? 1.0 : 0.0, "Fixed Exit Submitted", display=display.none)

alertcondition(longSetupPlacedEvent, "Long setup placed", "EMA Level Pullback Break Strategy LONG {{ticker}} Entry {{plot(\"Long Setup Entry\")}} Stop {{plot(\"Long Setup Stop\")}} Target {{plot(\"Long Setup Target\")}} Risk {{plot(\"Long Setup Risk\")}} TargetR {{plot(\"Long Setup Target R\")}} LocationCode {{plot(\"Long Setup Location Code\")}}")
alertcondition(shortSetupPlacedEvent, "Short setup placed", "EMA Level Pullback Break Strategy SHORT {{ticker}} Entry {{plot(\"Short Setup Entry\")}} Stop {{plot(\"Short Setup Stop\")}} Target {{plot(\"Short Setup Target\")}} Risk {{plot(\"Short Setup Risk\")}} TargetR {{plot(\"Short Setup Target R\")}} LocationCode {{plot(\"Short Setup Location Code\")}}")
alertcondition(longOrderCancelledEvent, "Long order cancelled", "EMA Level Pullback Break Strategy LONG CANCEL {{ticker}} Entry {{plot(\"Long Cancel Entry\")}} Stop {{plot(\"Long Cancel Stop\")}} Target {{plot(\"Long Cancel Target\")}} Risk {{plot(\"Long Cancel Risk\")}} ReasonCode {{plot(\"Long Cancel Reason Code\")}}")
alertcondition(shortOrderCancelledEvent, "Short order cancelled", "EMA Level Pullback Break Strategy SHORT CANCEL {{ticker}} Entry {{plot(\"Short Cancel Entry\")}} Stop {{plot(\"Short Cancel Stop\")}} Target {{plot(\"Short Cancel Target\")}} Risk {{plot(\"Short Cancel Risk\")}} ReasonCode {{plot(\"Short Cancel Reason Code\")}}")

// ===================== Plots / Historical Markers =====================

plot(ema9, "EMA 9", color=color.new(color.yellow, 0), linewidth=1)
plot(ema20, "EMA 20", color=color.new(color.orange, 0), linewidth=2)
plot(ema50, "EMA 50", color=color.new(color.red, 0), linewidth=2)

plot(showLevels and inRthSession ? basePrevDayHigh : na, "RTH Previous Day High", color=majorHighLevelColor, linewidth=2, style=plot.style_linebr)
plot(showLevels and inRthSession ? basePrevDayLow : na, "RTH Previous Day Low", color=majorLowLevelColor, linewidth=2, style=plot.style_linebr)
plot(showLevels and (inPremarketSession or inRthSession) ? (inPremarketSession ? autoPremarketHigh : basePremarketHigh) : na, "Premarket High", color=premarketLevelColor, linewidth=1, style=plot.style_linebr)
plot(showLevels and (inPremarketSession or inRthSession) ? (inPremarketSession ? autoPremarketLow : basePremarketLow) : na, "Premarket Low", color=premarketLevelColor, linewidth=1, style=plot.style_linebr)
plot(showLevels and inRthSession ? baseRthOpen : na, "RTH Open", color=openLevelColor, linewidth=2, style=plot.style_linebr)
plot(showOpeningRange and inRthSession ? openingRangeDisplayHigh : na, "15m Opening Range High", color=openingRangeHighColor, linewidth=1, style=plot.style_linebr)
plot(showOpeningRange and inRthSession ? openingRangeDisplayLow : na, "15m Opening Range Low", color=openingRangeLowColor, linewidth=1, style=plot.style_linebr)

plotshape(alertLabelMode == "Marker Only" and showBullSignals and longSetupPlacedEvent, title="Long Marker", style=shape.triangleup, location=location.belowbar, color=bullSignalColor, size=size.tiny, text="L", textcolor=color.white)
plotshape(alertLabelMode == "Marker Only" and showBearSignals and shortSetupPlacedEvent, title="Short Marker", style=shape.triangledown, location=location.abovebar, color=bearSignalColor, size=size.tiny, text="S", textcolor=color.white)

bool showLongStrategyDebugLabel = showStrategyDebugLabels and barstate.isconfirmed and not longSetupPlacedEvent and (longCurrentBarIsPullbackStructure or longStoredPullbackCandidateActive or longFirstBreakAttempted or longFirstBreakFailed or longChasingBlocked)
bool showShortStrategyDebugLabel = showStrategyDebugLabels and barstate.isconfirmed and not shortSetupPlacedEvent and not showLongStrategyDebugLabel and (shortCurrentBarIsPullbackStructure or shortStoredPullbackCandidateActive or shortFirstBreakAttempted or shortFirstBreakFailed or shortChasingBlocked)

if showLongStrategyDebugLabel or showShortStrategyDebugLabel
    bool debugIsLong = showLongStrategyDebugLabel
    string longDebugText = "L dbg\n" +
     "Can " + f_boolText(canPlaceLongOrder) + " EMA " + f_boolText(longFinalEmaClosePass) + "\n" +
     "F/M " + f_boolText(longFastEmaStackPass) + " F/S " + f_boolText(longFastSlowEmaStackPass) + " M/S " + f_boolText(longMidSlowEmaStackPass) + "\n" +
     "Struct " + f_boolText(longCurrentBarIsPullbackStructure) + " Stored " + f_boolText(longStoredPullbackCandidateActive) + "\n" +
     "Brk " + f_boolText(longFirstBreakAttempted) + " Fail " + f_boolText(longFirstBreakFailed) + " Chase " + f_boolText(longChasingBlocked) + "\n" +
     "Loc " + f_boolText(longLocationPass) + " Ret " + f_boolText(longCleanLevelRetestPass) + " Touch " + f_boolText(longTouchedAcceptancePass) + "\n" +
     "DCls " + f_boolText(longDelayedClosePass) + " D20 " + f_boolText(longDebugMaxDistanceFromMidEmaPass) + "\n" +
     "Type " + (longFirstBreakAttempted ? longConfirmationSetupType : longSetupType) + " Any " + f_boolText(longFirstBreakAttempted ? longAnyConfirmationQualifies : longAnySetupQualifies) + "\n" +
     "Stop " + f_boolText(longFirstBreakAttempted ? longConfirmationPullbackStopValid : longPullbackStopValid) + " Risk " + f_boolText(longDebugRiskPass) + " Q " + f_boolText(longDebugTriggerQualityPass) + " Qty " + str.tostring(longDebugContracts)
    string shortDebugText = "S dbg\n" +
     "Can " + f_boolText(canPlaceShortOrder) + " EMA " + f_boolText(shortFinalEmaClosePass) + "\n" +
     "F/M " + f_boolText(shortFastEmaStackPass) + " F/S " + f_boolText(shortFastSlowEmaStackPass) + " M/S " + f_boolText(shortMidSlowEmaStackPass) + "\n" +
     "Struct " + f_boolText(shortCurrentBarIsPullbackStructure) + " Stored " + f_boolText(shortStoredPullbackCandidateActive) + "\n" +
     "Brk " + f_boolText(shortFirstBreakAttempted) + " Fail " + f_boolText(shortFirstBreakFailed) + " Chase " + f_boolText(shortChasingBlocked) + "\n" +
     "Loc " + f_boolText(shortLocationPass) + " Ret " + f_boolText(shortCleanLevelRetestPass) + " Touch " + f_boolText(shortTouchedAcceptancePass) + "\n" +
     "DCls " + f_boolText(shortDelayedClosePass) + " D20 " + f_boolText(shortDebugMaxDistanceFromMidEmaPass) + "\n" +
     "Type " + (shortFirstBreakAttempted ? shortConfirmationSetupType : shortSetupType) + " Any " + f_boolText(shortFirstBreakAttempted ? shortAnyConfirmationQualifies : shortAnySetupQualifies) + "\n" +
     "Stop " + f_boolText(shortFirstBreakAttempted ? shortConfirmationPullbackStopValid : shortPullbackStopValid) + " Risk " + f_boolText(shortDebugRiskPass) + " Q " + f_boolText(shortDebugTriggerQualityPass) + " Qty " + str.tostring(shortDebugContracts)
    string debugText = debugIsLong ? longDebugText : shortDebugText
    label.new(bar_index, debugIsLong ? low : high, debugText, style=debugIsLong ? label.style_label_up : label.style_label_down, textcolor=color.white, color=color.new(color.gray, 30), size=size.tiny)

bool showEmaOverlapDebugLabel = showStrategyDebugLabels and barstate.isconfirmed and emaChopFilterMode == "EMA Bar Overlap" and canEvaluateSignals and (longCurrentBarIsPullbackStructure or shortCurrentBarIsPullbackStructure or longFirstBreakAttempted or shortFirstBreakAttempted)
if showEmaOverlapDebugLabel
    label.new(bar_index, high, emaChopOverlapSource + " overlap prior\n" + str.tostring(emaChopOverlapCount) + "/" + str.tostring(emaChopOverlapLookbackBars) + " bars [" + emaChopOverlapOffsetsText + "]", style=label.style_label_down, textcolor=color.white, color=color.new(color.orange, 15), size=size.tiny)

// ===================== Tables =====================

f_addStatusRow(table _table, int _row, string _name, string _value, color _valueColor) =>
    color rowBg = color.new(color.black, 82)
    table.cell(_table, 0, _row, _name, text_color=color.rgb(190, 190, 190), bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_left)
    table.cell(_table, 1, _row, _value, text_color=_valueColor, bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_right)
    _row + 1

f_addExcursionSection(table _table, int _row, string _title) =>
    color sectionBg = color.rgb(35, 35, 35)
    table.cell(_table, 0, _row, _title, text_color=color.white, bgcolor=sectionBg, text_size=size.tiny, text_halign=text.align_left)
    for col = 1 to 6
        table.cell(_table, col, _row, "", text_color=color.white, bgcolor=sectionBg, text_size=size.tiny)
    _row + 1

f_addExcursionMetricRow(table _table, int _row, string _name, string _value, color _valueColor) =>
    color rowBg = color.new(color.black, 84)
    table.cell(_table, 0, _row, _name, text_color=color.rgb(190, 190, 190), bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_left)
    table.cell(_table, 1, _row, _value, text_color=_valueColor, bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_right)
    for col = 2 to 6
        table.cell(_table, col, _row, "", text_color=color.rgb(220, 220, 220), bgcolor=rowBg, text_size=size.tiny)
    _row + 1

f_addExcursionStatsHeader(table _table, int _row, bool _showHit3) =>
    color headerBg = color.new(color.black, 72)
    table.cell(_table, 0, _row, "Bucket", text_color=color.white, bgcolor=headerBg, text_size=size.tiny, text_halign=text.align_left)
    table.cell(_table, 1, _row, "Records", text_color=color.white, bgcolor=headerBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 2, _row, "Avg MFE", text_color=color.white, bgcolor=headerBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 3, _row, "Avg MAE", text_color=color.white, bgcolor=headerBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 4, _row, "Final R", text_color=color.white, bgcolor=headerBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 5, _row, "Hit 1/1.5", text_color=color.white, bgcolor=headerBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 6, _row, _showHit3 ? "Hit 2/3" : "Hit 2", text_color=color.white, bgcolor=headerBg, text_size=size.tiny, text_halign=text.align_right)
    _row + 1

f_addExcursionStatsRow(table _table, int _row, string _name, int _count, float _sumMfe, float _sumMae, float _sumFinalExit, int _hit10, int _hit15, int _hit20, int _hit30, bool _showHit3) =>
    color rowBg = _count > 0 ? color.new(color.black, 84) : color.new(color.black, 90)
    color valueColor = _count > 0 ? color.rgb(220, 220, 220) : color.rgb(150, 150, 150)
    string hit10And15Text = f_pctText(f_pct(_hit10, _count)) + " / " + f_pctText(f_pct(_hit15, _count))
    string hit20And30Text = _showHit3 ? f_pctText(f_pct(_hit20, _count)) + " / " + f_pctText(f_pct(_hit30, _count)) : f_pctText(f_pct(_hit20, _count))
    table.cell(_table, 0, _row, _name, text_color=color.rgb(190, 190, 190), bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_left)
    table.cell(_table, 1, _row, str.tostring(_count), text_color=valueColor, bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 2, _row, f_rText(f_avg(_sumMfe, _count)), text_color=valueColor, bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 3, _row, f_rText(f_avg(_sumMae, _count)), text_color=valueColor, bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 4, _row, f_rText(f_avg(_sumFinalExit, _count)), text_color=valueColor, bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 5, _row, hit10And15Text, text_color=valueColor, bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_right)
    table.cell(_table, 6, _row, hit20And30Text, text_color=valueColor, bgcolor=rowBg, text_size=size.tiny, text_halign=text.align_right)
    _row + 1

var table debugTable = table.new(position.bottom_right, 2, 120, bgcolor=color.new(color.black, 85), border_width=0)
var table timeframeWarningTable = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 85), border_width=1)
var table excursionStatsTable = table.new(position.bottom_left, 7, 60, bgcolor=color.new(color.black, 86), border_width=0)

if barstate.islast
    if isFiveMinuteChart
        table.cell(timeframeWarningTable, 0, 0, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100), text_size=size.tiny)
    else
        table.cell(timeframeWarningTable, 0, 0, "Warning: designed for 5-minute ES/NQ/MES/MNQ charts", text_color=color.white, bgcolor=color.rgb(145, 0, 0), text_size=size.small)

    table.clear(excursionStatsTable, 0, 0, 6, 59)
    if showExcursionStats
        int excursionRow = 0
        excursionRow := f_addExcursionSection(excursionStatsTable, excursionRow, "MFE / MAE Closed Trade Records")
        if excursionCompletedTrades == 0
            excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Status", "No completed MFE records counted yet", color.yellow)
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Closed trade records seen", str.tostring(excursionClosedTradeRecordsSeen), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "MFE records counted", str.tostring(excursionCompletedTrades), excursionCompletedTrades > 0 ? color.lime : color.yellow)
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Invalid risk records", str.tostring(excursionInvalidTrades), excursionInvalidTrades > 0 ? color.yellow : color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Fallback risk records", str.tostring(excursionFallbackRiskTrades), excursionFallbackRiskTrades > 0 ? color.yellow : color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Active metadata records", str.tostring(excursionActiveMetadataTrades), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Fallback metadata records", str.tostring(excursionFallbackMetadataTrades), excursionFallbackMetadataTrades > 0 ? color.yellow : color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Avg MFE", f_rText(f_avg(excursionSumMfeR, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Avg MAE", f_rText(f_avg(excursionSumMaeR, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Avg Final R", f_rText(f_avg(excursionSumFinalExitR, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Avg Bars Held", f_numText(f_avg(excursionSumBarsHeld, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Hit 0.5R", f_pctText(f_pct(excursionHitMfe05, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Hit 1R", f_pctText(f_pct(excursionHitMfe10, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Hit 1.25R", f_pctText(f_pct(excursionHitMfe125, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Hit 1.5R", f_pctText(f_pct(excursionHitMfe15, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Hit 2R", f_pctText(f_pct(excursionHitMfe20, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Hit 2.5R", f_pctText(f_pct(excursionHitMfe25, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Hit 3R", f_pctText(f_pct(excursionHitMfe30, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "Hit 4R", f_pctText(f_pct(excursionHitMfe40, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "MAE >= 0.5R", f_pctText(f_pct(excursionHitMae05, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "MAE >= 1R", f_pctText(f_pct(excursionHitMae10, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "1R but not 1.5R", f_pctText(f_pct(excursionMfe10To15, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "1.5R but not 2R", f_pctText(f_pct(excursionMfe15To20, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "2R but not 3R", f_pctText(f_pct(excursionMfe20To30, excursionCompletedTrades)), color.rgb(220, 220, 220))
        excursionRow := f_addExcursionMetricRow(excursionStatsTable, excursionRow, "3R+", f_pctText(f_pct(excursionMfe30Plus, excursionCompletedTrades)), color.rgb(220, 220, 220))

        if showDirectionBreakdown
            excursionRow := f_addExcursionSection(excursionStatsTable, excursionRow, "Direction")
            excursionRow := f_addExcursionStatsHeader(excursionStatsTable, excursionRow, true)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "Long", excursionLongCount, excursionLongSumMfeR, excursionLongSumMaeR, excursionLongSumFinalExitR, excursionLongHit10, excursionLongHit15, excursionLongHit20, excursionLongHit30, true)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "Short", excursionShortCount, excursionShortSumMfeR, excursionShortSumMaeR, excursionShortSumFinalExitR, excursionShortHit10, excursionShortHit15, excursionShortHit20, excursionShortHit30, true)

        if showSetupBreakdown
            excursionRow := f_addExcursionSection(excursionStatsTable, excursionRow, "Setup")
            excursionRow := f_addExcursionStatsHeader(excursionStatsTable, excursionRow, true)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "STD", excursionStdCount, excursionStdSumMfeR, excursionStdSumMaeR, excursionStdSumFinalExitR, excursionStdHit10, excursionStdHit15, excursionStdHit20, excursionStdHit30, true)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "50R", excursionFiftyCount, excursionFiftySumMfeR, excursionFiftySumMaeR, excursionFiftySumFinalExitR, excursionFiftyHit10, excursionFiftyHit15, excursionFiftyHit20, excursionFiftyHit30, true)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "N/A", excursionSetupNaCount, excursionSetupNaSumMfeR, excursionSetupNaSumMaeR, excursionSetupNaSumFinalExitR, excursionSetupNaHit10, excursionSetupNaHit15, excursionSetupNaHit20, excursionSetupNaHit30, true)

        excursionRow := f_addExcursionSection(excursionStatsTable, excursionRow, "Entry Mode")
        excursionRow := f_addExcursionStatsHeader(excursionStatsTable, excursionRow, true)
        excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "Immediate", excursionImmediateCount, excursionImmediateSumMfeR, excursionImmediateSumMaeR, excursionImmediateSumFinalExitR, excursionImmediateHit10, excursionImmediateHit15, excursionImmediateHit20, excursionImmediateHit30, true)
        excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "Delayed", excursionDelayedCount, excursionDelayedSumMfeR, excursionDelayedSumMaeR, excursionDelayedSumFinalExitR, excursionDelayedHit10, excursionDelayedHit15, excursionDelayedHit20, excursionDelayedHit30, true)
        excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "N/A", excursionEntryNaCount, excursionEntryNaSumMfeR, excursionEntryNaSumMaeR, excursionEntryNaSumFinalExitR, excursionEntryNaHit10, excursionEntryNaHit15, excursionEntryNaHit20, excursionEntryNaHit30, true)

        if showLocationBreakdown and excursionTableMode == "Full"
            excursionRow := f_addExcursionSection(excursionStatsTable, excursionRow, "Location")
            excursionRow := f_addExcursionStatsHeader(excursionStatsTable, excursionRow, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "9EMA", loc9Count, loc9SumMfeR, loc9SumMaeR, loc9SumFinalExitR, loc9Hit10, loc9Hit15, loc9Hit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "20EMA", loc20Count, loc20SumMfeR, loc20SumMaeR, loc20SumFinalExitR, loc20Hit10, loc20Hit15, loc20Hit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "50EMA", loc50Count, loc50SumMfeR, loc50SumMaeR, loc50SumFinalExitR, loc50Hit10, loc50Hit15, loc50Hit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "ORH", locOrhCount, locOrhSumMfeR, locOrhSumMaeR, locOrhSumFinalExitR, locOrhHit10, locOrhHit15, locOrhHit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "ORL", locOrlCount, locOrlSumMfeR, locOrlSumMaeR, locOrlSumFinalExitR, locOrlHit10, locOrlHit15, locOrlHit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "PDH", locPdhCount, locPdhSumMfeR, locPdhSumMaeR, locPdhSumFinalExitR, locPdhHit10, locPdhHit15, locPdhHit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "PDL", locPdlCount, locPdlSumMfeR, locPdlSumMaeR, locPdlSumFinalExitR, locPdlHit10, locPdlHit15, locPdlHit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "PMH", locPmhCount, locPmhSumMfeR, locPmhSumMaeR, locPmhSumFinalExitR, locPmhHit10, locPmhHit15, locPmhHit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "PML", locPmlCount, locPmlSumMfeR, locPmlSumMaeR, locPmlSumFinalExitR, locPmlHit10, locPmlHit15, locPmlHit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "RTH Open", locRthOpenCount, locRthOpenSumMfeR, locRthOpenSumMaeR, locRthOpenSumFinalExitR, locRthOpenHit10, locRthOpenHit15, locRthOpenHit20, 0, false)
            excursionRow := f_addExcursionStatsRow(excursionStatsTable, excursionRow, "Other/N/A", locOtherCount, locOtherSumMfeR, locOtherSumMaeR, locOtherSumFinalExitR, locOtherHit10, locOtherHit15, locOtherHit20, 0, false)

    if showDebugTable
        bool currentAnyPendingOrder = longPendingOrder or shortPendingOrder
        string pendingDirectionText = longPendingOrder and shortPendingOrder ? "LONG+SHORT" : longPendingOrder ? "LONG" : shortPendingOrder ? "SHORT" : "None"
        string pendingEntryText = longPendingOrder and shortPendingOrder ? f_priceText(longPendingEntry) + " / " + f_priceText(shortPendingEntry) : longPendingOrder ? f_priceText(longPendingEntry) : shortPendingOrder ? f_priceText(shortPendingEntry) : "na"
        string pendingStopText = longPendingOrder and shortPendingOrder ? f_priceText(longPendingStop) + " / " + f_priceText(shortPendingStop) : longPendingOrder ? f_priceText(longPendingStop) : shortPendingOrder ? f_priceText(shortPendingStop) : "na"
        string pendingTargetText = longPendingOrder and shortPendingOrder ? f_priceText(longPendingTarget) + " / " + f_priceText(shortPendingTarget) : longPendingOrder ? f_priceText(longPendingTarget) : shortPendingOrder ? f_priceText(shortPendingTarget) : "na"
        string fastEmaLocationText = "On " + f_boolText(allowFastEmaLocation) + " L " + f_boolText(longTouchedEma9) + " / S " + f_boolText(shortTouchedEma9)
        string maxMidEmaDistanceText = useMaxDistanceFromMidEma ? "L " + f_boolText(longDebugMaxDistanceFromMidEmaPass) + " " + f_pointsText(longDebugDistanceFromMidEma) + " / S " + f_boolText(shortDebugMaxDistanceFromMidEmaPass) + " " + f_pointsText(shortDebugDistanceFromMidEma) : "Off"
        string activePlannedEntryText = strategy.position_size > 0 ? f_priceText(activeLongEntry) : strategy.position_size < 0 ? f_priceText(activeShortEntry) : "na"
        string activeAverageFillText = strategy.position_size > 0 ? f_priceText(activeLongAverageFillPrice) : strategy.position_size < 0 ? f_priceText(activeShortAverageFillPrice) : "na"
        string activeOriginalStopText = strategy.position_size > 0 ? f_priceText(activeLongStop) : strategy.position_size < 0 ? f_priceText(activeShortStop) : "na"
        string activePlannedRiskText = strategy.position_size > 0 ? f_pointsText(activeLongRisk) : strategy.position_size < 0 ? f_pointsText(activeShortRisk) : "na"
        string activeOneRTargetText = strategy.position_size > 0 ? f_priceText(activeLongOneRTarget) : strategy.position_size < 0 ? f_priceText(activeShortOneRTarget) : "na"
        string activeFinalTargetText = strategy.position_size > 0 ? f_priceText(activeLongTarget) : strategy.position_size < 0 ? f_priceText(activeShortTarget) : "na"
        string activeRunnerStopText = strategy.position_size > 0 ? f_priceText(activeLongRunnerStop) : strategy.position_size < 0 ? f_priceText(activeShortRunnerStop) : "na"
        string activeFilledQtyText = strategy.position_size > 0 ? str.tostring(activeLongFilledQty) : strategy.position_size < 0 ? str.tostring(activeShortFilledQty) : "na"
        int activeTablePositionQty = int(math.abs(strategy.position_size))
        bool activeTrimInvariantError = trimManagementMode and activeTablePositionQty >= 2 and ((strategy.position_size > 0 and (na(activeLongTrimQty) or na(activeLongRunnerQty) or not activeLongTrimManagementEligible)) or (strategy.position_size < 0 and (na(activeShortTrimQty) or na(activeShortRunnerQty) or not activeShortTrimManagementEligible)))
        string activeTrimInvariantReason = strategy.position_size > 0 ? f_trimStateIssueText(activeTablePositionQty, activeLongStop, activeLongRisk, activeLongOneRTarget, activeLongTarget, activeLongTrimQty, activeLongRunnerQty) : strategy.position_size < 0 ? f_trimStateIssueText(activeTablePositionQty, activeShortStop, activeShortRisk, activeShortOneRTarget, activeShortTarget, activeShortTrimQty, activeShortRunnerQty) : "Flat"
        string activeTrimQtyText = strategy.position_size > 0 ? str.tostring(activeLongTrimQty) : strategy.position_size < 0 ? str.tostring(activeShortTrimQty) : "na"
        string activeRunnerQtyText = strategy.position_size > 0 ? str.tostring(activeLongRunnerQty) : strategy.position_size < 0 ? str.tostring(activeShortRunnerQty) : "na"
        string trimRunnerQtyText = activeTrimInvariantError ? "ERROR: " + activeTrimInvariantReason : "T " + activeTrimQtyText + " / R " + activeRunnerQtyText
        string activeFallbackText = strategy.position_size > 0 ? f_boolText(activeLongFixedRFallback) : strategy.position_size < 0 ? f_boolText(activeShortFixedRFallback) : "FALSE"
        string oneRReachedText = strategy.position_size > 0 ? "L " + f_boolText(longOneRReached) : strategy.position_size < 0 ? "S " + f_boolText(shortOneRReached) : "Flat"
        string managementStateText = managementMode + (strategy.position_size > 0 ? " L eligible " + f_boolText(activeLongTrimManagementEligible) : strategy.position_size < 0 ? " S eligible " + f_boolText(activeShortTrimManagementEligible) : "")
        string exitSubmittedText = strategy.position_size > 0 ? "F " + f_boolText(longFixedExitSubmitted) + " T " + f_boolText(longTrimExitSubmitted) + " R " + f_boolText(longRunnerExitSubmitted) : strategy.position_size < 0 ? "F " + f_boolText(shortFixedExitSubmitted) + " T " + f_boolText(shortTrimExitSubmitted) + " R " + f_boolText(shortRunnerExitSubmitted) : "Flat"
        string pendingCancelDebugText = "Win " + f_boolText(pendingCancelledOutsideWindow) + " Sess " + f_boolText(pendingCancelledNewSession) + " RTH " + f_boolText(pendingCancelledRthFlatten)
        string touchedEmaCloseText = "9 " + f_boolText(longTouchedEma9ForClose) + " / 20 " + f_boolText(longTouchedEma20ForClose) + " / 50 " + f_boolText(longTouchedEma50ForClose)
        string requiredEmaCloseInputsText = "9 " + f_boolText(requireCloseBeyondFastEma) + " / 20 " + f_boolText(requireCloseBeyondMidEma) + " / 50 " + f_boolText(requireCloseBeyondSlowEma)
        string requiredEmaCloseText = f_pairBoolText(longRequiredEmaClosePass, shortRequiredEmaClosePass)
        string touchedEmaClosePassText = f_pairBoolText(longTouchedEmaClosePass, shortTouchedEmaClosePass)
        string badLevelBlockerText = "L " + f_boolText(longDebugBadLevelBlockerBlocked) + " / S " + f_boolText(shortDebugBadLevelBlockerBlocked)
        string badLevelThresholdText = "L " + f_pointsText(longDebugBadLevelBlockerThreshold) + " / S " + f_pointsText(shortDebugBadLevelBlockerThreshold)
        int row = 0
        table.cell(debugTable, 0, row, "EMA LPB Status", text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=size.tiny, text_halign=text.align_left)
        table.cell(debugTable, 1, row, syminfo.ticker + " " + timeframe.period, text_color=color.white, bgcolor=color.rgb(35, 35, 35), text_size=size.tiny, text_halign=text.align_right)
        row += 1
        row := f_addStatusRow(debugTable, row, "Can Evaluate", f_boolText(canEvaluateSignals), f_boolColor(canEvaluateSignals))
        row := f_addStatusRow(debugTable, row, "Time Window", f_boolText(inAlertTradingWindow), f_boolColor(inAlertTradingWindow))
        row := f_addStatusRow(debugTable, row, "Allow Pending After Window", f_boolText(allowPendingEntryFillsAfterWindow), allowPendingEntryFillsAfterWindow ? color.yellow : color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "Trades Today", str.tostring(tradesToday) + " / " + str.tostring(maxTradesPerDay), tradesToday < maxTradesPerDay ? color.lime : color.red)
        row := f_addStatusRow(debugTable, row, "OR Complete", f_boolText(openingRangeComplete), f_boolColor(openingRangeComplete))
        row := f_addStatusRow(debugTable, row, "OR Bias Filter", f_boolText(useOpeningRangeBiasFilter), useOpeningRangeBiasFilter ? color.yellow : color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "OR Bull Closes", str.tostring(openingRangeBullishCloseCount) + " / " + str.tostring(requiredOpeningRangeBreakoutCloses), openingRangeBullishCloseCount >= requiredOpeningRangeBreakoutCloses ? color.lime : color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "OR Bear Closes", str.tostring(openingRangeBearishCloseCount) + " / " + str.tostring(requiredOpeningRangeBreakoutCloses), openingRangeBearishCloseCount >= requiredOpeningRangeBreakoutCloses ? color.lime : color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "OR Bias Pass", f_pairBoolText(longOpeningRangeBiasPass, shortOpeningRangeBiasPass), f_pairBoolColor(longOpeningRangeBiasPass, shortOpeningRangeBiasPass))
        row := f_addStatusRow(debugTable, row, "OR Entry Levels", f_boolText(useOpeningRangeLevelsForEntries), useOpeningRangeLevelsForEntries ? color.lime : color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "Can Place", f_pairBoolText(canPlaceLongOrder, canPlaceShortOrder), f_pairBoolColor(canPlaceLongOrder, canPlaceShortOrder))
        row := f_addStatusRow(debugTable, row, "Context", f_pairBoolText(longContextPass, shortContextPass), f_pairBoolColor(longContextPass, shortContextPass))
        row := f_addStatusRow(debugTable, row, "EMA Close Requirement Mode", emaCloseRequirementMode, color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "Required EMA Close Inputs", requiredEmaCloseInputsText, color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "Touched EMA Close Lookback", str.tostring(emaTouchedCloseLookbackBars), color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "Touched 9/20/50 For Close", touchedEmaCloseText, color.rgb(220, 220, 220))
        row := f_addStatusRow(debugTable, row, "Required EMA Close Pass", requiredEmaCloseText, f_pairBoolColor(longRequiredEmaClosePass, shortRequiredEmaClosePass))
        row := f_addStatusRow(debugTable, row, "Touched EMA Close Pass", touchedEmaClosePassText, f_pairBoolColor(longTouchedEmaClosePass, shortTouchedEmaClosePass))
        row := f_addStatusRow(debugTable, row, "Final EMA Close", f_pairBoolText(longFinalEmaClosePass, shortFinalEmaClosePass), f_pairBoolColor(longFinalEmaClosePass, shortFinalEmaClosePass))
        row := f_addStatusRow(debugTable, row, "Fast/Mid Stack", f_pairBoolText(longFastEmaStackPass, shortFastEmaStackPass), f_pairBoolColor(longFastEmaStackPass, shortFastEmaStackPass))
        row := f_addStatusRow(debugTable, row, "Fast/Slow Stack", f_pairBoolText(longFastSlowEmaStackPass, shortFastSlowEmaStackPass), f_pairBoolColor(longFastSlowEmaStackPass, shortFastSlowEmaStackPass))
        row := f_addStatusRow(debugTable, row, "Mid/Slow Stack", f_pairBoolText(longMidSlowEmaStackPass, shortMidSlowEmaStackPass), f_pairBoolColor(longMidSlowEmaStackPass, shortMidSlowEmaStackPass))
        row := f_addStatusRow(debugTable, row, "EMA Slope Filter", f_boolText(useEmaSlopeFilter), useEmaSlopeFilter ? color.yellow : color.rgb(220, 220, 220))
